<Page
    x:Class="RetailStorePOS.UI.Reporting.Views.AdvancedReports.AbcXyzPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:components="using:RetailStorePOS.UI.Common.Views.Components"
    xmlns:local="using:RetailStorePOS.UI.Reporting.Views.AdvancedReports"
    mc:Ignorable="d"
    Background="White">

    <Page.Resources>
        <Style x:Key="AX_Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="BorderBrush" Value="#E8EAF0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="AX_HeaderCell" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#454443"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="AX_BodyCell" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#1A1D23"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="AX_MatrixCell" TargetType="Border">
            <Setter Property="BorderBrush" Value="#E8EAF0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="MinHeight" Value="56"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Padding="24,20,24,24" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock x:Uid="AbcXyz_Title"
                                   FontSize="22" FontWeight="SemiBold" Foreground="#1A1D23"/>
                        <Border Background="#EEE9FE" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                            <TextBlock x:Uid="AbcXyz_ProBadge" FontSize="11" FontWeight="SemiBold" Foreground="#6D28D9"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Uid="AbcXyz_Subtitle"
                               FontSize="13" Foreground="#8F96A3"
                               Margin="0,4,0,0"
                               TextWrapping="WrapWholeWords"/>
                </StackPanel>

                <components:PeriodFilterControl x:Name="PeriodFilter" Grid.Column="1"/>
            </Grid>

            <!-- 3x3 ABC × XYZ matrix -->
            <Border Grid.Row="1" Style="{StaticResource AX_Card}">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock x:Uid="AbcXyz_Matrix_Title"
                                   FontSize="14" FontWeight="SemiBold" Foreground="#1A1D23"/>
                        <TextBlock x:Uid="AbcXyz_Matrix_Subtitle"
                                   FontSize="12" Foreground="#8F96A3"/>
                    </StackPanel>

                    <Grid ColumnSpacing="8" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Column headers (A / B / C) -->
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="A"
                                   FontWeight="SemiBold" FontSize="13"
                                   Foreground="#6D28D9"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Grid.Row="0" Grid.Column="2"
                                   Text="B"
                                   FontWeight="SemiBold" FontSize="13"
                                   Foreground="#6D28D9"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Grid.Row="0" Grid.Column="3"
                                   Text="C"
                                   FontWeight="SemiBold" FontSize="13"
                                   Foreground="#6D28D9"
                                   HorizontalAlignment="Center"/>

                        <!-- Row headers (X / Y / Z) -->
                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="X"
                                   FontWeight="SemiBold" FontSize="13"
                                   Foreground="#6D28D9"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Text="Y"
                                   FontWeight="SemiBold" FontSize="13"
                                   Foreground="#6D28D9"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>
                        <TextBlock Grid.Row="3" Grid.Column="0"
                                   Text="Z"
                                   FontWeight="SemiBold" FontSize="13"
                                   Foreground="#6D28D9"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>

                        <!-- 9 matrix cells, populated from code-behind -->
                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource AX_MatrixCell}" Background="#F5F3FF">
                            <TextBlock x:Name="CellAX" Text="—" FontSize="12" Foreground="#1A1D23" TextAlignment="Center"/>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource AX_MatrixCell}" Background="#F5F3FF">
                            <TextBlock x:Name="CellBX" Text="—" FontSize="12" Foreground="#1A1D23" TextAlignment="Center"/>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="3" Style="{StaticResource AX_MatrixCell}" Background="#F5F3FF">
                            <TextBlock x:Name="CellCX" Text="—" FontSize="12" Foreground="#1A1D23" TextAlignment="Center"/>
                        </Border>

                        <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource AX_MatrixCell}" Background="#FAFAFC">
                            <TextBlock x:Name="CellAY" Text="—" FontSize="12" Foreground="#1A1D23" TextAlignment="Center"/>
                        </Border>
                        <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource AX_MatrixCell}" Background="#FAFAFC">
                            <TextBlock x:Name="CellBY" Text="—" FontSize="12" Foreground="#1A1D23" TextAlignment="Center"/>
                        </Border>
                        <Border Grid.Row="2" Grid.Column="3" Style="{StaticResource AX_MatrixCell}" Background="#FAFAFC">
                            <TextBlock x:Name="CellCY" Text="—" FontSize="12" Foreground="#1A1D23" TextAlignment="Center"/>
                        </Border>

                        <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource AX_MatrixCell}" Background="#FFFBEB">
                            <TextBlock x:Name="CellAZ" Text="—" FontSize="12" Foreground="#1A1D23" TextAlignment="Center"/>
                        </Border>
                        <Border Grid.Row="3" Grid.Column="2" Style="{StaticResource AX_MatrixCell}" Background="#FFFBEB">
                            <TextBlock x:Name="CellBZ" Text="—" FontSize="12" Foreground="#1A1D23" TextAlignment="Center"/>
                        </Border>
                        <Border Grid.Row="3" Grid.Column="3" Style="{StaticResource AX_MatrixCell}" Background="#FFFBEB">
                            <TextBlock x:Name="CellCZ" Text="—" FontSize="12" Foreground="#1A1D23" TextAlignment="Center"/>
                        </Border>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   x:Uid="AbcXyz_AxisLabel_Revenue"
                                   FontSize="11" Foreground="#8F96A3"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   x:Uid="AbcXyz_AxisLabel_Stability"
                                   FontSize="11" Foreground="#8F96A3"
                                   HorizontalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Detail table -->
            <Border Grid.Row="2" Style="{StaticResource AX_Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Padding="20,12" BorderBrush="#E8EAF0" BorderThickness="0,0,0,1" Background="#FAFBFC">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Uid="AbcXyz_Header_Class" Style="{StaticResource AX_HeaderCell}"/>
                        <TextBlock Grid.Column="1" x:Uid="AbcXyz_Header_Product" Style="{StaticResource AX_HeaderCell}"/>
                        <TextBlock Grid.Column="2" x:Uid="AbcXyz_Header_Units" Style="{StaticResource AX_HeaderCell}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="3" x:Uid="AbcXyz_Header_Revenue" Style="{StaticResource AX_HeaderCell}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="4" x:Uid="AbcXyz_Header_RevenueShare" Style="{StaticResource AX_HeaderCell}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="5" x:Uid="AbcXyz_Header_DemandCv" Style="{StaticResource AX_HeaderCell}" HorizontalAlignment="Right"/>
                    </Grid>

                    <ListView Grid.Row="1"
                              x:Name="RowsListView"
                              SelectionMode="None"
                              IsItemClickEnabled="False"
                              ScrollViewer.HorizontalScrollMode="Disabled"
                              MaxHeight="600">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="MinHeight" Value="0"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:AbcXyzDisplayItem">
                                <Grid Padding="20,10" BorderBrush="#F1F4F9" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            Background="{x:Bind ClassBackground}"
                                            CornerRadius="4"
                                            Padding="6,2"
                                            HorizontalAlignment="Left">
                                        <TextBlock Text="{x:Bind ClassText}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{x:Bind ClassForeground}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{x:Bind Name}" FontSize="13" FontWeight="SemiBold" Foreground="#1A1D23" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{x:Bind BarcodeText}" FontSize="11" Foreground="#8F96A3"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{x:Bind UnitsText}" Style="{StaticResource AX_BodyCell}" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="3" Text="{x:Bind RevenueText}" Style="{StaticResource AX_BodyCell}" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="4" Text="{x:Bind RevenueShareText}" Style="{StaticResource AX_BodyCell}" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="5" Text="{x:Bind DemandCvText}" Style="{StaticResource AX_BodyCell}" HorizontalAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- Status -->
            <TextBlock Grid.Row="3"
                       Text="{x:Bind StatusText, Mode=OneWay}"
                       FontSize="12"
                       Foreground="#8F96A3"/>
        </Grid>
    </ScrollViewer>
</Page>
