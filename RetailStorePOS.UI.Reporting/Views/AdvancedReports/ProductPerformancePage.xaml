<Page
    x:Class="RetailStorePOS.UI.Reporting.Views.AdvancedReports.ProductPerformancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:components="using:RetailStorePOS.UI.Common.Views.Components"
    xmlns:local="using:RetailStorePOS.UI.Reporting.Views.AdvancedReports"
    mc:Ignorable="d"
    Background="White">

    <Page.Resources>
        <Style x:Key="PP_Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderBrush" Value="#E8EAF0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="PP_TabButton" TargetType="ToggleButton">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Foreground" Value="#1A1D23"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="PP_HeaderCell" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#454443"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PP_BodyCell" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#1A1D23"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </Page.Resources>

    <Grid Padding="24,20,24,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: title + Pro badge + period filter -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock x:Uid="ProductPerformance_Title"
                           FontSize="22" FontWeight="SemiBold" Foreground="#1A1D23"/>
                <Border Background="#EEE9FE" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                    <TextBlock x:Uid="ProductPerformance_ProBadge" FontSize="11" FontWeight="SemiBold" Foreground="#6D28D9"/>
                </Border>
            </StackPanel>

            <components:PeriodFilterControl x:Name="PeriodFilter" Grid.Column="1"/>
        </Grid>

        <!-- Tabs + export -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ToggleButton x:Name="TopSellersButton"
                              x:Uid="ProductPerformance_Tab_TopSellers"
                              Style="{StaticResource PP_TabButton}"
                              Click="TabButton_Click"
                              Tag="TopSellers"
                              IsChecked="True"/>
                <ToggleButton x:Name="TopMoversButton"
                              x:Uid="ProductPerformance_Tab_TopMovers"
                              Style="{StaticResource PP_TabButton}"
                              Click="TabButton_Click"
                              Tag="TopMovers"/>
                <ToggleButton x:Name="SlowMoversButton"
                              x:Uid="ProductPerformance_Tab_SlowMovers"
                              Style="{StaticResource PP_TabButton}"
                              Click="TabButton_Click"
                              Tag="SlowMovers"/>
                <ToggleButton x:Name="DeadStockButton"
                              x:Uid="ProductPerformance_Tab_DeadStock"
                              Style="{StaticResource PP_TabButton}"
                              Click="TabButton_Click"
                              Tag="DeadStock"/>
            </StackPanel>

            <Button Grid.Column="1"
                    Click="ExportCsvButton_Click"
                    Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,8"
                    Foreground="#1A1D23">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE74E;" FontSize="13" Foreground="#1A1D23"/>
                    <TextBlock x:Uid="ProductPerformance_Export" FontSize="13"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Table -->
        <Border Grid.Row="2" Style="{StaticResource PP_Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header row -->
                <Grid Grid.Row="0" Padding="16,10" BorderBrush="#E8EAF0" BorderThickness="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Uid="ProductPerformance_Header_Rank" Style="{StaticResource PP_HeaderCell}" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="1" x:Uid="ProductPerformance_Header_Product" Style="{StaticResource PP_HeaderCell}"/>
                    <TextBlock Grid.Column="2" x:Uid="ProductPerformance_Header_Units" Style="{StaticResource PP_HeaderCell}" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="3" x:Uid="ProductPerformance_Header_Revenue" Style="{StaticResource PP_HeaderCell}" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="4" x:Uid="ProductPerformance_Header_Profit" Style="{StaticResource PP_HeaderCell}" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="5" x:Uid="ProductPerformance_Header_Margin" Style="{StaticResource PP_HeaderCell}" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="6" x:Uid="ProductPerformance_Header_LastSale" Style="{StaticResource PP_HeaderCell}" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="7" x:Uid="ProductPerformance_Header_Stock" Style="{StaticResource PP_HeaderCell}" HorizontalAlignment="Right"/>
                </Grid>

                <!-- Data rows -->
                <ListView Grid.Row="1"
                          x:Name="VisibleRowsListView"
                          SelectionMode="None"
                          IsItemClickEnabled="False"
                          ShowsScrollingPlaceholders="True"
                          ScrollViewer.VerticalScrollMode="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollMode="Disabled">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="MinHeight" Value="0"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:ProductPerformanceDisplayItem">
                            <Grid Padding="16,10" BorderBrush="#F1F4F9" BorderThickness="0,0,0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind RankText}" Style="{StaticResource PP_BodyCell}" HorizontalAlignment="Center" Foreground="#8F96A3"/>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{x:Bind Name}" FontSize="13" FontWeight="SemiBold" Foreground="#1A1D23" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{x:Bind BarcodeText}" FontSize="11" Foreground="#8F96A3"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{x:Bind UnitsText}" Style="{StaticResource PP_BodyCell}" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="3" Text="{x:Bind RevenueText}" Style="{StaticResource PP_BodyCell}" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="4" Text="{x:Bind ProfitText}" Style="{StaticResource PP_BodyCell}" HorizontalAlignment="Right" Foreground="{x:Bind ProfitBrush}"/>
                                <TextBlock Grid.Column="5" Text="{x:Bind MarginText}" Style="{StaticResource PP_BodyCell}" HorizontalAlignment="Right" Foreground="{x:Bind ProfitBrush}"/>
                                <TextBlock Grid.Column="6" Text="{x:Bind LastSoldText}" Style="{StaticResource PP_BodyCell}" HorizontalAlignment="Right" Foreground="#8F96A3"/>
                                <TextBlock Grid.Column="7" Text="{x:Bind StockText}" Style="{StaticResource PP_BodyCell}" HorizontalAlignment="Right"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock Grid.Row="1"
                           Text="{x:Bind EmptyStateText, Mode=OneWay}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="#8F96A3"
                           FontSize="13"
                           Visibility="{x:Bind EmptyStateVisibility, Mode=OneWay}"/>
            </Grid>
        </Border>

        <!-- Footer count + status -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind StatusText, Mode=OneWay}"
                       FontSize="12"
                       Foreground="#8F96A3"
                       VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1"
                       Text="{x:Bind RowCountText, Mode=OneWay}"
                       FontSize="12"
                       Foreground="#8F96A3"
                       VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Page>
