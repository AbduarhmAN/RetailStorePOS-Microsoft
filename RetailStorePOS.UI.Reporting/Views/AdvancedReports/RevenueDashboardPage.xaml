<Page
    x:Class="RetailStorePOS.UI.Reporting.Views.AdvancedReports.RevenueDashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:advanced="using:RetailStorePOS.UI.Reporting.Views.AdvancedReports"
    xmlns:components="using:RetailStorePOS.UI.Common.Views.Components"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation"
    mc:Ignorable="d"
    automation:AutomationProperties.Name="Revenue Intelligence dashboard"
    Background="White">

    <Page.Resources>
        <Style x:Key="RD_Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="BorderBrush" Value="#E8EAF0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="RD_KpiLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#454443"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="RD_KpiValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="#1A1D23"/>
        </Style>

        <Style x:Key="RD_CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1A1D23"/>
        </Style>

        <Style x:Key="RD_Delta" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>

        <!-- Animated shimmer used by all skeleton placeholders. Code-behind
             updates the gradient stops on a DispatcherTimer to create the
             sweep effect. -->
        <LinearGradientBrush x:Key="RD_ShimmerBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#EEF2F6" Offset="0"/>
            <GradientStop Color="#EEF2F6" Offset="0.18"/>
            <GradientStop Color="#F7F9FB" Offset="0.32"/>
            <GradientStop Color="#EEF2F6" Offset="0.46"/>
            <GradientStop Color="#EEF2F6" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="RD_SkeletonBlock" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource RD_ShimmerBrush}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Height" Value="14"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Padding="24,20,24,24" RowSpacing="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header: title, "Pro" badge, period filter -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock x:Uid="RevenueDashboard_Title" Text="Revenue Intelligence"
                               FontSize="22" FontWeight="SemiBold" Foreground="#1A1D23"/>
                    <Border Background="#EEE9FE" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                        <TextBlock x:Uid="RevenueDashboard_ProBadge" Text="Pro" FontSize="11" FontWeight="SemiBold" Foreground="#6D28D9"/>
                    </Border>
                </StackPanel>

                <components:PeriodFilterControl x:Name="PeriodFilter" Grid.Column="1"/>
            </Grid>

            <!-- Row 1: 4 KPI tiles -->
            <Grid Grid.Row="1" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Total Revenue -->
                <Border Grid.Column="0" Style="{StaticResource RD_Card}"
                        automation:AutomationProperties.Name="Total Revenue KPI"
                        automation:AutomationProperties.HelpText="{x:Bind TotalRevenueText, Mode=OneWay}">
                    <Grid>
                        <StackPanel Spacing="6" Visibility="{x:Bind SkeletonVisibility, Mode=OneWay}">
                            <Border Style="{StaticResource RD_SkeletonBlock}" Width="96" HorizontalAlignment="Left"/>
                            <Border Background="#EEF2F6" Height="1"/>
                            <Border Style="{StaticResource RD_SkeletonBlock}" Width="140" Height="28" Margin="0,8,0,0" HorizontalAlignment="Left"/>
                            <Border Style="{StaticResource RD_SkeletonBlock}" Width="100" HorizontalAlignment="Left"/>
                        </StackPanel>
                        <StackPanel Spacing="6" Visibility="{x:Bind ContentVisibility, Mode=OneWay}">
                            <TextBlock x:Uid="RevenueDashboard_KPI_TotalRevenue" Text="Total Revenue" Style="{StaticResource RD_KpiLabel}"/>
                            <Rectangle Height="1" Fill="#E2E8F0" HorizontalAlignment="Stretch" Margin="0,2,0,2"/>
                            <TextBlock Text="{x:Bind TotalRevenueText, Mode=OneWay}" Style="{StaticResource RD_KpiValue}" Margin="0,8,0,0"/>
                            <TextBlock Text="{x:Bind RevenueDeltaText, Mode=OneWay}" Style="{StaticResource RD_Delta}" Foreground="{x:Bind RevenueDeltaBrush, Mode=OneWay}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Gross Profit -->
                <Border Grid.Column="1" Style="{StaticResource RD_Card}"
                        automation:AutomationProperties.Name="Gross Profit KPI"
                        automation:AutomationProperties.HelpText="{x:Bind GrossProfitText, Mode=OneWay}">
                    <Grid>
                        <StackPanel Spacing="6" Visibility="{x:Bind SkeletonVisibility, Mode=OneWay}">
                            <Border Style="{StaticResource RD_SkeletonBlock}" Width="84" HorizontalAlignment="Left"/>
                            <Border Background="#EEF2F6" Height="1"/>
                            <Border Style="{StaticResource RD_SkeletonBlock}" Width="120" Height="28" Margin="0,8,0,0" HorizontalAlignment="Left"/>
                            <Border Style="{StaticResource RD_SkeletonBlock}" Width="100" HorizontalAlignment="Left"/>
                        </StackPanel>
                        <StackPanel Spacing="6" Visibility="{x:Bind ContentVisibility, Mode=OneWay}">
                            <TextBlock x:Uid="RevenueDashboard_KPI_GrossProfit" Text="Gross Profit" Style="{StaticResource RD_KpiLabel}"/>
                            <Rectangle Height="1" Fill="#E2E8F0" HorizontalAlignment="Stretch" Margin="0,2,0,2"/>
                            <TextBlock Text="{x:Bind GrossProfitText, Mode=OneWay}" Style="{StaticResource RD_KpiValue}" Margin="0,8,0,0"/>
                            <TextBlock Text="{x:Bind ProfitDeltaText, Mode=OneWay}" Style="{StaticResource RD_Delta}" Foreground="{x:Bind ProfitDeltaBrush, Mode=OneWay}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Transactions -->
                <Border Grid.Column="2" Style="{StaticResource RD_Card}"
                        automation:AutomationProperties.Name="Transactions KPI"
                        automation:AutomationProperties.HelpText="{x:Bind TransactionCountText, Mode=OneWay}">
                    <Grid>
                        <StackPanel Spacing="6" Visibility="{x:Bind SkeletonVisibility, Mode=OneWay}">
                            <Border Style="{StaticResource RD_SkeletonBlock}" Width="92" HorizontalAlignment="Left"/>
                            <Border Background="#EEF2F6" Height="1"/>
                            <Border Style="{StaticResource RD_SkeletonBlock}" Width="80" Height="28" Margin="0,8,0,0" HorizontalAlignment="Left"/>
                            <Border Style="{StaticResource RD_SkeletonBlock}" Width="100" HorizontalAlignment="Left"/>
                        </StackPanel>
                        <StackPanel Spacing="6" Visibility="{x:Bind ContentVisibility, Mode=OneWay}">
                            <TextBlock x:Uid="RevenueDashboard_KPI_Transactions" Text="Transactions" Style="{StaticResource RD_KpiLabel}"/>
                            <Rectangle Height="1" Fill="#E2E8F0" HorizontalAlignment="Stretch" Margin="0,2,0,2"/>
                            <TextBlock Text="{x:Bind TransactionCountText, Mode=OneWay}" Style="{StaticResource RD_KpiValue}" Margin="0,8,0,0"/>
                            <TextBlock Text="{x:Bind TransactionsDeltaText, Mode=OneWay}" Style="{StaticResource RD_Delta}" Foreground="{x:Bind TransactionsDeltaBrush, Mode=OneWay}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Avg Ticket -->
                <Border Grid.Column="3" Style="{StaticResource RD_Card}"
                        automation:AutomationProperties.Name="Average Transaction KPI"
                        automation:AutomationProperties.HelpText="{x:Bind AverageTransactionText, Mode=OneWay}">
                    <Grid>
                        <StackPanel Spacing="6" Visibility="{x:Bind SkeletonVisibility, Mode=OneWay}">
                            <Border Style="{StaticResource RD_SkeletonBlock}" Width="110" HorizontalAlignment="Left"/>
                            <Border Background="#EEF2F6" Height="1"/>
                            <Border Style="{StaticResource RD_SkeletonBlock}" Width="120" Height="28" Margin="0,8,0,0" HorizontalAlignment="Left"/>
                            <Border Style="{StaticResource RD_SkeletonBlock}" Width="100" HorizontalAlignment="Left"/>
                        </StackPanel>
                        <StackPanel Spacing="6" Visibility="{x:Bind ContentVisibility, Mode=OneWay}">
                            <TextBlock x:Uid="RevenueDashboard_KPI_AvgTransaction" Text="Avg Transaction" Style="{StaticResource RD_KpiLabel}"/>
                            <Rectangle Height="1" Fill="#E2E8F0" HorizontalAlignment="Stretch" Margin="0,2,0,2"/>
                            <TextBlock Text="{x:Bind AverageTransactionText, Mode=OneWay}" Style="{StaticResource RD_KpiValue}" Margin="0,8,0,0"/>
                            <TextBlock Text="{x:Bind AverageDeltaText, Mode=OneWay}" Style="{StaticResource RD_Delta}" Foreground="{x:Bind AverageDeltaBrush, Mode=OneWay}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Row 2: Revenue trend chart -->
            <Border Grid.Row="2" Style="{StaticResource RD_Card}" Padding="20,16">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="280"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="RevenueDashboard_Trend_Title" Text="Revenue trend" Style="{StaticResource RD_CardTitle}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="10" Height="10" CornerRadius="5" Background="#6D28D9"/>
                                <TextBlock x:Uid="RevenueDashboard_Trend_LegendRevenue" Text="Revenue" FontSize="12" Foreground="#454443"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="10" Height="10" CornerRadius="5" Background="#22C55E"/>
                                <TextBlock x:Uid="RevenueDashboard_Trend_LegendProfit" Text="Profit" FontSize="12" Foreground="#454443"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Border Style="{StaticResource RD_SkeletonBlock}"
                                Height="260"
                                CornerRadius="10"
                                Visibility="{x:Bind SkeletonVisibility, Mode=OneWay}"/>
                        <lvc:CartesianChart x:Name="TrendChart"
                                            automation:AutomationProperties.Name="Revenue and profit trend chart"
                                            Visibility="{x:Bind ContentVisibility, Mode=OneWay}"
                                            Series="{x:Bind TrendSeries, Mode=OneWay}"
                                            XAxes="{x:Bind TrendXAxes, Mode=OneWay}"
                                            YAxes="{x:Bind TrendYAxes, Mode=OneWay}"
                                            TooltipPosition="Top"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Row 3: top products + busiest tiles -->
            <Grid Grid.Row="3" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Top 5 products -->
                <Border Grid.Column="0" Style="{StaticResource RD_Card}"
                        automation:AutomationProperties.Name="Top products by revenue">
                    <Grid>
                        <!-- Skeleton: 5 fake rows -->
                        <StackPanel Spacing="12" Visibility="{x:Bind SkeletonVisibility, Mode=OneWay}">
                            <Border Style="{StaticResource RD_SkeletonBlock}" Width="120" HorizontalAlignment="Left"/>
                            <Rectangle Height="1" Fill="#E2E8F0" HorizontalAlignment="Stretch"/>
                            <StackPanel Spacing="14">
                                <Border Style="{StaticResource RD_SkeletonBlock}" Height="32" CornerRadius="6"/>
                                <Border Style="{StaticResource RD_SkeletonBlock}" Height="32" CornerRadius="6"/>
                                <Border Style="{StaticResource RD_SkeletonBlock}" Height="32" CornerRadius="6"/>
                                <Border Style="{StaticResource RD_SkeletonBlock}" Height="32" CornerRadius="6"/>
                                <Border Style="{StaticResource RD_SkeletonBlock}" Height="32" CornerRadius="6"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Real content -->
                        <StackPanel Spacing="12" Visibility="{x:Bind ContentVisibility, Mode=OneWay}">
                            <TextBlock x:Uid="RevenueDashboard_TopProducts_Title" Text="Top products" Style="{StaticResource RD_CardTitle}"/>
                            <Rectangle Height="1" Fill="#E2E8F0" HorizontalAlignment="Stretch"/>
                            <ListView x:Name="TopProductsListView"
                                      SelectionMode="None"
                                      IsItemClickEnabled="False"
                                      Padding="0">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="0,8"/>
                                        <Setter Property="MinHeight" Value="0"/>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="advanced:TopProductDisplayItem">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Background="#F5F3FF" CornerRadius="6" Padding="8,3" Width="34" HorizontalAlignment="Center">
                                                <TextBlock Text="{x:Bind RankText}" FontSize="12" FontWeight="SemiBold" Foreground="#6D28D9" HorizontalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Text="{x:Bind Name}" FontSize="13" FontWeight="SemiBold" Foreground="#1A1D23" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{x:Bind UnitsLabel}" FontSize="11" Foreground="#8F96A3"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind RevenueText}" FontSize="13" FontWeight="SemiBold" Foreground="#1A1D23" HorizontalAlignment="Right"/>
                                                <TextBlock Text="{x:Bind ProfitText}" FontSize="11" Foreground="{x:Bind ProfitBrush}" HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock x:Uid="RevenueDashboard_TopProducts_Empty"
                                       Text="No sales for this period"
                                       FontSize="12" Foreground="#8F96A3"
                                       HorizontalAlignment="Center"
                                       Margin="0,12,0,8"
                                       Visibility="{x:Bind EmptyTopProductsVisibility, Mode=OneWay}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Busiest hour + day -->
                <StackPanel Grid.Column="1" Spacing="16">
                    <Border Style="{StaticResource RD_Card}">
                        <Grid>
                            <StackPanel Spacing="6" Visibility="{x:Bind SkeletonVisibility, Mode=OneWay}">
                                <Border Style="{StaticResource RD_SkeletonBlock}" Width="100" HorizontalAlignment="Left"/>
                                <Border Background="#EEF2F6" Height="1"/>
                                <Border Style="{StaticResource RD_SkeletonBlock}" Width="140" Height="28" Margin="0,8,0,0" HorizontalAlignment="Left"/>
                                <Border Style="{StaticResource RD_SkeletonBlock}" Width="160" HorizontalAlignment="Left"/>
                            </StackPanel>
                            <StackPanel Spacing="6" Visibility="{x:Bind ContentVisibility, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE823;" FontSize="14" Foreground="#6D28D9"/>
                                    <TextBlock x:Uid="RevenueDashboard_BusiestHour_Label" Text="Busiest hour" Style="{StaticResource RD_KpiLabel}"/>
                                </StackPanel>
                                <Rectangle Height="1" Fill="#E2E8F0"/>
                                <TextBlock Text="{x:Bind BusiestHourText, Mode=OneWay}" Style="{StaticResource RD_KpiValue}" Margin="0,8,0,0"/>
                                <TextBlock Text="{x:Bind BusiestHourSubtext, Mode=OneWay}" FontSize="12" Foreground="#8F96A3"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource RD_Card}">
                        <Grid>
                            <StackPanel Spacing="6" Visibility="{x:Bind SkeletonVisibility, Mode=OneWay}">
                                <Border Style="{StaticResource RD_SkeletonBlock}" Width="100" HorizontalAlignment="Left"/>
                                <Border Background="#EEF2F6" Height="1"/>
                                <Border Style="{StaticResource RD_SkeletonBlock}" Width="120" Height="28" Margin="0,8,0,0" HorizontalAlignment="Left"/>
                                <Border Style="{StaticResource RD_SkeletonBlock}" Width="160" HorizontalAlignment="Left"/>
                            </StackPanel>
                            <StackPanel Spacing="6" Visibility="{x:Bind ContentVisibility, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE787;" FontSize="14" Foreground="#6D28D9"/>
                                    <TextBlock x:Uid="RevenueDashboard_BusiestDay_Label" Text="Busiest day" Style="{StaticResource RD_KpiLabel}"/>
                                </StackPanel>
                                <Rectangle Height="1" Fill="#E2E8F0"/>
                                <TextBlock Text="{x:Bind BusiestDayText, Mode=OneWay}" Style="{StaticResource RD_KpiValue}" Margin="0,8,0,0"/>
                                <TextBlock Text="{x:Bind BusiestDaySubtext, Mode=OneWay}" FontSize="12" Foreground="#8F96A3"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Loading / error overlay strip -->
            <Border Grid.Row="4"
                    Visibility="{x:Bind StatusBannerVisibility, Mode=OneWay}"
                    Background="#FFF7ED"
                    BorderBrush="#FED7AA"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,10">
                <TextBlock Text="{x:Bind StatusBannerText, Mode=OneWay}"
                           FontSize="13"
                           Foreground="#9A3412"/>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
