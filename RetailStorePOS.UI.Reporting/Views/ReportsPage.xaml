<Page
    x:Class="RetailStorePOS.UI.Reporting.Views.ReportsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <NavigationView x:Name="ReportsNavView" 
                        PaneDisplayMode="Top" 
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        SelectionChanged="NavView_SelectionChanged"
                        Margin="0,0,0,1">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="{x:Bind Reports_Nav_Dashboard, Mode=OneTime}" Tag="Dashboard" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Library"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{x:Bind Reports_Nav_Receipts, Mode=OneTime}" Tag="Receipts">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Folder"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="AdvancedAnalyticsNavItem"
                                    x:Uid="Reports_Nav_AdvancedAnalytics"
                                    Tag="AdvancedAnalytics"
                                    Visibility="Collapsed">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="ProductPerformanceNavItem"
                                    x:Uid="Reports_Nav_ProductPerformance"
                                    Tag="ProductPerformance"
                                    Visibility="Collapsed">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7BF;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="OperationsNavItem"
                                    x:Uid="Reports_Nav_Operations"
                                    Tag="Operations"
                                    Visibility="Collapsed">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE823;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="AbcXyzNavItem"
                                    x:Uid="Reports_Nav_AbcXyz"
                                    Tag="AbcXyz"
                                    Visibility="Collapsed">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8FD;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="BasketAffinityNavItem"
                                    x:Uid="Reports_Nav_BasketAffinity"
                                    Tag="BasketAffinity"
                                    Visibility="Collapsed">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE71D;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
        </NavigationView>

        <Frame x:Name="ReportsContentFrame" Grid.Row="1" IsNavigationStackEnabled="False">
            <Frame.ContentTransitions>
                <TransitionCollection />
            </Frame.ContentTransitions>
        </Frame>
    </Grid>
</Page>
