<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="RetailStorePOS.WinUiLogin.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid x:Name="RootLayout">
        <NavigationView x:Name="SettingsNavView"
                        Background="Transparent"
                        IsTabStop="False"
                        IsSettingsVisible="False"
                        IsBackButtonVisible="Collapsed"
                        IsTitleBarAutoPaddingEnabled="False"
                        AlwaysShowHeader="False"
                        IsPaneToggleButtonVisible="True"
                        PaneDisplayMode="Left"
                        IsPaneOpen="False"
                        OpenPaneLength="278"
                        SelectionChanged="SettingsNavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="CheckoutNavItem"
                                    Content="Checkout"
                                    ToolTipService.ToolTip="Checkout"
                                    Tag="checkout">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Shop" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="ProductsNavItem"
                                    Content="Products"
                                    ToolTipService.ToolTip="Products"
                                    Tag="products">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Library" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="ReportsNavItem"
                                    Content="Reports"
                                    ToolTipService.ToolTip="Reports"
                                    Tag="reports">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9F9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="SettingsRootNav"
                                    Content="Settings"
                                    ToolTipService.ToolTip="Settings"
                                    Tag="settings-root"
                                    SelectsOnInvoked="False">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </NavigationViewItem.Icon>

                    <NavigationViewItem.MenuItems>
                        <NavigationViewItem x:Name="StoreNav"
                                            Content="Store Management"
                                            ToolTipService.ToolTip="Store Management"
                                            Tag="store">
                            <NavigationViewItem.Icon>
                                <SymbolIcon Symbol="Shop" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>

                        <NavigationViewItem x:Name="TaxNav"
                                            Content="Tax Configuration"
                                            ToolTipService.ToolTip="Tax Configuration"
                                            Tag="tax">
                            <NavigationViewItem.Icon>
                                <SymbolIcon Symbol="Calculator" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>

                        <NavigationViewItem x:Name="UsersNav"
                                            Content="Users &amp; Roles"
                                            ToolTipService.ToolTip="Users &amp; Roles"
                                            Tag="users">
                            <NavigationViewItem.Icon>
                                <SymbolIcon Symbol="People" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>

                        <NavigationViewItem x:Name="PrefsNav"
                                            Content="My Preferences"
                                            ToolTipService.ToolTip="My Preferences"
                                            Tag="prefs">
                            <NavigationViewItem.Icon>
                                <SymbolIcon Symbol="ContactInfo" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                    </NavigationViewItem.MenuItems>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="AboutNavItem"
                                    Content="About"
                                    ToolTipService.ToolTip="About"
                                    Tag="about">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Help" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="SignOutNavItem"
                                    Content="Sign out"
                                    ToolTipService.ToolTip="Sign out"
                                    Tag="signout">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xF3B1;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Frame x:Name="SettingsContentFrame"
                   Background="Transparent" />
        </NavigationView>

    </Grid>
</Page>
