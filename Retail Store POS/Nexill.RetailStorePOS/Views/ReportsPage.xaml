<Page
    x:Name="ReportsShellPageRoot"
    x:Class="RetailStorePOS.WinUiLogin.Views.ReportsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#F4F5F7">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Tab Bar -->
            <RowDefinition Height="*"/>    <!-- Content Frame -->
        </Grid.RowDefinitions>

        <!-- ── Custom Horizontal Tab Bar ── -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="0,0,0,1"
                Padding="20,0">
            <StackPanel Orientation="Horizontal" Spacing="4">

                <!-- Dashboard Tab -->
                <Button x:Name="DashboardTabBtn"
                        Click="DashboardTab_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="16,12"
                        CornerRadius="0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Home" Foreground="#1976D2"/>
                        <TextBlock Text="Dashboard"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="#1976D2"/>
                    </StackPanel>
                </Button>

                <!-- Active indicator under Dashboard -->
                <Rectangle x:Name="DashboardIndicator"
                           Width="80" Height="2"
                           Fill="#1976D2"
                           VerticalAlignment="Bottom"/>

                <!-- Receipts Tab -->
                <Button x:Name="ReceiptsTabBtn"
                        Click="ReceiptsTab_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="16,12"
                        CornerRadius="0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Folder" Foreground="#8F96A3"/>
                        <TextBlock Text="Receipts"
                                   FontSize="13" FontWeight="Normal"
                                   Foreground="#8F96A3"/>
                    </StackPanel>
                </Button>

            </StackPanel>
        </Border>

        <!-- ── Content Frame ── -->
        <Frame x:Name="ReportsContentFrame"
               Grid.Row="1"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch"/>

    </Grid>
</Page>