<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="RetailStorePOS.WinUiLogin.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:viewModels="using:RetailStorePOS.WinUiLogin.ViewModels"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Background="#EEF3FA">
        <Grid.Resources>
            <LinearGradientBrush x:Key="HeroBackgroundBrush"
                                 StartPoint="0,0"
                                 EndPoint="1,1">
                <GradientStop Color="#11214A" Offset="0" />
                <GradientStop Color="#18346E" Offset="0.46" />
                <GradientStop Color="#4F2F92" Offset="1" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="PrimaryActionBrush"
                                 StartPoint="0,0"
                                 EndPoint="1,1">
                <GradientStop Color="#27458F" Offset="0" />
                <GradientStop Color="#5B46F4" Offset="1" />
            </LinearGradientBrush>

            <Style x:Key="ModeTabButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="UseSystemFocusVisuals" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Margin="{TemplateBinding Padding}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CashierCardButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>

            <Style x:Key="RoundedTextBoxStyle" TargetType="TextBox">
                <Setter Property="MinHeight" Value="38" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="BorderBrush" Value="#D8E2F0" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="UseSystemFocusVisuals" Value="False" />
            </Style>

            <Style x:Key="RoundedPasswordBoxStyle" TargetType="PasswordBox">
                <Setter Property="MinHeight" Value="38" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="BorderBrush" Value="#D8E2F0" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="UseSystemFocusVisuals" Value="False" />
            </Style>
        </Grid.Resources>

        <Grid ColumnSpacing="16"
              Padding="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.06*" />
                <ColumnDefinition Width="0.94*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    CornerRadius="30"
                    Background="{StaticResource HeroBackgroundBrush}"
                    Padding="14"
                    BorderBrush="#22FFFFFF"
                    BorderThickness="1">
                <Grid RowSpacing="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal"
                                Spacing="10"
                                HorizontalAlignment="Center">
                        <Border Width="86"
                                Height="86"
                                CornerRadius="22"
                                Background="#FFFFFF"
                                BorderThickness="0"
                                Padding="2">
                            <Image Source="ms-appx:///Assets/Logo.png"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Stretch="Uniform" />
                        </Border>

                        <StackPanel VerticalAlignment="Center"
                                    Spacing="1">
                            <TextBlock Text="Retail Store"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#F8FAFC" />
                            <TextBlock Text="Retail login workspace"
                                       FontSize="12"
                                       Foreground="#C9D6F2" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="1"
                                MaxWidth="360"
                                Spacing="10"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock Text="Fast cashier access. Secure admin control."
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="#FFFFFF" />
                        <TextBlock Text="Choose a mode, sign in, and keep the store moving without extra steps."
                                   FontSize="14"
                                   LineHeight="20"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="#D6E0F3" />
                        <TextBlock x:Name="HeroSupportText"
                                   Text="Cashier mode keeps the line moving."
                                   FontSize="13"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="#E2E8F0" />
                    </StackPanel>

                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Spacing="8">
                        <Border Background="#18FFFFFF"
                                BorderBrush="#28FFFFFF"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="11,6">
                            <TextBlock Text="Cashier flow"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#F8FAFC" />
                        </Border>
                        <Border Background="#18FFFFFF"
                                BorderBrush="#28FFFFFF"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="11,6">
                            <TextBlock Text="Admin security"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#F8FAFC" />
                        </Border>
                        <Border Background="#18FFFFFF"
                                BorderBrush="#28FFFFFF"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="11,6">
                            <TextBlock Text="Store ready"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#F8FAFC" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1"
                  Padding="0,2,0,2">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Border Background="#FFFFFF"
                            BorderBrush="#D9E2F0"
                            BorderThickness="1"
                            CornerRadius="30"
                            Padding="16,16">
                        <StackPanel MaxWidth="560"
                                    Spacing="12"
                                    HorizontalAlignment="Stretch">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Spacing="1">
                                    <TextBlock Text="Welcome back"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#5B46F4" />
                                    <TextBlock x:Name="ModeTitleText"
                                               Text="Cashier sign-in"
                                               FontSize="26"
                                               FontWeight="SemiBold"
                                               Foreground="#0F172A" />
                                    <TextBlock x:Name="ModeSubtitleText"
                                               Text="Select a mode, then sign in."
                                               FontSize="13"
                                               LineHeight="18"
                                               TextWrapping="Wrap"
                                               Foreground="#64748B" />
                                </StackPanel>

                                <Border Grid.Column="1"
                                        Width="72"
                                        Height="72"
                                        CornerRadius="18"
                                        Background="#FFFFFF"
                                        BorderThickness="0"
                                        Padding="2"
                                        VerticalAlignment="Center">
                                    <Image Source="ms-appx:///Assets/Logo.png"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Stretch="Uniform" />
                                </Border>
                            </Grid>

                            <Border Background="#F4F7FB"
                                    BorderBrush="#E5EAF3"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="2">
                                <Grid x:Name="ModeTabStrip"
                                      Height="44"
                                      SizeChanged="ModeTabStrip_SizeChanged">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border x:Name="ModeIndicator"
                                            Width="0"
                                            Height="36"
                                            Background="{StaticResource PrimaryActionBrush}"
                                            CornerRadius="10"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center">
                                        <Border.RenderTransform>
                                            <TranslateTransform x:Name="ModeIndicatorTransform" />
                                        </Border.RenderTransform>
                                    </Border>

                                    <Button x:Name="CashierTabButton"
                                            Click="CashierTabButton_Click"
                                            Style="{StaticResource ModeTabButtonStyle}">
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="5"
                                                    HorizontalAlignment="Center">
                                            <SymbolIcon x:Name="CashierTabIcon"
                                                        Symbol="Contact" />
                                            <TextBlock x:Name="CashierTabText"
                                                       Text="Cashier"
                                                       FontSize="13"
                                                       FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="AdminTabButton"
                                            Grid.Column="1"
                                            Click="AdminTabButton_Click"
                                            Style="{StaticResource ModeTabButtonStyle}">
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="5"
                                                    HorizontalAlignment="Center">
                                            <SymbolIcon x:Name="AdminTabIcon"
                                                        Symbol="Setting" />
                                            <TextBlock x:Name="AdminTabText"
                                                       Text="Admin"
                                                       FontSize="13"
                                                       FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <InfoBar x:Name="StatusInfoBar"
                                     IsOpen="False"
                                     IsClosable="False"
                                     Severity="Informational"
                                     Visibility="Collapsed"
                                     Message="" />

                            <Grid MinHeight="352">
                                <Border x:Name="CashierLoginPanel"
                                        Background="Transparent">
                                    <Border.Transitions>
                                        <TransitionCollection>
                                            <EntranceThemeTransition FromVerticalOffset="16"
                                                                     IsStaggeringEnabled="False" />
                                        </TransitionCollection>
                                    </Border.Transitions>

                                    <StackPanel Spacing="12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Spacing="3">
                                                <TextBlock Text="Cashier access"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"
                                                           Foreground="#0F172A" />
                                                <TextBlock x:Name="CashierHelperText"
                                                           Text="Choose a cashier card, then enter the PIN."
                                                           TextWrapping="Wrap"
                                                           FontSize="13"
                                                           Foreground="#64748B" />
                                            </StackPanel>

                                            <Border Grid.Column="1"
                                                    Background="#EDF2FF"
                                                    BorderBrush="#DCE5FF"
                                                    BorderThickness="1"
                                                    CornerRadius="9"
                                                    Padding="7,3"
                                                    VerticalAlignment="Top">
                                                <TextBlock x:Name="CashierCountBadgeText"
                                                           Text="Ready"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="#4338CA" />
                                            </Border>
                                        </Grid>

                                        <Border x:Name="CashierEmptyState"
                                                Background="#F8FAFC"
                                                BorderBrush="#E2E8F0"
                                                BorderThickness="1"
                                                CornerRadius="16"
                                                Padding="12,10"
                                                Visibility="Collapsed">
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="No cashier profiles available"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"
                                                           Foreground="#0F172A" />
                                                <TextBlock Text="Add an active staff user with a PIN in Users to enable quick cashier sign-in cards."
                                                           TextWrapping="Wrap"
                                                           FontSize="13"
                                                           Foreground="#64748B" />
                                            </StackPanel>
                                        </Border>

                                        <ItemsControl x:Name="StaffListView"
                                                      MinHeight="146"
                                                      ScrollViewer.HorizontalScrollMode="Disabled"
                                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                      ScrollViewer.VerticalScrollMode="Disabled"
                                                      ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <ItemsWrapGrid Orientation="Horizontal"
                                                                   MaximumRowsOrColumns="3" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>

                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="viewModels:LoginStaffOption">
                                                    <Button Click="CashierCardButton_Click"
                                                            Tag="{x:Bind}"
                                                            Style="{StaticResource CashierCardButtonStyle}">
                                                        <Border Width="156"
                                                                Height="138"
                                                                Padding="12"
                                                                Background="{x:Bind CardBackgroundBrush, Mode=OneWay}"
                                                                BorderBrush="{x:Bind CardBorderBrush, Mode=OneWay}"
                                                                BorderThickness="2"
                                                                CornerRadius="18">
                                                            <Grid RowSpacing="8">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="*" />
                                                                </Grid.RowDefinitions>

                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>

                                                                    <Border Width="44"
                                                                            Height="44"
                                                                            CornerRadius="13"
                                                                            Background="{x:Bind BadgeBackgroundBrush, Mode=OneWay}">
                                                                        <TextBlock Text="{x:Bind Initial}"
                                                                                   FontSize="20"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="{x:Bind InitialForegroundBrush, Mode=OneWay}"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center" />
                                                                    </Border>

                                                                    <Border Grid.Column="2"
                                                                            Width="24"
                                                                            Height="24"
                                                                            CornerRadius="12"
                                                                            Background="#5B46F4"
                                                                            Visibility="{x:Bind SelectionGlyphVisibility, Mode=OneWay}">
                                                                        <FontIcon Glyph="&#xE73E;"
                                                                                  FontFamily="Segoe Fluent Icons"
                                                                                  FontSize="11"
                                                                                  Foreground="White"
                                                                                  HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center" />
                                                                    </Border>
                                                                </Grid>

                                                                <StackPanel Grid.Row="1"
                                                                            Spacing="2">
                                                                    <TextBlock Text="{x:Bind DisplayName}"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               FontSize="13"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{x:Bind NameForegroundBrush, Mode=OneWay}" />
                                                                    <TextBlock Text="{x:Bind User.RoleLabel, Mode=OneWay}"
                                                                               FontSize="10"
                                                                               Foreground="#64748B" />
                                                                </StackPanel>

                                                                <Border Grid.Row="2"
                                                                        HorizontalAlignment="Left"
                                                                        VerticalAlignment="Bottom"
                                                                        Padding="7,3"
                                                                        CornerRadius="9"
                                                                        Background="{x:Bind PinStatusBackgroundBrush, Mode=OneWay}">
                                                                    <TextBlock Text="{x:Bind PinStatusText, Mode=OneWay}"
                                                                               FontSize="9"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{x:Bind PinStatusForegroundBrush, Mode=OneWay}" />
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <StackPanel Spacing="6" HorizontalAlignment="Stretch">
                                            <TextBlock Text="Cashier PIN"
                                                        FontWeight="SemiBold"
                                                        Foreground="#0F172A" />

                                            <Grid ColumnSpacing="8" HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    
                                                </Grid.ColumnDefinitions>

                                                <PasswordBox x:Name="PinPasswordBox"
                                                              Height="38"
                                                              MaxLength="4"
                                                              PlaceholderText="Enter 4-digit PIN"
                                                              CornerRadius="8"
                                                              HorizontalAlignment="Stretch"
                                                              VerticalAlignment="Center"
                                                              FontSize="14"
                                                              KeyDown="PinPasswordBox_KeyDown"
                                                              AutomationProperties.Name="Cashier PIN"
                                                              PasswordRevealMode="Peek"
                                                              Style="{StaticResource DefaultPasswordBoxStyle}" />

                                                <Button x:Name="CashierActionButton"
                                                        Grid.Column="1"
                                                        Content="Login"
                                                        Click="CashierSignInButton_Click"
                                                        HorizontalAlignment="Stretch"
                                                        MinWidth="176"
                                                        Height="38"
                                                        CornerRadius="8"
                                                        Style="{ThemeResource AccentButtonStyle}" />
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="AdminLoginPanel"
                                        Background="Transparent"
                                        Visibility="Collapsed">
                                    <Border.Transitions>
                                        <TransitionCollection>
                                            <EntranceThemeTransition FromVerticalOffset="16"
                                                                     IsStaggeringEnabled="False" />
                                        </TransitionCollection>
                                    </Border.Transitions>

                                    <StackPanel Spacing="12">
                                        <StackPanel Spacing="1">
                                            <TextBlock Text="Administrator access"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       Foreground="#0F172A" />
                                            <TextBlock x:Name="AdminHelperText"
                                                       Text="Use an administrator account for secure changes and store-wide controls."
                                                       TextWrapping="Wrap"
                                                       FontSize="13"
                                                       Foreground="#64748B" />
                                        </StackPanel>

                                        <Border x:Name="SetupCallout"
                                                Visibility="Collapsed"
                                                Background="#F8FAFC"
                                                BorderBrush="#DDE5F3"
                                                BorderThickness="1"
                                                CornerRadius="16"
                                                Padding="12">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <Border Width="36"
                                                        Height="36"
                                                        CornerRadius="11"
                                                        Background="#EEF2FF">
                                                    <FontIcon Glyph="&#xE946;"
                                                              FontFamily="Segoe Fluent Icons"
                                                              FontSize="15"
                                                              Foreground="#4F46E5"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                                </Border>

                                                <StackPanel Grid.Column="1"
                                                            Spacing="2">
                                                    <TextBlock Text="First-time store setup"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="#0F172A" />
                                                    <TextBlock x:Name="SetupCalloutText"
                                                               Text="Finish the admin setup, then add cashier profiles with PINs for quick access at the counter."
                                                               TextWrapping="Wrap"
                                                               FontSize="13"
                                                               Foreground="#64748B" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <StackPanel Spacing="5">
                                            <TextBlock Text="Username"
                                                       FontWeight="SemiBold"
                                                       Foreground="#0F172A" />
                                            <TextBox x:Name="UsernameBox"
                                                      HorizontalAlignment="Stretch"
                                                      Height="38"
                                                      PlaceholderText="Enter username"
                                                      Style="{StaticResource RoundedTextBoxStyle}"
                                                      AutomationProperties.Name="Username"
                                                      KeyDown="AdminCredentialBox_KeyDown" />
                                        </StackPanel>

                                        <StackPanel Spacing="5">
                                            <TextBlock Text="Password"
                                                       FontWeight="SemiBold"
                                                       Foreground="#0F172A" />
                                            <PasswordBox x:Name="AdminPasswordBox"
                                                         HorizontalAlignment="Stretch"
                                                         Height="38"
                                                         PlaceholderText="Enter your password"
                                                         CornerRadius="12"
                                                         Style="{StaticResource DefaultPasswordBoxStyle}"
                                                         PasswordRevealMode="Peek"
                                                         AutomationProperties.Name="Password"
                                                         KeyDown="AdminCredentialBox_KeyDown" />
                                        </StackPanel>

                                        <Button x:Name="AdminActionButton"
                                                Content="Login as admin"
                                                Click="AdminSignInButton_Click"
                                                HorizontalAlignment="Stretch"
                                                Height="38"
                                                CornerRadius="8"
                                                Style="{ThemeResource AccentButtonStyle}" />

                                        <Border x:Name="OnboardingHintPanel"
                                                Visibility="Collapsed"
                                                Background="#FEE2E2"
                                                BorderBrush="#FCA5A5"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Padding="12,10"
                                                Margin="0,8,0,0">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="First-Time Administrator Setup"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="#991B1B" />
                                                <TextBlock Text="Default Username: admin | Password: 1234"
                                                           FontSize="12"
                                                           Foreground="#7F1D1D" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </Grid>
        </Grid>

        <TeachingTip x:Name="CashierPinTip"
                     Target="{x:Bind PinPasswordBox, Mode=OneWay}"
                     PreferredPlacement="Left"
                     TailVisibility="Visible"
                     PlacementMargin="12"
                     ShouldConstrainToRootBounds="True"
                     IsLightDismissEnabled="True"
                     CloseButtonContent="Close"
                     Title="Cashier PIN"
                     Subtitle="The default Cashier PIN is 1234." />
    </Grid>
</Page>


