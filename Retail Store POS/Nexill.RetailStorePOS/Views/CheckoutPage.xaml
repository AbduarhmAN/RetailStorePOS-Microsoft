<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="RetailStorePOS.WinUiLogin.Views.CheckoutPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:data="using:RetailStorePOS.Data.Models"
    xmlns:models="using:RetailStorePOS.WinUiLogin.Models"
    xmlns:common="using:RetailStorePOS.WinUiLogin.Common"
    xmlns:input="using:Microsoft.UI.Xaml.Input"
    xmlns:animation="using:Microsoft.UI.Xaml.Media.Animation"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="8">
        <InfoBar x:Name="InventoryAlertInfoBar"
                 Title="Inventory Alert"
                 Message="{x:Bind ViewModel.InventoryAlertMessage, Mode=OneWay}"
                 IsOpen="{x:Bind ViewModel.IsInventoryAlertOpen, Mode=TwoWay}"
                 Severity="Warning"
                 IsClosable="True"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Top"
                 Margin="0,0,0,0"
                 Canvas.ZIndex="100" />

        <ContentDialog x:Name="DiscountDialog"
                       Title="Apply Discount"
                       PrimaryButtonText="Apply"
                       CloseButtonText="Cancel"
                       PrimaryButtonClick="DiscountDialog_PrimaryButtonClick">
            <StackPanel Spacing="16">
                <TextBlock Text="Enter the discount amount to apply to the entire cart." TextWrapping="Wrap" />
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="8" VerticalAlignment="Bottom">
                        <TextBlock Text="Discount Type" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ToggleSwitch OnContent="Percentage (%)" OffContent="Amount ($)" IsOn="{x:Bind ViewModel.IsDiscountPercentage, Mode=TwoWay}" />
                    </StackPanel>
                    <NumberBox x:Name="DiscountAmountBox"
                               Grid.Column="1"
                               Header="Discount Value"
                               Value="{x:Bind ViewModel.DiscountAmount, Mode=TwoWay}"
                               SpinButtonPlacementMode="Hidden"
                               Minimum="0"
                               common:NumericInputNormalization.NormalizeOnLostFocus="True" />
                </Grid>
                <StackPanel Spacing="8">
                    <TextBlock Text="Quick presets" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Grid ColumnSpacing="8" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Button Content="5%" Tag="pct:5" Click="DiscountPresetButton_Click" HorizontalAlignment="Stretch" />
                        <Button Grid.Column="1" Content="10%" Tag="pct:10" Click="DiscountPresetButton_Click" HorizontalAlignment="Stretch" />
                        <Button Grid.Row="1" Content="$1" Tag="amt:1" Click="DiscountPresetButton_Click" HorizontalAlignment="Stretch" />
                        <Button Grid.Row="1" Grid.Column="1" Content="$5" Tag="amt:5" Click="DiscountPresetButton_Click" HorizontalAlignment="Stretch" />
                    </Grid>
                </StackPanel>
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                    <Run Text="Discount summary: " />
                    <Run Text="{x:Bind ViewModel.DiscountAmountText, Mode=OneWay}" FontWeight="SemiBold" />
                </TextBlock>
            </StackPanel>
        </ContentDialog>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*" />
                <ColumnDefinition Width="1.05*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Padding="10,8" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE7BF;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontSize="18" />
                                <TextBlock Text="Current Sale" FontSize="18" FontWeight="SemiBold" />
                            </StackPanel>

                            <Border Grid.Column="1"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8,4"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.CartItemsCountText, Mode=OneWay}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Border>

                            <Button Grid.Column="2"
                                    Command="{x:Bind ViewModel.AddDiscountCommand}"
                                    Content="Discount"
                                    Padding="12,6"
                                    CornerRadius="4"
                                    VerticalAlignment="Center" />

                            <Button Grid.Column="3"
                                    Click="ClearCartButton_Click"
                                    IsEnabled="{x:Bind ViewModel.CanClearCart, Mode=OneWay}"
                                    Content="Clear"
                                    Padding="12,6"
                                    CornerRadius="4"
                                    VerticalAlignment="Center" />
                        </Grid>

                        <Grid Grid.Row="1" Margin="8,6,8,6">
                                <ListView x:Name="CartItemsListView"
                                      ItemsSource="{x:Bind ViewModel.CartItems, Mode=OneWay}"
                                      Visibility="{x:Bind ViewModel.CartListVisibility, Mode=OneWay}"
                                      SelectionMode="None"
                                      Padding="0"
                                      VerticalAlignment="Stretch"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollMode="Enabled">
                                <ListView.Header>
                                    <Border Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                            CornerRadius="4"
                                            Padding="10,6">
                                        <Grid ColumnSpacing="12" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="360" />
                                                <ColumnDefinition Width="108" />
                                                <ColumnDefinition Width="124" />
                                                <ColumnDefinition Width="118" />
                                                <ColumnDefinition Width="88" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="Item" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="Qty" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="Price" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="Total" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="4" Text="Adjust" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </ListView.Header>
                                <ListView.ItemContainerTransitions>
                                    <animation:TransitionCollection />
                                </ListView.ItemContainerTransitions>
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                        <Setter Property="Padding" Value="10,6" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:CheckoutCartItem">
                                        <Grid ColumnSpacing="12"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center"
                                              MinHeight="40">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="360" />
                                                <ColumnDefinition Width="108" />
                                                <ColumnDefinition Width="124" />
                                                <ColumnDefinition Width="118" />
                                                <ColumnDefinition Width="88" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Spacing="1" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Name}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxLines="1"
                                                           HorizontalAlignment="Left" />
                                                <TextBlock Text="{x:Bind Barcode}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxLines="1"
                                                           HorizontalAlignment="Center"
                                                           TextAlignment="Center" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Button Command="{Binding ElementName=RootPage, Path=ViewModel.DecreaseQtyCommand}"
                                                        CommandParameter="{x:Bind}"
                                                        Content="-"
                                                        Width="30"
                                                        Height="30"
                                                        CornerRadius="4" />
                                                <TextBlock Text="{x:Bind QuantityText, Mode=OneWay}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                                <Button Command="{Binding ElementName=RootPage, Path=ViewModel.IncreaseQtyCommand}"
                                                        CommandParameter="{x:Bind}"
                                                        Content="+"
                                                        Width="30"
                                                        Height="30"
                                                        CornerRadius="4" />
                                            </StackPanel>

                                            <Grid Grid.Column="2"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center">
                                                <Button Click="PriceButton_Click"
                                                        Visibility="{x:Bind PriceOverrideVisibility, Mode=OneWay}"
                                                        Background="Transparent"
                                                        BorderBrush="Transparent"
                                                        BorderThickness="0"
                                                        CornerRadius="4"
                                                        Padding="8,4"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                    <StackPanel Spacing="0" HorizontalAlignment="Center">
                                                        <TextBlock Text="{x:Bind PriceText, Mode=OneWay}"
                                                                   HorizontalAlignment="Center"
                                                                   TextAlignment="Center"
                                                                   FontWeight="SemiBold" />
                                                        <TextBlock Text="{x:Bind OriginalPriceText, Mode=OneWay}"
                                                                   Visibility="{x:Bind OriginalPriceVisibility, Mode=OneWay}"
                                                                   HorizontalAlignment="Center"
                                                                   TextAlignment="Center"
                                                                   FontSize="11"
                                                                   TextDecorations="Strikethrough"
                                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                    </StackPanel>
                                                </Button>

                                                <StackPanel Visibility="{x:Bind PriceReadOnlyVisibility, Mode=OneWay}"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Spacing="0">
                                                    <TextBlock Text="{x:Bind PriceText, Mode=OneWay}"
                                                               HorizontalAlignment="Center"
                                                               TextAlignment="Center"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Text="{x:Bind OriginalPriceText, Mode=OneWay}"
                                                               Visibility="{x:Bind OriginalPriceVisibility, Mode=OneWay}"
                                                               HorizontalAlignment="Center"
                                                               TextAlignment="Center"
                                                               FontSize="11"
                                                               TextDecorations="Strikethrough"
                                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                </StackPanel>
                                            </Grid>

                                            <TextBlock Grid.Column="3"
                                                       Text="{x:Bind LineTotalText, Mode=OneWay}"
                                                       HorizontalAlignment="Center"
                                                       TextAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontWeight="SemiBold" />

                                            <Button Grid.Column="4"
                                                    Command="{Binding ElementName=RootPage, Path=ViewModel.RemoveItemCommand}"
                                                    CommandParameter="{x:Bind}"
                                                    Content="Remove"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Padding="8,5"
                                                    CornerRadius="4" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <Border Visibility="{x:Bind ViewModel.EmptyCartVisibility, Mode=OneWay}"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="18,14"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <StackPanel HorizontalAlignment="Center" Spacing="10">
                                    <Border Width="56"
                                            Height="56"
                                            Background="{ThemeResource AcrylicBackgroundFillColorBaseBrush}"
                                            CornerRadius="4"
                                            HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE7BF;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="No items yet" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock Text="Find a product on the right and add it to start the sale."
                                               TextWrapping="WrapWholeWords"
                                               HorizontalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Border>
                        </Grid>

                        <Grid Grid.Row="2" Margin="8,0,8,8" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="0.5"
                                    CornerRadius="4"
                                    Padding="10,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Subtotal" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SubtotalText, Mode=OneWay}" FontWeight="SemiBold" />
                                </Grid>
                            </Border>

                            <Border Grid.Column="1"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="0.5"
                                    CornerRadius="4"
                                    Padding="10,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Tax" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TaxText, Mode=OneWay}" FontWeight="SemiBold" />
                                </Grid>
                            </Border>

                            <Border Grid.Column="2"
                                    Background="{ThemeResource AppBarItemPointerOverBackgroundThemeBrush}"
                                    BorderBrush="{ThemeResource AccentControlElevationBorderBrush}"
                                    BorderThickness="0"
                                    CornerRadius="4"
                                    Padding="10,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Total" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TotalText, Mode=OneWay}" FontWeight="Bold" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="8">
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="116" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 x:Name="TenderedCashBox"
                                 Text="{x:Bind ViewModel.TenderedInputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 common:NumericInputNormalization.NormalizeOnLostFocus="True"
                                 Header="Cash"
                                 CornerRadius="4"
                                 Background="LightGray"
                                 PlaceholderText="Cash Tendered"
                                 ToolTipService.ToolTip="Shortcut: Ctrl+D"
                                 BorderThickness="1"
                                 Padding="0"
                                 GotFocus="TenderedCashBox_GotFocus"
                                 TextChanged="TenderedCashBox_TextChanged"
                                 KeyDown="TenderedCashBox_KeyDown">
                            <TextBox.KeyboardAccelerators>
                                <input:KeyboardAccelerator Key="D"
                                                           Modifiers="Control"
                                                           Invoked="TenderedCashBox_CtrlD_Invoked" />
                            </TextBox.KeyboardAccelerators>
                        </TextBox>

                        <Button Grid.Column="1"
                                Command="{x:Bind ViewModel.TenderExactCommand}"
                                Content="Exact"
                                Padding="10,6"
                                CornerRadius="4"
                                VerticalAlignment="Bottom" />

                        <Button Grid.Column="2"
                                Command="{x:Bind ViewModel.TenderPlus1Command}"
                                Content="{x:Bind ViewModel.QuickCash1Text, Mode=OneWay}"
                                Padding="10,6"
                                CornerRadius="4"
                                VerticalAlignment="Bottom" />

                        <Button Grid.Column="3"
                                Command="{x:Bind ViewModel.TenderPlus2Command}"
                                Content="{x:Bind ViewModel.QuickCash2Text, Mode=OneWay}"
                                Padding="10,6"
                                CornerRadius="4"
                                VerticalAlignment="Bottom" />

                        <Button Grid.Column="4"
                                Command="{x:Bind ViewModel.TenderPlus3Command}"
                                Content="{x:Bind ViewModel.QuickCash3Text, Mode=OneWay}"
                                Padding="10,6"
                                CornerRadius="4"
                                VerticalAlignment="Bottom" />

                        <Border Grid.Column="5"
                                Visibility="{x:Bind ViewModel.StatusVisibility, Mode=OneWay}"
                                Background="{x:Bind ViewModel.StatusBackgroundBrush, Mode=OneWay}"
                                BorderBrush="{x:Bind ViewModel.StatusBorderBrush, Mode=OneWay}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="10,8"
                                Margin="2,0,0,0"
                                VerticalAlignment="Bottom">
                            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                                       Foreground="{x:Bind ViewModel.StatusTextBrush, Mode=OneWay}"
                                       TextWrapping="WrapWholeWords"
                                       MaxLines="2" />
                        </Border>

                        <Border Grid.Column="6"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Background="{ThemeResource AppBarItemPointerOverBackgroundThemeBrush}"
                                BorderBrush="{ThemeResource AppBarItemPointerOverBackgroundThemeBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="10,8">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Change:" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ChangeDueText, Mode=OneWay}" FontWeight="Bold" />
                            </Grid>
                        </Border>

                        <Button Grid.Column="7"
                                Command="{x:Bind ViewModel.CompleteSaleCommand}"
                                Content="Complete Sale"
                                Style="{ThemeResource AccentButtonStyle}"
                                Padding="12,8"
                                CornerRadius="4"
                                VerticalAlignment="Bottom" />
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Column="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Spacing="2">
                        <TextBlock Text="Find Product" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Search by product name or barcode, then add the selected item to the sale."
                                   TextWrapping="WrapWholeWords"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <Border Grid.Row="1"
                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,0">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <FontIcon Glyph="&#xE721;"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      VerticalAlignment="Center" />

                            <TextBox Grid.Column="1"
                                     x:Name="SearchTextBox"
                                     PlaceholderText="Search products"
                                     Text="{x:Bind ViewModel.SearchTerm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0,10,0,10"
                                     TextChanged="SearchTextBox_TextChanged"
                                     PreviewKeyDown="SearchTextBox_PreviewKeyDown" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="2"
                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8,4"
                            HorizontalAlignment="Stretch">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind ViewModel.SearchResultsCountText, Mode=OneWay}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <ListView Grid.Row="3"
                              x:Name="SearchResultsListView"
                              ItemsSource="{x:Bind ViewModel.SearchResults, Mode=OneWay}"
                              IsItemClickEnabled="True"
                              PreviewKeyDown="SearchResultsListView_PreviewKeyDown"
                              ItemClick="SearchResultsListView_ItemClick"
                              SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,4" />
                                <Setter Property="UseSystemFocusVisuals" Value="False" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:SearchResultItem">
                                <Border Background="{x:Bind CardBackgroundBrush, Mode=OneWay}"
                                        BorderBrush="{x:Bind CardBorderBrush, Mode=OneWay}"
                                        BorderThickness="{x:Bind CardBorderThickness, Mode=OneWay}"
                                        CornerRadius="4"
                                        Padding="10,8"
                                        PointerEntered="SearchResultCard_PointerEntered"
                                        PointerExited="SearchResultCard_PointerExited">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{x:Bind Price}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>

                                        <FontIcon Grid.Column="1"
                                                  Glyph="&#xE72A;"
                                                  Foreground="{x:Bind ChevronBrush, Mode=OneWay}"
                                                  VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Button Grid.Row="4"
                            Click="AddSelectedButton_Click"
                            IsEnabled="{x:Bind ViewModel.CanAddSelectedProduct, Mode=OneWay}"
                            Content="Add to Sale"
                            Padding="12,8"
                            CornerRadius="4" />
                </Grid>
            </Border>
        </Grid>
    <Grid Visibility="{x:Bind ViewModel.ReceiptVisibility, Mode=OneWay}">
        <Rectangle Fill="#B0182438" />

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Margin="12">
            <Grid>
                <Border HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="510"
                        MaxHeight="860"
                        Background="#FFFDFDFE"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="30,24">
                    <Grid RowSpacing="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid x:Name="ReceiptPrintContent"
                              Grid.Row="0"
                              Grid.RowSpan="4"
                              RowSpacing="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0"
                                        HorizontalAlignment="Center"
                                        Spacing="8"
                                        Margin="0,0,0,6">
                                <Border Width="70"
                                        Height="70"
                                        CornerRadius="4"
                                        Background="#a6a6a63b"
                                        HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE73E;"
                                              Width="30"
                                              Height="30"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{x:Bind ViewModel.StoreName, Mode=OneWay}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.StoreAddress, Mode=OneWay}"
                                           FontSize="11"
                                           HorizontalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="WrapWholeWords"
                                           TextAlignment="Center"
                                           Visibility="{x:Bind ViewModel.StoreAddressVisibility, Mode=OneWay}" />
                                <TextBlock Text="Sale Complete"
                                           FontSize="22"
                                           FontWeight="Black"
                                           HorizontalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock FontSize="13"
                                           HorizontalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                    <Run Text="Receipt # " />
                                    <Run Text="{x:Bind ViewModel.LastReceiptNumberLabel, Mode=OneWay}"
                                         FontWeight="SemiBold" />
                                </TextBlock>
                            </StackPanel>

                            <Border Grid.Row="1"
                                    Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                    CornerRadius="4"
                                    Padding="0,14">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="CHANGE DUE"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Margin="0,0,0,4" />
                                    <TextBlock FontSize="40"
                                               FontWeight="Black"
                                               HorizontalAlignment="Center"
                                               Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                               Text="{x:Bind ViewModel.LastReceiptChangeText, Mode=OneWay}" />
                                </StackPanel>
                            </Border>

                            <ScrollViewer Grid.Row="2"
                                          VerticalScrollBarVisibility="Auto"
                                          MaxHeight="220">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.ReceiptItems, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:ReceiptLineItem">
                                            <Grid Margin="0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="110" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                           Text="{x:Bind Name}"
                                                           FontSize="13"
                                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{x:Bind QuantityText}"
                                                           Margin="8,0"
                                                           FontSize="13"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Grid.Column="2"
                                                           HorizontalAlignment="Right"
                                                           FontSize="13"
                                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                           Text="{x:Bind LineTotalText}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <StackPanel Grid.Row="3">
                                <Border Height="1"
                                        Background="{ThemeResource CardStrokeColorDefaultBrush}"
                                        Margin="0,0,0,10" />
                                <Grid Margin="0,10,0,0">
                                    <TextBlock Text="Total Charged"
                                               FontWeight="SemiBold"
                                               FontSize="14"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <TextBlock HorizontalAlignment="Right"
                                               FontWeight="Bold"
                                               FontSize="14"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                               Text="{x:Bind ViewModel.LastReceiptTotalText, Mode=OneWay}" />
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="4">
                            <TextBlock Text="Use the Windows print dialog to choose a printer."
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,10"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Margin="0,0,0,10">
                            <Button Click="PrintReceiptButton_Click"
                                    Content="Print Receipt"
                                    Padding="14,8"
                                    CornerRadius="4"
                                    Margin="0,0,8,0" />
                                <Button Command="{x:Bind ViewModel.OpenReceiptsFolderCommand}"
                                        Content="Receipts Folder"
                                        Padding="14,8"
                                        CornerRadius="4" />
                            </StackPanel>

                            <Button Command="{x:Bind ViewModel.DismissReceiptCommand}"
                                    Content="New Sale"
                                    MinWidth="150"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    Padding="12,10"
                                    CornerRadius="4" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
    
    <!-- Hidden container removed -->
    </Grid>
</Page>

