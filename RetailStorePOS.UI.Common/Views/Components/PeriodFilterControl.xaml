<UserControl
    x:Class="RetailStorePOS.UI.Common.Views.Components.PeriodFilterControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="PeriodPresetButton" TargetType="ToggleButton">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="MinWidth" Value="64"/>
            <Setter Property="Foreground" Value="#1A1D23"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Resources>

    <Border Background="White"
            BorderBrush="#E8EAF0"
            BorderThickness="1"
            CornerRadius="10"
            Padding="10,8">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <ToggleButton x:Name="TodayButton"
                          Style="{StaticResource PeriodPresetButton}"
                          Content="Today"
                          Click="PresetButton_Click"
                          Tag="Today"/>
            <ToggleButton x:Name="Last7Button"
                          Style="{StaticResource PeriodPresetButton}"
                          Content="7 days"
                          Click="PresetButton_Click"
                          Tag="Last7Days"
                          IsChecked="True"/>
            <ToggleButton x:Name="Last30Button"
                          Style="{StaticResource PeriodPresetButton}"
                          Content="30 days"
                          Click="PresetButton_Click"
                          Tag="Last30Days"/>
            <ToggleButton x:Name="Last90Button"
                          Style="{StaticResource PeriodPresetButton}"
                          Content="90 days"
                          Click="PresetButton_Click"
                          Tag="Last90Days"/>
            <ToggleButton x:Name="CustomButton"
                          Style="{StaticResource PeriodPresetButton}"
                          Content="Custom"
                          Click="PresetButton_Click"
                          Tag="Custom"/>

            <StackPanel x:Name="CustomRangePanel"
                        Orientation="Horizontal"
                        Spacing="6"
                        VerticalAlignment="Center"
                        Visibility="Collapsed"
                        Margin="6,0,0,0">
                <CalendarDatePicker x:Name="StartDatePicker"
                                    DateChanged="DatePicker_DateChanged"
                                    PlaceholderText="Start"
                                    MinWidth="140"/>
                <TextBlock Text="–" VerticalAlignment="Center" Foreground="#8F96A3"/>
                <CalendarDatePicker x:Name="EndDatePicker"
                                    DateChanged="DatePicker_DateChanged"
                                    PlaceholderText="End"
                                    MinWidth="140"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
