<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="RetailStorePOS.UI.Sales.Views.CheckoutPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:data="using:RetailStorePOS.Data.Models"
    xmlns:models="using:RetailStorePOS.UI.Sales.Models"
    xmlns:commonModels="using:RetailStorePOS.UI.Common.Models"
    xmlns:common="using:RetailStorePOS.UI.Common"
    xmlns:input="using:Microsoft.UI.Xaml.Input"
    xmlns:animation="using:Microsoft.UI.Xaml.Media.Animation"
    xmlns:local="using:RetailStorePOS.UI.Sales.Views"
    mc:Ignorable="d"
    Background="#F9FAFB">


    <Page.Resources>
        <ThemeShadow x:Key="CardShadow" />
    </Page.Resources>

    <Grid Padding="8">
        <!-- Low-stock heads-up: a slim, quiet status strip. The cashier needs to know,    -->
        <!-- not be alarmed. A small amber dot is the only signal of severity; the rest    -->
        <!-- reads in normal ink on warm paper. Flat, no shadow, no big icon.              -->
        <Border x:Name="InventoryAlertInfoBar"
                Background="#FAFAF7"
                BorderBrush="#E8EAF0"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,8"
                MinWidth="320"
                MaxWidth="560"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,12,0,0"
                Visibility="{x:Bind ViewModel.InventoryAlertVisibility, Mode=OneWay}"
                Canvas.ZIndex="100">
            <Border.Transitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="-12" IsStaggeringEnabled="False" />
                </TransitionCollection>
            </Border.Transitions>
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- Severity dot. Amber #D97706 = low stock; the only color signal. -->
                <Ellipse Grid.Column="0"
                         Width="8"
                         Height="8"
                         Fill="#D97706"
                         VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{x:Bind ViewModel.InventoryAlertMessage, Mode=OneWay}"
                           FontSize="13"
                           Foreground="#1A1D23"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
                <Button Grid.Column="2"
                        Click="InventoryAlertCloseButton_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="6"
                        MinWidth="24"
                        MinHeight="24"
                        CornerRadius="4"
                        VerticalAlignment="Center"
                        ToolTipService.ToolTip="Dismiss">
                    <FontIcon Glyph="&#xE711;"
                              FontFamily="Segoe Fluent Icons"
                              FontSize="10"
                              Foreground="#8F96A3" />
                </Button>
            </Grid>
        </Border>

        <ContentDialog x:Name="DiscountDialog"
                       
                       CornerRadius="12"
                        Title="{x:Bind GetLoc('Checkout_Discount_Dialog_Title'), Mode=OneWay}"
                        PrimaryButtonText="{x:Bind GetLoc('Checkout_Discount_Apply_Button'), Mode=OneWay}"
                        CloseButtonText="{x:Bind GetLoc('Checkout_Discount_Discard_Button'), Mode=OneWay}"
                        PrimaryButtonClick="DiscountDialog_PrimaryButtonClick">
            <StackPanel Spacing="18" MinWidth="380">
                <TextBlock Text="{x:Bind GetLoc('Checkout_Discount_Text.Text'), Mode=OneWay}" TextWrapping="Wrap" Foreground="#5F6775" FontSize="13"/>

                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="8" VerticalAlignment="Bottom">
                        <TextBlock Text="{x:Bind GetLoc('Checkout_Discount_TypeLabel.Text'), Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="#5F6775" CharacterSpacing="40"/>
                        <ToggleSwitch OnContent="{x:Bind GetLoc('Checkout_Discount_Percentage_Label'), Mode=OneWay}"
                                      OffContent="{x:Bind GetLoc('Checkout_Discount_Amount_Label'), Mode=OneWay}"
                                      IsOn="{x:Bind ViewModel.IsDiscountPercentage, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Bottom">
                        <NumberBox x:Name="DiscountAmountBox"
                                   Header="{x:Bind GetLoc('Checkout_Discount_ValueHeader.Header'), Mode=OneWay}"
                                   Value="{x:Bind ViewModel.DiscountAmount, Mode=TwoWay}"
                                   SpinButtonPlacementMode="Hidden"
                                   Minimum="0"
                                   CornerRadius="6"
                                   MinHeight="36"
                                   FontSize="15"
                                   common:NumericInputNormalization.NormalizeOnLostFocus="True" />
                    </StackPanel>
                </Grid>

                <StackPanel Spacing="8">
                    <TextBlock Text="{x:Bind GetLoc('Checkout_Discount_PresetsTitle.Text'), Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="#5F6775" CharacterSpacing="40"/>
                    <Grid ColumnSpacing="8" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Button Content="5%"  Tag="pct:5"  Click="DiscountPresetButton_Click" HorizontalAlignment="Stretch" CornerRadius="6" MinHeight="36" FontWeight="SemiBold"/>
                        <Button Grid.Column="1" Content="10%" Tag="pct:10" Click="DiscountPresetButton_Click" HorizontalAlignment="Stretch" CornerRadius="6" MinHeight="36" FontWeight="SemiBold"/>
                        <Button Grid.Row="1" Content="$1"  Tag="amt:1"  Click="DiscountPresetButton_Click" HorizontalAlignment="Stretch" CornerRadius="6" MinHeight="36" FontWeight="SemiBold"/>
                        <Button Grid.Row="1" Grid.Column="1" Content="$5" Tag="amt:5"  Click="DiscountPresetButton_Click" HorizontalAlignment="Stretch" CornerRadius="6" MinHeight="36" FontWeight="SemiBold"/>
                    </Grid>
                </StackPanel>

                <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,9">
                    <TextBlock FontSize="13" Foreground="#475569">
                        <Run Text="{x:Bind GetLoc('Checkout_Discount_SummaryLabel.Text'), Mode=OneWay}" />
                        <Run Text="{x:Bind ViewModel.DiscountAmountText, Mode=OneWay}" FontWeight="Bold" Foreground="#0F172A" />
                    </TextBlock>
                </Border>
            </StackPanel>
        </ContentDialog>

        <Grid ColumnSpacing="0"
              RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="7*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Row="0"
                  Grid.Column="0"
                  RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Grid.Column="0"
                        Background="{ThemeResource AcrylicBackgroundFillColorBaseBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,0,1,0"
                        CornerRadius="0"
                        Padding="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Padding="10,8" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"/>

                      

                            <Button x:Name="CartDiscountButton" Content="{x:Bind GetLoc('Checkout_Cart_DiscountButton.Content'), Mode=OneWay}"

                                    Grid.Column="2"
                                    Command="{x:Bind ViewModel.AddDiscountCommand}"
                                    Padding="14,7"
                                    CornerRadius="6"
                                    MinHeight="34"
                                    FontSize="13"
                                    VerticalAlignment="Center" />


                            <Button x:Name="ClearCartButton" Content="{x:Bind GetLoc('Checkout_Cart_ClearButton.Content'), Mode=OneWay}"

                                    Grid.Column="3"
                                    Command="{x:Bind ViewModel.ClearCartCommand}"
                                    IsEnabled="{x:Bind ViewModel.CanClearCart, Mode=OneWay}"
                                    Padding="14,7"
                                    CornerRadius="6"
                                    MinHeight="34"
                                    FontSize="13"
                                    VerticalAlignment="Center" />

                        </Grid>

                        <Grid Grid.Row="1" Margin="0,6,0,6">
                                <ListView x:Name="CartItemsListView"
                                      Visibility="{x:Bind ViewModel.CartListVisibility, Mode=OneWay}"
                                      SelectionMode="None"
                                      Padding="0"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollMode="Enabled">
                                <ListView.Header>
                                    <Border Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                            CornerRadius="4"
                                            Padding="10,0"
                                            HorizontalAlignment="Stretch">
                                    </Border>
                                </ListView.Header>
                                <ListView.ItemContainerTransitions>
                                    <animation:TransitionCollection />
                                </ListView.ItemContainerTransitions>
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                        <Setter Property="Padding" Value="0,1" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:CheckoutCartItem">
                                        <Border BorderBrush="#E5E7EB" 
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                
                                                Background="White"
                                                Shadow="{ThemeResource CardShadow}"
                                                Translation="0,0,4">
                                            <Grid>
                                                <Border Width="3" 
                                                        HorizontalAlignment="Left" 
                                                        Background="#3B82F6" 
                                                        CornerRadius="12,0,0,12" />
                                                <Grid HorizontalAlignment="Stretch"
                                                      Padding="16,12"
                                                      MinHeight="72">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>

                                                <!-- Top Row: Name and Trash Icon -->
                                                <TextBlock Grid.Row="0" Grid.Column="0"
                                                           Text="{x:Bind Name}"
                                                           FontWeight="SemiBold"
                                                           FontSize="14"
                                                           Foreground="#111827"
                                                           TextWrapping="WrapWholeWords"
                                                           MaxLines="1"
                                                           HorizontalAlignment="Left"
                                                           VerticalAlignment="Center" />

                                                <Button Grid.Row="0" Grid.Column="1"
                                                        Click="CartItemRemoveButton_Click"
                                                        Tag="{x:Bind}"
                                                        Background="Transparent"
                                                        Foreground="#9CA3AF"
                                                        BorderThickness="0"
                                                        Width="30"
                                                        Height="30"
                                                        CornerRadius="15"
                                                        Padding="0"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center">
                                                    <Button.Resources>
                                                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FEE2E2" />
                                                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FECACA" />
                                                        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#DC2626" />
                                                        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#991B1B" />
                                                    </Button.Resources>
                                                    <FontIcon Glyph="&#xE711;" FontSize="13" />
                                                </Button>

                                                <!-- Bottom Row: Qty/Unit and Total Price -->
                                                <StackPanel Grid.Row="1" Grid.Column="0"
                                                            Orientation="Horizontal" Spacing="6" 
                                                            VerticalAlignment="Bottom"
                                                            Margin="0,8,0,0">
                                                    <Border Background="#EFF6FF"
                                                            BorderBrush="#DBEAFE"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Padding="8,3">
                                                        <TextBlock Text="{x:Bind QuantityText, Mode=OneWay}"
                                                                   FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#1D4ED8" />
                                                    </Border>
                                                    <TextBlock Text="{x:Bind QuantityPriceUnitText, Mode=OneWay}"
                                                               FontSize="13"
                                                               Foreground="#6B7280"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>

                                                <TextBlock Grid.Row="1" Grid.Column="1"
                                                           Text="{x:Bind LineTotalAmountText, Mode=OneWay}"
                                                           FontWeight="Bold"
                                                           FontSize="18"
                                                           Foreground="#111827"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Bottom" />
                                            </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <Border Visibility="{x:Bind ViewModel.EmptyCartVisibility, Mode=OneWay}"
                                    Background="Transparent"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Padding="20">
                                <StackPanel HorizontalAlignment="Center" Spacing="12" MaxWidth="320">
                                    <Border Width="56"
                                            Height="56"
                                            Background="#F1F5F9"
                                            CornerRadius="28"
                                            HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE7BF;" Foreground="#94A3B8" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{x:Bind GetLoc('Checkout_Cart_EmptyTitle.Text'), Mode=OneWay}"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="#1A1D23"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="{x:Bind GetLoc('Checkout_Cart_EmptySubtitle.Text'), Mode=OneWay}"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               FontSize="12"
                                               Foreground="#8F96A3"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Integrated Footer Area -->
                        <Grid Grid.Row="2" Margin="0">
                            <Border Background="#1E293B" CornerRadius="0" Padding="20,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind GetLoc('Checkout_Footer_GrandTotal.Text'), Mode=OneWay}" FontSize="14" FontWeight="SemiBold" Foreground="#718096"/>


                                        <TextBlock Text="{x:Bind ViewModel.CartItemsCountText, Mode=OneWay}" FontSize="12" Foreground="#64748B" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <TextBlock Text="{x:Bind ViewModel.TotalAmountText, Mode=OneWay}" FontWeight="Bold" FontSize="36" Foreground="White" HorizontalAlignment="Right" />
                                        <TextBlock FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Right" Margin="0,-2,0,0">
                                            <Run Text="{x:Bind GetLoc('Checkout_Footer_SubtotalLabel.Text'), Mode=OneWay}" />
                                            <Run Text=": " />
                                            <Run Text="{x:Bind ViewModel.SubtotalAmountText, Mode=OneWay}" />
                                            <Run Text=" + " />
                                            <Run Text="{x:Bind GetLoc('Checkout_Footer_TaxLabel.Text'), Mode=OneWay}" />
                                            <Run Text=": " />
                                            <Run Text="{x:Bind ViewModel.TaxAmountText, Mode=OneWay}" />
                                        </TextBlock>

                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="0"
                    Grid.Column="1"
                    Background="Transparent"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0"
                    CornerRadius="0"
                    Padding="10,0,0,0">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

 

                    <Border Grid.Row="1"
                            Background="White"
                            BorderBrush="#E8EAF0"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,0">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <FontIcon Glyph="&#xE721;"
                                      FontSize="16"
                                      Foreground="#8F96A3"
                                      VerticalAlignment="Center" />

                            <TextBox Grid.Column="1"
                                     x:Name="SearchTextBox"
                                     PlaceholderText="{x:Bind GetLoc('Checkout_Search_Placeholder.PlaceholderText'), Mode=OneWay}"
                                     Text="{x:Bind ViewModel.SearchTerm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0,12,0,12"
                                     FontSize="15"
                                     TextChanged="SearchTextBox_TextChanged"
                                     PreviewKeyDown="SearchTextBox_PreviewKeyDown">
                                <TextBox.Resources>
                                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlElevationBorderBrush" Color="Transparent" />
                                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                </TextBox.Resources>
                            </TextBox>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2"
                            Background="#FAFBFC"
                            BorderBrush="#E8EAF0"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,6"
                            HorizontalAlignment="Stretch">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind ViewModel.SearchResultsCountText, Mode=OneWay}"
                                       FontSize="12"
                                       Foreground="#8F96A3"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <ListView Grid.Row="3"
                              x:Name="SearchResultsListView"
                              IsItemClickEnabled="True"
                              Loaded="SearchResultsListView_Loaded"
                              SizeChanged="SearchResultsListView_SizeChanged"
                              PreviewKeyDown="SearchResultsListView_PreviewKeyDown"
                              ItemClick="SearchResultsListView_ItemClick"
                              SelectionMode="None"
                              HorizontalAlignment="Stretch"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.HorizontalScrollMode="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollMode="Enabled">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal"
                                               ItemHeight="92" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,4,6" />
                                <Setter Property="UseSystemFocusVisuals" Value="False" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:SearchResultItem">
                                <Border Background="{x:Bind CardBackgroundBrush, Mode=OneWay}"
                                        BorderBrush="{x:Bind CardBorderBrush, Mode=OneWay}"
                                        BorderThickness="{x:Bind CardBorderThickness, Mode=OneWay}"
                                        CornerRadius="4"
                                        Padding="0"
                                        PointerEntered="SearchResultCard_PointerEntered"
                                        PointerExited="SearchResultCard_PointerExited">
                                    <Grid>
                                        <!-- Image-backed layout -->
                                        <Grid Visibility="{x:Bind HasThumbnail, Mode=OneWay}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Border Grid.Row="0" Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="4,4,0,0">
                                                <Image Source="{x:Bind ThumbnailImageSource, Mode=OneWay}" Stretch="UniformToFill" />
                                            </Border>

                                            <Grid Grid.Row="1" Padding="8,0,8,6" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="0,0,4,4">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="12" MaxLines="2" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            </Grid>
                                        </Grid>

                                        <!-- No-image layout -->
                                        <Grid Visibility="{x:Bind HasNoThumbnail, Mode=OneWay}" Padding="10,8">
                                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" />
                                                <TextBlock Text="{x:Bind FormattedPrice}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Grid.ColumnSpan="2"
                    Background="White"
                    BorderBrush="#E8EAF0"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="10"
                    MinHeight="64">
                <Grid ColumnSpacing="6"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      MinHeight="50">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.8*" MinWidth="140" />
                        <ColumnDefinition Width="1.2*" MinWidth="120" />
                        <ColumnDefinition Width="1*" MinWidth="90" />
                        <ColumnDefinition Width="1*" MinWidth="90" />
                        <ColumnDefinition Width="1*" MinWidth="90" />
                        <ColumnDefinition Width="1.6*" MinWidth="140" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             x:Name="TenderedCashBox"
                             Text="{x:Bind ViewModel.TenderedInputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             common:NumericInputNormalization.NormalizeOnLostFocus="True"
                             CornerRadius="8"
                             Background="#F1F5F9"
                             BorderBrush="#CBD5E1"
                             BorderThickness="1"
                             PlaceholderText="{x:Bind GetLoc('Checkout_Pay_TenderPlaceholder.PlaceholderText'), Mode=OneWay}"
                             ToolTipService.ToolTip="Shortcut: Ctrl+D"
                             Padding="0"
                             VerticalAlignment="Stretch"
                             VerticalContentAlignment="Center"
                             HorizontalContentAlignment="Center"
                             TextAlignment="Center"
                             FontSize="28"
                             FontWeight="Bold"
                             Foreground="#0F172A"
                             GotFocus="TenderedCashBox_GotFocus"
                             TextChanged="TenderedCashBox_TextChanged"
                             KeyDown="TenderedCashBox_KeyDown">
                        <TextBox.KeyboardAccelerators>
                            <input:KeyboardAccelerator Key="D"
                                                       Modifiers="Control"
                                                       Invoked="TenderedCashBox_CtrlD_Invoked" />
                        </TextBox.KeyboardAccelerators>
                    </TextBox>

                    <Button Grid.Column="1"
                            Command="{x:Bind ViewModel.TenderExactCommand}"
                            Background="#DBEAFE"
                            Foreground="#1E3A8A"
                            Padding="12,6"
                            CornerRadius="6"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#BFDBFE" />
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#93C5FD" />
                            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#1E3A8A" />
                        </Button.Resources>
                        <Grid ColumnSpacing="6" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" MinWidth="0" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8FB;" FontSize="16" FontWeight="Bold" Foreground="#1E3A8A" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind GetLoc('Checkout_Pay_ExactButtonText.Text'), Mode=OneWay}"
                                       FontWeight="Bold"
                                       FontSize="16"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="WrapWholeWords"
                                       Foreground="#1E3A8A" />
                        </Grid>
                    </Button>

                    <Button Grid.Column="2"
                            Command="{x:Bind ViewModel.TenderPlus1Command}"
                            Background="#E0E7FF"
                            Foreground="#3730A3"
                            Padding="10,0"
                            CornerRadius="6"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#C7D2FE" />
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#A5B4FC" />
                            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#3730A3" />
                        </Button.Resources>
                        <TextBlock Text="{x:Bind ViewModel.QuickCash1Text, Mode=OneWay}"
                                   FontWeight="Bold"
                                   FontSize="16"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="WrapWholeWords"
                                   Foreground="#3730A3" />
                    </Button>

                    <Button Grid.Column="3"
                            Command="{x:Bind ViewModel.TenderPlus2Command}"
                            Background="#F5F3FF"
                            Foreground="#5B21B6"
                            Padding="10,0"
                            CornerRadius="6"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#EDE9FE" />
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#DDD6FE" />
                            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#5B21B6" />
                        </Button.Resources>
                        <TextBlock Text="{x:Bind ViewModel.QuickCash2Text, Mode=OneWay}"
                                   FontWeight="Bold"
                                   FontSize="16"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="WrapWholeWords"
                                   Foreground="#5B21B6" />
                    </Button>

                    <Button Grid.Column="4"
                            Command="{x:Bind ViewModel.TenderPlus3Command}"
                            Background="#ECFDF5"
                            Foreground="#065F46"
                            Padding="10,0"
                            CornerRadius="6"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#D1FAE5" />
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#A7F3D0" />
                            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#065F46" />
                        </Button.Resources>
                        <TextBlock Text="{x:Bind ViewModel.QuickCash3Text, Mode=OneWay}"
                                   FontWeight="Bold"
                                   FontSize="16"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="WrapWholeWords"
                                   Foreground="#065F46" />
                    </Button>

                    <Border Grid.Column="5"
                            Visibility="{x:Bind ViewModel.StatusVisibility, Mode=OneWay}"
                            Background="{x:Bind ViewModel.StatusBackgroundBrush, Mode=OneWay}"
                            BorderBrush="{x:Bind ViewModel.StatusBorderBrush, Mode=OneWay}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,8"
                            Margin="2,0,0,0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                        <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                                   Foreground="{x:Bind ViewModel.StatusTextBrush, Mode=OneWay}"
                                   FontSize="12"
                                   TextWrapping="WrapWholeWords"
                                   VerticalAlignment="Center"
                                   MaxLines="2" />
                    </Border>

                    <Border Grid.Column="6"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Stretch"
                            Background="#ECFDF5"
                            BorderBrush="#A7F3D0"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,8">
                        <Grid ColumnSpacing="10" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind GetLoc('Checkout_Pay_ChangeLabel.Text'), Mode=OneWay}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#065F46"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ViewModel.ChangeDueText, Mode=OneWay}"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#065F46"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Button x:Name="CompleteSaleButton" Content="{x:Bind GetLoc('Checkout_Pay_CompleteButton.Content'), Mode=OneWay}"

                            Grid.Column="7"
                            Command="{x:Bind ViewModel.CompleteSaleCommand}"
                            Style="{ThemeResource AccentButtonStyle}"
                            Padding="20,10"
                            CornerRadius="8"
                            FontSize="16"
                            FontWeight="Bold"
                            VerticalAlignment="Stretch" 
                            MinWidth="240"/>

                </Grid>
            </Border>
        </Grid>
    <Grid Visibility="{x:Bind ViewModel.ReceiptVisibility, Mode=OneWay}">
        <Rectangle Fill="#B0182438" />

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Margin="12">
            <Grid>
                <Border HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="510"
                        MaxHeight="860"
                        Background="White"
                        BorderBrush="#E8EAF0"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="32,28">
                    <Grid RowSpacing="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0"
                              Grid.RowSpan="4"
                              RowSpacing="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0"
                                        HorizontalAlignment="Center"
                                        Spacing="6"
                                        Margin="0,0,0,6">
                                <Border Width="56"
                                        Height="56"
                                        CornerRadius="28"
                                        Background="#DCFCE7"
                                        HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE73E;"
                                              Width="28"
                                              Height="28"
                                              FontSize="22"
                                              Foreground="#15803D"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{x:Bind ViewModel.StoreName, Mode=OneWay}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Foreground="#1A1D23"
                                           Margin="0,8,0,0"/>
                                <TextBlock Text="{x:Bind ViewModel.StoreAddress, Mode=OneWay}"
                                           FontSize="11"
                                           HorizontalAlignment="Center"
                                           Foreground="#8F96A3"
                                           TextWrapping="WrapWholeWords"
                                           TextAlignment="Center"
                                           Visibility="{x:Bind ViewModel.StoreAddressVisibility, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind GetLoc('Checkout_Receipt_CompleteTitle.Text'), Mode=OneWay}"
                                            FontSize="22"
                                            FontWeight="Bold"
                                            HorizontalAlignment="Center"
                                            Foreground="#1A1D23"
                                            Margin="0,4,0,0"/>
                                <TextBlock FontSize="12"
                                           HorizontalAlignment="Center"
                                           Foreground="#8F96A3">
                                    <Run Text="{x:Bind GetLoc('Checkout_Receipt_NumberLabel.Text'), Mode=OneWay}" />
                                    <Run Text="{x:Bind ViewModel.LastReceiptNumberLabel, Mode=OneWay}"
                                         FontWeight="SemiBold" />
                                </TextBlock>
                            </StackPanel>

                            <Border Grid.Row="1"
                                    Background="#ECFDF5"
                                    BorderBrush="#A7F3D0"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="0,16">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{x:Bind GetLoc('Checkout_Receipt_ChangeDueLabel.Text'), Mode=OneWay}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               Foreground="#065F46"
                                               Margin="0,0,0,4" />
                                    <TextBlock FontSize="40"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Foreground="#065F46"
                                               Text="{x:Bind ViewModel.LastReceiptChangeText, Mode=OneWay}" />
                                </StackPanel>
                            </Border>

                            <ScrollViewer Grid.Row="2"
                                          VerticalScrollBarVisibility="Auto"
                                          MaxHeight="220">
                                <ItemsControl x:Name="ReceiptItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="commonModels:ReceiptLineItem">
                                            <Grid Margin="0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="110" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                           Text="{x:Bind Name}"
                                                           FontSize="13"
                                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{x:Bind QuantityText}"
                                                           Margin="8,0"
                                                           FontSize="13"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Grid.Column="2"
                                                           HorizontalAlignment="Right"
                                                           FontSize="13"
                                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                           Text="{x:Bind LineTotalText}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <StackPanel Grid.Row="3">
                                <Border Height="1"
                                        Background="{ThemeResource CardStrokeColorDefaultBrush}"
                                        Margin="0,0,0,10" />
                                <Grid Margin="0,10,0,0">
                                    <TextBlock Text="{x:Bind GetLoc('Checkout_Receipt_TotalCharged.Text'), Mode=OneWay}"
                                               FontWeight="SemiBold"
                                               FontSize="14"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <TextBlock HorizontalAlignment="Right"
                                               FontWeight="Bold"
                                               FontSize="14"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                               Text="{x:Bind ViewModel.LastReceiptTotalText, Mode=OneWay}" />
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="4">
                            <TextBlock Text="{x:Bind GetLoc('Checkout_Receipt_PrinterTip.Text'), Mode=OneWay}"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,10"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Margin="0,0,0,10">
                            <Button Click="PrintReceiptButton_Click"
                                    Content="{x:Bind GetLoc('Checkout_Receipt_PrintButton.Content'), Mode=OneWay}"
                                    Padding="14,8"
                                    CornerRadius="6"
                                    MinHeight="36"
                                    Margin="0,0,8,0" />
                                <Button Command="{x:Bind ViewModel.OpenReceiptsFolderCommand}"
                                        Content="{x:Bind GetLoc('Checkout_Receipt_FolderButton.Content'), Mode=OneWay}"
                                        Padding="14,8"
                                        CornerRadius="6"
                                        MinHeight="36" />
                            </StackPanel>

                            <Button Command="{x:Bind ViewModel.DismissReceiptCommand}"
                                    Content="{x:Bind GetLoc('Checkout_Receipt_NewSaleButton.Content'), Mode=OneWay}"
                                    MinWidth="180"
                                    MinHeight="40"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    Padding="16,10"
                                    CornerRadius="8"
                                    FontSize="14"
                                    FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
    
    <!-- Hidden container removed -->

    <!-- Register Not Open Overlay — blocks ONLY the checkout content, not the app navigation -->
    <Border x:Name="RegisterOverlay" Visibility="Collapsed" Canvas.ZIndex="200"
            Background="#F9FAFB">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" MaxWidth="400">
            <FontIcon Glyph="&#xE825;" FontSize="48" Foreground="#8F96A3" HorizontalAlignment="Center"/>
            <TextBlock Text="{x:Bind GetLoc('Checkout_Register_ClosedTitle.Text'), Mode=OneWay}" FontSize="22" FontWeight="Bold" Foreground="#1A1D23"
                       HorizontalAlignment="Center"/>


            <TextBlock Text="{x:Bind GetLoc('Checkout_Register_ClosedText.Text'), Mode=OneWay}"
                       TextWrapping="Wrap" Foreground="#8F96A3" FontSize="14" TextAlignment="Center"
                       HorizontalAlignment="Center"/>



            <Button x:Name="OpenRegisterOverlayButton" Content="{x:Bind GetLoc('Checkout_Register_OpenButton.Content'), Mode=OneWay}"

                    Click="OpenRegisterOverlayButton_Click"
                    Style="{StaticResource AccentButtonStyle}"
                    HorizontalAlignment="Center" Padding="24,12" FontSize="16" CornerRadius="6"/>


        </StackPanel>
    </Border>

    </Grid>
</Page>
