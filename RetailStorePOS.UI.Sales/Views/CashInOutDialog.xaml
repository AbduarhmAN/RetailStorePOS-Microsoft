<ContentDialog
    x:Class="RetailStorePOS.UI.Sales.Views.CashInOutDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    DefaultButton="Primary"
    RequestedTheme="Light"
    CornerRadius="10"
    FlowDirection="{x:Bind Loc.FlowDirection, Mode=OneWay}"
    PrimaryButtonText="{x:Bind CashInOutDialog_PrimaryButtonText, Mode=OneWay}"
    SecondaryButtonText="{x:Bind CashInOutDialog_SecondaryButtonText, Mode=OneWay}"
    PrimaryButtonClick="CashInOutDialog_PrimaryButtonClick">

    <ContentDialog.Title>
        <TextBlock Text="{x:Bind CashInOutDialog_Title, Mode=OneWay}" />
    </ContentDialog.Title>

    <ContentDialog.Resources>
        <Style x:Key="CashModeButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Height" Value="48" />
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <Style x:Key="CashInSelectedButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="Height" Value="48" />
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <Style x:Key="CashOutSelectedButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Height" Value="48" />
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="#C42B1C" />
            <Setter Property="BorderBrush" Value="#C42B1C" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="RootGrid"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              CornerRadius="{TemplateBinding CornerRadius}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualStateGroup.Transitions>
                                        <VisualTransition GeneratedDuration="0:0:0.08" />
                                    </VisualStateGroup.Transitions>
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid"
                                                                           Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0">
                                                    <DiscreteObjectKeyFrame.Value>
                                                        <SolidColorBrush Color="#A61F11" />
                                                    </DiscreteObjectKeyFrame.Value>
                                                </DiscreteObjectKeyFrame>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid"
                                                                           Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0">
                                                    <DiscreteObjectKeyFrame.Value>
                                                        <SolidColorBrush Color="#A61F11" />
                                                    </DiscreteObjectKeyFrame.Value>
                                                </DiscreteObjectKeyFrame>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid"
                                                                           Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0">
                                                    <DiscreteObjectKeyFrame.Value>
                                                        <SolidColorBrush Color="#8F1B10" />
                                                    </DiscreteObjectKeyFrame.Value>
                                                </DiscreteObjectKeyFrame>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid"
                                                                           Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0">
                                                    <DiscreteObjectKeyFrame.Value>
                                                        <SolidColorBrush Color="#8F1B10" />
                                                    </DiscreteObjectKeyFrame.Value>
                                                </DiscreteObjectKeyFrame>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ContentPresenter"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.4"
                                                             Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter x:Name="ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Padding="{TemplateBinding Padding}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ContentDialog.Resources>

    <ContentDialog.PrimaryButtonStyle>
        <Style TargetType="Button"
               BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="Width" Value="150" />
            <Setter Property="Height" Value="60" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
    </ContentDialog.PrimaryButtonStyle>

    <ContentDialog.SecondaryButtonStyle>
        <Style TargetType="Button"
               BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Width" Value="150" />
            <Setter Property="Height" Value="60" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
    </ContentDialog.SecondaryButtonStyle>

    <StackPanel Width="520"
                Spacing="16"
                Margin="0,8,0,0">
        <TextBlock Text="{x:Bind CashInOutDialog_Description, Mode=OneWay}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   TextWrapping="WrapWholeWords" />

        <InfoBar x:Name="ErrorBar"
                 Title="{x:Bind CashInOutDialog_ErrorBar, Mode=OneWay}"
                 Severity="Error"
                 IsOpen="False" />

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="200" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="8">
                <TextBlock Text="{x:Bind CashInOutDialog_AdjustmentTypeHeader, Mode=OneWay}"
                           FontWeight="SemiBold" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="CashInButton"
                            Click="CashInButton_Click"
                            Content="{x:Bind CashInOutDialog_CashInButton, Mode=OneWay}"
                            Style="{StaticResource CashInSelectedButtonStyle}" />

                    <Button x:Name="CashOutButton"
                            Grid.Column="1"
                            Click="CashOutButton_Click"
                            Content="{x:Bind CashInOutDialog_CashOutButton, Mode=OneWay}"
                            Style="{StaticResource CashModeButtonStyle}" />
                </Grid>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Spacing="8">
                <TextBlock Text="{x:Bind CashInOutDialog_AmountHeader, Mode=OneWay}"
                           FontWeight="SemiBold" />
                <TextBox x:Name="AmountBox"
                         PlaceholderText="{x:Bind CashInOutDialog_AmountBox, Mode=OneWay}"
                         InputScope="Number"
                         TextChanged="Input_TextChanged" />
            </StackPanel>
        </Grid>

        <StackPanel Spacing="8">
            <TextBlock Text="{x:Bind CashInOutDialog_ReasonHeader, Mode=OneWay}"
                       FontWeight="SemiBold" />
            <TextBox x:Name="ReasonBox"
                     AcceptsReturn="True"
                     Height="100"
                     TextWrapping="Wrap"
                     PlaceholderText="{x:Bind CashInOutDialog_ReasonBox, Mode=OneWay}"
                     TextChanged="Input_TextChanged" />
        </StackPanel>
    </StackPanel>
</ContentDialog>
