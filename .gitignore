## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ins.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Mono auto generated files
mono_crash.*

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/

# Visual Studio 2015/2017/2019/2022 cache/options directory
.vs/

# VSTU Extensions
.vsix

# Appx Packages (WinUI / UWP)
*.appx
*.appxbundle
*.msix
*.msixbundle
AppPackages/
BundleArtifacts/

# SQLite Databases (If you test locally, don't push the DB!)
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Windows image file caches
Thumbs.db
ehthumbs.db
ehthumbs_vista.db

# Folder config file
Desktop.ini

# Package dependency files
/packages/
*.nupkg

# --- Custom User Routing ---
# Ignore scripts
[Ss]cript/
[Ss]cripts/

# Explicitly FORCE KEEP deployment folder & all files inside it
![Dd]eployment/
![Dd]eployment/*
