<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="RetailStorePOS.WinUiLogin.Views.ProductsPage"
      x:Name="RootPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:models="using:RetailStorePOS.WinUiLogin.Models"
      xmlns:common="using:RetailStorePOS.WinUiLogin.Common"
      mc:Ignorable="d"
      Background="Transparent">
    <Grid Padding="20" ColumnSpacing="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.25*" />
            <ColumnDefinition Width="0.95*" />
        </Grid.ColumnDefinitions>

        <ContentDialog x:Name="TransferStockDialog"
                       Title="Transfer Stock"
                       PrimaryButtonText="Transfer"
                       CloseButtonText="Cancel"
                       PrimaryButtonClick="TransferStockDialog_PrimaryButtonClick">
            <StackPanel Spacing="16">
                <TextBlock Text="Move items from Warehouse to Store." TextWrapping="Wrap" />
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Available in Warehouse" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind SelectedProductWarehouseQuantityText, Mode=OneWay}" FontWeight="SemiBold" FontSize="18" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="Current in Store" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind SelectedProductStoreQuantityText, Mode=OneWay}" FontWeight="SemiBold" FontSize="18" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                </Grid>
                <NumberBox x:Name="TransferQuantityBox" Minimum="1" Maximum="10000" Value="1" SpinButtonPlacementMode="Inline" Header="Quantity to move" Margin="0,8,0,0" common:NumericInputNormalization.NormalizeOnLostFocus="True" />
            </StackPanel>
        </ContentDialog>

        <!-- LEFT COLUMN: Header + List -->
        <Grid Grid.Column="0" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  ColumnSpacing="12"
                  VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Border Width="34"
                                Height="34"
                                CornerRadius="10"
                                Background="{ThemeResource TextOnAccentFillColorPrimaryBrush}">
                            <SymbolIcon Symbol="Shop"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Products"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                    <TextBlock Text="Browse the live product catalog"
                               TextWrapping="WrapWholeWords"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <InfoBar IsOpen="{x:Bind HasCatalogInventoryAlerts, Mode=OneWay}"
                             Visibility="{x:Bind CatalogInventoryAlertVisibility, Mode=OneWay}"
                             Severity="{x:Bind CatalogInventoryAlertSeverity, Mode=OneWay}"
                             Message="{x:Bind CatalogInventoryAlertText, Mode=OneWay}"
                             IsClosable="False" />
                </StackPanel>

                <CommandBar Grid.Column="1"
                            Background="Transparent"
                            DefaultLabelPosition="Right"
                            VerticalAlignment="Top">
                    <AppBarButton Label="Add" Click="AddProductButton_Click" IsEnabled="{x:Bind CanBrowseProducts, Mode=OneWay}">
                        <AppBarButton.Icon><SymbolIcon Symbol="Add" /></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Label="Import Data" Click="ImportDataButton_Click" IsEnabled="{x:Bind CanBrowseProducts, Mode=OneWay}">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE8B5;" /></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Label="Export Data" Click="ExportDataButton_Click" IsEnabled="{x:Bind CanBrowseProducts, Mode=OneWay}">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE8D8;" /></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Label="Refresh" Click="RefreshButton_Click" IsEnabled="{x:Bind CanBrowseProducts, Mode=OneWay}">
                        <AppBarButton.Icon><SymbolIcon Symbol="Refresh" /></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Label="Clear" Click="ClearSearchButton_Click" IsEnabled="{x:Bind CanBrowseProducts, Mode=OneWay}">
                        <AppBarButton.Icon><SymbolIcon Symbol="Clear" /></AppBarButton.Icon>
                    </AppBarButton>
                </CommandBar>
            </Grid>


            <!-- LIST panel -->
            <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="14">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Background="{ThemeResource ControlFillColorDefaultBrush}" Padding="12,0">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE721;" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" x:Name="SearchTextBox" PlaceholderText="Search products" Text="{x:Bind SearchTerm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{x:Bind CanBrowseProducts, Mode=OneWay}" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="0,10,0,10" />
                        </Grid>
                    </Grid>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind ProductsCountText, Mode=OneWay}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind SearchStatusText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                    <Grid Grid.Row="2">
                        <ListView x:Name="ProductsListView" ItemsSource="{x:Bind Products, Mode=OneWay}" SelectionMode="Single" IsItemClickEnabled="True" IsEnabled="{x:Bind CanBrowseProducts, Mode=OneWay}" SelectionChanged="ProductsListView_SelectionChanged" Padding="0" BorderThickness="0">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,8" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:ProductListItem">
                                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0.5"  Padding="12,10" CornerRadius="6">
                                        <Grid ColumnSpacing="12" CornerRadius="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                                <TextBlock Text="{x:Bind BarcodeText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind StockSummaryText}" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{x:Bind PriceText}" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Visibility="{Binding ElementName=RootPage, Path=PriceVisibility}" />
                                                <TextBlock Text="{x:Bind UnitText}" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="18" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind NoProductsVisibility, Mode=OneWay}">
                            <StackPanel HorizontalAlignment="Center" Spacing="10">
                                <Border Width="56" Height="56" Background="{ThemeResource AccentFillColorSecondaryBrush}" HorizontalAlignment="Center">
                                    <SymbolIcon Symbol="Shop" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="No products found" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="Try a different search term or clear the search box." TextWrapping="WrapWholeWords" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                </Grid><!-- /Grid.Row="2" -->
                </Grid><!-- /Grid RowSpacing="12" -->
            </Border><!-- /LIST panel -->
        </Grid><!-- /LEFT COLUMN -->



        <!-- RIGHT COLUMN: Selected Product Details (full height) -->
        <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="18,16,18,18" VerticalAlignment="Stretch">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="{x:Bind RightPanelTitleText, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{x:Bind SelectedProductModeText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="WrapWholeWords" />
                        </StackPanel>
                        <Border Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8,6">
                            <CommandBar Background="Transparent"
                                        DefaultLabelPosition="Right"
                                        VerticalAlignment="Center">
                                <AppBarButton Label="Delete"
                                              Click="DeleteProductButton_Click"
                                              Visibility="{x:Bind DeleteButtonVisibility, Mode=OneWay}">
                                    <AppBarButton.Icon>
                                        <SymbolIcon Symbol="Delete" />
                                    </AppBarButton.Icon>
                                </AppBarButton>
                                <AppBarButton Label="Transfer Stock"
                                              Click="TransferStockButton_Click"
                                              Visibility="{x:Bind SelectedProductViewVisibility, Mode=OneWay}">
                                    <AppBarButton.Icon>
                                        <SymbolIcon Symbol="Switch" />
                                    </AppBarButton.Icon>
                                </AppBarButton>
                                <AppBarButton Label="{x:Bind SelectedProductActionText, Mode=OneWay}"
                                              Click="SelectedProductActionButton_Click"
                                              Background="{ThemeResource LayerFillColorDefaultBrush}"
                                              IsEnabled="{x:Bind CanExecuteSelectedProductAction, Mode=OneWay}">
                                    <AppBarButton.Icon>
                                        <SymbolIcon Symbol="{x:Bind SelectedProductActionSymbol, Mode=OneWay}" />
                                    </AppBarButton.Icon>
                                </AppBarButton>
                                <AppBarButton Label="Cancel"
                                              Click="CancelEditButton_Click"
                                              Visibility="{x:Bind SelectedProductCancelVisibility, Mode=OneWay}">
                                    <AppBarButton.Icon>
                                        <SymbolIcon Symbol="Clear" />
                                    </AppBarButton.Icon>
                                </AppBarButton>
                            </CommandBar>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="1" Spacing="4">
                        <TextBlock Text="{x:Bind StatusMessage, Mode=OneWay}" Visibility="{x:Bind StatusVisibility, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="WrapWholeWords" />
                        <InfoBar IsOpen="{x:Bind SelectedProductHasInventoryAlert, Mode=OneWay}" Visibility="{x:Bind SelectedProductInventoryAlertVisibility, Mode=OneWay}" Severity="{x:Bind SelectedProductInventoryAlertSeverity, Mode=OneWay}" Message="{x:Bind SelectedProductInventoryAlertText, Mode=OneWay}" IsClosable="False" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="2" Margin="0,2,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="12">

                            <Border Background="{ThemeResource ControlFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="14" Visibility="{x:Bind SelectedProductViewVisibility, Mode=OneWay}">
                                <StackPanel Spacing="12">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Barcode" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind SelectedProductBarcodeText, Mode=OneWay}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4" HorizontalAlignment="Center">
                                            <TextBlock Text="SKU" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind SelectedProductSkuText, Mode=OneWay}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Spacing="8" Visibility="{x:Bind PriceVisibility, Mode=OneWay}">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="Cost price" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind SelectedProductCostPriceText, Mode=OneWay}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                            </StackPanel>
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="Sell price" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind SelectedProductPriceText, Mode=OneWay}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                            </StackPanel>
                                    </StackPanel>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Store quantity" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind SelectedProductStoreQuantityText, Mode=OneWay}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4" HorizontalAlignment="Center">
                                            <TextBlock Text="Warehouse quantity" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind SelectedProductWarehouseQuantityText, Mode=OneWay}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Store threshold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind SelectedProductStoreThresholdText, Mode=OneWay}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4" HorizontalAlignment="Center">
                                            <TextBlock Text="Warehouse threshold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind SelectedProductWarehouseThresholdText, Mode=OneWay}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Purchased at" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind SelectedProductPurchasedAtText, Mode=OneWay}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4" HorizontalAlignment="Center">
                                            <TextBlock Text="Last sale at" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind SelectedProductLastSaleAtText, Mode=OneWay}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4" Grid.ColumnSpan="2">
                                            <TextBlock Text="Tax configuration" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind SelectedProductTaxText, Mode=OneWay}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <StackPanel Spacing="14" Visibility="{x:Bind SelectedProductEditVisibility, Mode=OneWay}">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Edit details" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="Update the selected product inline and save when you're done." TextWrapping="WrapWholeWords" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="Name" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBox Text="{x:Bind Draft.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="40" FontSize="15" Padding="12,8" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" />
                                </StackPanel>

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Barcode" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBox Text="{x:Bind Draft.Barcode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="40" FontSize="15" Padding="12,8" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="6">
                                        <TextBlock Text="SKU" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBox Text="{x:Bind Draft.Sku, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="40" FontSize="15" Padding="12,8" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" />
                                    </StackPanel>
                                </Grid>

                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="6" Grid.ColumnSpan="{x:Bind ProductValueColumnSpan, Mode=OneWay}">
                                            <TextBlock Text="Unit" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBox Text="{x:Bind Draft.Unit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="40" FontSize="15" Padding="12,8" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="8" Visibility="{x:Bind PriceVisibility, Mode=OneWay}">
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="Cost price" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBox Text="{x:Bind Draft.CostPriceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="40" FontSize="15" Padding="12,8" common:NumericInputNormalization.NormalizeOnLostFocus="True" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" />
                                            </StackPanel>
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="Sell price" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBox Text="{x:Bind Draft.PriceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="40" FontSize="15" Padding="12,8" common:NumericInputNormalization.NormalizeOnLostFocus="True" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>

                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Store quantity" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBox Text="{x:Bind Draft.QuantityStoreText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="40" FontSize="15" Padding="12,8" common:NumericInputNormalization.NormalizeOnLostFocus="True" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="6">
                                            <TextBlock Text="Warehouse quantity" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBox Text="{x:Bind Draft.QuantityWarehouseText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="40" FontSize="15" Padding="12,8" common:NumericInputNormalization.NormalizeOnLostFocus="True" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Store threshold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBox Text="{x:Bind Draft.MinThresholdStoreText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="40" FontSize="15" Padding="12,8" common:NumericInputNormalization.NormalizeOnLostFocus="True" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="6">
                                            <TextBlock Text="Warehouse threshold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBox Text="{x:Bind Draft.MinThresholdWarehouseText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="40" FontSize="15" Padding="12,8" common:NumericInputNormalization.NormalizeOnLostFocus="True" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Purchased at" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <DatePicker Date="{x:Bind Draft.PurchasedAtDate, Mode=TwoWay}" MinHeight="40" FontSize="15" Padding="12,8" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Bottom">
                                            <TextBlock Text="Last sale at" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind SelectedProductLastSaleAtText, Mode=OneWay}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Tax" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <ComboBox x:Name="EditTaxPicker" ItemsSource="{x:Bind TaxPickerItems, Mode=OneWay}" SelectedItem="{x:Bind SelectedTaxPickerItem, Mode=TwoWay}" SelectionChanged="TaxPicker_SelectionChanged" MinHeight="40" FontSize="15" Padding="10,6" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" HorizontalAlignment="Stretch" CornerRadius="4">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:TaxPickerItem">
                                                    <Grid>
                                                        <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Margin="0,10,0,4" Visibility="{x:Bind HeaderVis}"/>
                                                        <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind SelectableVis}">
                                                            <TextBlock Text="{x:Bind DisplayName}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                                            <TextBlock Text="{x:Bind Subtitle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{x:Bind TaxInfoChipVisibility, Mode=OneWay}" Margin="0,2,0,0">
                                            <FontIcon Glyph="&#xE946;" FontSize="12" Foreground="{ThemeResource SystemAccentColor}" VerticalAlignment="Center" />
                                            <TextBlock Text="{x:Bind TaxInfoChipText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>

                                <TextBlock Text="{x:Bind SelectedProductEditHintText, Mode=OneWay}" TextWrapping="WrapWholeWords" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <StackPanel Spacing="14" Visibility="{x:Bind AddProductVisibility, Mode=OneWay}">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="New product details" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="Fill in the fields below and press Save to add this product to the catalog." TextWrapping="WrapWholeWords" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="Name *" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBox Text="{x:Bind Draft.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="40" FontSize="15" Padding="12,8" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" />
                                </StackPanel>

                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Barcode" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBox Text="{x:Bind Draft.Barcode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="40" FontSize="15" Padding="12,8" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="6">
                                            <TextBlock Text="SKU" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBox Text="{x:Bind Draft.Sku, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="40" FontSize="15" Padding="12,8" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="6" Grid.ColumnSpan="1">
                                            <TextBlock Text="Unit" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBox Text="{x:Bind Draft.Unit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="40" FontSize="15" Padding="12,8" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="8">
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="Cost price" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBox Text="{x:Bind Draft.CostPriceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="40" FontSize="15" Padding="12,8" common:NumericInputNormalization.NormalizeOnLostFocus="True" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" />
                                            </StackPanel>
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="Sell price *" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBox Text="{x:Bind Draft.PriceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="40" FontSize="15" Padding="12,8" common:NumericInputNormalization.NormalizeOnLostFocus="True" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>

                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Store quantity" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBox Text="{x:Bind Draft.QuantityStoreText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="40" FontSize="15" Padding="12,8" common:NumericInputNormalization.NormalizeOnLostFocus="True" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="6">
                                            <TextBlock Text="Warehouse quantity" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBox Text="{x:Bind Draft.QuantityWarehouseText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="40" FontSize="15" Padding="12,8" common:NumericInputNormalization.NormalizeOnLostFocus="True" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Store threshold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBox Text="{x:Bind Draft.MinThresholdStoreText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="40" FontSize="15" Padding="12,8" common:NumericInputNormalization.NormalizeOnLostFocus="True" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="6">
                                            <TextBlock Text="Warehouse threshold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBox Text="{x:Bind Draft.MinThresholdWarehouseText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="40" FontSize="15" Padding="12,8" common:NumericInputNormalization.NormalizeOnLostFocus="True" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" />
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Tax" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <ComboBox x:Name="AddTaxPicker" ItemsSource="{x:Bind TaxPickerItems, Mode=OneWay}" SelectedItem="{x:Bind SelectedTaxPickerItem, Mode=TwoWay}" SelectionChanged="TaxPicker_SelectionChanged" MinHeight="40" FontSize="15" Padding="10,6" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" HorizontalAlignment="Stretch" CornerRadius="4">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:TaxPickerItem">
                                                    <Grid>
                                                        <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Margin="0,10,0,4" Visibility="{x:Bind HeaderVis}"/>
                                                        <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind SelectableVis}">
                                                            <TextBlock Text="{x:Bind DisplayName}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                                            <TextBlock Text="{x:Bind Subtitle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{x:Bind TaxInfoChipVisibility, Mode=OneWay}" Margin="0,2,0,0">
                                            <FontIcon Glyph="&#xE946;" FontSize="12" Foreground="{ThemeResource SystemAccentColor}" VerticalAlignment="Center" />
                                            <TextBlock Text="{x:Bind TaxInfoChipText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>
                            </StackPanel>

                        <StackPanel HorizontalAlignment="Center" Spacing="10" Padding="0,24,0,0" Visibility="{x:Bind NoSelectionVisibility, Mode=OneWay}">
                            <FontIcon Glyph="&#xE897;" 
          FontSize="50" 
          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" 
          HorizontalAlignment="Center" 
          VerticalAlignment="Center" />

                            <TextBlock Text="Select a product" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="Choose an item from the catalog to inspect its details." TextWrapping="WrapWholeWords" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
</Page>




