<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="RetailStorePOS.WinUiLogin.Views.ProductsPage"
      x:Name="RootPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:models="using:RetailStorePOS.WinUiLogin.Models"
      xmlns:common="using:RetailStorePOS.WinUiLogin.Common"
      mc:Ignorable="d"
      Background="Transparent"
      FlowDirection="{x:Bind Loc.FlowDirection, Mode=OneWay}">

    <Page.Resources>
        <Style x:Key="PP_Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E8EAF0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>

        <Style x:Key="PP_PrimaryButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="PP_GhostButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E8EAF0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#1A1D23"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="PP_DangerButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FCA5A5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#DC2626"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#E8EAF0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#E8EAF0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#E8EAF0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="NumberBox">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="MinHeight" Value="36"/>
        </Style>

        <!-- Right-panel typography -->
        <Style x:Key="PP_SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1A1D23"/>
        </Style>

        <Style x:Key="PP_SectionSubtitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="WrapWholeWords"/>
            <Setter Property="Foreground" Value="#8F96A3"/>
        </Style>

        <!-- Tracked-uppercase metadata label: matches the system signature applied   -->
        <!-- everywhere else (CharacterSpacing=40, 11px SemiBold Graphite).            -->
        <Style x:Key="PP_FormLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#5F6775"/>
            <Setter Property="CharacterSpacing" Value="40"/>
        </Style>

        <Style x:Key="PP_FormValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1A1D23"/>
        </Style>

        <Style x:Key="PP_HelperText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#8F96A3"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="PP_SectionDivider" TargetType="Border">
            <Setter Property="Background" Value="#F1F4F9"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <!-- PP_SectionCard kept for backward compatibility but flattened: no border, no -->
        <!-- background. The editor body uses these as plain section containers, so the  -->
        <!-- nested-card problem is gone.                                                -->
        <Style x:Key="PP_SectionCard" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <!-- Tax picker item template (shared by Edit and Add forms) -->
        <DataTemplate x:Key="PP_TaxComboItemTemplate" x:DataType="models:TaxPickerItem">
            <Grid>
                <TextBlock Text="{x:Bind DisplayName}"
                           FontWeight="SemiBold"
                           FontSize="11"
                           CharacterSpacing="40"
                           Foreground="#5F6775"
                           Margin="0,10,0,4"
                           Visibility="{x:Bind HeaderVis}"/>
                <StackPanel Orientation="Horizontal"
                            Spacing="8"
                            Visibility="{x:Bind SelectableVis}">
                    <TextBlock Text="{x:Bind DisplayName}"
                               FontSize="13"
                               Foreground="#1A1D23"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{x:Bind Subtitle}"
                               Foreground="#8F96A3"
                               FontSize="12"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="20" ColumnSpacing="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.25*" />
            <ColumnDefinition Width="0.95*" />
        </Grid.ColumnDefinitions>

        <ContentDialog x:Name="TransferStockDialog"
                       Title="{x:Bind Products_Dialog_Transfer_Title, Mode=OneWay}"
                       PrimaryButtonText="{x:Bind Products_Dialog_Transfer_PrimaryButtonText, Mode=OneWay}"
                       CloseButtonText="{x:Bind Products_Dialog_Transfer_CloseButtonText, Mode=OneWay}"
                       PrimaryButtonClick="TransferStockDialog_PrimaryButtonClick">
            <StackPanel Spacing="16">
                <TextBlock Text="{x:Bind Products_Dialog_Transfer_Text, Mode=OneWay}" TextWrapping="Wrap" />
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="{x:Bind Products_Dialog_Transfer_WarehouseQty, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind SelectedProductWarehouseQuantityText, Mode=OneWay}" FontWeight="SemiBold" FontSize="18" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="{x:Bind Products_Dialog_Transfer_StoreQty, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind SelectedProductStoreQuantityText, Mode=OneWay}" FontWeight="SemiBold" FontSize="18" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                </Grid>
                <NumberBox x:Name="TransferQuantityBox" Minimum="1" Maximum="10000" Value="1" SpinButtonPlacementMode="Inline" Header="{x:Bind Products_Dialog_Transfer_QtyToMove, Mode=OneWay}" Margin="0,8,0,0" common:NumericInputNormalization.NormalizeOnLostFocus="True" />
            </StackPanel>
        </ContentDialog>

        <!-- LEFT COLUMN: Header + List -->
        <Grid Grid.Column="0" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  ColumnSpacing="12"
                  VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="6">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{x:Bind Products_Header_Title, Mode=OneWay}"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="#1A1D23"/>
                    </StackPanel>
                    <InfoBar IsOpen="{x:Bind HasCatalogInventoryAlerts, Mode=OneWay}"
                             Visibility="{x:Bind CatalogInventoryAlertVisibility, Mode=OneWay}"
                             Severity="{x:Bind CatalogInventoryAlertSeverity, Mode=OneWay}"
                             Message="{x:Bind CatalogInventoryAlertText, Mode=OneWay}"
                             IsClosable="False"
                             CornerRadius="8"
                             Margin="0,4,0,0"/>
                    <Border Visibility="{x:Bind ImportProgressVisibility, Mode=OneWay}"
                            Background="{ThemeResource AccentFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,10">
                        <Grid RowSpacing="8"
                              ColumnSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="4">
                                <TextBlock Text="{x:Bind ImportProgressTitle, Mode=OneWay}"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="{x:Bind ImportProgressDetail, Mode=OneWay}"
                                           TextWrapping="WrapWholeWords"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Content="{x:Bind ImportCancelButtonText, Mode=OneWay}"
                                    Click="CancelImportButton_Click"
                                    IsEnabled="{x:Bind CanCancelImport, Mode=OneWay}"
                                    VerticalAlignment="Top" />

                            <Grid Grid.Row="1"
                                  Grid.ColumnSpan="2"
                                  ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ProgressBar Value="{x:Bind ImportProgressPercent, Mode=OneWay}"
                                             IsIndeterminate="{x:Bind IsImportProgressIndeterminate, Mode=OneWay}"
                                             Minimum="0"
                                             Maximum="100"
                                             Height="8"
                                             VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind ImportProgressPercentText, Mode=OneWay}"
                                           FlowDirection="LeftToRight"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Top">
                    <Button Content="{x:Bind Products_Button_Refresh, Mode=OneWay}"
                            Click="RefreshButton_Click"
                            Style="{StaticResource PP_GhostButton}"
                            IsEnabled="{x:Bind CanBrowseProducts, Mode=OneWay}"/>
                    <Button Content="{x:Bind Products_Button_Clear, Mode=OneWay}"
                            Click="ClearSearchButton_Click"
                            Style="{StaticResource PP_GhostButton}"
                            IsEnabled="{x:Bind CanBrowseProducts, Mode=OneWay}"/>
                    <Button Content="{x:Bind Products_Button_Import, Mode=OneWay}"
                            Click="ImportDataButton_Click"
                            Style="{StaticResource PP_GhostButton}"
                            IsEnabled="{x:Bind CanBrowseProducts, Mode=OneWay}"/>
                    <Button Content="{x:Bind Products_Button_Export, Mode=OneWay}"
                            Click="ExportDataButton_Click"
                            Style="{StaticResource PP_GhostButton}"
                            IsEnabled="{x:Bind CanBrowseProducts, Mode=OneWay}"/>
                    <Button Content="{x:Bind Products_Button_Add, Mode=OneWay}"
                            Click="AddProductButton_Click"
                            Style="{StaticResource PP_PrimaryButton}"
                            IsEnabled="{x:Bind CanBrowseProducts, Mode=OneWay}"/>
                </StackPanel>
            </Grid>


            <!-- LIST panel -->
            <Border Grid.Row="1" Style="{StaticResource PP_Card}" Padding="14">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Background="#FAFBFC" Padding="12,0" BorderBrush="#E8EAF0" CornerRadius="8" BorderThickness="1">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                                <AutoSuggestBox x:Name="SearchTextBox"
                                                Grid.Column="1"
                                                PlaceholderText="{x:Bind Products_Search_Placeholder, Mode=OneWay}" 
                                                Text="{x:Bind SearchTerm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                IsEnabled="{x:Bind CanBrowseProducts, Mode=OneWay}" 
                                                Background="Transparent" 
                                                BorderThickness="0" 
                                                HorizontalAlignment="Stretch" 
                                                VerticalAlignment="Center" 
                                                QueryIcon="Find" 
                                                Padding="12,6">
                                </AutoSuggestBox>
                        </Grid>
                    </Grid>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind ProductsCountText, Mode=OneWay}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </Grid>
                    <Grid Grid.Row="2">
                        <ListView x:Name="ProductsListView" ItemsSource="{x:Bind Products, Mode=OneWay}" SelectionMode="Single" IsItemClickEnabled="True" IsEnabled="{x:Bind CanBrowseProducts, Mode=OneWay}" SelectionChanged="ProductsListView_SelectionChanged" Padding="0" BorderThickness="0">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,8" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:ProductListItem">
                                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0.5"  Padding="12,10" CornerRadius="6">
                                        <Grid ColumnSpacing="12" CornerRadius="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                                <TextBlock Text="{x:Bind BarcodeText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind StockSummaryText}" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{x:Bind PriceText}" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Visibility="{Binding ElementName=RootPage, Path=PriceVisibility}" />
                                                <TextBlock Text="{x:Bind UnitText}" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Border HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind NoProductsVisibility, Mode=OneWay}">
                            <StackPanel HorizontalAlignment="Center" Spacing="6" MaxWidth="320">
                                <TextBlock Text="{x:Bind Products_Count_None, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="#1A1D23" />
                                <TextBlock Text="{x:Bind Products_Count_Subtitle, Mode=OneWay}" TextWrapping="WrapWholeWords" TextAlignment="Center" HorizontalAlignment="Center" FontSize="12" Foreground="#8F96A3" />
                            </StackPanel>
                        </Border>
                </Grid><!-- /Grid.Row="2" -->
                </Grid><!-- /Grid RowSpacing="12" -->
            </Border><!-- /LIST panel -->
        </Grid><!-- /LEFT COLUMN -->



        <!-- RIGHT COLUMN: Selected Product Details (full height) -->
        <Border Grid.Column="1"
                IsHitTestVisible="{x:Bind CanUseProductDetails, Mode=OneWay}"
                Style="{StaticResource PP_Card}"
                Padding="18,16,18,18"
                VerticalAlignment="Stretch">
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header: title + subtitle on the left, action buttons on the right -->
                <Grid Grid.Row="0" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind RightPanelTitleText, Mode=OneWay}"
                                   Style="{StaticResource PP_SectionTitle}" />
                        <TextBlock Text="{x:Bind SelectedProductSubtitleText, Mode=OneWay}"
                                   Style="{StaticResource PP_SectionSubtitle}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Top"
                                HorizontalAlignment="Right">
                        <Button Content="{x:Bind Products_Details_Delete, Mode=OneWay}"
                                Click="DeleteProductButton_Click"
                                Style="{StaticResource PP_DangerButton}"
                                Visibility="{x:Bind DeleteButtonVisibility, Mode=OneWay}" />
                        <Button Content="{x:Bind Products_Details_Transfer, Mode=OneWay}"
                                Click="TransferStockButton_Click"
                                Style="{StaticResource PP_GhostButton}"
                                Visibility="{x:Bind SelectedProductViewVisibility, Mode=OneWay}" />
                        <Button Content="{x:Bind Products_Details_Cancel, Mode=OneWay}"
                                Click="CancelEditButton_Click"
                                Style="{StaticResource PP_GhostButton}"
                                Visibility="{x:Bind SelectedProductCancelVisibility, Mode=OneWay}" />
                        <Button Content="{x:Bind SelectedProductActionText, Mode=OneWay}"
                                Click="SelectedProductActionButton_Click"
                                Style="{StaticResource PP_PrimaryButton}"
                                IsEnabled="{x:Bind CanExecuteSelectedProductAction, Mode=OneWay}" />
                    </StackPanel>
                </Grid>

                <!-- Status / inventory alert bars -->
                <StackPanel Grid.Row="1" Spacing="6">
                    <InfoBar IsOpen="{x:Bind IsStatusOpen, Mode=OneWay}"
                             Severity="{x:Bind StatusSeverity, Mode=OneWay}"
                             Message="{x:Bind StatusMessage, Mode=OneWay}"
                             IsClosable="True"
                             CornerRadius="8" />
                    <InfoBar IsOpen="{x:Bind SelectedProductHasInventoryAlert, Mode=OneWay}"
                             Visibility="{x:Bind SelectedProductInventoryAlertVisibility, Mode=OneWay}"
                             Severity="{x:Bind SelectedProductInventoryAlertSeverity, Mode=OneWay}"
                             Message="{x:Bind SelectedProductInventoryAlertText, Mode=OneWay}"
                             IsClosable="False"
                             CornerRadius="8" />
                </StackPanel>

                <!-- Body: image, view-only summary, edit form, add form, empty state -->
                <ScrollViewer Grid.Row="2"
                              Margin="0,2,0,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="18">

                        <!-- Product image + change/remove buttons -->
                        <Grid x:Name="ProductImageContainer"
                              Visibility="{x:Bind ProductImageContainerVisibility, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Width="140" Height="140"
                                    CornerRadius="10"
                                    Background="#FAFBFC"
                                    BorderBrush="#E8EAF0"
                                    BorderThickness="1">
                                <Grid>
                                    <Image Source="{x:Bind Draft.PreviewImageSource, Mode=OneWay}"
                                           Stretch="Uniform"
                                           AutomationProperties.Name="Product preview image" />
                                    <FontIcon Glyph="&#xE722;"
                                              FontFamily="Segoe Fluent Icons"
                                              FontSize="32"
                                              Foreground="#8F96A3"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Visibility="{x:Bind Draft.HasNoImageVisibility, Mode=OneWay}" />
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Margin="16,0,0,0"
                                        Spacing="8"
                                        Visibility="{x:Bind ProductImageEditorVisibility, Mode=OneWay}">
                                <Button Content="{x:Bind ProductImageActionText, Mode=OneWay}"
                                        Click="ChangePictureButton_Click"
                                        Style="{StaticResource PP_PrimaryButton}"
                                        HorizontalAlignment="Stretch" />
                                <Button Content="{x:Bind Products_Button_RemovePicture, Mode=OneWay}"
                                        Click="RemovePictureButton_Click"
                                        Style="{StaticResource PP_GhostButton}"
                                        HorizontalAlignment="Stretch"
                                        Visibility="{x:Bind Draft.HasImageVisibility, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>

                        <!-- Read-only summary (selected, not editing). PP_SectionCard is now -->
                        <!-- a flat container so this no longer creates a nested card.        -->
                        <Border Style="{StaticResource PP_SectionCard}"
                                Visibility="{x:Bind SelectedProductViewVisibility, Mode=OneWay}">
                            <StackPanel Spacing="18">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{x:Bind Products_Label_Barcode, Mode=OneWay}" Style="{StaticResource PP_FormLabel}" />
                                        <TextBlock Text="{x:Bind SelectedProductBarcodeText, Mode=OneWay}" Style="{StaticResource PP_FormValue}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="{x:Bind Products_Label_SKU, Mode=OneWay}" Style="{StaticResource PP_FormLabel}" />
                                        <TextBlock Text="{x:Bind SelectedProductSkuText, Mode=OneWay}" Style="{StaticResource PP_FormValue}" />
                                    </StackPanel>
                                </Grid>

                                <Border Style="{StaticResource PP_SectionDivider}" Visibility="{x:Bind PriceVisibility, Mode=OneWay}" />

                                <Grid ColumnSpacing="12" Visibility="{x:Bind PriceVisibility, Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{x:Bind Products_Label_CostPrice, Mode=OneWay}" Style="{StaticResource PP_FormLabel}" />
                                        <TextBlock Text="{x:Bind SelectedProductCostPriceText, Mode=OneWay}" Style="{StaticResource PP_FormValue}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="{x:Bind Products_Label_SellPrice, Mode=OneWay}" Style="{StaticResource PP_FormLabel}" />
                                        <TextBlock Text="{x:Bind SelectedProductPriceText, Mode=OneWay}" Style="{StaticResource PP_FormValue}" />
                                    </StackPanel>
                                </Grid>

                                <Border Style="{StaticResource PP_SectionDivider}" />

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{x:Bind Products_Label_StoreQty, Mode=OneWay}" Style="{StaticResource PP_FormLabel}" />
                                        <TextBlock Text="{x:Bind SelectedProductStoreQuantityText, Mode=OneWay}" Style="{StaticResource PP_FormValue}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="{x:Bind Products_Label_WarehouseQty, Mode=OneWay}" Style="{StaticResource PP_FormLabel}" />
                                        <TextBlock Text="{x:Bind SelectedProductWarehouseQuantityText, Mode=OneWay}" Style="{StaticResource PP_FormValue}" />
                                    </StackPanel>
                                </Grid>

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{x:Bind Products_Label_StoreThreshold, Mode=OneWay}" Style="{StaticResource PP_FormLabel}" />
                                        <TextBlock Text="{x:Bind SelectedProductStoreThresholdText, Mode=OneWay}" Style="{StaticResource PP_FormValue}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="{x:Bind Products_Label_WarehouseThreshold, Mode=OneWay}" Style="{StaticResource PP_FormLabel}" />
                                        <TextBlock Text="{x:Bind SelectedProductWarehouseThresholdText, Mode=OneWay}" Style="{StaticResource PP_FormValue}" />
                                    </StackPanel>
                                </Grid>

                                <Border Style="{StaticResource PP_SectionDivider}" />

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{x:Bind Products_Label_PurchasedAt, Mode=OneWay}" Style="{StaticResource PP_FormLabel}" />
                                        <TextBlock Text="{x:Bind SelectedProductPurchasedAtText, Mode=OneWay}" Style="{StaticResource PP_FormValue}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="{x:Bind Products_Label_LastSaleAt, Mode=OneWay}" Style="{StaticResource PP_FormLabel}" />
                                        <TextBlock Text="{x:Bind SelectedProductLastSaleAtText, Mode=OneWay}" Style="{StaticResource PP_FormValue}" />
                                    </StackPanel>
                                </Grid>

                                <Border Style="{StaticResource PP_SectionDivider}" />

                                <StackPanel Spacing="4">
                                    <TextBlock Text="{x:Bind Products_Label_Tax, Mode=OneWay}" Style="{StaticResource PP_FormLabel}" />
                                    <TextBlock Text="{x:Bind SelectedProductTaxText, Mode=OneWay}"
                                               Style="{StaticResource PP_FormValue}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Edit existing product -->
                        <StackPanel Spacing="14" Visibility="{x:Bind SelectedProductEditVisibility, Mode=OneWay}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{x:Bind Products_Details_EditTitle, Mode=OneWay}" Style="{StaticResource PP_SectionTitle}" />
                                <TextBlock Text="{x:Bind Products_Details_EditSubtitle, Mode=OneWay}" Style="{StaticResource PP_SectionSubtitle}" />
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="{x:Bind Products_Label_Name, Mode=OneWay}" Style="{StaticResource PP_FormLabel}" />
                                <TextBox Text="{x:Bind Draft.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{x:Bind Products_Label_Barcode, Mode=OneWay}" Style="{StaticResource PP_FormLabel}" />
                                    <TextBox Text="{x:Bind Draft.Barcode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="{x:Bind Products_Label_SKU, Mode=OneWay}" Style="{StaticResource PP_FormLabel}" />
                                    <TextBox Text="{x:Bind Draft.Sku, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="6" Grid.ColumnSpan="{x:Bind ProductValueColumnSpan, Mode=OneWay}">
                                    <TextBlock Text="{x:Bind Products_Label_Unit, Mode=OneWay}" Style="{StaticResource PP_FormLabel}" />
                                    <TextBox Text="{x:Bind Draft.Unit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="8" Visibility="{x:Bind PriceVisibility, Mode=OneWay}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{x:Bind Products_Label_CostPrice, Mode=OneWay}" Style="{StaticResource PP_FormLabel}" />
                                        <TextBox Text="{x:Bind Draft.CostPriceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 common:NumericInputNormalization.NormalizeOnLostFocus="True" />
                                    </StackPanel>
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{x:Bind Products_Label_SellPrice, Mode=OneWay}" Style="{StaticResource PP_FormLabel}" />
                                        <TextBox Text="{x:Bind Draft.PriceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 common:NumericInputNormalization.NormalizeOnLostFocus="True" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{x:Bind Products_Label_StoreQty, Mode=OneWay}" Style="{StaticResource PP_FormLabel}" />
                                    <TextBox Text="{x:Bind Draft.QuantityStoreText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             common:NumericInputNormalization.NormalizeOnLostFocus="True" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="{x:Bind Products_Label_WarehouseQty, Mode=OneWay}" Style="{StaticResource PP_FormLabel}" />
                                    <TextBox Text="{x:Bind Draft.QuantityWarehouseText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             common:NumericInputNormalization.NormalizeOnLostFocus="True" />
                                </StackPanel>
                            </Grid>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{x:Bind Products_Label_StoreThreshold, Mode=OneWay}" Style="{StaticResource PP_FormLabel}" />
                                    <TextBox Text="{x:Bind Draft.MinThresholdStoreText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             common:NumericInputNormalization.NormalizeOnLostFocus="True" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="{x:Bind Products_Label_WarehouseThreshold, Mode=OneWay}" Style="{StaticResource PP_FormLabel}" />
                                    <TextBox Text="{x:Bind Draft.MinThresholdWarehouseText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             common:NumericInputNormalization.NormalizeOnLostFocus="True" />
                                </StackPanel>
                            </Grid>

                            <!-- Purchased At alone in its row: it is the only editable date here. -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="{x:Bind Products_Label_PurchasedAt, Mode=OneWay}" Style="{StaticResource PP_FormLabel}" />
                                <DatePicker Date="{x:Bind Draft.PurchasedAtDate, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="{x:Bind Products_Label_Tax, Mode=OneWay}" Style="{StaticResource PP_FormLabel}" />
                                <ComboBox x:Name="EditTaxPicker"
                                          ItemsSource="{x:Bind TaxPickerItems, Mode=OneWay}"
                                          SelectedItem="{x:Bind SelectedTaxPickerItem, Mode=TwoWay}"
                                          SelectionChanged="TaxPicker_SelectionChanged"
                                          ItemTemplate="{StaticResource PP_TaxComboItemTemplate}" />
                                <StackPanel Orientation="Horizontal"
                                            Spacing="6"
                                            Margin="0,2,0,0"
                                            Visibility="{x:Bind TaxInfoChipVisibility, Mode=OneWay}">
                                    <FontIcon Glyph="&#xE946;"
                                              FontFamily="Segoe Fluent Icons"
                                              FontSize="12"
                                              Foreground="#1D4ED8"
                                              VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind TaxInfoChipText, Mode=OneWay}"
                                               FontSize="12"
                                               Foreground="#5F6775"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Read-only metadata footer: last sale date sits below the form,    -->
                            <!-- so it is not mistaken for an editable field.                     -->
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{x:Bind Products_Label_LastSaleAt, Mode=OneWay}"
                                           Style="{StaticResource PP_HelperText}" />
                                <TextBlock Text="{x:Bind SelectedProductLastSaleAtText, Mode=OneWay}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#5F6775" />
                            </StackPanel>

                            <TextBlock Text="{x:Bind SelectedProductEditHintText, Mode=OneWay}"
                                       Style="{StaticResource PP_HelperText}" />
                        </StackPanel>

                        <!-- Add new product -->
                        <StackPanel Spacing="14" Visibility="{x:Bind AddProductVisibility, Mode=OneWay}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{x:Bind Products_Details_NewTitle, Mode=OneWay}" Style="{StaticResource PP_SectionTitle}" />
                                <TextBlock Text="{x:Bind Products_Details_NewSubtitle, Mode=OneWay}" Style="{StaticResource PP_SectionSubtitle}" />
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="{x:Bind Products_Label_Name_Required, Mode=OneWay}" Style="{StaticResource PP_FormLabel}" />
                                <TextBox Text="{x:Bind Draft.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{x:Bind Products_Label_Barcode, Mode=OneWay}" Style="{StaticResource PP_FormLabel}" />
                                    <TextBox Text="{x:Bind Draft.Barcode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="{x:Bind Products_Label_SKU, Mode=OneWay}" Style="{StaticResource PP_FormLabel}" />
                                    <TextBox Text="{x:Bind Draft.Sku, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{x:Bind Products_Label_Unit, Mode=OneWay}" Style="{StaticResource PP_FormLabel}" />
                                    <TextBox Text="{x:Bind Draft.Unit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="8">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{x:Bind Products_Label_CostPrice, Mode=OneWay}" Style="{StaticResource PP_FormLabel}" />
                                        <TextBox Text="{x:Bind Draft.CostPriceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 common:NumericInputNormalization.NormalizeOnLostFocus="True" />
                                    </StackPanel>
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{x:Bind Products_Label_SellPrice_Required, Mode=OneWay}" Style="{StaticResource PP_FormLabel}" />
                                        <TextBox Text="{x:Bind Draft.PriceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 common:NumericInputNormalization.NormalizeOnLostFocus="True" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{x:Bind Products_Label_StoreQty, Mode=OneWay}" Style="{StaticResource PP_FormLabel}" />
                                    <TextBox Text="{x:Bind Draft.QuantityStoreText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             common:NumericInputNormalization.NormalizeOnLostFocus="True" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="{x:Bind Products_Label_WarehouseQty, Mode=OneWay}" Style="{StaticResource PP_FormLabel}" />
                                    <TextBox Text="{x:Bind Draft.QuantityWarehouseText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             common:NumericInputNormalization.NormalizeOnLostFocus="True" />
                                </StackPanel>
                            </Grid>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{x:Bind Products_Label_StoreThreshold, Mode=OneWay}" Style="{StaticResource PP_FormLabel}" />
                                    <TextBox Text="{x:Bind Draft.MinThresholdStoreText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             common:NumericInputNormalization.NormalizeOnLostFocus="True" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="{x:Bind Products_Label_WarehouseThreshold, Mode=OneWay}" Style="{StaticResource PP_FormLabel}" />
                                    <TextBox Text="{x:Bind Draft.MinThresholdWarehouseText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             common:NumericInputNormalization.NormalizeOnLostFocus="True" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Spacing="6">
                                <TextBlock Text="{x:Bind Products_Label_Tax, Mode=OneWay}" Style="{StaticResource PP_FormLabel}" />
                                <ComboBox x:Name="AddTaxPicker"
                                          ItemsSource="{x:Bind TaxPickerItems, Mode=OneWay}"
                                          SelectedItem="{x:Bind SelectedTaxPickerItem, Mode=TwoWay}"
                                          SelectionChanged="TaxPicker_SelectionChanged"
                                          ItemTemplate="{StaticResource PP_TaxComboItemTemplate}" />
                                <StackPanel Orientation="Horizontal"
                                            Spacing="6"
                                            Margin="0,2,0,0"
                                            Visibility="{x:Bind TaxInfoChipVisibility, Mode=OneWay}">
                                    <FontIcon Glyph="&#xE946;"
                                              FontSize="12"
                                              Foreground="#1D4ED8"
                                              VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind TaxInfoChipText, Mode=OneWay}"
                                               FontSize="12"
                                               Foreground="#5F6775"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- Empty state (no product selected, not adding) -->
                        <StackPanel HorizontalAlignment="Center"
                                    Spacing="6"
                                    Padding="0,32,0,0"
                                    MaxWidth="380"
                                    Visibility="{x:Bind NoSelectionVisibility, Mode=OneWay}">
                            <TextBlock Text="{x:Bind Products_Details_SelectProduct, Mode=OneWay}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Foreground="#1A1D23" />
                            <TextBlock Text="{x:Bind Products_Details_SelectSubtitle, Mode=OneWay}"
                                       TextWrapping="WrapWholeWords"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"
                                       FontSize="12"
                                       Foreground="#8F96A3" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
        <Border Grid.ColumnSpan="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,12,0,0"
                MaxWidth="440"
                MinWidth="320"
                Padding="16,14"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{x:Bind ImportFailureTipVisibility, Mode=OneWay}">
            <StackPanel Spacing="12">
                <TextBlock Text="{x:Bind ImportFailureTipTitle, Mode=OneWay}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="{x:Bind ImportFailureTipMessage, Mode=OneWay}"
                           MaxWidth="408"
                           TextWrapping="WrapWholeWords"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="{x:Bind ImportFailureTipSkipText, Mode=OneWay}"
                            Click="ImportFailureTipSkipButton_Click"
                            CornerRadius="4" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
