<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="RetailStorePOS.WinUiLogin.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="32" Spacing="24">
            
            <StackPanel Spacing="12" HorizontalAlignment="Center">
                <Border Width="96"
                        Height="96"
                        Padding="16"
                        CornerRadius="12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  >
                    <Image Source="ms-appx:///Assets/Logo.png" Stretch="Uniform" />
                </Border>

                <StackPanel Spacing="4" HorizontalAlignment="Center">
                    <TextBlock Text="Retail Store"
                               FontSize="32"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="VersionText"
                               FontSize="16"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Privacy and policy"
                               FontSize="13"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </StackPanel>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="24">
                <TextBlock x:Name="PolicyTextBlock"
                           Text="Loading policy text..."
                           TextWrapping="WrapWholeWords"
                           FontSize="14"
                           LineHeight="22"
                           IsTextSelectionEnabled="True"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            </Border>
            
        </StackPanel>
    </ScrollViewer>
</Page>


