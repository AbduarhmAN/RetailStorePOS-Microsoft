<ContentDialog
    x:Class="RetailStorePOS.WinUiLogin.Views.CloseRegisterDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RetailStorePOS.WinUiLogin.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Uid="CloseRegisterDialog"
    RequestedTheme="Light"
    CornerRadius="10">

    <ContentDialog.Resources>
        <SolidColorBrush x:Key="DialogPrimaryTextBrush" Color="#0F172A" />
        <SolidColorBrush x:Key="DialogSecondaryTextBrush" Color="#475569" />
        <SolidColorBrush x:Key="DialogDangerTextBrush" Color="#991B1B" />

        <Style x:Key="AccordionRowButtonStyle"
               TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="DialogFooterDefaultButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Height" Value="60" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="12,6" />
        </Style>

        <Style x:Key="DialogFooterPrimaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource AccentBlueButtonStyle}">
            <Setter Property="Height" Value="60" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="12,6" />
        </Style>
    </ContentDialog.Resources>

    <ContentDialog.Title>
        <TextBlock x:Uid="CloseRegisterDialog_Title"
                   Text="Closing Register"
                   FontSize="20"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center" />
    </ContentDialog.Title>

    <Grid x:Name="DialogLayoutRoot"
          RowSpacing="16"
          Margin="0,8,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="DialogScrollViewer"
                      VerticalScrollMode="Auto"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Disabled"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="DialogContentRoot"
                        HorizontalAlignment="Stretch"
                        Spacing="16">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="CloseRegisterDialog_ReviewText"
                                   Text="Review the current register totals before ending this session."
                                   FontWeight="SemiBold"
                                   TextWrapping="WrapWholeWords" />
                        <TextBlock x:Name="SessionMetaText"
                                   x:Uid="CloseRegisterDialog_SessionMetaText"
                                   Text="Active register session"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="WrapWholeWords" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Spacing="2"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top">
                        <TextBlock x:Name="SessionTotalsText"
                                   Text="0 orders: 0.00"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Right" />
                        <TextBlock x:Uid="CloseRegisterDialog_SessionTotalLabel"
                                   Text="Session total"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>

                <InfoBar x:Name="ErrorBar"
                         x:Uid="CloseRegisterDialog_ErrorBar"
                         Title="Action Failed"
                         Severity="Error"
                         IsOpen="False" />

                <StackPanel Spacing="12">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12">
                        <StackPanel Spacing="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Uid="CloseRegisterDialog_CashLabel"
                                           Text="Cash"
                                           Foreground="{StaticResource DialogPrimaryTextBrush}" />
                                <TextBlock x:Name="ExpectedCashText"
                                           Grid.Column="1"
                                           Text="0.00"
                                           Foreground="{StaticResource DialogPrimaryTextBrush}"
                                           FontSize="20"
                                           FontWeight="SemiBold" />
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Uid="CloseRegisterDialog_OpeningLabel"
                                           Text="Opening"
                                           Foreground="{StaticResource DialogSecondaryTextBrush}" />
                                <TextBlock x:Name="OpeningAmountText"
                                           Grid.Column="1"
                                           Foreground="{StaticResource DialogSecondaryTextBrush}"
                                           Text="0.00" />
                            </Grid>

                            <Button x:Name="CashAdjustmentExpanderButton"
                                    Click="CashAdjustmentExpanderButton_Click"
                                    Style="{StaticResource AccordionRowButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock x:Uid="CloseRegisterDialog_CashInOutLabel"
                                               Text="Cash In / Out"
                                               Foreground="{StaticResource DialogSecondaryTextBrush}" />
                                    <TextBlock x:Name="CashInOutAmountText"
                                               Grid.Column="1"
                                               Margin="0,0,6,0"
                                               Foreground="{StaticResource DialogPrimaryTextBrush}"
                                               Text="0.00"
                                               VerticalAlignment="Center" />
                                    <FontIcon x:Name="CashAdjustmentChevronIcon"
                                              Grid.Column="2"
                                              Glyph="&#xE70D;"
                                              FontSize="12"
                                              Foreground="{StaticResource DialogSecondaryTextBrush}"
                                              VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                            <StackPanel x:Name="CashAdjustmentEntriesPanel"
                                        Margin="12,0,0,0"
                                        Spacing="6"
                                        Visibility="Collapsed" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Uid="CloseRegisterDialog_CountedLabel"
                                           Text="Counted"
                                           Foreground="{StaticResource DialogSecondaryTextBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="CountedAmountText"
                                           Grid.Column="1"
                                           Foreground="{StaticResource DialogPrimaryTextBrush}"
                                           FontWeight="SemiBold"
                                           Text="0.00"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Uid="CloseRegisterDialog_DifferenceLabel"
                                           Text="Difference"
                                           Foreground="{StaticResource DialogSecondaryTextBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="DifferenceText"
                                           Grid.Column="1"
                                           Foreground="{StaticResource DialogPrimaryTextBrush}"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           Text="0.00" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!--
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12">
                        <StackPanel Spacing="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Card"
                                           Foreground="{StaticResource DialogPrimaryTextBrush}" />
                                <TextBlock x:Name="ExpectedCardText"
                                           Grid.Column="1"
                                           Text="0.00"
                                           Foreground="{StaticResource DialogPrimaryTextBrush}"
                                           FontSize="20"
                                           FontWeight="SemiBold" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    -->
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock x:Uid="CloseRegisterDialog_CountedCashLabel"
                               Text="Counted Cash"
                               FontWeight="SemiBold" />
                    <TextBox x:Name="CountedCashInputBox"
                             x:Uid="CloseRegisterDialog_CountedCashInputBox"
                             PlaceholderText="0.00"
                             InputScope="Number"
                             TextChanged="CountedCashInputBox_TextChanged" />
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock x:Uid="CloseRegisterDialog_ClosingNoteLabel"
                               Text="Closing Note (Optional)"
                               FontWeight="SemiBold" />
                    <TextBox x:Name="ClosingNoteBox"
                             x:Uid="CloseRegisterDialog_ClosingNoteBox"
                             AcceptsReturn="True"
                             Height="96"
                             TextWrapping="Wrap"
                             PlaceholderText="Add any session discrepancies or notes here..." />
                </StackPanel>

                <TextBlock x:Uid="CloseRegisterDialog_FooterHint"
                           Text="After saving, the app signs out and returns to the login screen."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="WrapWholeWords" />
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1"
              ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    x:Uid="CloseRegisterDialog_CloseRegisterButton"
                    MinWidth="150"
                    Content="Close Register"
                    Style="{StaticResource DialogFooterPrimaryButtonStyle}"
                    Click="CloseRegisterButton_Click" />

            <Button Grid.Column="1"
                    x:Uid="CloseRegisterDialog_CashInOutButton"
                    MinWidth="150"
                    Content="Cash In / Out"
                    Style="{StaticResource DialogFooterDefaultButtonStyle}"
                    Click="CashInOutFooterButton_Click" />

            <Button Grid.Column="3"
                    x:Uid="CloseRegisterDialog_DiscardButton"
                    Width="92"
                    Content="Discard"
                    Style="{StaticResource DialogFooterDefaultButtonStyle}"
                    Click="CloseButton_Click" />
        </Grid>
    </Grid>
</ContentDialog>
