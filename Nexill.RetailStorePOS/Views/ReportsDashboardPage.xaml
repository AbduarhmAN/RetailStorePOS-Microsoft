<Page
    x:Class="RetailStorePOS.WinUiLogin.Views.ReportsDashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:RetailStorePOS.WinUiLogin.Views"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    mc:Ignorable="d"
    Background="White"
    FlowDirection="{x:Bind Loc.FlowDirection, Mode=OneWay}">

    <Page.Resources>
        <!-- Card Style -->
        <Style x:Key="DashCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="BorderBrush" Value="#E8EAF0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- KPI Label -->
        <Style x:Key="KpiLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#5F6775"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CharacterSpacing" Value="40"/>
        </Style>

        <!-- KPI Value -->
        <Style x:Key="KpiValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1A1D23"/>
        </Style>

        <!-- Section Header -->
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1A1D23"/>
        </Style>

        <!-- Badge Green -->
        <Style x:Key="BadgeGreen" TargetType="Border">
            <Setter Property="Background" Value="#E6F4EA"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,3"/>
        </Style>

        <!-- Badge Red -->
        <Style x:Key="BadgeRed" TargetType="Border">
            <Setter Property="Background" Value="#FCE8E6"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,3"/>
        </Style>

        <!-- Badge Neutral -->
        <Style x:Key="BadgeNeutral" TargetType="Border">
            <Setter Property="Background" Value="#F5F7FA"/>
            <Setter Property="BorderBrush" Value="#D8DEE8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,3"/>
        </Style>

        <LinearGradientBrush x:Key="SkeletonShimmerBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#EEF2F6" Offset="0"/>
            <GradientStop Color="#EEF2F6" Offset="0.18"/>
            <GradientStop Color="#F7F9FB" Offset="0.32"/>
            <GradientStop Color="#EEF2F6" Offset="0.46"/>
            <GradientStop Color="#EEF2F6" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="SkeletonCard" TargetType="Border" BasedOn="{StaticResource DashCard}">
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="SkeletonBlock" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SkeletonShimmerBrush}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Height" Value="12"/>
        </Style>

        <Style x:Key="SkeletonCircle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SkeletonShimmerBrush}"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Width" Value="140"/>
            <Setter Property="Height" Value="140"/>
        </Style>
    </Page.Resources>

    <Grid>
    

    <ScrollViewer x:Name="DashboardScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Visible">
        <Grid Padding="24,20,24,24" RowSpacing="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="Auto"/> <!-- 4 KPI Cards -->
                <RowDefinition Height="Auto"/> <!-- Main Content Row -->
            </Grid.RowDefinitions>

            <!-- ═══════════════════════════════════════════════ -->
            <!--  ROW 0: Header Bar                              -->
            <!-- ═══════════════════════════════════════════════ -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock x:Name="GreetingText"
                               Text="{x:Bind GreetingValue, Mode=OneWay}"
                               FontSize="22" FontWeight="SemiBold"
                               Foreground="#1A1D23"/>
                    <TextBlock Text="{x:Bind ReportsDashboard_Subtitle, Mode=OneWay}"
                               FontSize="13" Foreground="#8F96A3" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border x:Name="StaleTag"
                            Background="#FEF3C7"
                            BorderBrush="#FBBF24"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,5"
                            Visibility="{x:Bind StaleTagVisibility, Mode=OneWay}">
                        <TextBlock x:Uid="ReportsDashboard_Stale_Tag"
                                   FontSize="12"
                                   Foreground="#92400E"
                                   FontWeight="SemiBold"/>
                    </Border>
                    <Border x:Name="TodayDatePill"
                            Background="White"
                            CornerRadius="8"
                            Padding="12,7"
                            BorderBrush="#E8EAF0"
                            BorderThickness="1"
                            MinWidth="132"
                            Tapped="TodayDatePill_Tapped">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <SymbolIcon Symbol="Calendar" Foreground="#8F96A3"/>
                            <TextBlock x:Name="TodayDateText" Text="{x:Bind TodayDateValue, Mode=OneWay}" FontSize="13" Foreground="#1A1D23"/>
                            <FontIcon x:Name="DatePillChevron"
                                      Glyph="&#xE70D;"
                                      FontSize="10"
                                      Foreground="#8F96A3"
                                      Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>
                    <!-- 
                    <Button Background="#1976D2" CornerRadius="8" Padding="12,7" BorderThickness="0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <SymbolIcon Symbol="Repair" Foreground="White"/>
                            <TextBlock Text="Quick Actions" Foreground="White" FontSize="13"/>
                        </StackPanel>
                    </Button>
                    -->
                </StackPanel>
            </Grid>

            <!-- ═══════════════════════════════════════════════ -->
            <!--  ROW 1: 4 KPI Metric Cards                     -->
            <!-- ═══════════════════════════════════════════════ -->
            <Grid Grid.Row="1" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Card 1: Sales Today -->
                <Border Grid.Column="0" Style="{StaticResource DashCard}" Padding="16" Background="White">
                    <Grid>
                        <StackPanel x:Name="SalesTodaySkeleton" Spacing="10" Visibility="Visible">
                            <Border Style="{StaticResource SkeletonBlock}" Width="96" Height="16" HorizontalAlignment="Left"/>
                            <Border Background="#EEF2F6" Height="1"/>
                            <Border Style="{StaticResource SkeletonBlock}" Width="128" Height="28" Margin="0,10,0,0" HorizontalAlignment="Left"/>
                            <Border Style="{StaticResource SkeletonBlock}" Width="84" Height="12" HorizontalAlignment="Left"/>
                            <Border Style="{StaticResource SkeletonBlock}" Height="60" CornerRadius="10" Margin="0,6,0,0"/>
                        </StackPanel>
                        <Grid x:Name="SalesTodayContent" Visibility="Collapsed">
                        <!-- BACKGROUND CHART LAYER -->
                        <Grid Opacity="0.3" Margin="0,0,-10,-10" VerticalAlignment="Bottom" Height="70" CornerRadius="0,0,12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30*"/>
                                <ColumnDefinition Width="70*"/>
                            </Grid.ColumnDefinitions>
                            <lvc:CartesianChart Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0" DrawMargin="{x:Null}"
                                                Background="White"
                                      Series="{x:Bind SalesSparkline}" 
                                      IsHitTestVisible="False">
                                <lvc:CartesianChart.XAxes>
                                    <lvc:AxesCollection>
                                        <lvc:XamlAxis IsVisible="False" MinLimit="0" MaxLimit="7"/>
                                    </lvc:AxesCollection>
                                </lvc:CartesianChart.XAxes>
                                <lvc:CartesianChart.YAxes>
                                    <lvc:AxesCollection>
                                        <lvc:XamlAxis IsVisible="False" MinLimit="0" MinStep="100"/>
                                    </lvc:AxesCollection>
                                </lvc:CartesianChart.YAxes>
                            </lvc:CartesianChart>
                        </Grid>

                        <!-- FOREGROUND TEXT LAYER -->
                        <StackPanel Spacing="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind ReportsDashboard_KPI_SalesToday, Mode=OneWay}" Style="{StaticResource KpiLabel}" TextWrapping="NoWrap"/>
                                <Button Grid.Column="1" Click="InfoIcon_Click" Background="Transparent" BorderThickness="0" Padding="4" VerticalAlignment="Center"
                                        Tag="ReportsDashboard_Tooltip_SalesToday">
                                    <FontIcon Glyph="&#xE946;" FontSize="14" Foreground="#8F96A3"/>
                                </Button>
                            </Grid>
                            <Rectangle Height="1" Fill="#E2E8F0" HorizontalAlignment="Stretch" Margin="0,2,0,2"/>
                            <StackPanel Spacing="4" Margin="0,12,0,4">
                                <TextBlock x:Name="SalesTodayText" Text="{x:Bind SalesTodayValue, Mode=OneWay}" Style="{StaticResource KpiValue}"/>
                                <TextBlock x:Name="SalesDeltaText" Text="{x:Bind SalesDeltaValue, Mode=OneWay}" FontSize="12" FontWeight="Normal" Foreground="#2E7D32" />
                            </StackPanel>
                        </StackPanel>
                    </Grid></Grid>
                </Border>

                <!-- Card 2: Net Profit Today -->
                <Border Grid.Column="1" Style="{StaticResource DashCard}" Padding="16" Background="White">
                    <Grid>
                        <StackPanel x:Name="NetProfitSkeleton" Spacing="10" Visibility="Visible">
                            <Border Style="{StaticResource SkeletonBlock}" Width="118" Height="16" HorizontalAlignment="Left"/>
                            <Border Background="#EEF2F6" Height="1"/>
                            <Border Style="{StaticResource SkeletonBlock}" Width="128" Height="28" Margin="0,10,0,0" HorizontalAlignment="Left"/>
                            <Border Style="{StaticResource SkeletonBlock}" Width="84" Height="12" HorizontalAlignment="Left"/>
                            <Border Style="{StaticResource SkeletonBlock}" Height="60" CornerRadius="10" Margin="0,6,0,0"/>
                        </StackPanel>
                        <Grid x:Name="NetProfitContent" Visibility="Collapsed">
                        <Grid Opacity="0.3" Margin="0,0,-10,-10" VerticalAlignment="Bottom" Height="70" CornerRadius="0,0,12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30*"/>
                                <ColumnDefinition Width="70*"/>
                            </Grid.ColumnDefinitions>
                            <lvc:CartesianChart Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0" DrawMargin="{x:Null}"
                                                Background="White"
                                      Series="{x:Bind ProfitSparkline}" 
                                      IsHitTestVisible="False" 
                                      >
                                <lvc:CartesianChart.XAxes>
                                    <lvc:AxesCollection>
                                        <lvc:XamlAxis IsVisible="False" MinLimit="0" MaxLimit="7"/>
                                    </lvc:AxesCollection>
                                </lvc:CartesianChart.XAxes>
                                <lvc:CartesianChart.YAxes>
                                    <lvc:AxesCollection>
                                        <lvc:XamlAxis IsVisible="False" MinLimit="0" MinStep="100"/>
                                    </lvc:AxesCollection>
                                </lvc:CartesianChart.YAxes>
                            </lvc:CartesianChart>
                        </Grid>

                        <StackPanel Spacing="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind ReportsDashboard_KPI_NetProfit, Mode=OneWay}" Style="{StaticResource KpiLabel}" TextWrapping="NoWrap"/>
                                <Button Grid.Column="1" Click="InfoIcon_Click" Background="Transparent" BorderThickness="0" Padding="4" VerticalAlignment="Center"
                                        Tag="ReportsDashboard_Tooltip_NetProfit">
                                    <FontIcon Glyph="&#xE946;" FontSize="14" Foreground="#8F96A3"/>
                                </Button>
                            </Grid>
                            <Rectangle Height="1" Fill="#E2E8F0" HorizontalAlignment="Stretch" Margin="0,2,0,2"/>

                            <StackPanel Spacing="4" Margin="0,12,0,4">
                                <TextBlock x:Name="NetProfitText" Text="{x:Bind NetProfitValue, Mode=OneWay}" Style="{StaticResource KpiValue}"/>
                                <TextBlock x:Name="ProfitDeltaText" Text="{x:Bind ProfitDeltaValue, Mode=OneWay}" FontSize="12" FontWeight="Normal" Foreground="#2E7D32" />
                            </StackPanel>
                        </StackPanel>
                    </Grid></Grid>
                </Border>

                <!-- Card 3: Invoice Count -->
                <Border Grid.Column="2" Style="{StaticResource DashCard}" Padding="16" Background="White">
                    <Grid>
                        <StackPanel x:Name="InvoiceCountSkeleton" Spacing="10" Visibility="Visible">
                            <Border Style="{StaticResource SkeletonBlock}" Width="110" Height="16" HorizontalAlignment="Left"/>
                            <Border Background="#EEF2F6" Height="1"/>
                            <Border Style="{StaticResource SkeletonBlock}" Width="128" Height="28" Margin="0,10,0,0" HorizontalAlignment="Left"/>
                            <Border Style="{StaticResource SkeletonBlock}" Width="84" Height="12" HorizontalAlignment="Left"/>
                            <Border Style="{StaticResource SkeletonBlock}" Height="60" CornerRadius="10" Margin="0,6,0,0"/>
                        </StackPanel>
                        <Grid x:Name="InvoiceCountContent" Visibility="Collapsed">
                        <Grid Opacity="0.3" Margin="0,0,-10,-10" VerticalAlignment="Bottom" Height="70" CornerRadius="0,0,12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30*"/>
                                <ColumnDefinition Width="70*"/>
                            </Grid.ColumnDefinitions>
                            <lvc:CartesianChart Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0" DrawMargin="{x:Null}"
                                                Background="White"
                                      Series="{x:Bind InvoiceSparkline}" 
                                      IsHitTestVisible="False" 
                                      >
                                <lvc:CartesianChart.XAxes>
                                    <lvc:AxesCollection>
                                        <lvc:XamlAxis IsVisible="False" MinLimit="0" MaxLimit="7"/>
                                    </lvc:AxesCollection>
                                </lvc:CartesianChart.XAxes>
                                <lvc:CartesianChart.YAxes>
                                    <lvc:AxesCollection>
                                        <lvc:XamlAxis IsVisible="False" MinLimit="0" MinStep="100"/>
                                    </lvc:AxesCollection>
                                </lvc:CartesianChart.YAxes>
                            </lvc:CartesianChart>
                        </Grid>

                        <StackPanel Spacing="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind ReportsDashboard_KPI_InvoiceCount, Mode=OneWay}" Style="{StaticResource KpiLabel}" TextWrapping="NoWrap"/>
                                <Button Grid.Column="1" Click="InfoIcon_Click" Background="Transparent" BorderThickness="0" Padding="4" VerticalAlignment="Center"
                                        Tag="ReportsDashboard_Tooltip_InvoiceCount">
                                    <FontIcon Glyph="&#xE946;" FontSize="14" Foreground="#8F96A3"/>
                                </Button>
                            </Grid>
                            <Rectangle Height="1" Fill="#E2E8F0" HorizontalAlignment="Stretch" Margin="0,2,0,2"/>

                            <StackPanel Spacing="4" Margin="0,12,0,4">
                                <TextBlock x:Name="InvoiceCountText" Text="{x:Bind InvoiceCountValue, Mode=OneWay}" Style="{StaticResource KpiValue}"/>
                                <TextBlock x:Name="InvoiceDeltaText" Text="{x:Bind InvoiceDeltaValue, Mode=OneWay}" FontSize="12" FontWeight="Normal" Foreground="#2E7D32" />
                            </StackPanel>
                        </StackPanel>
                    </Grid></Grid>
                </Border>

                <!-- Card 4: Avg Invoice Value -->
                <Border Grid.Column="3" Style="{StaticResource DashCard}" Padding="16" Background="White">
                    <Grid>
                        <StackPanel x:Name="AvgInvoiceSkeleton" Spacing="10" Visibility="Visible">
                            <Border Style="{StaticResource SkeletonBlock}" Width="130" Height="16" HorizontalAlignment="Left"/>
                            <Border Background="#EEF2F6" Height="1"/>
                            <Border Style="{StaticResource SkeletonBlock}" Width="128" Height="28" Margin="0,10,0,0" HorizontalAlignment="Left"/>
                            <Border Style="{StaticResource SkeletonBlock}" Width="84" Height="12" HorizontalAlignment="Left"/>
                            <Border Style="{StaticResource SkeletonBlock}" Height="60" CornerRadius="10" Margin="0,6,0,0"/>
                        </StackPanel>
                        <Grid x:Name="AvgInvoiceContent" Visibility="Collapsed">
                        <Grid Opacity="0.3" Margin="0,0,-10,-10" VerticalAlignment="Bottom" Height="70" CornerRadius="0,0,12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30*"/>
                                <ColumnDefinition Width="70*"/>
                            </Grid.ColumnDefinitions>
                            <lvc:CartesianChart Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0" DrawMargin="{x:Null}"
                                                Background="White"
                                      Series="{x:Bind AvgInvoiceSparkline}" 
                                      IsHitTestVisible="False" 
                                      >
                                <lvc:CartesianChart.XAxes>
                                    <lvc:AxesCollection>
                                        <lvc:XamlAxis IsVisible="False" MinLimit="0" MaxLimit="7"/>
                                    </lvc:AxesCollection>
                                </lvc:CartesianChart.XAxes>
                                <lvc:CartesianChart.YAxes>
                                    <lvc:AxesCollection>
                                        <lvc:XamlAxis IsVisible="False" MinLimit="0" MinStep="100"/>
                                    </lvc:AxesCollection>
                                </lvc:CartesianChart.YAxes>
                            </lvc:CartesianChart>
                        </Grid>

                        <StackPanel Spacing="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind ReportsDashboard_KPI_AvgInvoiceValue, Mode=OneWay}" Style="{StaticResource KpiLabel}" TextWrapping="NoWrap"/>
                                <Button Grid.Column="1" Click="InfoIcon_Click" Background="Transparent" BorderThickness="0" Padding="4" VerticalAlignment="Center"
                                        Tag="ReportsDashboard_Tooltip_AvgInvoiceValue">
                                    <FontIcon Glyph="&#xE946;" FontSize="14" Foreground="#8F96A3"/>
                                </Button>
                            </Grid>
                            <Rectangle Height="1" Fill="#E2E8F0" HorizontalAlignment="Stretch" Margin="0,2,0,2"/>

                            <StackPanel Spacing="4" Margin="0,12,0,4">
                                <TextBlock x:Name="AvgInvoiceText" Text="{x:Bind AvgInvoiceValue, Mode=OneWay}" Style="{StaticResource KpiValue}"/>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Spacing="6">
                                    <TextBlock Text="{x:Bind AvgInvoiceSubLabel, Mode=OneWay}"
                                               FontSize="12"
                                               FontWeight="Normal"
                                               Foreground="#8F96A3" />
                                    <TextBlock x:Name="MedianText"
                                               Text="{x:Bind MedianValue, Mode=OneWay}"
                                               FontSize="12"
                                               FontWeight="Normal"
                                               Foreground="#8F96A3" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Grid></Grid>
                </Border>
            </Grid>

            <!-- ═══════════════════════════════════════════════ -->
            <!--  ROW 2: Middle Cards (Sales vs Target | Top Products | Discounts + Stock Health) -->
            <!-- ═══════════════════════════════════════════════ -->
            <Grid Grid.Row="2" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="280"/>
                </Grid.ColumnDefinitions>

                <!-- Column 0: Sales vs Target + Critical Alerts -->
                <Grid Grid.Column="0" RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Sales vs Target Card -->
                    <Border Grid.Row="0" Style="{StaticResource DashCard}" Background="White">
                        <Grid RowSpacing="14">
                        <StackPanel x:Name="SalesTargetSkeleton" Spacing="12" Visibility="Visible">
                            <Border Style="{StaticResource SkeletonBlock}" Width="140" Height="16" HorizontalAlignment="Left"/>
                            <Border Style="{StaticResource SkeletonBlock}" Height="24" CornerRadius="8"/>
                            <Border Style="{StaticResource SkeletonBlock}" Width="200" Height="12" HorizontalAlignment="Left"/>
                        </StackPanel>
                        <Grid x:Name="SalesTargetContent" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind ReportsDashboard_Target_Title, Mode=OneWay}" Style="{StaticResource CardTitle}"/>
                                <TextBlock x:Name="SalesAchievedPctText" Text="{x:Bind SalesAchievedPctValue, Mode=OneWay}" Grid.Column="1" FontSize="18" FontWeight="Bold" Foreground="#1976D2" VerticalAlignment="Center" Margin="12,0"/>
                                <Button Grid.Column="2" Click="InfoIcon_Click" Background="Transparent" BorderThickness="0" Padding="4" VerticalAlignment="Center"
                                        Tag="ReportsDashboard_Tooltip_SalesTarget">
                                    <FontIcon Glyph="&#xE946;" FontSize="14" Foreground="#8F96A3"/>
                                </Button>
                            </Grid>

                            <!-- Today vs Target Row -->
                            <Grid Grid.Row="1" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="{x:Bind ReportsDashboard_Target_TodayLabel, Mode=OneWay}" FontSize="10" FontWeight="Bold" Foreground="#8F96A3" Margin="0,0,0,2"/>
                                    <TextBlock x:Name="CurrentSalesText" Text="{x:Bind CurrentSalesValue, Mode=OneWay}" FontSize="20" FontWeight="Bold" Foreground="#1A1D23"/>
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Right">
                                    <TextBlock Text="{x:Bind ReportsDashboard_Target_GoalLabel, Mode=OneWay}" FontSize="10" FontWeight="Bold" Foreground="#8F96A3" Margin="0,0,0,2" HorizontalAlignment="Right"/>
                                    <TextBlock x:Name="TargetText" Text="{x:Bind TargetValueText, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" Foreground="#8F96A3" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>

                            <!-- Progress bar row -->
                            <Grid Grid.Row="2" Height="14" x:Name="SalesBarContainer" Margin="0,4,0,12">
                                <Border Background="#F1F5F9" CornerRadius="7"/>
                                <Border x:Name="YesterdayBar" Background="#E2E8F0" CornerRadius="7" HorizontalAlignment="Left" Width="0"/>
                                <Grid x:Name="TodayBar" HorizontalAlignment="Left" Width="0">
                                    <Border Background="#1976D2" CornerRadius="7"/>
                                </Grid>
                            </Grid>


                             <TextBlock Grid.Row="3" x:Name="TargetSubText" Text="{x:Bind TargetSubValue, Mode=OneWay}" FontSize="11" Foreground="#8F96A3"/>
                        </Grid></Grid>
                    </Border>

                    <!-- Critical Alerts -->
                    <Border Grid.Row="1" Style="{StaticResource DashCard}" Background="White">
                        <Grid RowSpacing="14">
                        <StackPanel x:Name="CrAlertsSkeleton" Spacing="12" Visibility="Visible">
                            <Border Style="{StaticResource SkeletonBlock}" Width="140" Height="16" HorizontalAlignment="Left"/>
                            <Border Style="{StaticResource SkeletonBlock}" Height="24" CornerRadius="8"/>
                            <Border Style="{StaticResource SkeletonBlock}" Width="200" Height="12" HorizontalAlignment="Left"/>
                        </StackPanel>
                        <Grid x:Name="CrAlertsContent" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#FCE8E6" CornerRadius="4" Padding="4" Margin="0,0,8,0">
                                    <SymbolIcon Symbol="Important" Foreground="#E53935"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{x:Bind ReportsDashboard_Alerts_Title, Mode=OneWay}" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                                <Button Grid.Column="2" Click="InfoIcon_Click" Background="Transparent" BorderThickness="0" Padding="4" VerticalAlignment="Center"
                                        Tag="ReportsDashboard_Tooltip_CriticalAlerts">
                                    <FontIcon Glyph="&#xE946;" FontSize="14" Foreground="#8F96A3"/>
                                </Button>
                            </Grid>

                            <ItemsControl Grid.Row="1" Grid.RowSpan="2" x:Name="CriticalAlertsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:DashboardAlertItem">
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Name}"
                                                       FontSize="13"
                                                       Foreground="#1A1D23"
                                                       VerticalAlignment="Center"/>
                                            <Border Grid.Column="1"
                                                    Background="{x:Bind BadgeBackground}"
                                                    CornerRadius="6"
                                                    Padding="8,3">
                                                <TextBlock Text="{x:Bind CountText}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{x:Bind BadgeForeground}"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid></Grid>
                    </Border>

                </Grid>
                <!-- Column 1: Top Selling Products + Low Stock -->
                <Grid Grid.Column="1" RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Top Selling Products Card -->
                    <Border Grid.Row="0" Style="{StaticResource DashCard}" Background="White">
                        <Grid RowSpacing="12">
                        <StackPanel x:Name="TopProdSkeleton" Spacing="12" Visibility="Visible">
                            <Border Style="{StaticResource SkeletonBlock}" Width="140" Height="16" HorizontalAlignment="Left"/>
                            <Border Style="{StaticResource SkeletonBlock}" Height="24" CornerRadius="8"/>
                            <Border Style="{StaticResource SkeletonBlock}" Width="200" Height="12" HorizontalAlignment="Left"/>
                        </StackPanel>
                        <Grid x:Name="TopProdContent" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind ReportsDashboard_TopProducts_Title, Mode=OneWay}" Style="{StaticResource CardTitle}"/>
                                <Button Grid.Column="1" Click="InfoIcon_Click" Background="Transparent" BorderThickness="0" Padding="4" VerticalAlignment="Center"
                                        Tag="ReportsDashboard_Tooltip_TopProducts">
                                    <FontIcon Glyph="&#xE946;" FontSize="14" Foreground="#8F96A3"/>
                                </Button>
                            </Grid>

                            <ItemsControl Grid.Row="1" x:Name="TopProductsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:DashboardProductItem">
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{x:Bind Name}" FontSize="13" Foreground="#1A1D23"/>
                                                <ProgressBar Value="{x:Bind Pct}" Minimum="0" Maximum="100"
                                                             Height="5" CornerRadius="3" Margin="0,4,0,0"
                                                             Background="#E8EAF0" Foreground="#1976D2"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{x:Bind Revenue}" FontSize="13"
                                                       FontWeight="SemiBold" Foreground="#1A1D23"
                                                       VerticalAlignment="Center" Margin="12,0,0,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid></Grid>
                    </Border>

                    <!-- Low Stock / Out of Stock -->
                    <Border Grid.Row="1" Style="{StaticResource DashCard}" Background="White">
                        <Grid RowSpacing="12">
                        <StackPanel x:Name="LowStockSkeleton" Spacing="12" Visibility="Visible">
                            <Border Style="{StaticResource SkeletonBlock}" Width="140" Height="16" HorizontalAlignment="Left"/>
                            <Border Style="{StaticResource SkeletonBlock}" Height="24" CornerRadius="8"/>
                            <Border Style="{StaticResource SkeletonBlock}" Width="200" Height="12" HorizontalAlignment="Left"/>
                        </StackPanel>
                        <Grid x:Name="LowStockContent" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind ReportsDashboard_StockStatus_Title, Mode=OneWay}" Style="{StaticResource CardTitle}"/>
                                <Button Grid.Column="1" Click="InfoIcon_Click" Background="Transparent" BorderThickness="0" Padding="4" VerticalAlignment="Center"
                                        Tag="ReportsDashboard_Tooltip_StockStatus">
                                    <FontIcon Glyph="&#xE946;" FontSize="14" Foreground="#8F96A3"/>
                                </Button>
                            </Grid>

                            <ItemsControl Grid.Row="1" x:Name="LowStockList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:DashboardStockItem">
                                        <Border BorderBrush="#F1F4F9"
                                                BorderThickness="0,0,0,1"
                                                Padding="0,10,0,10">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Leading severity dot: instant visual scan of which items need attention -->
                                                <Ellipse Grid.Column="0"
                                                         Width="8"
                                                         Height="8"
                                                         Fill="{x:Bind StatusBrush}"
                                                         VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{x:Bind Name}"
                                                           FontSize="13"
                                                           Foreground="#1A1D23"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"/>
                                                <Grid Grid.Column="2" Margin="0,0,8,0" VerticalAlignment="Center" Visibility="{x:Bind SimpleStatusVisibility}">
                                                    <TextBlock Text="{x:Bind StockStatus}" FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{x:Bind StatusBrush}"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                                <Border Grid.Column="3" Style="{StaticResource BadgeNeutral}" Visibility="{x:Bind BadgeVisible}">
                                                    <Grid>
                                                        <TextBlock Text="{x:Bind BadgeText}"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#5F6775"
                                                                   Visibility="{x:Bind SimpleBadgeTextVisibility}"/>
                                                        <StackPanel Orientation="Horizontal"
                                                                    Spacing="2"
                                                                    Visibility="{x:Bind DetailedStatusVisibility}"
                                                                    VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Bind PrimaryLabelText}" FontSize="11" FontWeight="SemiBold" Foreground="#5F6775" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{x:Bind PrimaryStatusText}" FontSize="11" FontWeight="SemiBold" Foreground="{x:Bind PrimaryStatusBrush}" VerticalAlignment="Center"/>
                                                            <TextBlock Text="|" FontSize="11" FontWeight="SemiBold" Foreground="#8F96A3" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{x:Bind SecondaryLabelText}" FontSize="11" FontWeight="SemiBold" Foreground="#5F6775" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{x:Bind SecondaryStatusText}" FontSize="11" FontWeight="SemiBold" Foreground="{x:Bind SecondaryStatusBrush}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid></Grid>
                    </Border>

                </Grid>

                <!-- Right Column: Discounts + Stock Health -->
                <StackPanel Grid.Column="2" Spacing="16">

                    <!-- Discounts Today -->
                    <Border Style="{StaticResource DashCard}" Background="White">
                        <Grid RowSpacing="6">
                        <StackPanel x:Name="DiscountsSkeleton" Spacing="12" Visibility="Visible">
                            <Border Style="{StaticResource SkeletonBlock}" Width="140" Height="16" HorizontalAlignment="Left"/>
                            <Border Style="{StaticResource SkeletonBlock}" Height="24" CornerRadius="8"/>
                            <Border Style="{StaticResource SkeletonBlock}" Width="200" Height="12" HorizontalAlignment="Left"/>
                        </StackPanel>
                        <Grid x:Name="DiscountsContent" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind ReportsDashboard_Discounts_Title, Mode=OneWay}" Style="{StaticResource KpiLabel}"/>
                                <Button Grid.Column="1" Click="InfoIcon_Click" Background="Transparent" BorderThickness="0" Padding="4" VerticalAlignment="Center"
                                        Tag="ReportsDashboard_Tooltip_Discounts">
                                    <FontIcon Glyph="&#xE946;" FontSize="14" Foreground="#8F96A3"/>
                                </Button>
                            </Grid>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="DiscountsTotalText" Style="{StaticResource KpiValue}"/>
                                <Border Grid.Column="1" Style="{StaticResource BadgeNeutral}" VerticalAlignment="Center">
                                    <TextBlock x:Name="DiscountsDeltaText" FontSize="11" FontWeight="SemiBold" Foreground="#5F6775"/>
                                </Border>
                            </Grid>
                            <TextBlock Grid.Row="2" x:Name="DiscountsCountText" FontSize="11" Foreground="#8F96A3"/>
                        </Grid></Grid>
                    </Border>

                    <!-- Stock Health Donut -->
                    <Border Style="{StaticResource DashCard}" Background="White">
                        <Grid RowSpacing="12">
                        <StackPanel x:Name="StockHealthSkeleton" Spacing="12" Visibility="Visible">
                            <Border Style="{StaticResource SkeletonBlock}" Width="140" Height="16" HorizontalAlignment="Left"/>
                            <Border Style="{StaticResource SkeletonBlock}" Height="24" CornerRadius="8"/>
                            <Border Style="{StaticResource SkeletonBlock}" Width="200" Height="12" HorizontalAlignment="Left"/>
                        </StackPanel>
                        <Grid x:Name="StockHealthContent" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind ReportsDashboard_StockHealth_Title, Mode=OneWay}" Style="{StaticResource CardTitle}"/>
                                <Button Grid.Column="1" Click="InfoIcon_Click" Background="Transparent" BorderThickness="0" Padding="4" VerticalAlignment="Center"
                                        Tag="ReportsDashboard_Tooltip_StockHealth">
                                    <FontIcon Glyph="&#xE946;" FontSize="14" Foreground="#8F96A3"/>
                                </Button>
                            </Grid>

                            <!-- Donut drawn in code-behind via Path+ArcSegment -->
                            <Grid Grid.Row="1" HorizontalAlignment="Center">
                                <Canvas x:Name="StockHealthCanvas" Width="140" Height="140"/>
                                <!-- Center label overlaid on canvas -->
                                <TextBlock x:Name="DonutCenterText"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           TextAlignment="Center"
                                           Text="{x:Bind DonutCenterValue, Mode=OneWay}"
                                           FontSize="16" FontWeight="SemiBold"
                                           Foreground="#1A1D23"/>

                            </Grid>

                            <!-- Legend -->
                            <StackPanel Grid.Row="3" Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Ellipse Width="10" Height="10" Fill="#1976D2" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="HealthyLegendText" Text="{x:Bind HealthyLegendValue, Mode=OneWay}" FontSize="12" Foreground="#1A1D23"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Ellipse Width="10" Height="10" Fill="#F9A825" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="LowStockLegendText" Text="{x:Bind LowStockLegendValue, Mode=OneWay}" FontSize="12" Foreground="#1A1D23"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Ellipse Width="10" Height="10" Fill="#E53935" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="OutOfStockLegendText" Text="{x:Bind OutOfStockLegendValue, Mode=OneWay}" FontSize="12" Foreground="#1A1D23"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid></Grid>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ═══════════════════════════════════════════════ -->
            <!--  (Row 3 removed - was empty)                    -->
            <!-- ═══════════════════════════════════════════════ -->
        </Grid>
    </ScrollViewer>



        <TeachingTip x:Name="CardInfoTip"
                     Title="{x:Bind ReportsDashboard_TeachingTip_Title, Mode=OneWay}"
                     CloseButtonContent="{x:Bind Generic_Close, Mode=OneWay}"
                     PreferredPlacement="Right"
                     IsLightDismissEnabled="True">
            <TeachingTip.Resources>
                <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>
            </TeachingTip.Resources>
        </TeachingTip>

    </Grid>
</Page>
