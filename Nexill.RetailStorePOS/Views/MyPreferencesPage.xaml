<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="RetailStorePOS.WinUiLogin.Views.MyPreferencesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RetailStorePOS.WinUiLogin.Views"
    xmlns:common="using:RetailStorePOS.WinUiLogin.Common"
    Background="Transparent">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Section Header -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Text="My Preferences" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="SemiBold"/>
                <TextBlock Text="These settings apply only to your login and are designed for faster checkout." 
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="24">
                
                <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="20">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Quick-Cash Buttons" FontWeight="SemiBold" FontSize="16"/>
                        <TextBlock Text="Set the cash shortcuts shown on the checkout screen. Auto-saves directly." Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,-12,0,0"/>
                        
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <NumberBox
                                       Grid.Column="0"
                                       Header="Value 1"
                                       Value="{x:Bind ViewModel.QuickCash1Value, Mode=TwoWay}"
                                       Minimum="0"
                                       SmallChange="1"
                                       AcceptsExpression="False"
                                       SpinButtonPlacementMode="Hidden"
                                       CornerRadius="4"
                                       common:NumericInputNormalization.NormalizeOnLostFocus="True"/>
                            <NumberBox Grid.Column="1" Header="Value 2" Value="{x:Bind ViewModel.QuickCash2Value, Mode=TwoWay}" Minimum="0" SmallChange="1" AcceptsExpression="False" SpinButtonPlacementMode="Hidden" CornerRadius="4" common:NumericInputNormalization.NormalizeOnLostFocus="True" />
                            <NumberBox Grid.Column="2" Header="Value 3" Value="{x:Bind ViewModel.QuickCash3Value, Mode=TwoWay}" Minimum="0" SmallChange="1" AcceptsExpression="False" SpinButtonPlacementMode="Hidden" CornerRadius="4" common:NumericInputNormalization.NormalizeOnLostFocus="True" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Status readout -->
                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" 
                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" 
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
