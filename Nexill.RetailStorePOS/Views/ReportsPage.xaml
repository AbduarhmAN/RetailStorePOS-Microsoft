<Page
    x:Name="ReportsPageRoot"
    x:Class="RetailStorePOS.WinUiLogin.Views.ReportsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:RetailStorePOS.Data.Models"
    xmlns:views="using:RetailStorePOS.WinUiLogin.Views"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="24" RowSpacing="{x:Bind ViewModel.PageRowSpacing, Mode=OneWay}" ColumnSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="16"
                Visibility="{x:Bind ViewModel.ReportChromeVisibility, Mode=OneWay}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
         
                    <StackPanel>
                        <TextBlock Text="Reports" Style="{StaticResource TitleTextBlockStyle}" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock Text="Sales totals and transaction history" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button CornerRadius="3" Command="{x:Bind ViewModel.OpenReceiptFolderCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <SymbolIcon Symbol="Folder" />
                            <TextBlock Text="Receipts Folder" />
                        </StackPanel>
                    </Button>
                    <Button  CornerRadius="3" Command="{x:Bind ViewModel.RefreshCommand}" Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <SymbolIcon Symbol="Refresh" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                            <TextBlock Text="Refresh" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Filters Layer -->
        <Border Grid.Row="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="16"
                Visibility="{x:Bind ViewModel.ReportChromeVisibility, Mode=OneWay}">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Quick Range" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ToggleButton Content="Today" IsChecked="{x:Bind ViewModel.IsTodayPreset, Mode=OneWay}" Command="{x:Bind ViewModel.SetTodayRangeCommand}" CornerRadius="3"/>
                        <ToggleButton Content="7 Days" IsChecked="{x:Bind ViewModel.IsLast7DaysPreset, Mode=OneWay}" Command="{x:Bind ViewModel.SetLast7DaysRangeCommand}" CornerRadius="3"/>
                        <ToggleButton Content="30 Days" IsChecked="{x:Bind ViewModel.IsLast30DaysPreset, Mode=OneWay}" Command="{x:Bind ViewModel.SetLast30DaysRangeCommand}" CornerRadius="3"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="From" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" />
                    <CalendarDatePicker Date="{x:Bind ViewModel.FromDate, Mode=TwoWay}" CornerRadius="3" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="To" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" />
                    <CalendarDatePicker Date="{x:Bind ViewModel.ToDate, Mode=TwoWay}" CornerRadius="3"/>
                </StackPanel>

                <StackPanel Grid.Column="3">
                    <TextBlock Text="Search (Receipt, Size, Cash, Time)" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,8" />
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox CornerRadius="3" Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Search transactions..." />
                        <Button Grid.Column="1" CornerRadius="3" Command="{x:Bind ViewModel.ClearSearchCommand}" ToolTipService.ToolTip="Clear Search">
                            <SymbolIcon Symbol="Clear" />
                        </Button>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- KPI Metrics Layer -->
        <Grid Grid.Row="2" ColumnSpacing="16" Visibility="{x:Bind ViewModel.ReportChromeVisibility, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
                 <StackPanel Spacing="4">
                     <TextBlock Text="Total Sales" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                     <TextBlock Text="{x:Bind ViewModel.TotalSalesText, Mode=OneWay}" FontSize="24" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                 </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="06" Padding="16">
                 <StackPanel Spacing="4">
                     <TextBlock Text="Net Sales" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                     <TextBlock Text="{x:Bind ViewModel.NetSalesText, Mode=OneWay}" FontSize="24" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                 </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="06" Padding="16">
                 <StackPanel Spacing="4">
                     <TextBlock Text="Tax Collected" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                     <TextBlock Text="{x:Bind ViewModel.TaxCollectedText, Mode=OneWay}" FontSize="24" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                 </StackPanel>
            </Border>

            <Border Grid.Column="3" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
                 <StackPanel Spacing="4">
                     <TextBlock Text="Avg Sale" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                     <TextBlock Text="{x:Bind ViewModel.AverageSaleText, Mode=OneWay}" FontSize="24" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                 </StackPanel>
            </Border>

            <Border Grid.Column="4" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
                 <StackPanel Spacing="4">
                     <TextBlock Text="Transactions" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                     <TextBlock Text="{x:Bind ViewModel.TransactionsCount, Mode=OneWay}" FontSize="24" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                 </StackPanel>
            </Border>
        </Grid>

        <!-- Transaction Grid -->
        <Border Grid.Row="3" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Padding="16,14,16,14" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="{x:Bind ViewModel.RangeLabel, Mode=OneWay}" FontWeight="SemiBold" FontSize="16" />
                        <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Text="{x:Bind ViewModel.VisibleTransactionsCount, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />
                    <AppBarButton Grid.Column="2"
                                  Command="{x:Bind ViewModel.ToggleTransactionsViewCommand, Mode=OneWay}"
                                  ToolTipService.ToolTip="{x:Bind ViewModel.TransactionToggleTooltip, Mode=OneWay}"
                                  VerticalAlignment="Center">
                        <AppBarButton.Icon>
                            <SymbolIcon Symbol="{x:Bind ViewModel.TransactionToggleSymbol, Mode=OneWay}" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                </Grid>

                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Sales, Mode=OneWay}" SelectionMode="None" ShowsScrollingPlaceholders="False">
                    <ListView.Header>
                        <Grid Padding="16,12" Background="{ThemeResource LayerFillColorAltBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Receipt #" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Date" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="Time" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="Type" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="Subtotal" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="5" Text="Tax" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="6" Text="Total" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Left" Padding="15,0,0,0" />
                            <TextBlock Grid.Column="7" Text="Action" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                        </Grid>
                    </ListView.Header>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Sale">
                            <Grid Padding="16,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind ReceiptNumber}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{x:Bind views:ReportsPage.FormatDate(CreatedAt)}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{x:Bind views:ReportsPage.FormatTime(CreatedAt)}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{x:Bind PaymentType}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="4" Text="{x:Bind views:ReportsPage.FormatCurrency(Subtotal)}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="5" Text="{x:Bind views:ReportsPage.FormatCurrency(Tax)}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="6" Text="{x:Bind views:ReportsPage.FormatCurrency(Total)}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Left" Padding="15,0,0,0" />
                                <Button Grid.Column="7" HorizontalAlignment="Center" CornerRadius="3"
                                        Command="{Binding ElementName=ReportsPageRoot, Path=ViewModel.ReprintReceiptCommand}" 
                                        CommandParameter="{x:Bind}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <SymbolIcon Symbol="Print" />
                                        <TextBlock Text="Reprint" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{x:Bind ViewModel.EmptyStateVisibility, Mode=OneWay}" Spacing="8">
                    <SymbolIcon Symbol="Find" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="No transactions found" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="Try a different date range or search term." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Page>


