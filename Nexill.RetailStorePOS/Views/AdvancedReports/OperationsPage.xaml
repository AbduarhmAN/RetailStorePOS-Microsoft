<Page
    x:Class="RetailStorePOS.WinUiLogin.Views.AdvancedReports.OperationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:components="using:RetailStorePOS.WinUiLogin.Views.Components"
    xmlns:local="using:RetailStorePOS.WinUiLogin.Views.AdvancedReports"
    mc:Ignorable="d"
    Background="White">

    <Page.Resources>
        <Style x:Key="OP_Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="BorderBrush" Value="#E8EAF0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="OP_CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1A1D23"/>
        </Style>

        <Style x:Key="OP_HeaderCell" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#454443"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="OP_BodyCell" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#1A1D23"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="OP_FilterShell" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E8EAF0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="MinHeight" Value="52"/>
        </Style>

        <Style x:Key="OP_FilterLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CharacterSpacing" Value="40"/>
            <Setter Property="Foreground" Value="#5F6775"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="OP_FilterDivider" TargetType="Border">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Background" Value="#E8EAF0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="OP_FilterComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,2,8,2"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#1A1D23"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Padding="24,20,24,24" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header: title + Pro badge + reporting filters -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock x:Uid="Operations_Title"
                               FontSize="22" FontWeight="SemiBold" Foreground="#1A1D23"/>
                    <Border Background="#EEE9FE" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                        <TextBlock x:Uid="Operations_ProBadge" FontSize="11" FontWeight="SemiBold" Foreground="#6D28D9"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="10"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Border Style="{StaticResource OP_FilterShell}">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock x:Uid="Operations_OperatorFilter_Label"
                                       Style="{StaticResource OP_FilterLabel}"/>
                            <Border Style="{StaticResource OP_FilterDivider}"/>
                            <ComboBox x:Name="OperatorFilter"
                                      Width="180"
                                      Style="{StaticResource OP_FilterComboBox}"
                                      ItemsSource="{x:Bind OperatorOptions, Mode=OneWay}"
                                      SelectedItem="{x:Bind SelectedOperator, Mode=TwoWay}"
                                      MaxDropDownHeight="320"
                                      AutomationProperties.Name="Operator filter">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="local:OperatorFilterOption">
                                        <Grid MinWidth="160" Padding="2,4">
                                            <TextBlock Text="{x:Bind DisplayName}"
                                                       FontSize="13"
                                                       Foreground="#1A1D23"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Border>
                    <components:PeriodFilterControl x:Name="PeriodFilter"/>
                </StackPanel>
            </Grid>

            <!-- Heatmap card -->
            <Border Grid.Row="1" Style="{StaticResource OP_Card}">
                <StackPanel Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock x:Uid="Operations_Heatmap_Title" Style="{StaticResource OP_CardTitle}"/>
                            <TextBlock x:Uid="Operations_Heatmap_Subtitle"
                                       FontSize="12" Foreground="#8F96A3"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock x:Uid="Operations_Heatmap_Legend_Less" FontSize="11" Foreground="#8F96A3" VerticalAlignment="Center"/>
                            <Border Width="14" Height="14" CornerRadius="3" Background="#F5F3FF"/>
                            <Border Width="14" Height="14" CornerRadius="3" Background="#DDD6FE"/>
                            <Border Width="14" Height="14" CornerRadius="3" Background="#A78BFA"/>
                            <Border Width="14" Height="14" CornerRadius="3" Background="#7C3AED"/>
                            <Border Width="14" Height="14" CornerRadius="3" Background="#5B21B6"/>
                            <TextBlock x:Uid="Operations_Heatmap_Legend_More" FontSize="11" Foreground="#8F96A3" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="HeatmapHost"/>
                </StackPanel>
            </Border>

            <!-- Cashier table card -->
            <Border Grid.Row="2" Style="{StaticResource OP_Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Padding="20,16">
                        <TextBlock x:Uid="Operations_Cashier_Title" Style="{StaticResource OP_CardTitle}"/>
                    </Grid>

                    <Grid Grid.Row="1" Padding="20,8" BorderBrush="#E8EAF0" BorderThickness="0,1,0,1" Background="#FAFBFC">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Uid="Operations_Cashier_Header_Cashier" Style="{StaticResource OP_HeaderCell}"/>
                        <TextBlock Grid.Column="1" x:Uid="Operations_Cashier_Header_Sales" Style="{StaticResource OP_HeaderCell}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="2" x:Uid="Operations_Cashier_Header_Revenue" Style="{StaticResource OP_HeaderCell}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="3" x:Uid="Operations_Cashier_Header_AvgTicket" Style="{StaticResource OP_HeaderCell}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="4" x:Uid="ProductPerformance_Header_Units" Style="{StaticResource OP_HeaderCell}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="5" x:Uid="Operations_Cashier_Header_Items" Style="{StaticResource OP_HeaderCell}" HorizontalAlignment="Right"/>
                    </Grid>

                    <ListView Grid.Row="2"
                              ItemsSource="{x:Bind CashierRows, Mode=OneWay}"
                              SelectionMode="None"
                              IsItemClickEnabled="False"
                              ShowsScrollingPlaceholders="True"
                              ScrollViewer.HorizontalScrollMode="Disabled">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="MinHeight" Value="0"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:CashierDisplayItem">
                                <Grid Padding="20,10" BorderBrush="#F1F4F9" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind CashierName}" FontSize="13" FontWeight="SemiBold" Foreground="#1A1D23" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind SalesText}" Style="{StaticResource OP_BodyCell}" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="2" Text="{x:Bind RevenueText}" Style="{StaticResource OP_BodyCell}" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="3" Text="{x:Bind AverageTicketText}" Style="{StaticResource OP_BodyCell}" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="4" Text="{x:Bind UnitsText}" Style="{StaticResource OP_BodyCell}" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="5" Text="{x:Bind ItemsPerTicketText}" Style="{StaticResource OP_BodyCell}" HorizontalAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock Grid.Row="2"
                               x:Uid="Operations_Cashier_Empty"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="0,40,0,40"
                               Foreground="#8F96A3"
                               FontSize="13"
                               Visibility="{x:Bind EmptyCashierVisibility, Mode=OneWay}"/>
                </Grid>
            </Border>

            <!-- Status -->
            <TextBlock Grid.Row="3"
                       Text="{x:Bind StatusText, Mode=OneWay}"
                       FontSize="12"
                       Foreground="#8F96A3"/>
        </Grid>
    </ScrollViewer>
</Page>
