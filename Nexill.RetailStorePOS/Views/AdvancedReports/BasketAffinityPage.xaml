<Page
    x:Class="RetailStorePOS.WinUiLogin.Views.AdvancedReports.BasketAffinityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:components="using:RetailStorePOS.WinUiLogin.Views.Components"
    xmlns:local="using:RetailStorePOS.WinUiLogin.Views.AdvancedReports"
    mc:Ignorable="d"
    Background="White">

    <Page.Resources>
        <Style x:Key="BA_Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderBrush" Value="#E8EAF0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="BA_HeaderCell" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#454443"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="BA_BodyCell" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#1A1D23"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </Page.Resources>

    <Grid Padding="24,20,24,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock x:Uid="BasketAffinity_Title"
                               FontSize="22" FontWeight="SemiBold" Foreground="#1A1D23"/>
                    <Border Background="#EEE9FE" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                        <TextBlock x:Uid="BasketAffinity_ProBadge" FontSize="11" FontWeight="SemiBold" Foreground="#6D28D9"/>
                    </Border>
                </StackPanel>
                <TextBlock x:Uid="BasketAffinity_Subtitle"
                           FontSize="13" Foreground="#8F96A3"
                           Margin="0,4,0,0"
                           TextWrapping="WrapWholeWords"/>
            </StackPanel>

            <components:PeriodFilterControl x:Name="PeriodFilter" Grid.Column="1"/>
        </Grid>

        <!-- Pairs table -->
        <Border Grid.Row="1" Style="{StaticResource BA_Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Padding="20,12" BorderBrush="#E8EAF0" BorderThickness="0,0,0,1" Background="#FAFBFC">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Uid="BasketAffinity_Header_ProductA" Style="{StaticResource BA_HeaderCell}"/>
                    <TextBlock Grid.Column="1" x:Uid="BasketAffinity_Header_ProductB" Style="{StaticResource BA_HeaderCell}"/>
                    <TextBlock Grid.Column="2" x:Uid="BasketAffinity_Header_Pairs" Style="{StaticResource BA_HeaderCell}" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="3" x:Uid="BasketAffinity_Header_SupportA" Style="{StaticResource BA_HeaderCell}" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="4" x:Uid="BasketAffinity_Header_SupportB" Style="{StaticResource BA_HeaderCell}" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="5" x:Uid="BasketAffinity_Header_Confidence" Style="{StaticResource BA_HeaderCell}" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="6" x:Uid="BasketAffinity_Header_Lift" Style="{StaticResource BA_HeaderCell}" HorizontalAlignment="Right"/>
                </Grid>

                <ListView Grid.Row="1"
                          ItemsSource="{x:Bind Rows, Mode=OneWay}"
                          SelectionMode="None"
                          IsItemClickEnabled="False"
                          ScrollViewer.HorizontalScrollMode="Disabled">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="MinHeight" Value="0"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:BasketAffinityDisplayItem">
                            <Grid Padding="20,10" BorderBrush="#F1F4F9" BorderThickness="0,0,0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind ProductNameA}" Style="{StaticResource BA_BodyCell}" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" Text="{x:Bind ProductNameB}" Style="{StaticResource BA_BodyCell}" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="2" Text="{x:Bind PairCountText}" Style="{StaticResource BA_BodyCell}" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="3" Text="{x:Bind SupportAText}" Style="{StaticResource BA_BodyCell}" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="4" Text="{x:Bind SupportBText}" Style="{StaticResource BA_BodyCell}" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="5" Text="{x:Bind ConfidenceText}" Style="{StaticResource BA_BodyCell}" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="6" Text="{x:Bind LiftText}" Style="{StaticResource BA_BodyCell}" HorizontalAlignment="Right" Foreground="{x:Bind LiftBrush}" FontWeight="SemiBold"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock Grid.Row="1"
                           x:Uid="BasketAffinity_Empty"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="0,40,0,40"
                           Foreground="#8F96A3"
                           FontSize="13"
                           Visibility="{x:Bind EmptyVisibility, Mode=OneWay}"/>
            </Grid>
        </Border>

        <!-- Status -->
        <TextBlock Grid.Row="2"
                   Text="{x:Bind StatusText, Mode=OneWay}"
                   FontSize="12"
                   Foreground="#8F96A3"/>
    </Grid>
</Page>
