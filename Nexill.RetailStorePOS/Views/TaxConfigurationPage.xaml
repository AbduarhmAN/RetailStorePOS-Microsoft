<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="RetailStorePOS.WinUiLogin.Views.TaxConfigurationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RetailStorePOS.WinUiLogin.Views"
    xmlns:models="using:RetailStorePOS.Data.Modules.Tax"
    xmlns:common="using:RetailStorePOS.WinUiLogin.Common"
    Background="Transparent">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Section Header -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Uid="TaxConfiguration_Header_Title" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="SemiBold"/>
                <TextBlock x:Uid="TaxConfiguration_Header_Subtitle"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>

            <Button Grid.Column="1" 
                    CornerRadius="3"
                    x:Uid="TaxConfiguration_SaveButton"
                    Style="{StaticResource AccentButtonStyle}" 
                    Command="{x:Bind ViewModel.SaveStoreSettingsCommand}"/>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="24">
                
                <!-- Global Controls -->
                <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="20">
                    <StackPanel Spacing="16">
                        <TextBlock x:Uid="TaxConfiguration_TaxEngine_Title" FontWeight="SemiBold" FontSize="16"/>
                        <TextBlock x:Uid="TaxConfiguration_TaxEngine_Subtitle" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,-12,0,0"/>
                        
                        <StackPanel Spacing="4">
                            <CheckBox x:Uid="TaxConfiguration_EnableTax_Label" IsChecked="{x:Bind ViewModel.TaxEnabled, Mode=TwoWay}"/>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock x:Uid="TaxConfiguration_DefaultRate_Label"/>
                            <NumberBox Value="{x:Bind ViewModel.TaxRatePercentValue, Mode=TwoWay}" CornerRadius="3"
                                       Width="120"
                                       HorizontalAlignment="Left"
                                       Minimum="0"
                                       common:NumericInputNormalization.NormalizeOnLostFocus="True"
                                       SpinButtonPlacementMode="Hidden"
                                       AcceptsExpression="False" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Rounding Settings -->
                <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="20">
                    <StackPanel Spacing="16">
                        <TextBlock x:Uid="TaxConfiguration_Rounding_Title" FontWeight="SemiBold" FontSize="16"/>
                        <TextBlock x:Uid="TaxConfiguration_Rounding_Subtitle" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,-12,0,0"/>
                        
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4" Grid.Column="0">
                                <TextBlock x:Uid="TaxConfiguration_RoundingStrategy_Label"/>
                                <ComboBox ItemsSource="{x:Bind ViewModel.RoundingStrategies}" SelectedValue="{x:Bind ViewModel.SelectedRoundingStrategy, Mode=TwoWay}" SelectedValuePath="Key" DisplayMemberPath="Value" HorizontalAlignment="Stretch" CornerRadius="3" />
                                <TextBlock x:Uid="TaxConfiguration_RoundingStrategy_Tip" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            </StackPanel>
                            <StackPanel Spacing="4" Grid.Column="1">
                                <TextBlock x:Uid="TaxConfiguration_CashRounding_Label"/>
                                <ComboBox ItemsSource="{x:Bind ViewModel.CashRoundingUnits}" SelectedValue="{x:Bind ViewModel.SelectedCashRoundingUnit, Mode=TwoWay}" SelectedValuePath="Key" DisplayMemberPath="Value" HorizontalAlignment="Stretch" CornerRadius="3" />
                                <TextBlock x:Uid="TaxConfiguration_CashRounding_Tip" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Tax Authorities -->
                <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="20">
                    <StackPanel Spacing="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Uid="TaxConfiguration_Authorities_Title" FontWeight="SemiBold" FontSize="16"/>
                                <TextBlock x:Uid="TaxConfiguration_Authorities_Subtitle" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Button Grid.Column="1" x:Uid="TaxConfiguration_AddAuthority_Button" Click="AddAuthorityButton_Click" CornerRadius="3"/>
                        </Grid>

                        <ListView ItemsSource="{x:Bind ViewModel.TaxAuthorities, Mode=OneWay}" CornerRadius="3"
                                  SelectionMode="None"
                                  IsItemClickEnabled="False"
                                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                  BorderThickness="1"
                                  Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:TaxAuthority">
                                    <Grid Padding="4,8" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" Text="{x:Bind AuthorityCode}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Grid.Column="2" Text="{x:Bind RegistrationNumber}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <Button Grid.Column="3" Content="&#xE70F;" FontFamily="Segoe Fluent Icons" Tag="{x:Bind}" 
                                                Click="EditAuthorityButton_Click" x:Uid="TaxConfiguration_EditAuthority_Button" Background="Transparent" BorderBrush="Transparent"/>
                                        <Button Grid.Column="4" Content="&#xE74D;" FontFamily="Segoe Fluent Icons" Tag="{x:Bind}" 
                                                Click="DeleteAuthorityButton_Click" x:Uid="TaxConfiguration_DeleteAuthority_Button" Background="Transparent" BorderBrush="Transparent"
                                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <!-- Tax Rules -->
                <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="20">
                    <StackPanel Spacing="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Uid="TaxConfiguration_Rules_Title" FontWeight="SemiBold" FontSize="16"/>
                                <TextBlock x:Uid="TaxConfiguration_Rules_Subtitle" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Button
                                    Grid.Column="1"
                                    x:Uid="TaxConfiguration_AddRule_Button"
                                    Click="AddTaxRuleButton_Click"
                                    CornerRadius="3"/>
                        </Grid>

                        <ListView ItemsSource="{x:Bind ViewModel.TaxRules, Mode=OneWay}" CornerRadius="3"
                                  SelectionMode="None"
                                  IsItemClickEnabled="False"
                                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                  BorderThickness="1"
                                  Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:TaxRule">
                                    <Grid Padding="4,8" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Text="{x:Bind CalcType}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Grid.Column="2" Text="{x:Bind DisplaySummary}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Grid.Column="3" Text="{x:Bind InclusiveLabel}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Grid.Column="4" Text="{x:Bind ScopeLabel}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <Button Grid.Column="5" Content="&#xE70F;" FontFamily="Segoe Fluent Icons" Tag="{x:Bind}" 
                                                Click="EditTaxRuleButton_Click" x:Uid="TaxConfiguration_EditRule_Button" Background="Transparent" BorderBrush="Transparent"/>
                                        <Button Grid.Column="6" Content="&#xE74D;" FontFamily="Segoe Fluent Icons" Tag="{x:Bind}" 
                                                Click="DeleteTaxRuleButton_Click" x:Uid="TaxConfiguration_DeleteRule_Button" Background="Transparent" BorderBrush="Transparent"
                                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <!-- Tax Groups -->
                <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="20">
                    <StackPanel Spacing="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Uid="TaxConfiguration_Groups_Title" FontWeight="SemiBold" FontSize="16"/>
                                <TextBlock x:Uid="TaxConfiguration_Groups_Subtitle" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Button Grid.Column="1" x:Uid="TaxConfiguration_AddGroup_Button" Click="AddTaxGroupButton_Click" CornerRadius="3"/>
                        </Grid>

                        <ListView ItemsSource="{x:Bind ViewModel.TaxGroups, Mode=OneWay}" CornerRadius="3"
                                  SelectionMode="None"
                                  IsItemClickEnabled="False"
                                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                  BorderThickness="1"
                                  Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:TaxGroup">
                                    <Grid Padding="4,8" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"/>
                                            <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Visibility="{x:Bind local:TaxConfigurationPage.BoolToVis(IsDefault)}">
                                                <TextBlock x:Uid="TaxConfiguration_DefaultBadge" FontSize="10" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" FontWeight="SemiBold"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{x:Bind DisplaySummary}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <Button Grid.Column="2" Content="&#xE70F;" FontFamily="Segoe Fluent Icons" Tag="{x:Bind}" 
                                                Click="EditTaxGroupButton_Click" x:Uid="TaxConfiguration_EditGroup_Button" Background="Transparent" BorderBrush="Transparent"/>
                                        <Button Grid.Column="3" Content="&#xE74D;" FontFamily="Segoe Fluent Icons" Tag="{x:Bind}" 
                                                Click="DeleteTaxGroupButton_Click" x:Uid="TaxConfiguration_DeleteGroup_Button" Background="Transparent" BorderBrush="Transparent"
                                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                IsEnabled="{x:Bind local:TaxConfigurationPage.InverseBool(IsDefault)}"/> <!-- Can't delete default group -->
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <!-- Status readout -->
                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" 
                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" 
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
