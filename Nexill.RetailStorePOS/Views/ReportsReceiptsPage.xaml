<Page
    x:Name="ReportsReceiptsRoot"
    x:Class="RetailStorePOS.WinUiLogin.Views.ReportsReceiptsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:RetailStorePOS.Data.Modules.Sales"
    xmlns:views="using:RetailStorePOS.WinUiLogin.Views"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid>
        <!-- Removed the outer ScrollViewer! It was breaking the UI Virtualization by giving the ListView infinite height -->
        <Grid Padding="24" RowSpacing="{x:Bind ViewModel.PageRowSpacing, Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Inline Tools -->
            <Border Grid.Row="0"
                Visibility="{x:Bind ViewModel.ReportChromeVisibility, Mode=OneWay}"
                Padding="16"
                Background="#FCFDFD"
                BorderBrush="{StaticResource BorderDivider}"
                BorderThickness="1"
                CornerRadius="14">
                <Grid RowSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="2">
                            <TextBlock x:Uid="ReportsReceipts_Filters_Title"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryText}" />
                            <TextBlock x:Uid="ReportsReceipts_Filters_Subtitle"
                                   Style="{StaticResource NotionMetaTextStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.RangeLabel, Mode=OneWay}" Style="{StaticResource NotionMetaTextStyle}" />
                            <TextBlock Text="|" Style="{StaticResource NotionMetaTextStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.VisibleTransactionsCount, Mode=OneWay}" Style="{StaticResource NotionMetaTextStyle}" />
                            <TextBlock x:Uid="ReportsReceipts_ShownLabel" Style="{StaticResource NotionMetaTextStyle}" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Quick Range Buttons -->
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Uid="ReportsReceipts_QuickRange_Label" Style="{StaticResource NotionMetaTextStyle}" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Uid="ReportsReceipts_QuickRange_Today" Style="{StaticResource NotionButtonStyle}" Command="{x:Bind ViewModel.SetTodayRangeCommand}" Background="{x:Bind ViewModel.TodayPresetBackground, Mode=OneWay}" />
                                <Button x:Uid="ReportsReceipts_QuickRange_7Days" Style="{StaticResource NotionButtonStyle}" Command="{x:Bind ViewModel.SetLast7DaysRangeCommand}" Background="{x:Bind ViewModel.Last7PresetBackground, Mode=OneWay}" />
                                <Button x:Uid="ReportsReceipts_QuickRange_30Days" Style="{StaticResource NotionButtonStyle}" Command="{x:Bind ViewModel.SetLast30DaysRangeCommand}" Background="{x:Bind ViewModel.Last30PresetBackground, Mode=OneWay}" />
                                <Button Style="{StaticResource AccentBlueButtonStyle}" Command="{x:Bind ViewModel.GenerateXReportCommand}" 
                                        Margin="16,0,0,0" Translation="0,0,8">
                                    <Button.Shadow>
                                        <ThemeShadow />
                                    </Button.Shadow>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE9F9;" FontSize="13" Foreground="White" />
                                        <TextBlock x:Uid="ReportsReceipts_XReport_Button" FontSize="13" Foreground="White" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock x:Uid="ReportsReceipts_Date_From" Style="{StaticResource NotionMetaTextStyle}" Margin="0,0,0,8" />
                            <CalendarDatePicker Date="{x:Bind ViewModel.FromDate, Mode=TwoWay}" CornerRadius="4" BorderThickness="1" BorderBrush="{StaticResource BorderDivider}" Background="Transparent" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock x:Uid="ReportsReceipts_Date_To" Style="{StaticResource NotionMetaTextStyle}" Margin="0,0,0,8" />
                            <CalendarDatePicker Date="{x:Bind ViewModel.ToDate, Mode=TwoWay}" CornerRadius="4" BorderThickness="1" BorderBrush="{StaticResource BorderDivider}" Background="Transparent" />
                        </StackPanel>

                        <StackPanel Grid.Column="3">
                            <TextBlock x:Uid="ReportsReceipts_Search_Label" Style="{StaticResource NotionMetaTextStyle}" Margin="0,0,0,8" />
                            <Grid ColumnSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Uid="ReportsReceipts_Search_Box" CornerRadius="4" Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" BorderThickness="1" BorderBrush="{StaticResource BorderDivider}" Background="Transparent" />
                                <Button Grid.Column="1" x:Uid="ReportsReceipts_Search_ClearTooltip" Style="{StaticResource NotionButtonStyle}" Command="{x:Bind ViewModel.ClearSearchCommand}">
                                    <SymbolIcon Symbol="Clear" Foreground="{StaticResource MutedText}" />
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Transaction Grid -->
            <Border Grid.Row="1" Background="Transparent" BorderBrush="{StaticResource BorderDivider}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Padding="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Bind ViewModel.RangeLabel, Mode=OneWay}" Style="{StaticResource NotionSectionHeaderStyle}" Margin="0" />
                            <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" Style="{StaticResource NotionMetaTextStyle}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.VisibleTransactionsCount, Mode=OneWay}" Style="{StaticResource NotionMetaTextStyle}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Button Grid.Column="2" Style="{StaticResource NotionButtonStyle}" Command="{x:Bind ViewModel.ToggleTransactionsViewCommand, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind ViewModel.TransactionToggleTooltip, Mode=OneWay}" VerticalAlignment="Center">
                            <SymbolIcon Symbol="{x:Bind ViewModel.TransactionToggleSymbol, Mode=OneWay}" Foreground="{StaticResource MutedText}" />
                        </Button>
                    </Grid>

                    <ListView Grid.Row="1"
                          ItemsSource="{x:Bind ViewModel.Sales, Mode=OneWay}"
                          SelectionMode="None"
                          ShowsScrollingPlaceholders="False"
                          Background="Transparent"
                          BorderThickness="0"
                          ScrollViewer.VerticalScrollMode="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollMode="Disabled">
                        <ListView.Header>
                            <Grid Padding="16,8" BorderBrush="{StaticResource BorderDivider}" BorderThickness="0,0,0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" x:Uid="ReportsReceipts_List_Header_Receipt" Style="{StaticResource NotionMetaTextStyle}" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="1" x:Uid="ReportsReceipts_List_Header_Date" Style="{StaticResource NotionMetaTextStyle}" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="2" x:Uid="ReportsReceipts_List_Header_Time" Style="{StaticResource NotionMetaTextStyle}" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="3" x:Uid="ReportsReceipts_List_Header_Type" Style="{StaticResource NotionMetaTextStyle}" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="4" x:Uid="ReportsReceipts_List_Header_Subtotal" Style="{StaticResource NotionMetaTextStyle}" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="5" x:Uid="ReportsReceipts_List_Header_Tax" Style="{StaticResource NotionMetaTextStyle}" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="6" x:Uid="ReportsReceipts_List_Header_Total" Style="{StaticResource NotionMetaTextStyle}" HorizontalAlignment="Left" Padding="15,0,0,0" />
                                <TextBlock Grid.Column="7" x:Uid="ReportsReceipts_List_Header_Action" Style="{StaticResource NotionMetaTextStyle}" HorizontalAlignment="Center" />
                            </Grid>
                        </ListView.Header>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:Sale">
                                <Grid Padding="16,12" BorderBrush="{StaticResource BorderDivider}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind ReceiptNumber}" Foreground="{StaticResource MutedText}" Style="{StaticResource NotionBodyTextStyle}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind views:ReportsReceiptsPage.FormatDate(CreatedAt)}" Style="{StaticResource NotionBodyTextStyle}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind views:ReportsReceiptsPage.FormatTime(CreatedAt)}" Style="{StaticResource NotionBodyTextStyle}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind PaymentType}" Style="{StaticResource NotionBodyTextStyle}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind views:ReportsReceiptsPage.FormatCurrency(Subtotal)}" Style="{StaticResource NotionBodyTextStyle}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="5" Text="{x:Bind views:ReportsReceiptsPage.FormatCurrency(Tax)}" Style="{StaticResource NotionBodyTextStyle}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="6" Text="{x:Bind views:ReportsReceiptsPage.FormatCurrency(Total)}" FontWeight="SemiBold" Style="{StaticResource NotionBodyTextStyle}" VerticalAlignment="Center" HorizontalAlignment="Left" Padding="15,0,0,0" />
                                    <Button Grid.Column="7" HorizontalAlignment="Center" Style="{StaticResource NotionButtonStyle}"
                                        Click="ReprintButton_Click" 
                                        Tag="{x:Bind}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <SymbolIcon Symbol="Print" Foreground="{StaticResource MutedText}" />
                                            <TextBlock x:Uid="ReportsReceipts_List_ReprintButton" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <ContentDialog x:Name="XReportDialog"
                       x:Uid="ReportsReceipts_XReport_Dialog"
                       PrimaryButtonClick="XReportDialog_PrintClick"
                       SecondaryButtonClick="XReportDialog_OpenPdfClick"
                       CloseButtonClick="XReportDialog_CloseClick"
                       PrimaryButtonStyle="{StaticResource AccentBlueButtonStyle}"
                       SecondaryButtonStyle="{StaticResource AccentBlueButtonStyle}"
                       CloseButtonStyle="{StaticResource FlatCloseButtonStyle}">
            <StackPanel Spacing="16" MinWidth="360">

                <!-- Success Banner -->
                <Border Background="#F0FFF4" Padding="12" CornerRadius="4">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE73E;" FontSize="16" Foreground="#2E7D32" />
                        <TextBlock x:Uid="ReportsReceipts_XReport_Dialog_Success" FontSize="14" Foreground="#2E7D32" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- File path -->
                <StackPanel Spacing="4">
                    <TextBlock x:Uid="ReportsReceipts_XReport_Dialog_SavedTo" FontSize="12" Foreground="{StaticResource MutedText}" />
                    <TextBlock x:Name="XReportStatusText" FontSize="12" Foreground="{StaticResource PrimaryText}" TextWrapping="Wrap"
                               IsTextSelectionEnabled="True" />
                </StackPanel>

                <!-- Hint -->
                <TextBlock x:Uid="ReportsReceipts_XReport_Dialog_Hint" 
                           FontSize="12" Foreground="{StaticResource MutedText}" TextWrapping="Wrap" />

            </StackPanel>
        </ContentDialog>
    </Grid>
</Page>
