<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="RetailStorePOS.WinUiLogin.Views.StoreManagementPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RetailStorePOS.WinUiLogin.Views"
    xmlns:models="using:RetailStorePOS.Data.Models"
    xmlns:common="using:RetailStorePOS.WinUiLogin.Common"
    Background="Transparent">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Section Header -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Uid="StoreManagement_Header_Title" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="SemiBold"/>
                <TextBlock x:Uid="StoreManagement_Header_Subtitle"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>

            <Button Grid.Column="1" 
                    CornerRadius="3"
                    x:Uid="StoreManagement_SaveButton"
                    Style="{StaticResource AccentButtonStyle}" 
                    Click="SaveStoreSettingsButton_Click"/>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="24">
                
                <!-- General Store Details -->
                <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="20">
                    <StackPanel Spacing="16">
                        <TextBlock x:Uid="StoreManagement_StoreIdentity_Title" FontWeight="SemiBold" FontSize="16"/>
                        <TextBlock x:Uid="StoreManagement_StoreIdentity_Subtitle" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,-12,0,0"/>
                        
                        <StackPanel Spacing="4">
                            <TextBlock x:Uid="StoreManagement_StoreName_Label"/>
                            <TextBox Text="{x:Bind ViewModel.StoreName, Mode=TwoWay}"
                                     CornerRadius="3"/>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock x:Uid="StoreManagement_StoreAddress_Label"/>
                            <TextBox Text="{x:Bind ViewModel.StoreAddress, Mode=TwoWay}"
                                     MinHeight="80"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     CornerRadius="3"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Checkout Defaults -->
                <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="20">
                    <StackPanel Spacing="16">
                        <TextBlock x:Uid="StoreManagement_CheckoutDefaults_Title" FontWeight="SemiBold" FontSize="16"/>

                        <Grid ColumnSpacing="12" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="4">
                                <TextBlock x:Uid="StoreManagement_Region_Label"/>
                                <ComboBox ItemsSource="{x:Bind ViewModel.RegionOptions, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.SelectedRegionOption, Mode=TwoWay}"
                                          Width="280"
                                          HorizontalAlignment="Left"
                                          CornerRadius="3"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock x:Uid="StoreManagement_Currency_Label"/>
                                <ComboBox ItemsSource="{x:Bind ViewModel.CurrencyOptions, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.SelectedCurrencyOption, Mode=TwoWay}"
                                          MinWidth="320"
                                          HorizontalAlignment="Stretch"
                                          CornerRadius="3"/>
                            </StackPanel>
                        </Grid>

                    </StackPanel>
                </Border>

                <!-- Printing Settings -->
                <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="20">
                    <StackPanel Spacing="16">
                        <TextBlock x:Uid="StoreManagement_PrintingSettings_Title" FontWeight="SemiBold" FontSize="16"/>
                        <TextBlock x:Uid="StoreManagement_PrintingSettings_Subtitle" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,-12,0,0"/>

                        <StackPanel Spacing="4">
                            <TextBlock x:Uid="StoreManagement_Printer_Label"/>
                            <ComboBox ItemsSource="{x:Bind ViewModel.PrinterOptions, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.SelectedPrinterOption, Mode=TwoWay}"
                                      MinWidth="320"
                                      HorizontalAlignment="Stretch"
                                      CornerRadius="3"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                
                <!-- Language & Region -->
                <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="20">
                    <StackPanel Spacing="16">
                        <TextBlock x:Uid="StoreManagement_LanguageRegion_Title" FontWeight="SemiBold" FontSize="16"/>

                        <Grid ColumnSpacing="12" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="4">
                                <TextBlock x:Uid="StoreManagement_AppLanguage_Label"/>
                                <ComboBox ItemsSource="{x:Bind ViewModel.LanguageOptions, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.SelectedAppLanguage, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch"
                                          CornerRadius="3"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Dashboard Settings -->
                <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="20">
                    <StackPanel Spacing="16">
                        <TextBlock x:Uid="StoreManagement_DashboardSettings_Title" FontWeight="SemiBold" FontSize="16"/>
                        <TextBlock x:Uid="StoreManagement_DashboardSettings_Subtitle" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,-12,0,0"/>
                        
                        <StackPanel Spacing="4">
                            <TextBlock x:Uid="StoreManagement_DailyTarget_Label"/>
                            <NumberBox Value="{x:Bind ViewModel.DailyTargetValue, Mode=TwoWay}"
                                       SpinButtonPlacementMode="Hidden"
                                       Minimum="0"
                                       Width="280"
                                       HorizontalAlignment="Left"
                                       CornerRadius="3"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!--  <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="20">
    <StackPanel Spacing="16">
        <TextBlock Text="Tablet Mode" FontWeight="SemiBold" FontSize="16"/>
        <TextBlock Text="Enable touch-friendly controls for devices with touch screens." Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,-12,0,0"/>

        <CheckBox Content="Touch Mode"
                  IsChecked="{x:Bind ViewModel.IsTouchModeEnabled, Mode=TwoWay}"/>
    </StackPanel>
</Border>
                -->

                <!-- Status readout -->
                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" 
                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" 
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"/>
                <!-- Fresh Start / Reset Section 
                <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource SystemFillColorCriticalBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock x:Uid="StoreManagement_FreshStart_Title"
                                   FontWeight="SemiBold"
                                   FontSize="16"/>
                        <TextBlock x:Uid="StoreManagement_FreshStart_Subtitle"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Button x:Uid="StoreManagement_ResetButton"
                                Click="ResetAppDataButton_Click"
                                HorizontalAlignment="Left"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                    </StackPanel>
                </Border> -->
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
