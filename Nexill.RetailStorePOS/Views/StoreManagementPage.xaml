<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="RetailStorePOS.WinUiLogin.Views.StoreManagementPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RetailStorePOS.WinUiLogin.Views"
    xmlns:models="using:RetailStorePOS.Data.Models"
    xmlns:common="using:RetailStorePOS.WinUiLogin.Common"
    Background="Transparent">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Section Header -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Store Management" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="SemiBold"/>
                <TextBlock Text="Manage store details, receipt output, and tax settings used across the workspace." 
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>

            <Button Grid.Column="1" 
                    CornerRadius="3"
                    Content="Save" 
                    Style="{StaticResource AccentButtonStyle}" 
                    Click="SaveStoreSettingsButton_Click"/>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="24">
                
                <!-- General Store Details -->
                <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="20">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Store Identity" FontWeight="SemiBold" FontSize="16"/>
                        <TextBlock Text="These details appear on receipts and other customer-facing documents." Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,-12,0,0"/>
                        
                        <StackPanel Spacing="4">
                            <TextBlock Text="Store Name"/>
                            <TextBox Text="{x:Bind ViewModel.StoreName, Mode=TwoWay}"
                                     CornerRadius="3"/>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Store Address"/>
                            <TextBox Text="{x:Bind ViewModel.StoreAddress, Mode=TwoWay}"
                                     MinHeight="80"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     CornerRadius="3"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Checkout Defaults -->
                <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="20">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Checkout Defaults" FontWeight="SemiBold" FontSize="16"/>

                        <Grid ColumnSpacing="12" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Region"/>
                                <ComboBox ItemsSource="{x:Bind ViewModel.RegionOptions, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.SelectedRegionOption, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayName"
                                          Width="280"
                                          HorizontalAlignment="Left"
                                          CornerRadius="3"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="Currency"/>
                                <ComboBox ItemsSource="{x:Bind ViewModel.CurrencyOptions, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.SelectedCurrencyOption, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayName"
                                          MinWidth="320"
                                          HorizontalAlignment="Stretch"
                                          CornerRadius="3"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{x:Bind ViewModel.CurrencySelectionPreviewText, Mode=OneWay}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Status readout -->
                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" 
                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" 
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"/>
<!-- comment start here -->
                <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource SystemFillColorCriticalBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Fresh Start"
                                   FontWeight="SemiBold"
                                   FontSize="16"/>
                        <TextBlock Text="Delete the local catalog, users, receipts, preferences, secure credentials, and telemetry cache. The app will reopen like a fresh install."
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Button Content="Reset app data"
                                Click="ResetAppDataButton_Click"
                                HorizontalAlignment="Left"
                                ToolTipService.ToolTip="Wipes local app data and relaunches the app fresh."
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                    </StackPanel>
                </Border>
 <!-- comment start here -->
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
