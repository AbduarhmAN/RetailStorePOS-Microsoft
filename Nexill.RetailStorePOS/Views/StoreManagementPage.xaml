<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="RetailStorePOS.WinUiLogin.Views.StoreManagementPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RetailStorePOS.WinUiLogin.Views"
    xmlns:models="using:RetailStorePOS.Data.Models"
    xmlns:common="using:RetailStorePOS.WinUiLogin.Common"
    Background="Transparent"
    FlowDirection="{x:Bind ViewModel.Loc.FlowDirection, Mode=OneWay}">

    <Page.Resources>
        <Style x:Key="SM_Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E8EAF0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="22"/>
        </Style>

        <Style x:Key="SM_DangerCard" TargetType="Border">
            <Setter Property="Background" Value="#FFF5F5"/>
            <Setter Property="BorderBrush" Value="#FECACA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="22"/>
        </Style>

        <Style x:Key="SM_SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1A1D23"/>
        </Style>

        <Style x:Key="SM_SectionSubtitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#8F96A3"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="SM_FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#5F6775"/>
            <Setter Property="CharacterSpacing" Value="40"/>
        </Style>

        <Style x:Key="SM_TextBox" TargetType="TextBox">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="MinHeight" Value="34"/>
        </Style>

        <Style x:Key="SM_ComboBox" TargetType="ComboBox">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="MinWidth" Value="260"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <Style x:Key="SM_NumberBox" TargetType="NumberBox">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="MinHeight" Value="34"/>
        </Style>
    </Page.Resources>

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top action bar -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="4">
                <TextBlock Text="{x:Bind ViewModel.StoreManagement_Header_Title, Mode=OneWay}"
                           FontSize="22" FontWeight="SemiBold" Foreground="#1A1D23"/>
                <TextBlock Text="{x:Bind ViewModel.StoreManagement_Header_Subtitle, Mode=OneWay}"
                           FontSize="13" Foreground="#8F96A3" TextWrapping="Wrap"/>
            </StackPanel>

            <Button Grid.Column="1"
                    Content="{x:Bind ViewModel.StoreManagement_SaveButton, Mode=OneWay}"
                    CornerRadius="8"
                    Padding="16,8"
                    MinHeight="36"
                    VerticalAlignment="Top"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="SaveStoreSettingsButton_Click"/>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16" Padding="0,0,4,24">

                <!-- Store Identity -->
                <Border Style="{StaticResource SM_Card}">
                    <StackPanel Spacing="20">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Bind ViewModel.StoreManagement_StoreIdentity_Title, Mode=OneWay}" Style="{StaticResource SM_SectionTitle}"/>
                            <TextBlock Text="{x:Bind ViewModel.StoreManagement_StoreIdentity_Subtitle, Mode=OneWay}" Style="{StaticResource SM_SectionSubtitle}"/>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="{x:Bind ViewModel.StoreManagement_StoreName_Label, Mode=OneWay}" Style="{StaticResource SM_FieldLabel}"/>
                            <TextBox Text="{x:Bind ViewModel.StoreName, Mode=TwoWay}" Style="{StaticResource SM_TextBox}"/>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="{x:Bind ViewModel.StoreManagement_StoreAddress_Label, Mode=OneWay}" Style="{StaticResource SM_FieldLabel}"/>
                            <TextBox Text="{x:Bind ViewModel.StoreAddress, Mode=TwoWay}"
                                     MinHeight="80"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     CornerRadius="6"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Checkout Defaults -->
                <Border Style="{StaticResource SM_Card}">
                    <StackPanel Spacing="20">
                        <TextBlock Text="{x:Bind ViewModel.StoreManagement_CheckoutDefaults_Title, Mode=OneWay}" Style="{StaticResource SM_SectionTitle}"/>

                        <Grid ColumnSpacing="16" RowSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock Text="{x:Bind ViewModel.StoreManagement_Region_Label, Mode=OneWay}" Style="{StaticResource SM_FieldLabel}"/>
                                <ComboBox ItemsSource="{x:Bind ViewModel.RegionOptions, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.SelectedRegionOption, Mode=TwoWay}"
                                          Style="{StaticResource SM_ComboBox}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="{x:Bind ViewModel.StoreManagement_Currency_Label, Mode=OneWay}" Style="{StaticResource SM_FieldLabel}"/>
                                <ComboBox ItemsSource="{x:Bind ViewModel.CurrencyOptions, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.SelectedCurrencyOption, Mode=TwoWay}"
                                          Style="{StaticResource SM_ComboBox}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Printing Settings -->
                <Border Style="{StaticResource SM_Card}">
                    <StackPanel Spacing="20">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Bind ViewModel.StoreManagement_PrintingSettings_Title, Mode=OneWay}" Style="{StaticResource SM_SectionTitle}"/>
                            <TextBlock Text="{x:Bind ViewModel.StoreManagement_PrintingSettings_Subtitle, Mode=OneWay}" Style="{StaticResource SM_SectionSubtitle}"/>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="{x:Bind ViewModel.StoreManagement_Printer_Label, Mode=OneWay}" Style="{StaticResource SM_FieldLabel}"/>
                            <ComboBox ItemsSource="{x:Bind ViewModel.PrinterOptions, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.SelectedPrinterOption, Mode=TwoWay}"
                                      Style="{StaticResource SM_ComboBox}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Language -->
                <Border Style="{StaticResource SM_Card}">
                    <StackPanel Spacing="20">
                        <TextBlock Text="{x:Bind ViewModel.StoreManagement_LanguageRegion_Title, Mode=OneWay}" Style="{StaticResource SM_SectionTitle}"/>

                        <StackPanel Spacing="6">
                            <TextBlock Text="{x:Bind ViewModel.StoreManagement_AppLanguage_Label, Mode=OneWay}" Style="{StaticResource SM_FieldLabel}"/>
                            <ComboBox ItemsSource="{x:Bind ViewModel.LanguageOptions, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.SelectedAppLanguage, Mode=TwoWay}"
                                      Style="{StaticResource SM_ComboBox}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Dashboard Settings -->
                <Border Style="{StaticResource SM_Card}">
                    <StackPanel Spacing="20">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Bind ViewModel.StoreManagement_DashboardSettings_Title, Mode=OneWay}" Style="{StaticResource SM_SectionTitle}"/>
                            <TextBlock Text="{x:Bind ViewModel.StoreManagement_DashboardSettings_Subtitle, Mode=OneWay}" Style="{StaticResource SM_SectionSubtitle}"/>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="{x:Bind ViewModel.StoreManagement_DailyTarget_Label, Mode=OneWay}" Style="{StaticResource SM_FieldLabel}"/>
                            <NumberBox Value="{x:Bind ViewModel.DailyTargetValue, Mode=TwoWay}"
                                       SpinButtonPlacementMode="Hidden"
                                       Minimum="0"
                                       Width="280"
                                       HorizontalAlignment="Left"
                                       Style="{StaticResource SM_NumberBox}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Status banner -->
                <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="14,10"
                        Visibility="{x:Bind ViewModel.StatusVisibility, Mode=OneWay}">
                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                               Foreground="#1D4ED8"
                               FontSize="13"
                               TextWrapping="Wrap"/>
                </Border>

                <!-- Danger zone -->
                <Border Style="{StaticResource SM_DangerCard}">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="3">
                            <TextBlock Text="{x:Bind ViewModel.StoreManagement_FreshStart_Title, Mode=OneWay}"
                                       FontSize="15" FontWeight="SemiBold" Foreground="#7F1D1D"/>
                            <TextBlock Text="{x:Bind ViewModel.StoreManagement_FreshStart_Subtitle, Mode=OneWay}"
                                       FontSize="12" Foreground="#991B1B" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Button Content="{x:Bind ViewModel.StoreManagement_ResetButton, Mode=OneWay}"
                                Click="ResetAppDataButton_Click"
                                HorizontalAlignment="Left"
                                Background="White"
                                BorderBrush="#FCA5A5"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="14,7"
                                MinHeight="34"
                                Foreground="#DC2626"
                                FontWeight="SemiBold"
                                FontSize="13"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
