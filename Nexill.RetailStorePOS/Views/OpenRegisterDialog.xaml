<ContentDialog
    x:Class="RetailStorePOS.WinUiLogin.Views.OpenRegisterDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RetailStorePOS.WinUiLogin.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    DefaultButton="Primary"
    RequestedTheme="Light" CornerRadius="14"
    FlowDirection="{x:Bind Loc.FlowDirection, Mode=OneWay}"
    PrimaryButtonText="{x:Bind OpenRegisterDialog_PrimaryButtonText, Mode=OneWay}"
    SecondaryButtonText="{x:Bind OpenRegisterDialog_SecondaryButtonText, Mode=OneWay}">

    <ContentDialog.Title>
        <TextBlock Text="{x:Bind OpenRegisterDialog_Title, Mode=OneWay}"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Foreground="#1A1D23" />
    </ContentDialog.Title>

    <ContentDialog.PrimaryButtonStyle>
        <Style TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="MinWidth" Value="160"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
    </ContentDialog.PrimaryButtonStyle>

    <ContentDialog.SecondaryButtonStyle>
        <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
    </ContentDialog.SecondaryButtonStyle>

    <StackPanel Spacing="18" Width="420" Margin="0,8,0,0">
        <TextBlock Text="{x:Bind OpenRegisterDialog_IntroText, Mode=OneWay}" 
                   TextWrapping="Wrap" 
                   Foreground="#5F6775" 
                   FontSize="13"/>

        <StackPanel Spacing="6">
            <TextBlock Text="{x:Bind OpenRegisterDialog_OpeningCashHeader, Mode=OneWay}"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="#5F6775"
                       CharacterSpacing="40"/>
            <NumberBox x:Name="OpeningCashBox" 
                       Value="0" 
                       PlaceholderText="{x:Bind OpenRegisterDialog_OpeningCashBox, Mode=OneWay}"
                       Minimum="0"
                       SmallChange="1"
                       LargeChange="10"
                       CornerRadius="6"
                       MinHeight="36"
                       FontSize="15"
                       HorizontalAlignment="Stretch"/>
        </StackPanel>

        <StackPanel Spacing="6">
            <TextBlock Text="{x:Bind OpenRegisterDialog_NotesHeader, Mode=OneWay}"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="#5F6775"
                       CharacterSpacing="40"/>
            <TextBox x:Name="NoteBox" 
                     PlaceholderText="{x:Bind OpenRegisterDialog_NoteBox, Mode=OneWay}"
                     AcceptsReturn="True"
                     Height="100"
                     CornerRadius="6"
                     FontSize="13"
                     MaxLength="500"/>
        </StackPanel>
    </StackPanel>
</ContentDialog>
