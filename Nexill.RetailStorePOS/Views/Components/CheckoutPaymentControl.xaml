<UserControl
    x:Class="RetailStorePOS.WinUiLogin.Views.Components.CheckoutPaymentControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:common="using:RetailStorePOS.WinUiLogin.Common"
    xmlns:input="using:Microsoft.UI.Xaml.Input"
    xmlns:viewmodels="using:RetailStorePOS.WinUiLogin.ViewModels"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- Navy Blue exact button and darker hover state -->
        <SolidColorBrush x:Key="NavyBackgroundBrush" Color="#2C3E50" />
        <SolidColorBrush x:Key="NavyHoverBrush" Color="#1F2C38" />
        
        <!-- Standard Quick Cash hover -->
        <SolidColorBrush x:Key="QuickCashHoverBrush" Color="#D0D0D0" />

        <!-- Styles -->
        <Style x:Key="NavyButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource NavyBackgroundBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="RootGrid" Background="{TemplateBinding Background}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource NavyHoverBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#151D26" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#707070" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter x:Name="ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              HorizontalContentAlignment="Center"
                                              VerticalContentAlignment="Center"
                                              Padding="{TemplateBinding Padding}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuickCashButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource ButtonBackground}" />
            <Setter Property="Foreground" Value="{ThemeResource ButtonForeground}" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="RootGrid" Background="{TemplateBinding Background}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource QuickCashHoverBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter x:Name="ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              HorizontalContentAlignment="Center"
                                              VerticalContentAlignment="Center"
                                              Padding="{TemplateBinding Padding}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4"
            Padding="8"
            HorizontalAlignment="Stretch">
        <Grid ColumnSpacing="6" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.8*" MinWidth="130" />
                <ColumnDefinition Width="1.2*" MinWidth="110" />
                <ColumnDefinition Width="1*" MinWidth="80" />
                <ColumnDefinition Width="1*" MinWidth="80" />
                <ColumnDefinition Width="1*" MinWidth="80" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     x:Name="TenderedCashBox"
                     x:Uid="Checkout_Pay_TenderBox"
                     Text="{x:Bind ViewModel.TenderedInputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     common:NumericInputNormalization.NormalizeOnLostFocus="True"
                     CornerRadius="4"
                     Background="LightGray"
                     TextAlignment="Center"
                     BorderThickness="1"
                     Padding="0"
                     GotFocus="TenderedCashBox_GotFocus"
                     TextChanged="TenderedCashBox_TextChanged"
                     KeyDown="TenderedCashBox_KeyDown">
                <TextBox.KeyboardAccelerators>
                    <input:KeyboardAccelerator Key="D"
                                               Modifiers="Control"
                                               Invoked="TenderedCashBox_CtrlD_Invoked" />
                </TextBox.KeyboardAccelerators>
            </TextBox>

            <Button Grid.Column="1"
                    Command="{x:Bind ViewModel.TenderExactCommand}"
                    Style="{StaticResource NavyButtonStyle}">
                <TextBlock x:Uid="Checkout_Pay_ExactButtonText" FontWeight="Bold" VerticalAlignment="Center" />
            </Button>

            <Button Grid.Column="2"
                    Command="{x:Bind ViewModel.TenderPlus1Command}"
                    Content="{x:Bind ViewModel.QuickCash1Text, Mode=OneWay}"
                    Style="{StaticResource QuickCashButtonStyle}" />

            <Button Grid.Column="3"
                    Command="{x:Bind ViewModel.TenderPlus2Command}"
                    Content="{x:Bind ViewModel.QuickCash2Text, Mode=OneWay}"
                    Style="{StaticResource QuickCashButtonStyle}" />

            <Button Grid.Column="4"
                    Command="{x:Bind ViewModel.TenderPlus3Command}"
                    Content="{x:Bind ViewModel.QuickCash3Text, Mode=OneWay}"
                    Style="{StaticResource QuickCashButtonStyle}" />

            <Border Grid.Column="5"
                    Visibility="{x:Bind ViewModel.StatusVisibility, Mode=OneWay}"
                    Background="{x:Bind ViewModel.StatusBackgroundBrush, Mode=OneWay}"
                    BorderBrush="{x:Bind ViewModel.StatusBorderBrush, Mode=OneWay}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="10,8"
                    Margin="2,0,0,0"
                    VerticalAlignment="Bottom">
                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                           Foreground="{x:Bind ViewModel.StatusTextBrush, Mode=OneWay}"
                           TextWrapping="WrapWholeWords"
                           MaxLines="2" />
            </Border>

            <Border Grid.Column="6"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Background="{ThemeResource AppBarItemPointerOverBackgroundThemeBrush}"
                    BorderBrush="{ThemeResource AppBarItemPointerOverBackgroundThemeBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="10,8">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="Checkout_Pay_ChangeLabel" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ChangeDueText, Mode=OneWay}" FontWeight="Bold" />
                </Grid>
            </Border>

            <Button Grid.Column="7"
                    x:Uid="Checkout_Pay_CompleteButton"
                    Command="{x:Bind ViewModel.CompleteSaleCommand}"
                    Style="{ThemeResource AccentButtonStyle}"
                    Padding="12,8"
                    CornerRadius="4"
                    VerticalAlignment="Bottom" />
        </Grid>
    </Border>
</UserControl>
