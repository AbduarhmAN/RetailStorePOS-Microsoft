<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="RetailStorePOS.WinUiLogin.Views.CheckoutPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:data="using:RetailStorePOS.Data.Models"
    xmlns:models="using:RetailStorePOS.WinUiLogin.Models"
    xmlns:common="using:RetailStorePOS.WinUiLogin.Common"
    xmlns:input="using:Microsoft.UI.Xaml.Input"
    xmlns:animation="using:Microsoft.UI.Xaml.Media.Animation"
    xmlns:local="using:RetailStorePOS.WinUiLogin.Views"
    mc:Ignorable="d"
    Background="#F9FAFB">

    <Page.Resources>
        <ThemeShadow x:Key="CardShadow" />
    </Page.Resources>

    <Grid Padding="8" x:Name="PageRootGrid">
        <InfoBar x:Name="InventoryAlertInfoBar"
                 x:Uid="Checkout_Alert_Inventory"
                 Message="{x:Bind ViewModel.InventoryAlertMessage, Mode=OneWay}"
                 IsOpen="{x:Bind ViewModel.IsInventoryAlertOpen, Mode=TwoWay}"
                 Severity="Warning"
                 IsClosable="True"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Top"
                 Margin="0,0,0,0"
                 Canvas.ZIndex="100" />

        <ContentDialog x:Name="DiscountDialog"
                       x:Uid="Checkout_Discount"
                       Title="Apply Discount"
                       PrimaryButtonText="Apply"
                       CloseButtonText="Discard"
                       PrimaryButtonClick="DiscountDialog_PrimaryButtonClick">
            <StackPanel Spacing="16">
                <TextBlock x:Uid="Checkout_Discount_Text" TextWrapping="Wrap" />
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="8" VerticalAlignment="Bottom">
                        <TextBlock x:Uid="Checkout_Discount_TypeLabel" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ToggleSwitch OnContent="Percentage (%)" OffContent="Amount ($)" IsOn="{x:Bind ViewModel.IsDiscountPercentage, Mode=TwoWay}" />
                    </StackPanel>
                    <NumberBox x:Name="DiscountAmountBox"
                               Grid.Column="1"
                               x:Uid="Checkout_Discount_ValueHeader"
                               Value="{x:Bind ViewModel.DiscountAmount, Mode=TwoWay}"
                               SpinButtonPlacementMode="Hidden"
                               Minimum="0"
                               common:NumericInputNormalization.NormalizeOnLostFocus="True" />
                </Grid>
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="Checkout_Discount_PresetsTitle" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Grid ColumnSpacing="8" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Button Content="5%" Tag="pct:5" Click="DiscountPresetButton_Click" HorizontalAlignment="Stretch" />
                        <Button Grid.Column="1" Content="10%" Tag="pct:10" Click="DiscountPresetButton_Click" HorizontalAlignment="Stretch" />
                        <Button Grid.Row="1" Content="$1" Tag="amt:1" Click="DiscountPresetButton_Click" HorizontalAlignment="Stretch" />
                        <Button Grid.Row="1" Grid.Column="1" Content="$5" Tag="amt:5" Click="DiscountPresetButton_Click" HorizontalAlignment="Stretch" />
                    </Grid>
                </StackPanel>
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                    <Run x:Uid="Checkout_Discount_SummaryLabel" />
                    <Run Text="{x:Bind ViewModel.DiscountAmountText, Mode=OneWay}" FontWeight="SemiBold" />
                </TextBlock>
            </StackPanel>
        </ContentDialog>

        <Grid ColumnSpacing="0"
              RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="7*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Row="0"
                  Grid.Column="0"
                  RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Grid.Column="0"
                        Background="{ThemeResource AcrylicBackgroundFillColorBaseBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,0,1,0"
                        CornerRadius="0"
                        Padding="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Padding="10,8" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE7BF;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontSize="18" />
                            </StackPanel>

                      

                            <Button Grid.Column="2"
                                    Command="{x:Bind ViewModel.AddDiscountCommand}"
                                    x:Uid="Checkout_Cart_DiscountButton"
                                    Padding="12,6"
                                    CornerRadius="4"
                                    VerticalAlignment="Center" />

                            <Button Grid.Column="3"
                                    Click="ClearCartButton_Click"
                                    IsEnabled="{x:Bind ViewModel.CanClearCart, Mode=OneWay}"
                                    x:Uid="Checkout_Cart_ClearButton"
                                    Padding="12,6"
                                    CornerRadius="4"
                                    VerticalAlignment="Center" />
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,6,0,6">
                                <ListView x:Name="CartItemsListView"
                                      ItemsSource="{x:Bind ViewModel.CartItems, Mode=OneWay}"
                                      Visibility="{x:Bind ViewModel.CartListVisibility, Mode=OneWay}"
                                      SelectionMode="None"
                                      Padding="0"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollMode="Enabled">
                                <ListView.Header>
                                    <Border Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                            CornerRadius="4"
                                            Padding="10,0"
                                            HorizontalAlignment="Stretch">
                                    </Border>
                                </ListView.Header>
                                <ListView.ItemContainerTransitions>
                                    <animation:TransitionCollection />
                                </ListView.ItemContainerTransitions>
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                        <Setter Property="Padding" Value="0,1" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:CheckoutCartItem">
                                        <Border BorderBrush="#E5E7EB" 
                                                BorderThickness="1"
                                                CornerRadius="7"
                                                
                                                Background="White"
                                                Shadow="{ThemeResource CardShadow}"
                                                Translation="0,0,8">
                                            <Grid>
                                                <Border Width="4" 
                                                        HorizontalAlignment="Left" 
                                                        Background="#2563EB" 
                                                        CornerRadius="12,0,0,12" />
                                                <Grid HorizontalAlignment="Stretch"
                                                      Padding="16,14"
                                                      MinHeight="84">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>

                                                <!-- Top Row: Name and Trash Icon -->
                                                <TextBlock Grid.Row="0" Grid.Column="0"
                                                           Text="{x:Bind Name}"
                                                           FontWeight="Bold"
                                                           FontSize="12"
                                                           Foreground="#111827"
                                                           TextWrapping="WrapWholeWords"
                                                           MaxLines="1"
                                                           HorizontalAlignment="Left"
                                                           VerticalAlignment="Center" />

                                                <Button Grid.Row="0" Grid.Column="1"
                                                        Command="{Binding DataContext.RemoveItemCommand, ElementName=RootPage}"
                                                        CommandParameter="{x:Bind}"
                                                        Background="#FEF2F2"
                                                        Foreground="#EF4444"
                                                        Width="28"
                                                        Height="28"
                                                        CornerRadius="14"
                                                        Padding="0"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center">
                                                    <Button.Resources>
                                                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FEE2E2" />
                                                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FECACA" />
                                                    </Button.Resources>
                                                    <FontIcon Glyph="&#xE711;" FontSize="14" />
                                                </Button>

                                                <!-- Bottom Row: Qty/Unit and Total Price -->
                                                <StackPanel Grid.Row="1" Grid.Column="0"
                                                            Orientation="Horizontal" Spacing="6" 
                                                            VerticalAlignment="Bottom"
                                                            Margin="0,8,0,0">
                                                    <Border Background="#F3F4F6"
                                                            BorderBrush="#E5E7EB"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Padding="6,2">
                                                        <TextBlock Text="{x:Bind QuantityText, Mode=OneWay}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#4B5563" />
                                                    </Border>
                                                    <TextBlock Text="{x:Bind QuantityPriceUnitText, Mode=OneWay}"
                                                               FontSize="13"
                                                               Foreground="#6B7280"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>

                                                <TextBlock Grid.Row="1" Grid.Column="1"
                                                           Text="{x:Bind LineTotalAmountText, Mode=OneWay}"
                                                           FontWeight="Bold"
                                                           FontSize="16"
                                                           Foreground="#111827"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Bottom" />
                                            </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <Border Visibility="{x:Bind ViewModel.EmptyCartVisibility, Mode=OneWay}"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="18,14"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <StackPanel HorizontalAlignment="Center" Spacing="10">
                                    <Border Width="56"
                                            Height="56"
                                            Background="#F1F5F9"
                                            CornerRadius="28"
                                            HorizontalAlignment="Center">
                                        <FontIcon Glyph="&#xE7BF;" Foreground="#94A3B8" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock x:Uid="Checkout_Cart_EmptyTitle" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock x:Uid="Checkout_Cart_EmptySubtitle"
                                               TextWrapping="WrapWholeWords"
                                               HorizontalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Border>
                        </Grid>

                        <!-- Integrated Footer Area -->
                        <Grid Grid.Row="2" Margin="0">
                            <Border Background="#1E293B" CornerRadius="0" Padding="20,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Uid="Checkout_Footer_GrandTotal" FontSize="11" CharacterSpacing="100" Foreground="#94A3B8" FontWeight="Bold" />
                                        <TextBlock Text="{x:Bind ViewModel.CartItemsCountText, Mode=OneWay}" FontSize="12" Foreground="#64748B" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <TextBlock Text="{x:Bind ViewModel.TotalAmountText, Mode=OneWay}" FontWeight="Bold" FontSize="28" Foreground="White" HorizontalAlignment="Right" />
                                        <TextBlock FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Right" Margin="0,-2,0,0">
                                            <Run x:Uid="Checkout_Footer_SubtotalLabel" />
                                            <Run Text="{x:Bind ViewModel.SubtotalAmountText, Mode=OneWay}" />
                                            <Run Text=" + " />
                                            <Run x:Uid="Checkout_Footer_TaxLabel" />
                                            <Run Text="{x:Bind ViewModel.TaxAmountText, Mode=OneWay}" />
                                            <Run x:Uid="Checkout_Footer_TaxSuffix" />
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="0"
                    Grid.Column="1"
                    Background="Transparent"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0"
                    CornerRadius="0"
                    Padding="10,0,0,0">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

 

                    <Border Grid.Row="1"
                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,0">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <FontIcon Glyph="&#xE721;"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      VerticalAlignment="Center" />

                            <TextBox Grid.Column="1"
                                     x:Name="SearchTextBox"
                                     x:Uid="Checkout_Search_Placeholder"
                                     Text="{x:Bind ViewModel.SearchTerm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0,10,0,10"
                                     TextChanged="SearchTextBox_TextChanged"
                                     PreviewKeyDown="SearchTextBox_PreviewKeyDown">
                                <TextBox.Resources>
                                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlElevationBorderBrush" Color="Transparent" />
                                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                </TextBox.Resources>
                            </TextBox>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2"
                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8,4"
                            HorizontalAlignment="Stretch">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind ViewModel.SearchResultsCountText, Mode=OneWay}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <ListView Grid.Row="3"
                              x:Name="SearchResultsListView"
                              ItemsSource="{x:Bind ViewModel.SearchResults, Mode=OneWay}"
                              IsItemClickEnabled="True"
                              Loaded="SearchResultsListView_Loaded"
                              SizeChanged="SearchResultsListView_SizeChanged"
                              PreviewKeyDown="SearchResultsListView_PreviewKeyDown"
                              ItemClick="SearchResultsListView_ItemClick"
                              SelectionMode="None"
                              HorizontalAlignment="Stretch"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.HorizontalScrollMode="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollMode="Enabled">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal"
                                               ItemHeight="92" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,4,6" />
                                <Setter Property="UseSystemFocusVisuals" Value="False" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:SearchResultItem">
                                <Border Background="{x:Bind CardBackgroundBrush, Mode=OneWay}"
                                        BorderBrush="{x:Bind CardBorderBrush, Mode=OneWay}"
                                        BorderThickness="{x:Bind CardBorderThickness, Mode=OneWay}"
                                        CornerRadius="4"
                                        Padding="0"
                                        PointerEntered="SearchResultCard_PointerEntered"
                                        PointerExited="SearchResultCard_PointerExited">
                                    <Grid>
                                        <!-- Image-backed layout -->
                                        <Grid Visibility="{x:Bind HasThumbnail, Mode=OneWay}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Border Grid.Row="0" Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="4,4,0,0">
                                                <Image Source="{x:Bind ThumbnailImageSource, Mode=OneWay}" Stretch="UniformToFill" />
                                            </Border>

                                            <Grid Grid.Row="1" Padding="8,0,8,6" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="0,0,4,4">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="12" MaxLines="2" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            </Grid>
                                        </Grid>

                                        <!-- No-image layout -->
                                        <Grid Visibility="{x:Bind HasNoThumbnail, Mode=OneWay}" Padding="10,8">
                                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" />
                                                <TextBlock Text="{x:Bind FormattedPrice}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Grid.ColumnSpan="2"
                    Background="#F8F9FA"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="8"
                    MinHeight="50">
                <Grid ColumnSpacing="6"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      MinHeight="50">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.8*" MinWidth="140" />
                        <ColumnDefinition Width="1.2*" MinWidth="120" />
                        <ColumnDefinition Width="1*" MinWidth="90" />
                        <ColumnDefinition Width="1*" MinWidth="90" />
                        <ColumnDefinition Width="1*" MinWidth="90" />
                        <ColumnDefinition Width="1.6*" MinWidth="140" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             x:Name="TenderedCashBox"
                             Text="{x:Bind ViewModel.TenderedInputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             common:NumericInputNormalization.NormalizeOnLostFocus="True"
                             CornerRadius="4"
                             Background="LightGray"
                             x:Uid="Checkout_Pay_TenderPlaceholder"
                             ToolTipService.ToolTip="Shortcut: Ctrl+D"
                             BorderThickness="1"
                             Padding="0"
                             VerticalAlignment="Stretch"
                             VerticalContentAlignment="Center"
                             HorizontalContentAlignment="Center"
                             TextAlignment="Center"
                             FontSize="24"
                             FontWeight="Bold"
                             GotFocus="TenderedCashBox_GotFocus"
                             TextChanged="TenderedCashBox_TextChanged"
                             KeyDown="TenderedCashBox_KeyDown">
                        <TextBox.KeyboardAccelerators>
                            <input:KeyboardAccelerator Key="D"
                                                       Modifiers="Control"
                                                       Invoked="TenderedCashBox_CtrlD_Invoked" />
                        </TextBox.KeyboardAccelerators>
                    </TextBox>

                    <Button Grid.Column="1"
                            Command="{x:Bind ViewModel.TenderExactCommand}"
                            Background="#DBEAFE"
                            Foreground="#1E3A8A"
                            Padding="12,6"
                            CornerRadius="6"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#BFDBFE" />
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#93C5FD" />
                            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#1E3A8A" />
                        </Button.Resources>
                        <Grid ColumnSpacing="6" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" MinWidth="0" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8FB;" FontSize="16" FontWeight="Bold" Foreground="#1E3A8A" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       x:Uid="Checkout_Pay_ExactButtonText"
                                       FontWeight="Bold"
                                       FontSize="16"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="WrapWholeWords"
                                       Foreground="#1E3A8A" />
                        </Grid>
                    </Button>

                    <Button Grid.Column="2"
                            Command="{x:Bind ViewModel.TenderPlus1Command}"
                            Background="#E0E7FF"
                            Foreground="#3730A3"
                            Padding="10,0"
                            CornerRadius="6"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#C7D2FE" />
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#A5B4FC" />
                            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#3730A3" />
                        </Button.Resources>
                        <TextBlock Text="{x:Bind ViewModel.QuickCash1Text, Mode=OneWay}"
                                   FontWeight="Bold"
                                   FontSize="16"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="WrapWholeWords"
                                   Foreground="#3730A3" />
                    </Button>

                    <Button Grid.Column="3"
                            Command="{x:Bind ViewModel.TenderPlus2Command}"
                            Background="#F5F3FF"
                            Foreground="#5B21B6"
                            Padding="10,0"
                            CornerRadius="6"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#EDE9FE" />
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#DDD6FE" />
                            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#5B21B6" />
                        </Button.Resources>
                        <TextBlock Text="{x:Bind ViewModel.QuickCash2Text, Mode=OneWay}"
                                   FontWeight="Bold"
                                   FontSize="16"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="WrapWholeWords"
                                   Foreground="#5B21B6" />
                    </Button>

                    <Button Grid.Column="4"
                            Command="{x:Bind ViewModel.TenderPlus3Command}"
                            Background="#ECFDF5"
                            Foreground="#065F46"
                            Padding="10,0"
                            CornerRadius="6"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#D1FAE5" />
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#A7F3D0" />
                            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#065F46" />
                        </Button.Resources>
                        <TextBlock Text="{x:Bind ViewModel.QuickCash3Text, Mode=OneWay}"
                                   FontWeight="Bold"
                                   FontSize="16"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="WrapWholeWords"
                                   Foreground="#065F46" />
                    </Button>

                    <Border Grid.Column="5"
                            Visibility="{x:Bind ViewModel.StatusVisibility, Mode=OneWay}"
                            Background="{x:Bind ViewModel.StatusBackgroundBrush, Mode=OneWay}"
                            BorderBrush="{x:Bind ViewModel.StatusBorderBrush, Mode=OneWay}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10,8"
                            Margin="2,0,0,0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                        <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                                   Foreground="{x:Bind ViewModel.StatusTextBrush, Mode=OneWay}"
                                   TextWrapping="WrapWholeWords"
                                   VerticalAlignment="Center"
                                   MaxLines="2" />
                    </Border>

                    <Border Grid.Column="6"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Stretch"
                            Background="{ThemeResource AppBarItemPointerOverBackgroundThemeBrush}"
                            BorderBrush="{ThemeResource AppBarItemPointerOverBackgroundThemeBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10,8">
                        <Grid ColumnSpacing="12" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Uid="Checkout_Pay_ChangeLabel" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ChangeDueText, Mode=OneWay}" FontWeight="Bold" />
                        </Grid>
                    </Border>

                    <Button Grid.Column="7"
                            Command="{x:Bind ViewModel.CompleteSaleCommand}"
                            x:Uid="Checkout_Pay_CompleteButton"
                            Style="{ThemeResource AccentButtonStyle}"
                            Padding="12,8"
                            CornerRadius="4"
                            VerticalAlignment="Stretch" 
                            MinWidth="240"/>
                </Grid>
            </Border>
        </Grid>
    <Grid Visibility="{x:Bind ViewModel.ReceiptVisibility, Mode=OneWay}">
        <Rectangle Fill="#B0182438" />

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Margin="12">
            <Grid>
                <Border HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="510"
                        MaxHeight="860"
                        Background="#FFFDFDFE"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="30,24">
                    <Grid RowSpacing="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid x:Name="ReceiptPrintContent"
                              Grid.Row="0"
                              Grid.RowSpan="4"
                              RowSpacing="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0"
                                        HorizontalAlignment="Center"
                                        Spacing="8"
                                        Margin="0,0,0,6">
                                <Border Width="70"
                                        Height="70"
                                        CornerRadius="4"
                                        Background="#a6a6a63b"
                                        HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE73E;"
                                              Width="30"
                                              Height="30"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{x:Bind ViewModel.StoreName, Mode=OneWay}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.StoreAddress, Mode=OneWay}"
                                           FontSize="11"
                                           HorizontalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="WrapWholeWords"
                                           TextAlignment="Center"
                                           Visibility="{x:Bind ViewModel.StoreAddressVisibility, Mode=OneWay}" />
                                <TextBlock x:Uid="Checkout_Receipt_CompleteTitle"
                                            FontSize="22"
                                            FontWeight="Black"
                                            HorizontalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock FontSize="13"
                                           HorizontalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                    <Run x:Uid="Checkout_Receipt_NumberLabel" />
                                    <Run Text="{x:Bind ViewModel.LastReceiptNumberLabel, Mode=OneWay}"
                                         FontWeight="SemiBold" />
                                </TextBlock>
                            </StackPanel>

                            <Border Grid.Row="1"
                                    Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                    CornerRadius="4"
                                    Padding="0,14">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock x:Uid="Checkout_Receipt_ChangeDueLabel"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Margin="0,0,0,4" />
                                    <TextBlock FontSize="40"
                                               FontWeight="Black"
                                               HorizontalAlignment="Center"
                                               Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                               Text="{x:Bind ViewModel.LastReceiptChangeText, Mode=OneWay}" />
                                </StackPanel>
                            </Border>

                            <ScrollViewer Grid.Row="2"
                                          VerticalScrollBarVisibility="Auto"
                                          MaxHeight="220">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.ReceiptItems, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:ReceiptLineItem">
                                            <Grid Margin="0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="110" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                           Text="{x:Bind Name}"
                                                           FontSize="13"
                                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{x:Bind QuantityText}"
                                                           Margin="8,0"
                                                           FontSize="13"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Grid.Column="2"
                                                           HorizontalAlignment="Right"
                                                           FontSize="13"
                                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                           Text="{x:Bind LineTotalText}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <StackPanel Grid.Row="3">
                                <Border Height="1"
                                        Background="{ThemeResource CardStrokeColorDefaultBrush}"
                                        Margin="0,0,0,10" />
                                <Grid Margin="0,10,0,0">
                                    <TextBlock x:Uid="Checkout_Receipt_TotalCharged"
                                               FontWeight="SemiBold"
                                               FontSize="14"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <TextBlock HorizontalAlignment="Right"
                                               FontWeight="Bold"
                                               FontSize="14"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                               Text="{x:Bind ViewModel.LastReceiptTotalText, Mode=OneWay}" />
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="4">
                            <TextBlock x:Uid="Checkout_Receipt_PrinterTip"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,10"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Margin="0,0,0,10">
                            <Button Click="PrintReceiptButton_Click"
                                    x:Uid="Checkout_Receipt_PrintButton"
                                    Padding="14,8"
                                    CornerRadius="4"
                                    Margin="0,0,8,0" />
                                <Button Command="{x:Bind ViewModel.OpenReceiptsFolderCommand}"
                                        x:Uid="Checkout_Receipt_FolderButton"
                                        Padding="14,8"
                                        CornerRadius="4" />
                            </StackPanel>

                            <Button Command="{x:Bind ViewModel.DismissReceiptCommand}"
                                    x:Uid="Checkout_Receipt_NewSaleButton"
                                    MinWidth="150"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    Padding="12,10"
                                    CornerRadius="4" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
    
    <!-- Hidden container removed -->

    <!-- Register Not Open Overlay — blocks ONLY the checkout content, not the app navigation -->
    <Grid x:Name="RegisterOverlay" Visibility="Collapsed" Canvas.ZIndex="200"
          Background="#F9FAFB">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" MaxWidth="400">
            <FontIcon Glyph="&#xE825;" FontSize="48" Foreground="#8F96A3" HorizontalAlignment="Center"/>
            <TextBlock x:Uid="Checkout_Register_ClosedTitle" FontSize="22" FontWeight="Bold" Foreground="#1A1D23"
                       HorizontalAlignment="Center"/>
            <TextBlock x:Uid="Checkout_Register_ClosedText"
                       TextWrapping="Wrap" Foreground="#8F96A3" FontSize="14" TextAlignment="Center"
                       HorizontalAlignment="Center"/>

            <Button x:Name="OpenRegisterOverlayButton" x:Uid="Checkout_Register_OpenButton"
                    Click="OpenRegisterOverlayButton_Click"
                    Style="{StaticResource AccentButtonStyle}"
                    HorizontalAlignment="Center" Padding="24,12" FontSize="16" CornerRadius="6"/>

        </StackPanel>
    </Grid>

    </Grid>
</Page>
