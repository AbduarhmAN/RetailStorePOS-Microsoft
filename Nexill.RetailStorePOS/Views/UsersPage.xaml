<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="RetailStorePOS.WinUiLogin.Views.UsersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:data="using:RetailStorePOS.Data.Models"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <Style x:Key="UsersTitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="UsersSubtitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="WrapWholeWords" />
        </Style>

        <Style x:Key="UsersSectionTitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="UsersMetricValueTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="UsersMetricLabelTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="UsersCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="20" />
        </Style>

        <Style x:Key="UsersSectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
    </Page.Resources>

    <Grid Padding="3,3,3,3">
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.5*" />
                <ColumnDefinition Width="1.5*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource UsersCardStyle}"
                    Padding="16,16,16,10">
                <Grid RowSpacing="7">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="4" Margin="16">
                            <TextBlock x:Uid="Users_List_Title"
                                       Style="{StaticResource UsersSectionTitleTextStyle}" />
                            <TextBlock x:Uid="Users_List_Subtitle"
                                       Style="{StaticResource UsersSubtitleTextStyle}" />
                        </StackPanel>

                        <Border Grid.Column="1"
                                BorderBrush="{ThemeResource ControlFillColorTransparent}"
                                BorderThickness="1"
                                CornerRadius="2"
                                Padding="10,5"
                                VerticalAlignment="Top">
                            <TextBlock Text="{x:Bind ViewModel.TotalUsers, Mode=OneWay}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </Border>
                    </Grid>

                    <ListView Grid.Row="2"
                              x:Name="UsersListView"
                              ItemsSource="{x:Bind ViewModel.Users, Mode=OneWay}"
                              SelectionMode="Single"
                              IsItemClickEnabled="True"
                              SelectionChanged="UsersListView_SelectionChanged"
                              Padding="0"
                              BorderThickness="0">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,8" />
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="data:User">
                                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="12,11"
                                        Tapped="UserCard_Tapped">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <PersonPicture Width="40"
                                                       Height="40"
                                                       DisplayName="{x:Bind DisplayName}" />

                                        <StackPanel Grid.Column="1"
                                                    Spacing="3"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind DisplayName}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                            <TextBlock Text="{x:Bind Username}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>

                                        <Border Grid.Column="2"
                                                Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource AccentFillColorTertiaryBrush}"
                                                BorderThickness="1"
                                                CornerRadius="2"
                                                Padding="10,5"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind IsAdmin, Converter={StaticResource UserRoleConverter}, Mode=OneWay}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Style="{StaticResource UsersCardStyle}"
                    Padding="16">
                <Grid RowSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.EditorTitle, Mode=OneWay}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.EditorSubtitle, Mode=OneWay}"
                                       Style="{StaticResource UsersSubtitleTextStyle}" />
                        </StackPanel>

                        <CommandBar Grid.Column="1"
                                    Background="Transparent"
                                    DefaultLabelPosition="Right"
                                    VerticalAlignment="Center">
                            <AppBarButton x:Name="NewUserButton"
                                          x:Uid="Users_Editor_NewButton" CornerRadius="6"
                                          Background="#fcfcfc"
                                          Command="{x:Bind ViewModel.NewUserCommand}"
                                          IsEnabled="{x:Bind ViewModel.CanManageUsers, Mode=OneWay}">
                                <AppBarButton.Icon>
                                    <SymbolIcon Symbol="Add" />
                                </AppBarButton.Icon>
                            </AppBarButton>

                            <AppBarButton x:Name="UnlockUserButton"
                                           x:Uid="Users_Editor_UnlockButton"
                                           CornerRadius="3"
                                           Background="#fcfcfc"
                                           Command="{x:Bind ViewModel.UnlockEditCommand}"
                                          Visibility="{x:Bind ViewModel.IsUnlockRequiredVisibility, Mode=OneWay}">
                                <AppBarButton.Icon>
                                    <SymbolIcon Symbol="Edit" />
                                </AppBarButton.Icon>
                            </AppBarButton>
                        </CommandBar>
                    </Grid>

                    <Grid Grid.Row="1">
                        <ScrollViewer x:Name="UserEditorScrollViewer"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Spacing="14">
                                <Border Visibility="{x:Bind ViewModel.ReadOnlyBannerVisibility, Mode=OneWay}"
                                        Style="{StaticResource UsersSectionCardStyle}"
                                        Padding="12,10">
                                    <TextBlock x:Uid="Users_Editor_ReadOnlyBanner"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Border>

                                <InfoBar IsOpen="{x:Bind ViewModel.IsOnboardingActive, Mode=OneWay}"
                                         Severity="Error"
                                         IsClosable="False"
                                         x:Uid="Users_Editor_SecurityWarning" />

                                <Border Style="{StaticResource UsersSectionCardStyle}"
                                        Padding="16"
                                        Visibility="{x:Bind ViewModel.HasSelectedUserVisibility, Mode=OneWay}">
                                    <StackPanel Spacing="14">
                                        <StackPanel Spacing="4">
                                            <TextBlock x:Uid="Users_Section_Identity"
                                                       Style="{StaticResource UsersSectionTitleTextStyle}" />
                                            <TextBlock x:Uid="Users_Section_Identity_Subtitle"
                                                       Style="{StaticResource UsersSubtitleTextStyle}" />
                                        </StackPanel>

                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Spacing="6">
                                                <TextBlock x:Uid="Users_Label_DisplayName" Style="{StaticResource UsersSubtitleTextStyle}" />
                                                <TextBox Text="{x:Bind ViewModel.EditDisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" CornerRadius="3"
                                                         IsReadOnly="{x:Bind ViewModel.IsEditLocked, Mode=OneWay}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Spacing="6">
                                                <TextBlock x:Uid="Users_Label_Username" Style="{StaticResource UsersSubtitleTextStyle}" />
                                                <TextBox Text="{x:Bind ViewModel.EditUsername, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" CornerRadius="3"
                                                         IsReadOnly="{x:Bind ViewModel.IsEditLocked, Mode=OneWay}" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource UsersSectionCardStyle}"
                                        Padding="16"
                                        Visibility="{x:Bind ViewModel.HasSelectedUserVisibility, Mode=OneWay}">
                                    <StackPanel Spacing="14">
                                        <StackPanel Spacing="4">
                                            <TextBlock x:Uid="Users_Section_Security"
                                                       Style="{StaticResource UsersSectionTitleTextStyle}" />
                                            <TextBlock x:Uid="Users_Section_Security_Subtitle"
                                                       Style="{StaticResource UsersSubtitleTextStyle}" />
                                        </StackPanel>

                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Spacing="6">
                                                <TextBlock x:Uid="Users_Label_PIN" Style="{StaticResource UsersSubtitleTextStyle}" />
                                                <TextBox Text="{x:Bind ViewModel.EditPin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" CornerRadius="3"
                                                         IsReadOnly="{x:Bind ViewModel.IsEditLocked, Mode=OneWay}"
                                                         MaxLength="4"
                                                         FontFamily="Consolas" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1"
                                                        Spacing="6"
                                                        Visibility="{x:Bind ViewModel.AdminPasswordVisibility, Mode=OneWay}">
                                                <TextBlock x:Uid="Users_Label_AdminPassword" Style="{StaticResource UsersSubtitleTextStyle}" />
                                                <PasswordBox x:Name="EditorPasswordBox"
                                                              IsEnabled="{x:Bind ViewModel.IsEditUnlocked, Mode=OneWay}" />
                                                <TextBlock x:Uid="Users_Label_AdminPasswordHint"
                                                           Style="{StaticResource UsersSubtitleTextStyle}" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource UsersSectionCardStyle}"
                                      
                                        Padding="16"
                                        Visibility="{x:Bind ViewModel.HasSelectedUserVisibility, Mode=OneWay}">
                                    <StackPanel Spacing="14">
                                        <Grid ColumnSpacing="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Spacing="4">
                                                <TextBlock x:Uid="Users_Section_Roles"
                                                           Style="{StaticResource UsersSectionTitleTextStyle}" />
                                                <TextBlock x:Uid="Users_Section_Roles_Subtitle"
                                                           Style="{StaticResource UsersSubtitleTextStyle}" />
                                            </StackPanel>

                                            <Border Grid.Column="1"
                                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="2"
                                                    Padding="10,6"
                                                    VerticalAlignment="Top">
                                                <TextBlock Text="{x:Bind ViewModel.AccessLevelLabel, Mode=OneWay}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Border>
                                        </Grid>

                                        <StackPanel Spacing="14">
                                            <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Spacing="14">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="2">
                                                        <TextBlock x:Uid="Users_Role_Admin"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                                        <TextBlock x:Uid="Users_Role_Admin_Description"
                                                                   Style="{StaticResource UsersSubtitleTextStyle}" />
                                                    </StackPanel>
     <ToggleSwitch x:Name="AdministratorAccessToggle"
                    Grid.Column="1"
                    IsOn="{x:Bind ViewModel.EditIsAdmin, Mode=TwoWay}"
                    IsEnabled="{x:Bind ViewModel.IsEditUnlocked, Mode=OneWay}" />
                                                </Grid>

                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="2">
                                                        <TextBlock x:Uid="Users_Role_Checkout"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                                        <TextBlock x:Uid="Users_Role_Checkout_Description"
                                                                   Style="{StaticResource UsersSubtitleTextStyle}" />
                                                    </StackPanel>
                                                    <ToggleSwitch Grid.Column="1"
                                                                  IsOn="{x:Bind ViewModel.EditCanCheckout, Mode=TwoWay}"
                                                                  IsEnabled="{x:Bind ViewModel.IsEditUnlocked, Mode=OneWay}" />
                                                </Grid>

                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="2">
                                                        <TextBlock x:Uid="Users_Role_Override"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                                        <TextBlock x:Uid="Users_Role_Override_Description"
                                                                   Style="{StaticResource UsersSubtitleTextStyle}" />
                                                    </StackPanel>
                                                    <ToggleSwitch Grid.Column="1"
                                                                  IsOn="{x:Bind ViewModel.EditCanOverridePrice, Mode=TwoWay}"
                                                                  IsEnabled="{x:Bind ViewModel.IsEditUnlocked, Mode=OneWay}" />
                                                </Grid>

                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="2">
                                                        <TextBlock x:Uid="Users_Role_Reports"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                                        <TextBlock x:Uid="Users_Role_Reports_Description"
                                                                   Style="{StaticResource UsersSubtitleTextStyle}" />
                                                    </StackPanel>
                                                    <ToggleSwitch Grid.Column="1"
                                                                  IsOn="{x:Bind ViewModel.EditCanViewReports, Mode=TwoWay}"
                                                                  IsEnabled="{x:Bind ViewModel.IsEditUnlocked, Mode=OneWay}" />
                                                </Grid>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Spacing="14">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="2">
                                                        <TextBlock x:Uid="Users_Role_Products"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                                        <TextBlock x:Uid="Users_Role_Products_Description"
                                                                   Style="{StaticResource UsersSubtitleTextStyle}" />
                                                    </StackPanel>
                                                    <ToggleSwitch Grid.Column="1"
                                                                  IsOn="{x:Bind ViewModel.EditCanManageProducts, Mode=TwoWay}"
                                                                  IsEnabled="{x:Bind ViewModel.IsEditUnlocked, Mode=OneWay}" />
                                                </Grid>

                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="2">
                                                        <TextBlock x:Uid="Users_Role_Settings"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                                        <TextBlock x:Uid="Users_Role_Settings_Description"
                                                                   Style="{StaticResource UsersSubtitleTextStyle}" />
                                                    </StackPanel>
                                                    <ToggleSwitch Grid.Column="1"
                                                                  IsOn="{x:Bind ViewModel.EditCanManageSettings, Mode=TwoWay}"
                                                                  IsEnabled="{x:Bind ViewModel.IsEditUnlocked, Mode=OneWay}" />
                                                </Grid>
                                            </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource UsersSectionCardStyle}"
                                        Padding="14,12"
                                        Visibility="{x:Bind ViewModel.HasSelectedUserVisibility, Mode=OneWay}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0"
                                                Background="#DC2626"
                                                Foreground="White"
                                                BorderBrush="#B91C1C"
                                                Command="{x:Bind ViewModel.DeactivateUserCommand}"
                                                Visibility="{x:Bind ViewModel.CanDeactivateVisibility, Mode=OneWay}"
                                                IsEnabled="{x:Bind ViewModel.CanManageUsers, Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <SymbolIcon Symbol="Delete" />
                                                <TextBlock x:Uid="Users_Button_Deactivate" />
                                            </StackPanel>
                                        </Button>

                                        <TextBlock Grid.Column="1"
                                                   x:Uid="Users_Button_Deactivate_Tip"
                                                   Style="{StaticResource UsersSubtitleTextStyle}"
                                                   VerticalAlignment="Center"
                                                   Margin="10,0,10,0" />

                                        <StackPanel Grid.Column="2"
                                                    Orientation="Horizontal"
                                                    Spacing="10"
                                                    VerticalAlignment="Center">
                                            <Button Background="Transparent" CornerRadius="3"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                    Command="{x:Bind ViewModel.CancelCommand}">
                                                <TextBlock x:Uid="Users_Button_Cancel" />
                                            </Button>

                                            <Button x:Name="SaveUserChangesButton"
                                                    Background="#6d998e" CornerRadius="3"
                                                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                                    Foreground="White"
                                                    Command="{x:Bind ViewModel.SaveUserCommand}"
                                                    CommandParameter="{Binding ElementName=EditorPasswordBox}"
                                                    IsEnabled="{x:Bind ViewModel.IsEditUnlocked, Mode=OneWay}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <SymbolIcon Symbol="Save" />
                                                    <TextBlock x:Uid="Users_Button_Save" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Visibility="{x:Bind ViewModel.HasStatusVisibility, Mode=OneWay}"
                                        Background="#ddd"
                         
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        Padding="12,9">
                                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                                               Foreground="Red"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               FontSize="12" />
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <Border Canvas.ZIndex="1"
                                Visibility="{x:Bind ViewModel.ShowEmptySelectionStateVisibility, Mode=OneWay}"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="0"
                                Padding="22"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="10">
                                <Border Width="68"
                                        Height="68"
                                        CornerRadius="0"
                                        HorizontalAlignment="Center">
                                    <SymbolIcon Symbol="Contact"
                                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />
                                </Border>
                                <TextBlock x:Uid="Users_Empty_Title"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                <TextBlock x:Uid="Users_Empty_Subtitle"
                                           Style="{StaticResource UsersSubtitleTextStyle}"
                                           TextAlignment="Center"
                                           Width="340" />
                            </StackPanel>
                        </Border>

                        <Border Canvas.ZIndex="2"
                                Visibility="{x:Bind ViewModel.ShowUnlockPromptVisibility, Mode=OneWay}"
                                Background="#7818233A"
                                CornerRadius="0">
                            <Border Width="420"
                                    MaxWidth="420"
                                    Padding="22"
                                    Background="{ThemeResource SystemControlForegroundChromeWhiteBrush}"
                                    BorderThickness="0.5"
                                    CornerRadius="6"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <StackPanel Spacing="0">
                                    <Border Width="52"
                                            Height="52"
                                            BorderThickness="1"
                                            CornerRadius="0"
                                            HorizontalAlignment="Center">
                                        <SymbolIcon Symbol="Help"
                                                    Width="22"
                                                    Height="22"
                                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center" />
                                    </Border>

                                    <TextBlock x:Uid="Users_Unlock_Title"
                                               FontSize="22"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                               TextAlignment="Center"
                                               Margin="0,16,0,0" />

                                    <TextBlock x:Uid="Users_Unlock_Subtitle"
                                               Style="{StaticResource UsersSubtitleTextStyle}"
                                               TextAlignment="Center"
                                               Margin="0,10,0,0" />

                                    <Border Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="14"
                                            Margin="0,16,0,0">
                                        <StackPanel>
                                            <TextBlock x:Uid="Users_Unlock_Reason_Title"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                            <TextBlock x:Uid="Users_Unlock_Reason_Text"
                                                       Style="{StaticResource UsersSubtitleTextStyle}"
                                                       Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <Grid Margin="0,20,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0"
                                                CornerRadius="3"
                                                Background="Transparent"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                Command="{x:Bind ViewModel.DismissUnlockPromptCommand}">
                                            <TextBlock x:Uid="Users_Unlock_Button_Cancel" />
                                        </Button>

                                        <Button Grid.Column="2"
                                                CornerRadius="3"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                                Foreground="White"
                                                Command="{x:Bind ViewModel.ConfirmUnlockEditCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <SymbolIcon Symbol="Edit" />
                                                <TextBlock x:Uid="Users_Unlock_Button_Confirm" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <TeachingTip x:Name="AdministratorAccessTip"
                     Target="{x:Bind UsersListView, Mode=OneWay}"
                     x:Uid="Users_Walkthrough_Admin"
                     PreferredPlacement="Right"
                     IsLightDismissEnabled="False"
                     CloseButtonClick="AdministratorAccessTip_CloseButtonClick" />
        <TeachingTip x:Name="NewUserTeachingTip"
                     Target="{x:Bind NewUserButton, Mode=OneWay}"
                     PreferredPlacement="Bottom"
                     IsLightDismissEnabled="False"
                     x:Uid="Users_Walkthrough_New"
                     ActionButtonClick="NewUserTeachingTip_ActionButtonClick"
                     CloseButtonClick="UsersWalkthroughTip_CloseButtonClick" />
        <TeachingTip x:Name="UnlockTeachingTip"
                     Target="{x:Bind UnlockUserButton, Mode=OneWay}"
                     PreferredPlacement="Bottom"
                     IsLightDismissEnabled="False"
                     x:Uid="Users_Walkthrough_Unlock"
                     ActionButtonClick="UnlockTeachingTip_ActionButtonClick"
