<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="RetailStorePOS.WinUiLogin.Views.UsersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:data="using:RetailStorePOS.Data.Models"
    mc:Ignorable="d"
    Background="Transparent"
    FlowDirection="{x:Bind ViewModel.Loc.FlowDirection, Mode=OneWay}">

    <Page.Resources>
        <!-- Card (used only for the outer left-list and right-editor containers) -->
        <Style x:Key="UP_Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E8EAF0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>

        <!-- Typography -->
        <Style x:Key="UP_SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1A1D23"/>
        </Style>

        <Style x:Key="UP_SectionSubtitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#8F96A3"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="UP_FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#5F6775"/>
            <Setter Property="CharacterSpacing" Value="40"/>
        </Style>

        <Style x:Key="UP_HelperText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#8F96A3"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="UP_RoleName" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1A1D23"/>
        </Style>

        <Style x:Key="UP_RoleDescription" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#8F96A3"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Inputs -->
        <Style x:Key="UP_TextBox" TargetType="TextBox">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="MinHeight" Value="34"/>
        </Style>

        <Style x:Key="UP_PasswordBox" TargetType="PasswordBox">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="MinHeight" Value="34"/>
        </Style>

        <!-- Buttons (single source of truth for the page) -->
        <Style x:Key="UP_PrimaryButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="UP_GhostButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E8EAF0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#1A1D23"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="UP_DangerButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FCA5A5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#DC2626"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Section divider: thin row-divider line used between sections inside a card -->
        <Style x:Key="UP_SectionDivider" TargetType="Border">
            <Setter Property="Background" Value="#F1F4F9"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
    </Page.Resources>

    <Grid Padding="16">
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.5*"/>
                <ColumnDefinition Width="1.5*"/>
            </Grid.ColumnDefinitions>

            <!-- ─── LEFT: User list ─── -->
            <Border Grid.Column="0" Style="{StaticResource UP_Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- List header -->
                    <Grid Grid.Row="0" Padding="20,16,20,14" BorderBrush="#E8EAF0" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Bind ViewModel.Users_List_Title, Mode=OneWay}"
                                       Style="{StaticResource UP_SectionTitle}"/>
                            <TextBlock Text="{x:Bind ViewModel.Users_List_Subtitle, Mode=OneWay}"
                                       Style="{StaticResource UP_SectionSubtitle}"/>
                        </StackPanel>

                        <Border Grid.Column="1"
                                Background="#EEF2FF"
                                CornerRadius="6"
                                Padding="8,3"
                                VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.TotalUsers, Mode=OneWay}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#3B82F6"/>
                        </Border>
                    </Grid>

                    <!-- List body -->
                    <ListView Grid.Row="1"
                              x:Name="UsersListView"
                              ItemsSource="{x:Bind ViewModel.Users, Mode=OneWay}"
                              SelectionMode="Single"
                              IsItemClickEnabled="True"
                              SelectionChanged="UsersListView_SelectionChanged"
                              Padding="12,12,12,12"
                              BorderThickness="0"
                              Background="Transparent">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,6"/>
                                <Setter Property="MinHeight" Value="0"/>
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="data:User">
                                <Border Background="#FAFBFC"
                                        BorderBrush="#E8EAF0"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12,10"
                                        Tapped="UserCard_Tapped">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <PersonPicture Width="36" Height="36"
                                                       DisplayName="{x:Bind DisplayName}"/>

                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind DisplayName}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="#1A1D23"/>
                                            <TextBlock Text="{x:Bind Username}"
                                                       FontSize="11"
                                                       Foreground="#8F96A3"/>
                                        </StackPanel>

                                        <Border Grid.Column="2"
                                                Background="#EEF2FF"
                                                CornerRadius="6"
                                                Padding="8,3"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind IsAdmin, Converter={StaticResource UserRoleConverter}, Mode=OneWay}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="#3B82F6"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- ─── RIGHT: Editor ─── -->
            <Border Grid.Column="1" Style="{StaticResource UP_Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Editor header with action buttons -->
                    <Grid Grid.Row="0" Padding="20,16,20,14" BorderBrush="#E8EAF0" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Bind ViewModel.EditorTitle, Mode=OneWay}"
                                       Style="{StaticResource UP_SectionTitle}"/>
                            <TextBlock Text="{x:Bind ViewModel.EditorSubtitle, Mode=OneWay}"
                                       Style="{StaticResource UP_SectionSubtitle}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button x:Name="UnlockUserButton"
                                    Content="{x:Bind ViewModel.Users_Editor_UnlockButton, Mode=OneWay}"
                                    Style="{StaticResource UP_GhostButton}"
                                    Command="{x:Bind ViewModel.UnlockEditCommand}"
                                    Visibility="{x:Bind ViewModel.IsUnlockRequiredVisibility, Mode=OneWay}"/>

                            <Button x:Name="NewUserButton"
                                    Content="{x:Bind ViewModel.Users_Editor_NewButton, Mode=OneWay}"
                                    Style="{StaticResource UP_PrimaryButton}"
                                    Command="{x:Bind ViewModel.NewUserCommand}"
                                    IsEnabled="{x:Bind ViewModel.CanManageUsers, Mode=OneWay}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Editor body -->
                    <Grid Grid.Row="1">
                        <ScrollViewer x:Name="UserEditorScrollViewer"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="20,18,20,20">
                            <StackPanel Spacing="18">
                                <!-- Read-only banner -->
                                <Border Style="{StaticResource App_BannerWarning}"
                                        Visibility="{x:Bind ViewModel.ReadOnlyBannerVisibility, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE72E;"
                                                  Style="{StaticResource App_BannerIcon}"
                                                  Foreground="{StaticResource App_BannerWarningForeground}"/>
                                        <TextBlock Text="{x:Bind ViewModel.Users_Editor_ReadOnlyBanner, Mode=OneWay}"
                                                   Style="{StaticResource App_BannerTitle}"
                                                   Foreground="{StaticResource App_BannerWarningForeground}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Onboarding warning -->
                                <InfoBar IsOpen="{x:Bind ViewModel.IsOnboardingActive, Mode=OneWay}"
                                         Severity="Error"
                                         IsClosable="False"
                                         Title="{x:Bind ViewModel.Users_Editor_SecurityWarning_Title, Mode=OneWay}"
                                         Message="{x:Bind ViewModel.Users_Editor_SecurityWarning_Message, Mode=OneWay}"/>

                                <!-- Identity section (flat, no nested card) -->
                                <StackPanel Spacing="14" Visibility="{x:Bind ViewModel.HasSelectedUserVisibility, Mode=OneWay}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind ViewModel.Users_Section_Identity, Mode=OneWay}"
                                                   Style="{StaticResource UP_SectionTitle}"/>
                                        <TextBlock Text="{x:Bind ViewModel.Users_Section_Identity_Subtitle, Mode=OneWay}"
                                                   Style="{StaticResource UP_SectionSubtitle}"/>
                                    </StackPanel>

                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Spacing="6">
                                            <TextBlock Text="{x:Bind ViewModel.Users_Label_DisplayName, Mode=OneWay}" Style="{StaticResource UP_FieldLabel}"/>
                                            <TextBox Text="{x:Bind ViewModel.EditDisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     IsReadOnly="{x:Bind ViewModel.IsEditLocked, Mode=OneWay}"
                                                     Style="{StaticResource UP_TextBox}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Spacing="6">
                                            <TextBlock Text="{x:Bind ViewModel.Users_Label_Username, Mode=OneWay}" Style="{StaticResource UP_FieldLabel}"/>
                                            <TextBox Text="{x:Bind ViewModel.EditUsername, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     IsReadOnly="{x:Bind ViewModel.IsEditLocked, Mode=OneWay}"
                                                     Style="{StaticResource UP_TextBox}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <Border Style="{StaticResource UP_SectionDivider}"
                                        Visibility="{x:Bind ViewModel.HasSelectedUserVisibility, Mode=OneWay}"/>

                                <!-- Security section (flat, no nested card) -->
                                <StackPanel Spacing="14" Visibility="{x:Bind ViewModel.HasSelectedUserVisibility, Mode=OneWay}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind ViewModel.Users_Section_Security, Mode=OneWay}"
                                                   Style="{StaticResource UP_SectionTitle}"/>
                                        <TextBlock Text="{x:Bind ViewModel.Users_Section_Security_Subtitle, Mode=OneWay}"
                                                   Style="{StaticResource UP_SectionSubtitle}"/>
                                    </StackPanel>

                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Spacing="6">
                                            <TextBlock Text="{x:Bind ViewModel.Users_Label_PIN, Mode=OneWay}" Style="{StaticResource UP_FieldLabel}"/>
                                            <TextBox Text="{x:Bind ViewModel.EditPin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     IsReadOnly="{x:Bind ViewModel.IsEditLocked, Mode=OneWay}"
                                                     MaxLength="4"
                                                     FontFamily="Consolas"
                                                     Style="{StaticResource UP_TextBox}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1"
                                                    Spacing="6"
                                                    Visibility="{x:Bind ViewModel.AdminPasswordVisibility, Mode=OneWay}">
                                            <TextBlock Text="{x:Bind ViewModel.Users_Label_AdminPassword, Mode=OneWay}" Style="{StaticResource UP_FieldLabel}"/>
                                            <PasswordBox x:Name="EditorPasswordBox"
                                                         IsEnabled="{x:Bind ViewModel.IsEditUnlocked, Mode=OneWay}"
                                                         Style="{StaticResource UP_PasswordBox}"/>
                                            <TextBlock Text="{x:Bind ViewModel.Users_Label_AdminPasswordHint, Mode=OneWay}"
                                                       Style="{StaticResource UP_HelperText}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <Border Style="{StaticResource UP_SectionDivider}"
                                        Visibility="{x:Bind ViewModel.HasSelectedUserVisibility, Mode=OneWay}"/>

                                <!-- Roles & Permissions section (flat, no nested card) -->
                                <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.HasSelectedUserVisibility, Mode=OneWay}">
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{x:Bind ViewModel.Users_Section_Roles, Mode=OneWay}"
                                                       Style="{StaticResource UP_SectionTitle}"/>
                                            <TextBlock Text="{x:Bind ViewModel.Users_Section_Roles_Subtitle, Mode=OneWay}"
                                                       Style="{StaticResource UP_SectionSubtitle}"/>
                                        </StackPanel>

                                        <Border Grid.Column="1"
                                                Background="#F1F4F9"
                                                CornerRadius="6"
                                                Padding="10,4"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind ViewModel.AccessLevelLabel, Mode=OneWay}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="#5F6775"/>
                                        </Border>
                                    </Grid>

                                    <Grid ColumnSpacing="20" RowSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Row 0, Col 0: Admin -->
                                        <Grid Grid.Row="0" Grid.Column="0" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{x:Bind ViewModel.Users_Role_Admin, Mode=OneWay}" Style="{StaticResource UP_RoleName}"/>
                                                <TextBlock Text="{x:Bind ViewModel.Users_Role_Admin_Description, Mode=OneWay}" Style="{StaticResource UP_RoleDescription}"/>
                                            </StackPanel>
                                            <ToggleSwitch x:Name="AdministratorAccessToggle"
                                                          Grid.Column="1"
                                                          MinWidth="0"
                                                          IsOn="{x:Bind ViewModel.EditIsAdmin, Mode=TwoWay}"
                                                          IsEnabled="{x:Bind ViewModel.IsEditUnlocked, Mode=OneWay}"/>
                                        </Grid>

                                        <!-- Row 0, Col 1: Products -->
                                        <Grid Grid.Row="0" Grid.Column="1" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{x:Bind ViewModel.Users_Role_Products, Mode=OneWay}" Style="{StaticResource UP_RoleName}"/>
                                                <TextBlock Text="{x:Bind ViewModel.Users_Role_Products_Description, Mode=OneWay}" Style="{StaticResource UP_RoleDescription}"/>
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="1"
                                                          MinWidth="0"
                                                          IsOn="{x:Bind ViewModel.EditCanManageProducts, Mode=TwoWay}"
                                                          IsEnabled="{x:Bind ViewModel.IsEditUnlocked, Mode=OneWay}"/>
                                        </Grid>

                                        <!-- Row 1, Col 0: Checkout -->
                                        <Grid Grid.Row="1" Grid.Column="0" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{x:Bind ViewModel.Users_Role_Checkout, Mode=OneWay}" Style="{StaticResource UP_RoleName}"/>
                                                <TextBlock Text="{x:Bind ViewModel.Users_Role_Checkout_Description, Mode=OneWay}" Style="{StaticResource UP_RoleDescription}"/>
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="1"
                                                          MinWidth="0"
                                                          IsOn="{x:Bind ViewModel.EditCanCheckout, Mode=TwoWay}"
                                                          IsEnabled="{x:Bind ViewModel.IsEditUnlocked, Mode=OneWay}"/>
                                        </Grid>

                                        <!-- Row 1, Col 1: Settings -->
                                        <Grid Grid.Row="1" Grid.Column="1" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{x:Bind ViewModel.Users_Role_Settings, Mode=OneWay}" Style="{StaticResource UP_RoleName}"/>
                                                <TextBlock Text="{x:Bind ViewModel.Users_Role_Settings_Description, Mode=OneWay}" Style="{StaticResource UP_RoleDescription}"/>
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="1"
                                                          MinWidth="0"
                                                          IsOn="{x:Bind ViewModel.EditCanManageSettings, Mode=TwoWay}"
                                                          IsEnabled="{x:Bind ViewModel.IsEditUnlocked, Mode=OneWay}"/>
                                        </Grid>

                                        <!-- Row 2, Col 0: Override -->
                                        <Grid Grid.Row="2" Grid.Column="0" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{x:Bind ViewModel.Users_Role_Override, Mode=OneWay}" Style="{StaticResource UP_RoleName}"/>
                                                <TextBlock Text="{x:Bind ViewModel.Users_Role_Override_Description, Mode=OneWay}" Style="{StaticResource UP_RoleDescription}"/>
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="1"
                                                          MinWidth="0"
                                                          IsOn="{x:Bind ViewModel.EditCanOverridePrice, Mode=TwoWay}"
                                                          IsEnabled="{x:Bind ViewModel.IsEditUnlocked, Mode=OneWay}"/>
                                        </Grid>

                                        <!-- Row 3, Col 0: Reports -->
                                        <Grid Grid.Row="3" Grid.Column="0" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{x:Bind ViewModel.Users_Role_Reports, Mode=OneWay}" Style="{StaticResource UP_RoleName}"/>
                                                <TextBlock Text="{x:Bind ViewModel.Users_Role_Reports_Description, Mode=OneWay}" Style="{StaticResource UP_RoleDescription}"/>
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="1"
                                                          MinWidth="0"
                                                          IsOn="{x:Bind ViewModel.EditCanViewReports, Mode=TwoWay}"
                                                          IsEnabled="{x:Bind ViewModel.IsEditUnlocked, Mode=OneWay}"/>
                                        </Grid>
                                    </Grid>
                                </StackPanel>

                                <Border Style="{StaticResource UP_SectionDivider}"
                                        Visibility="{x:Bind ViewModel.HasSelectedUserVisibility, Mode=OneWay}"/>

                                <!-- Action bar (flat row, not a nested card) -->
                                <Grid ColumnSpacing="12" Visibility="{x:Bind ViewModel.HasSelectedUserVisibility, Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0"
                                            Style="{StaticResource UP_DangerButton}"
                                            Content="{x:Bind ViewModel.Users_Button_Deactivate, Mode=OneWay}"
                                            Command="{x:Bind ViewModel.DeactivateUserCommand}"
                                            Visibility="{x:Bind ViewModel.CanDeactivateVisibility, Mode=OneWay}"
                                            IsEnabled="{x:Bind ViewModel.CanManageUsers, Mode=OneWay}"/>

                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind ViewModel.Users_Button_Deactivate_Tip, Mode=OneWay}"
                                               Style="{StaticResource UP_HelperText}"
                                               VerticalAlignment="Center"
                                               Margin="6,0,6,0"/>

                                    <Button Grid.Column="2"
                                            Style="{StaticResource UP_GhostButton}"
                                            Content="{x:Bind ViewModel.Users_Button_Cancel, Mode=OneWay}"
                                            Command="{x:Bind ViewModel.CancelCommand}"/>

                                    <Button Grid.Column="3"
                                            x:Name="SaveUserChangesButton"
                                            Style="{StaticResource UP_PrimaryButton}"
                                            Content="{x:Bind ViewModel.Users_Button_Save, Mode=OneWay}"
                                            Command="{x:Bind ViewModel.SaveUserCommand}"
                                            CommandParameter="{Binding ElementName=EditorPasswordBox}"
                                            IsEnabled="{x:Bind ViewModel.IsEditUnlocked, Mode=OneWay}"/>
                                </Grid>

                                <!-- Status banner with icon -->
                                <Border Style="{StaticResource App_BannerDanger}"
                                        Visibility="{x:Bind ViewModel.HasStatusVisibility, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xEA39;"
                                                  Style="{StaticResource App_BannerIcon}"
                                                  Foreground="{StaticResource App_BannerDangerForeground}"/>
                                        <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                                                   Style="{StaticResource App_BannerTitle}"
                                                   Foreground="{StaticResource App_BannerDangerForeground}"/>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>

                        <!-- Empty selection state overlay -->
                        <Border Canvas.ZIndex="1"
                                Visibility="{x:Bind ViewModel.ShowEmptySelectionStateVisibility, Mode=OneWay}"
                                Background="White"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="6"
                                        MaxWidth="380"
                                        Padding="0,32,0,0">
                                <TextBlock Text="{x:Bind ViewModel.Users_Empty_Title, Mode=OneWay}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Foreground="#1A1D23"/>
                                <TextBlock Text="{x:Bind ViewModel.Users_Empty_Subtitle, Mode=OneWay}"
                                           FontSize="12"
                                           Foreground="#8F96A3"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Unlock prompt overlay -->
                        <Border Canvas.ZIndex="2"
                                Visibility="{x:Bind ViewModel.ShowUnlockPromptVisibility, Mode=OneWay}"
                                Background="#7818233A">
                            <Border Width="420"
                                    MaxWidth="420"
                                    Padding="22"
                                    Background="White"
                                    BorderBrush="#E8EAF0"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <StackPanel Spacing="14">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{x:Bind ViewModel.Users_Unlock_Title, Mode=OneWay}"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   Foreground="#1A1D23"/>
                                        <TextBlock Text="{x:Bind ViewModel.Users_Unlock_Subtitle, Mode=OneWay}"
                                                   FontSize="12"
                                                   Foreground="#8F96A3"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1"
                                            CornerRadius="8" Padding="14">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="#92400E" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{x:Bind ViewModel.Users_Unlock_Reason_Title, Mode=OneWay}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="#92400E"/>
                                                <TextBlock Text="{x:Bind ViewModel.Users_Unlock_Reason_Text, Mode=OneWay}"
                                                           FontSize="12"
                                                           Foreground="#78350F"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0"
                                                Style="{StaticResource UP_GhostButton}"
                                                Content="{x:Bind ViewModel.Users_Unlock_Button_Cancel, Mode=OneWay}"
                                                HorizontalAlignment="Stretch"
                                                Command="{x:Bind ViewModel.DismissUnlockPromptCommand}"/>

                                        <Button Grid.Column="1"
                                                Style="{StaticResource UP_PrimaryButton}"
                                                Content="{x:Bind ViewModel.Users_Unlock_Button_Confirm, Mode=OneWay}"
                                                HorizontalAlignment="Stretch"
                                                Command="{x:Bind ViewModel.ConfirmUnlockEditCommand}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Teaching tips -->
        <TeachingTip x:Name="AdministratorAccessTip"
                     Target="{x:Bind UsersListView, Mode=OneTime}"
                     Title="{x:Bind ViewModel.Users_Walkthrough_Admin_Title, Mode=OneWay}"
                     Subtitle="{x:Bind ViewModel.Users_Walkthrough_Admin_Subtitle, Mode=OneWay}"
                     CloseButtonContent="{x:Bind ViewModel.Generic_Close, Mode=OneWay}"
                     PreferredPlacement="Right"
                     IsLightDismissEnabled="False"
                     CloseButtonClick="AdministratorAccessTip_CloseButtonClick"/>

        <TeachingTip x:Name="NewUserTeachingTip"
                     Target="{x:Bind NewUserButton, Mode=OneTime}"
                     PreferredPlacement="Bottom"
                     IsLightDismissEnabled="False"
                     Title="{x:Bind ViewModel.Users_Walkthrough_New_Title, Mode=OneWay}"
                     Subtitle="{x:Bind ViewModel.Users_Walkthrough_New_Subtitle, Mode=OneWay}"
                     ActionButtonContent="{x:Bind ViewModel.Generic_Next, Mode=OneWay}"
                     CloseButtonContent="{x:Bind ViewModel.Generic_Close, Mode=OneWay}"
                     ActionButtonClick="NewUserTeachingTip_ActionButtonClick"
                     CloseButtonClick="UsersWalkthroughTip_CloseButtonClick"/>

        <TeachingTip x:Name="UnlockTeachingTip"
                     Target="{x:Bind UnlockUserButton, Mode=OneTime}"
                     PreferredPlacement="Bottom"
                     IsLightDismissEnabled="False"
                     Title="{x:Bind ViewModel.Users_Walkthrough_Unlock_Title, Mode=OneWay}"
                     Subtitle="{x:Bind ViewModel.Users_Walkthrough_Unlock_Subtitle, Mode=OneWay}"
                     ActionButtonContent="{x:Bind ViewModel.Generic_Next, Mode=OneWay}"
                     CloseButtonContent="{x:Bind ViewModel.Generic_Close, Mode=OneWay}"
                     ActionButtonClick="UnlockTeachingTip_ActionButtonClick"
                     CloseButtonClick="UsersWalkthroughTip_CloseButtonClick"/>

        <TeachingTip x:Name="SaveChangesTeachingTip"
                     Target="{x:Bind SaveUserChangesButton, Mode=OneTime}"
                     PreferredPlacement="Top"
                     IsLightDismissEnabled="False"
                     Title="{x:Bind ViewModel.Users_Walkthrough_Save_Title, Mode=OneWay}"
                     Subtitle="{x:Bind ViewModel.Users_Walkthrough_Save_Subtitle, Mode=OneWay}"
                     ActionButtonContent="{x:Bind ViewModel.Generic_Done, Mode=OneWay}"
                     CloseButtonContent="{x:Bind ViewModel.Generic_Close, Mode=OneWay}"
                     ActionButtonClick="SaveChangesTeachingTip_ActionButtonClick"
                     CloseButtonClick="UsersWalkthroughTip_CloseButtonClick"/>
    </Grid>
</Page>
