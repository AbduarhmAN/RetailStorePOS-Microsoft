<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup Condition="'$(BuildingForLiveUnitTesting)' == 'true'">
    <UseWinUI>false</UseWinUI>
  </PropertyGroup>
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>RetailStorePOS.WinUiLogin</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>$(RetailStorePOSWinUiAssemblyName)</AssemblyName>
    <TargetName>$(RetailStorePOSWinUiTargetName)</TargetName>
    <AssemblyTitle>$(RetailStorePOSWinUiTitle)</AssemblyTitle>
    <Product>$(RetailStorePOSWinUiProductName)</Product>
    <Description>$(RetailStorePOSDescription)</Description>
    <ApplicationIcon>$(RetailStorePOSAppIcon)</ApplicationIcon>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling Condition="'$(WindowsPackageType)' != 'None'">true</EnableMsixTooling>
    <AppxPackage Condition="'$(WindowsPackageType)' != 'None'">true</AppxPackage>
    <WindowsPackageType>MSIX</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <AppxPackageSigningEnabled>true</AppxPackageSigningEnabled>
    <PackageCertificateThumbprint>6F9820672293A31028DDF6FF6B328633ECAA01DD</PackageCertificateThumbprint>
    <AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm>
    <WindowsAppSdkDeploymentManagerInitialize>false</WindowsAppSdkDeploymentManagerInitialize>
    <WinUISDKReferences>false</WinUISDKReferences>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>$(RetailStorePOSVersion)</Version>
    <GenerateAppInstallerFile>False</GenerateAppInstallerFile>
    <AppxAutoIncrementPackageRevision>False</AppxAutoIncrementPackageRevision>
    <GenerateTestArtifacts>False</GenerateTestArtifacts>
    <AppxBundle>Always</AppxBundle>
    <IsTestProject>false</IsTestProject>
    <SkipLiveUnitTesting>true</SkipLiveUnitTesting>
    <HoursBetweenUpdateChecks>0</HoursBetweenUpdateChecks>
    <AppxBundlePlatforms>x64</AppxBundlePlatforms>
    <GenerateTemporaryStoreCertificate>True</GenerateTemporaryStoreCertificate>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260209005" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RetailStorePOS.Data\RetailStorePOS.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Core Services have been migrated locally to the Services/ folder -->
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\BrandLogo.webp" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\Logo.png" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
    <Content Include="Assets\app_icon.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Resources\Policies\retail_store_pos_terms_and_privacy_policy.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="'$(WindowsPackageType)'!='None'">
    <AppxManifest Include="Package.appxmanifest">
      <SubType>Designer</SubType>
    </AppxManifest>
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectCapability Remove="TestContainer" />
  </ItemGroup>

  <Target Name="CopyWinUiPriToPublishDirectory" AfterTargets="Publish" Condition="'$(PublishDir)' != ''">
    <ItemGroup>
      <_GeneratedAppPri Include="$(TargetDir)$(AssemblyName).pri" Condition="Exists('$(TargetDir)$(AssemblyName).pri')" />
      <_GeneratedRootXbf Include="$(TargetDir)*.xbf" />
      <_GeneratedViewXbf Include="$(TargetDir)Views\**\*.xbf" />
      <_GeneratedRuntimeAsset Include="$(MSBuildProjectDirectory)\Assets\**\*" Condition="Exists('$(MSBuildProjectDirectory)\Assets')" />
    </ItemGroup>

    <Copy SourceFiles="@(_GeneratedAppPri)" DestinationFiles="@(_GeneratedAppPri->'$(PublishDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" Condition="'@(_GeneratedAppPri)' != ''" />

    <Copy SourceFiles="@(_GeneratedRootXbf)" DestinationFiles="@(_GeneratedRootXbf->'$(PublishDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" Condition="'@(_GeneratedRootXbf)' != ''" />

    <Copy SourceFiles="@(_GeneratedViewXbf)" DestinationFiles="@(_GeneratedViewXbf->'$(PublishDir)Views\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" Condition="'@(_GeneratedViewXbf)' != ''" />

    <Copy SourceFiles="@(_GeneratedRuntimeAsset)" DestinationFiles="@(_GeneratedRuntimeAsset->'$(PublishDir)Assets\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" Condition="'@(_GeneratedRuntimeAsset)' != ''" />
  </Target>



</Project>


