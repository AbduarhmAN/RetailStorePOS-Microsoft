<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="RetailStorePOS.WinUiLogin.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Nexill">

    <Grid x:Name="RootGrid"
          Background="{StaticResource BackgroundMain}"
          RequestedTheme="Light">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource BackgroundMain}"
                BorderBrush="{StaticResource BorderDivider}"
                BorderThickness="0,0,0,1">
            <Grid x:Name="AppTitleBar"
                  Padding="12,0,144,0">
                <Border x:Name="TitleBarDragRegion"
                        Background="#FFFFFF" />

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal"
                                Spacing="12"
                                VerticalAlignment="Center">
                        <Button x:Name="PaneToggleButton"
                                Click="PaneToggleButton_Click"
                                Width="36"
                                Height="36"
                                CornerRadius="0"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                Visibility="Collapsed">
                            <FontIcon Glyph="&#xE700;"
                                      FontSize="16"
                                      Foreground="#4B5563" />
                        </Button>

                        <TextBlock Text="Retail-Store / Nexill POS"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedText}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Notion Style Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource BackgroundSidebar}" BorderBrush="{StaticResource BorderDivider}" BorderThickness="0,0,1,0" Padding="8,16">
                <ListView SelectionChanged="ShellNavigationView_SelectionChanged" SelectionMode="Single" Background="Transparent" BorderThickness="0">
                    <ListView.ItemContainerStyle>
                        <StaticResource ResourceKey="NotionSidebarItemStyle"/>
                    </ListView.ItemContainerStyle>
                    <ListViewItem Tag="checkout">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="Shop" />
                            <TextBlock Text="Checkout" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem Tag="products" x:Name="ProductsNavItem">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="Library" />
                            <TextBlock Text="Products" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem Tag="reports">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="View" />
                            <TextBlock Text="Reports" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem Tag="settings">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="Setting" />
                            <TextBlock Text="Settings" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem Tag="about">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="Help" />
                            <TextBlock Text="About" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem Tag="signout">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8AC;" FontSize="16" />
                            <TextBlock Text="Sign out" />
                        </StackPanel>
                    </ListViewItem>
                </ListView>
            </Border>

            <!-- Main Content Area -->
            <Frame x:Name="RootFrame" Grid.Column="1" Margin="48,0" />
        </Grid>

        <TeachingTip x:Name="FirstRunTutorialTip"
                     Grid.RowSpan="2"
                     Title="Main navigation"
                     Subtitle="Use this button to open and close the app navigation."
                     CloseButtonContent="Skip"
                     IsLightDismissEnabled="False"
                     PreferredPlacement="Right"
                     IsOpen="False"
                     CloseButtonClick="FirstRunTutorialTip_CloseButtonClick"
                     Canvas.ZIndex="300" />

        <!-- SPLASH SCREEN OVERLAY -->
        <Grid x:Name="SplashOverlay" Grid.RowSpan="2" Background="#0F172A">
            <Border Width="440" Height="260" Background="#1E293B" CornerRadius="28" BorderBrush="#335A78A6" BorderThickness="1" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <Border Width="56" Height="56" CornerRadius="18" Background="#F8FBFF" Padding="8">
                            <Image Source="ms-appx:///Assets/Logo.png" Stretch="Uniform" />
                        </Border>
                        <StackPanel Margin="14,2,0,0">
                            <TextBlock Text="Nexill POS" FontSize="24" FontWeight="Bold" Foreground="White" />
                            <TextBlock Text="Preparing the store workspace" Margin="0,4,0,0" FontSize="13" Foreground="#C9D8EE" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,16,0,18">
                        <TextBlock x:Name="SplashStatusTitle" Text="Starting services" FontSize="18" FontWeight="SemiBold" Foreground="White" />
                        <TextBlock x:Name="SplashStatusDetail" Text="Loading local database, services, and runtime." Margin="0,8,0,0" FontSize="13" TextWrapping="Wrap" Foreground="#B7C9E2" LineHeight="20" />
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressBar IsIndeterminate="True" Height="8" VerticalAlignment="Center" Background="#0F172A" Foreground="#5EA0FF" CornerRadius="4" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE945;" FontSize="16" Foreground="#9CC2FF" Margin="0,0,6,0" />
                            <TextBlock Text="Offline-first startup" FontSize="11" FontWeight="SemiBold" Foreground="#AFC6E8" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>


