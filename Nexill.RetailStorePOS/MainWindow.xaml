<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="RetailStorePOS.WinUiLogin.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Nexill">

    <Grid x:Name="RootGrid"
          Background="#F7FAFC"
          RequestedTheme="Light">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#FFFFFF"
                BorderBrush="#D8E0EC"
                BorderThickness="0,0,0,1">
            <Grid x:Name="AppTitleBar"
                  Padding="12,0,144,0">
                <Border x:Name="TitleBarDragRegion"
                        Background="#FFFFFF" />

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal"
                                Spacing="12"
                                VerticalAlignment="Center">
                        <Button x:Name="PaneToggleButton"
                                Click="PaneToggleButton_Click"
                                Width="36"
                                Height="36"
                                CornerRadius="0"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                Visibility="Collapsed">
                            <FontIcon Glyph="&#xE700;"
                                      FontSize="16"
                                      Foreground="#4B5563" />
                        </Button>

                        <Border Width="32"
                                Height="32"
                                Padding="0"
                                CornerRadius="6"
                                Background="#FFFFFF"
                                BorderBrush="#D7DFEC"
                                BorderThickness="0.4">
                            <Image Source="ms-appx:///Assets/Logo.png"
                                   Stretch="Uniform" />
                        </Border>

                        <StackPanel Spacing="0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Retail Store"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#1F2937" />
                            <TextBlock Text="Fast checkout and daily store control"
                                       FontSize="12"
                                       Foreground="#66758C" />
                        </StackPanel>
                    </StackPanel>

                    <Border x:Name="UserBadge"
                            Grid.Column="1"
                            Visibility="Collapsed"
                            Background="#FFFFFF"
                            BorderBrush="#D8E1EF"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10,6"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="10"
                                    VerticalAlignment="Center">
                            <PersonPicture x:Name="UserPicture"
                                           Width="30"
                                           Height="30" />

                            <StackPanel Spacing="0"
                                        VerticalAlignment="Center">
                                <TextBlock x:Name="UserNameText"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#1F2937" />
                                 </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <NavigationView x:Name="ShellNavigationView"
                        Grid.Row="1"
                        PaneDisplayMode="LeftMinimal"
                        IsPaneToggleButtonVisible="False"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        IsTitleBarAutoPaddingEnabled="False"
                        AlwaysShowHeader="False"
                        OpenPaneLength="220"
                        Background="Transparent"
                        SelectionChanged="ShellNavigationView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="CheckoutNavItem"
                                    Content="Checkout"
                                    Tag="checkout">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Shop" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="ProductsNavItem"
                                    Content="Products"
                                    Tag="products"
                                    Visibility="Collapsed">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Library" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="ReportsNavItem"
                                    Content="Reports"
                                    Tag="reports">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="View" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>


                <NavigationViewItem x:Name="SettingsNavItem"
                                    Content="Settings"
                                    Tag="settings">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="About"
                                    Tag="about">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Help" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemSeparator />

                <NavigationViewItem Content="Sign out"
                                    Tag="signout">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8AC;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="RootFrame" />
        </NavigationView>

        <TeachingTip x:Name="FirstRunTutorialTip"
                     Grid.RowSpan="2"
                     Title="Main navigation"
                     Subtitle="Use this button to open and close the app navigation."
                     CloseButtonContent="Skip"
                     IsLightDismissEnabled="False"
                     PreferredPlacement="Right"
                     IsOpen="False"
                     CloseButtonClick="FirstRunTutorialTip_CloseButtonClick"
                     Canvas.ZIndex="300" />

        <!-- SPLASH SCREEN OVERLAY -->
        <Grid x:Name="SplashOverlay" Grid.RowSpan="2" Background="#0F172A">
            <Border Width="440" Height="260" Background="#1E293B" CornerRadius="28" BorderBrush="#335A78A6" BorderThickness="1" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <Border Width="56" Height="56" CornerRadius="18" Background="#F8FBFF" Padding="8">
                            <Image Source="ms-appx:///Assets/Logo.png" Stretch="Uniform" />
                        </Border>
                        <StackPanel Margin="14,2,0,0">
                            <TextBlock Text="Nexill POS" FontSize="24" FontWeight="Bold" Foreground="White" />
                            <TextBlock Text="Preparing the store workspace" Margin="0,4,0,0" FontSize="13" Foreground="#C9D8EE" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,16,0,18">
                        <TextBlock x:Name="SplashStatusTitle" Text="Starting services" FontSize="18" FontWeight="SemiBold" Foreground="White" />
                        <TextBlock x:Name="SplashStatusDetail" Text="Loading local database, services, and runtime." Margin="0,8,0,0" FontSize="13" TextWrapping="Wrap" Foreground="#B7C9E2" LineHeight="20" />
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressBar IsIndeterminate="True" Height="8" VerticalAlignment="Center" Background="#0F172A" Foreground="#5EA0FF" CornerRadius="4" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE945;" FontSize="16" Foreground="#9CC2FF" Margin="0,0,6,0" />
                            <TextBlock Text="Offline-first startup" FontSize="11" FontWeight="SemiBold" Foreground="#AFC6E8" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>


