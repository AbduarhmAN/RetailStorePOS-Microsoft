<ContentDialog
    x:Class="RetailStorePOS.UI.Products.Views.ImportColumnMappingDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RetailStorePOS.UI.Products.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    DefaultButton="Primary"
    RequestedTheme="Light"
    CornerRadius="14"
    FlowDirection="{x:Bind Loc.FlowDirection, Mode=OneWay}"
    PrimaryButtonClick="OnPrimaryButtonClick">

    <ContentDialog.Resources>
        <!-- Override the default ContentDialog size caps so the dialog
             actually fits its two-column layout (product field + dropdown). -->
        <x:Double x:Key="ContentDialogMinWidth">720</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">960</x:Double>
        <x:Double x:Key="ContentDialogMinHeight">420</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">760</x:Double>

        <SolidColorBrush x:Key="DialogPrimaryTextBrush" Color="#0F172A" />
        <SolidColorBrush x:Key="DialogSecondaryTextBrush" Color="#475569" />
        <SolidColorBrush x:Key="DialogMutedTextBrush" Color="#64748B" />
        <SolidColorBrush x:Key="DialogCardBorderBrush" Color="#E2E8F0" />
        <SolidColorBrush x:Key="DialogCardBackgroundBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="DialogAccentBrush" Color="#1976D2" />

        <Style x:Key="MappingHeaderText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CharacterSpacing" Value="80"/>
            <Setter Property="Foreground" Value="{StaticResource DialogMutedTextBrush}"/>
        </Style>

        <Style x:Key="MappingFieldNameText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource DialogPrimaryTextBrush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="MappingImportanceBadge" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CharacterSpacing" Value="100"/>
        </Style>

        <Style x:Key="MappingSampleText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource DialogSecondaryTextBrush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="MappingRowCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource DialogCardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,12"/>
        </Style>

        <Style x:Key="MappingFieldCombo" TargetType="ComboBox">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </ContentDialog.Resources>

    <Grid RowSpacing="14" Margin="0,8,0,0" MinWidth="700" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Subtitle / explanation -->
        <StackPanel Grid.Row="0" Spacing="6">
            <TextBlock x:Name="SubtitleTextBlock"
                       FontSize="13"
                       Foreground="{StaticResource DialogSecondaryTextBrush}"
                       Margin="0,8,0,16"
                       TextWrapping="WrapWholeWords"/>
            <TextBlock x:Name="FoundColumnsText"
                       FontSize="12"
                       Foreground="{StaticResource DialogMutedTextBrush}"/>
        </StackPanel>

        <!-- Column headers (Product field ← CSV column) -->
        <Grid Grid.Row="1" ColumnSpacing="12" Margin="14,0,14,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="22"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ProductFieldHeader" Style="{StaticResource MappingHeaderText}"/>
            <TextBlock Grid.Column="2" x:Name="CsvColumnHeader" Style="{StaticResource MappingHeaderText}"/>
        </Grid>

        <!-- Required-name InfoBar (status of the Name mapping) -->
        <InfoBar Grid.Row="2"
                 x:Name="NameStatusBar"
                 IsOpen="True"
                 IsClosable="False"
                 Severity="Warning"
                 Title=""
                 Message=""/>

        <!-- One row per product field -->
        <ScrollViewer Grid.Row="3"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      MinHeight="240"
                      MaxHeight="420">
            <ItemsControl x:Name="RowsList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="10"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:ColumnMappingRow">
                        <Border Style="{StaticResource MappingRowCard}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="280"/>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="22"/>
                                </Grid.ColumnDefinitions>

                                <!-- Product field (left, static) -->
                                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind FieldDisplayName, Mode=OneWay}"
                                               Style="{StaticResource MappingFieldNameText}"/>
                                    <TextBlock Text="{x:Bind ImportanceLabel, Mode=OneWay}"
                                               Foreground="{x:Bind ImportanceBrush, Mode=OneWay}"
                                               Style="{StaticResource MappingImportanceBadge}"/>
                                </StackPanel>

                                <!-- ← arrow indicating "filled from" -->
                                <FontIcon Grid.Column="1"
                                          Glyph="&#xE72B;"
                                          FontSize="14"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Center"
                                          Foreground="{StaticResource DialogMutedTextBrush}"/>

                                <!-- CSV column dropdown (right) + sample preview -->
                                <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center">
                                    <ComboBox Style="{StaticResource MappingFieldCombo}"
                                              Loaded="CsvCombo_Loaded"
                                              SelectionChanged="CsvCombo_SelectionChanged">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="local:CsvColumnOption">
                                                <TextBlock Text="{x:Bind DisplayName}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Text="{x:Bind SampleText, Mode=OneWay}"
                                               Style="{StaticResource MappingSampleText}"/>
                                </StackPanel>

                                <!-- Status icon -->
                                <FontIcon Grid.Column="3"
                                          Glyph="{x:Bind StatusGlyph, Mode=OneWay}"
                                          Foreground="{x:Bind StatusBrush, Mode=OneWay}"
                                          FontSize="14"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Validation bar (errors / duplicate warnings) -->
        <InfoBar Grid.Row="4"
                 x:Name="ValidationBar"
                 IsOpen="False"
                 IsClosable="False"
                 Severity="Error"/>
    </Grid>
</ContentDialog>

