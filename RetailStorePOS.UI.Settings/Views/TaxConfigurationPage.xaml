<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="RetailStorePOS.UI.Settings.Views.TaxConfigurationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RetailStorePOS.UI.Settings.Views"
    xmlns:models="using:RetailStorePOS.Data.Modules.Tax"
    xmlns:common="using:RetailStorePOS.UI.Common"
    Background="Transparent"
    FlowDirection="{x:Bind ViewModel.Loc.FlowDirection, Mode=OneWay}">

    <Page.Resources>
        <Style x:Key="TX_Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E8EAF0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="22"/>
        </Style>

        <Style x:Key="TX_SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1A1D23"/>
        </Style>

        <Style x:Key="TX_SectionSubtitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#8F96A3"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="TX_FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#5F6775"/>
            <Setter Property="CharacterSpacing" Value="40"/>
        </Style>

        <Style x:Key="TX_HelperText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#8F96A3"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="TX_TableHeaderText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#5F6775"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="CharacterSpacing" Value="40"/>
        </Style>

        <Style x:Key="TX_TableCell" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#1A1D23"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="TX_RowIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="MinWidth" Value="32"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>

        <Style x:Key="TX_AddButton" TargetType="Button">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="12,6"/>
        </Style>

        <Style x:Key="TX_ComboBox" TargetType="ComboBox">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="MinWidth" Value="220"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <Style x:Key="TX_NumberBox" TargetType="NumberBox">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="MinHeight" Value="34"/>
        </Style>
    </Page.Resources>

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top action bar -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="4">
                <TextBlock Text="{x:Bind ViewModel.TaxConfiguration_Header_Title, Mode=OneWay}"
                           FontSize="22" FontWeight="SemiBold" Foreground="#1A1D23"/>
                <TextBlock Text="{x:Bind ViewModel.TaxConfiguration_Header_Subtitle, Mode=OneWay}"
                           FontSize="13" Foreground="#8F96A3" TextWrapping="Wrap"/>
            </StackPanel>

            <Button Grid.Column="1"
                    Content="{x:Bind ViewModel.TaxConfiguration_SaveButton, Mode=OneWay}"
                    CornerRadius="8"
                    Padding="16,8"
                    MinHeight="36"
                    VerticalAlignment="Top"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Style="{StaticResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.SaveStoreSettingsCommand}"/>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16" Padding="0,0,4,24">

                <!-- Tax Engine -->
                <Border Style="{StaticResource TX_Card}">
                    <StackPanel Spacing="20">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Bind ViewModel.TaxConfiguration_TaxEngine_Title, Mode=OneWay}" Style="{StaticResource TX_SectionTitle}"/>
                            <TextBlock Text="{x:Bind ViewModel.TaxConfiguration_TaxEngine_Subtitle, Mode=OneWay}" Style="{StaticResource TX_SectionSubtitle}"/>
                        </StackPanel>

                        <CheckBox Content="{x:Bind ViewModel.TaxConfiguration_EnableTax_Label, Mode=OneWay}"
                                  IsChecked="{x:Bind ViewModel.TaxEnabled, Mode=TwoWay}"/>

                        <StackPanel Spacing="6">
                            <TextBlock Text="{x:Bind ViewModel.TaxConfiguration_DefaultRate_Label, Mode=OneWay}" Style="{StaticResource TX_FieldLabel}"/>
                            <NumberBox Value="{x:Bind ViewModel.TaxRatePercentValue, Mode=TwoWay}"
                                       Width="160"
                                       HorizontalAlignment="Left"
                                       Minimum="0"
                                       common:NumericInputNormalization.NormalizeOnLostFocus="True"
                                       SpinButtonPlacementMode="Hidden"
                                       AcceptsExpression="False"
                                       Style="{StaticResource TX_NumberBox}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Rounding -->
                <Border Style="{StaticResource TX_Card}">
                    <StackPanel Spacing="20">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Bind ViewModel.TaxConfiguration_Rounding_Title, Mode=OneWay}" Style="{StaticResource TX_SectionTitle}"/>
                            <TextBlock Text="{x:Bind ViewModel.TaxConfiguration_Rounding_Subtitle, Mode=OneWay}" Style="{StaticResource TX_SectionSubtitle}"/>
                        </StackPanel>

                        <Grid ColumnSpacing="20" RowSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock Text="{x:Bind ViewModel.TaxConfiguration_RoundingStrategy_Label, Mode=OneWay}" Style="{StaticResource TX_FieldLabel}"/>
                                <ComboBox x:Name="RoundingStrategiesComboBox"
                                          SelectionChanged="RoundingStrategiesComboBox_SelectionChanged"
                                          Style="{StaticResource TX_ComboBox}"/>
                                <TextBlock Text="{x:Bind ViewModel.TaxConfiguration_RoundingStrategy_Tip, Mode=OneWay}"
                                           Style="{StaticResource TX_HelperText}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="{x:Bind ViewModel.TaxConfiguration_CashRounding_Label, Mode=OneWay}" Style="{StaticResource TX_FieldLabel}"/>
                                <ComboBox x:Name="CashRoundingUnitsComboBox"
                                          SelectionChanged="CashRoundingUnitsComboBox_SelectionChanged"
                                          Style="{StaticResource TX_ComboBox}"/>
                                <TextBlock Text="{x:Bind ViewModel.TaxConfiguration_CashRounding_Tip, Mode=OneWay}"
                                           Style="{StaticResource TX_HelperText}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Tax Authorities -->
                <Border Style="{StaticResource TX_Card}" Padding="0">
                    <StackPanel>
                        <Grid Padding="22,20,22,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="{x:Bind ViewModel.TaxConfiguration_Authorities_Title, Mode=OneWay}" Style="{StaticResource TX_SectionTitle}"/>
                                <TextBlock Text="{x:Bind ViewModel.TaxConfiguration_Authorities_Subtitle, Mode=OneWay}" Style="{StaticResource TX_SectionSubtitle}"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="{x:Bind ViewModel.TaxConfiguration_AddAuthority_Button, Mode=OneWay}"
                                    Click="AddAuthorityButton_Click"
                                    Style="{StaticResource TX_AddButton}"
                                    VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Padding="22,10" Background="#FAFBFC" BorderBrush="#E8EAF0" BorderThickness="0,1,0,1" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Name"            Style="{StaticResource TX_TableHeaderText}"/>
                            <TextBlock Grid.Column="1" Text="Code"            Style="{StaticResource TX_TableHeaderText}"/>
                            <TextBlock Grid.Column="2" Text="Reg. number"     Style="{StaticResource TX_TableHeaderText}"/>
                            <TextBlock Grid.Column="3" Text=""                Style="{StaticResource TX_TableHeaderText}"/>
                        </Grid>

                        <ListView x:Name="TaxAuthoritiesListView"
                                  SelectionMode="None"
                                  IsItemClickEnabled="False"
                                  Background="Transparent"
                                  BorderThickness="0">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="MinHeight" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:TaxAuthority">
                                    <Grid Padding="22,10" ColumnSpacing="12" BorderBrush="#F1F4F9" BorderThickness="0,0,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource TX_TableCell}" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" Text="{x:Bind AuthorityCode}" Style="{StaticResource TX_TableCell}" Foreground="#5F6775"/>
                                        <TextBlock Grid.Column="2" Text="{x:Bind RegistrationNumber}" Style="{StaticResource TX_TableCell}" Foreground="#5F6775"/>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Style="{StaticResource TX_RowIconButton}" Tag="{x:Bind}"
                                                    Click="EditAuthorityButton_Click"
                                                    ToolTipService.ToolTip="{x:Bind ((local:TaxConfigurationPage)local:TaxConfigurationPage.Current).ViewModel.TaxConfiguration_EditAuthority_Button, Mode=OneWay}">
                                                <FontIcon Glyph="&#xE70F;" FontSize="14" Foreground="#5F6775"/>
                                            </Button>
                                            <Button Style="{StaticResource TX_RowIconButton}" Tag="{x:Bind}"
                                                    Click="DeleteAuthorityButton_Click"
                                                    ToolTipService.ToolTip="{x:Bind ((local:TaxConfigurationPage)local:TaxConfigurationPage.Current).ViewModel.TaxConfiguration_DeleteAuthority_Button, Mode=OneWay}">
                                                <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="#DC2626"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <!-- Tax Rules -->
                <Border Style="{StaticResource TX_Card}" Padding="0">
                    <StackPanel>
                        <Grid Padding="22,20,22,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="{x:Bind ViewModel.TaxConfiguration_Rules_Title, Mode=OneWay}" Style="{StaticResource TX_SectionTitle}"/>
                                <TextBlock Text="{x:Bind ViewModel.TaxConfiguration_Rules_Subtitle, Mode=OneWay}" Style="{StaticResource TX_SectionSubtitle}"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="{x:Bind ViewModel.TaxConfiguration_AddRule_Button, Mode=OneWay}"
                                    Click="AddTaxRuleButton_Click"
                                    Style="{StaticResource TX_AddButton}"
                                    VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Padding="22,10" Background="#FAFBFC" BorderBrush="#E8EAF0" BorderThickness="0,1,0,1" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Name"        Style="{StaticResource TX_TableHeaderText}"/>
                            <TextBlock Grid.Column="1" Text="Calculation" Style="{StaticResource TX_TableHeaderText}"/>
                            <TextBlock Grid.Column="2" Text="Rate"        Style="{StaticResource TX_TableHeaderText}"/>
                            <TextBlock Grid.Column="3" Text="Inclusive"   Style="{StaticResource TX_TableHeaderText}"/>
                            <TextBlock Grid.Column="4" Text="Scope"       Style="{StaticResource TX_TableHeaderText}"/>
                            <TextBlock Grid.Column="5" Text=""            Style="{StaticResource TX_TableHeaderText}"/>
                        </Grid>

                        <ListView x:Name="TaxRulesListView"
                                  SelectionMode="None"
                                  IsItemClickEnabled="False"
                                  Background="Transparent"
                                  BorderThickness="0">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="MinHeight" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:TaxRule">
                                    <Grid Padding="22,10" ColumnSpacing="12" BorderBrush="#F1F4F9" BorderThickness="0,0,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource TX_TableCell}" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" Text="{x:Bind CalcType}" Style="{StaticResource TX_TableCell}" Foreground="#5F6775"/>
                                        <TextBlock Grid.Column="2" Text="{x:Bind DisplaySummary}" Style="{StaticResource TX_TableCell}" Foreground="#5F6775"/>
                                        <TextBlock Grid.Column="3" Text="{x:Bind InclusiveLabel}" Style="{StaticResource TX_TableCell}" Foreground="#5F6775"/>
                                        <TextBlock Grid.Column="4" Text="{x:Bind ScopeLabel}" Style="{StaticResource TX_TableCell}" Foreground="#5F6775"/>
                                        <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Style="{StaticResource TX_RowIconButton}" Tag="{x:Bind}"
                                                    Click="EditTaxRuleButton_Click"
                                                    ToolTipService.ToolTip="{x:Bind ((local:TaxConfigurationPage)local:TaxConfigurationPage.Current).ViewModel.TaxConfiguration_EditRule_Button, Mode=OneWay}">
                                                <FontIcon Glyph="&#xE70F;" FontSize="14" Foreground="#5F6775"/>
                                            </Button>
                                            <Button Style="{StaticResource TX_RowIconButton}" Tag="{x:Bind}"
                                                    Click="DeleteTaxRuleButton_Click"
                                                    ToolTipService.ToolTip="{x:Bind ((local:TaxConfigurationPage)local:TaxConfigurationPage.Current).ViewModel.TaxConfiguration_DeleteRule_Button, Mode=OneWay}">
                                                <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="#DC2626"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <!-- Tax Groups -->
                <Border Style="{StaticResource TX_Card}" Padding="0">
                    <StackPanel>
                        <Grid Padding="22,20,22,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="{x:Bind ViewModel.TaxConfiguration_Groups_Title, Mode=OneWay}" Style="{StaticResource TX_SectionTitle}"/>
                                <TextBlock Text="{x:Bind ViewModel.TaxConfiguration_Groups_Subtitle, Mode=OneWay}" Style="{StaticResource TX_SectionSubtitle}"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="{x:Bind ViewModel.TaxConfiguration_AddGroup_Button, Mode=OneWay}"
                                    Click="AddTaxGroupButton_Click"
                                    Style="{StaticResource TX_AddButton}"
                                    VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Padding="22,10" Background="#FAFBFC" BorderBrush="#E8EAF0" BorderThickness="0,1,0,1" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Group"        Style="{StaticResource TX_TableHeaderText}"/>
                            <TextBlock Grid.Column="1" Text="Summary"      Style="{StaticResource TX_TableHeaderText}"/>
                            <TextBlock Grid.Column="2" Text=""             Style="{StaticResource TX_TableHeaderText}"/>
                        </Grid>

                        <ListView x:Name="TaxGroupsListView"
                                  SelectionMode="None"
                                  IsItemClickEnabled="False"
                                  Background="Transparent"
                                  BorderThickness="0">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="MinHeight" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:TaxGroup">
                                    <Grid Padding="22,10" ColumnSpacing="12" BorderBrush="#F1F4F9" BorderThickness="0,0,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource TX_TableCell}" FontWeight="SemiBold"/>
                                            <Border Background="#EEF2FF" CornerRadius="6" Padding="8,2" VerticalAlignment="Center"
                                                    Visibility="{x:Bind local:TaxConfigurationPage.BoolToVis(IsDefault)}">
                                                <TextBlock Text="{x:Bind ((local:TaxConfigurationPage)local:TaxConfigurationPage.Current).ViewModel.TaxConfiguration_DefaultBadge, Mode=OneWay}"
                                                           FontSize="10" Foreground="#3B82F6" FontWeight="SemiBold"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{x:Bind DisplaySummary}" Style="{StaticResource TX_TableCell}" Foreground="#5F6775"/>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Style="{StaticResource TX_RowIconButton}" Tag="{x:Bind}"
                                                    Click="EditTaxGroupButton_Click"
                                                    ToolTipService.ToolTip="{x:Bind ((local:TaxConfigurationPage)local:TaxConfigurationPage.Current).ViewModel.TaxConfiguration_EditGroup_Button, Mode=OneWay}">
                                                <FontIcon Glyph="&#xE70F;" FontSize="14" Foreground="#5F6775"/>
                                            </Button>
                                            <Button Style="{StaticResource TX_RowIconButton}" Tag="{x:Bind}"
                                                    Click="DeleteTaxGroupButton_Click"
                                                    IsEnabled="{x:Bind local:TaxConfigurationPage.InverseBool(IsDefault)}"
                                                    ToolTipService.ToolTip="{x:Bind ((local:TaxConfigurationPage)local:TaxConfigurationPage.Current).ViewModel.TaxConfiguration_DeleteGroup_Button, Mode=OneWay}">
                                                <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="#DC2626"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <!-- Status banner -->
                <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="14,10"
                        Visibility="{x:Bind ViewModel.StatusVisibility, Mode=OneWay}">
                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                               Foreground="#1D4ED8"
                               FontSize="13"
                               TextWrapping="Wrap"/>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
