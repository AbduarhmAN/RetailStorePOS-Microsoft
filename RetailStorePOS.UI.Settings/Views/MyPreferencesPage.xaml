<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="RetailStorePOS.UI.Settings.Views.MyPreferencesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RetailStorePOS.UI.Settings.Views"
    xmlns:common="using:RetailStorePOS.UI.Common"
    Background="Transparent"
    FlowDirection="{x:Bind ViewModel.Loc.FlowDirection, Mode=OneWay}">

    <Page.Resources>
        <Style x:Key="MP_Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E8EAF0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="22"/>
        </Style>

        <Style x:Key="MP_SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1A1D23"/>
        </Style>

        <Style x:Key="MP_SectionSubtitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#8F96A3"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="MP_FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#5F6775"/>
            <Setter Property="CharacterSpacing" Value="40"/>
        </Style>

        <Style x:Key="MP_HelperText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#8F96A3"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="MP_NumberBox" TargetType="NumberBox">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="MinHeight" Value="34"/>
        </Style>
    </Page.Resources>

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel Spacing="4">
                <TextBlock Text="{x:Bind ViewModel.MyPreferences_Header_Title, Mode=OneWay}"
                           FontSize="22" FontWeight="SemiBold" Foreground="#1A1D23"/>
                <TextBlock Text="{x:Bind ViewModel.MyPreferences_Header_Subtitle, Mode=OneWay}"
                           FontSize="13" Foreground="#8F96A3" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16" Padding="0,0,4,24">

                <!-- Quick Cash buttons -->
                <Border Style="{StaticResource MP_Card}">
                    <StackPanel Spacing="20">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Bind ViewModel.MyPreferences_QuickCash_Title, Mode=OneWay}" Style="{StaticResource MP_SectionTitle}"/>
                            <TextBlock Text="{x:Bind ViewModel.MyPreferences_QuickCash_Subtitle, Mode=OneWay}" Style="{StaticResource MP_SectionSubtitle}"/>
                        </StackPanel>

                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock Text="{x:Bind ViewModel.MyPreferences_QuickCash_Value1, Mode=OneWay}" Style="{StaticResource MP_FieldLabel}"/>
                                <NumberBox Value="{x:Bind ViewModel.QuickCash1Value, Mode=TwoWay}"
                                           Minimum="0"
                                           SmallChange="1"
                                           AcceptsExpression="False"
                                           SpinButtonPlacementMode="Hidden"
                                           common:NumericInputNormalization.NormalizeOnLostFocus="True"
                                           Style="{StaticResource MP_NumberBox}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="{x:Bind ViewModel.MyPreferences_QuickCash_Value2, Mode=OneWay}" Style="{StaticResource MP_FieldLabel}"/>
                                <NumberBox Value="{x:Bind ViewModel.QuickCash2Value, Mode=TwoWay}"
                                           Minimum="0"
                                           SmallChange="1"
                                           AcceptsExpression="False"
                                           SpinButtonPlacementMode="Hidden"
                                           common:NumericInputNormalization.NormalizeOnLostFocus="True"
                                           Style="{StaticResource MP_NumberBox}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Spacing="6">
                                <TextBlock Text="{x:Bind ViewModel.MyPreferences_QuickCash_Value3, Mode=OneWay}" Style="{StaticResource MP_FieldLabel}"/>
                                <NumberBox Value="{x:Bind ViewModel.QuickCash3Value, Mode=TwoWay}"
                                           Minimum="0"
                                           SmallChange="1"
                                           AcceptsExpression="False"
                                           SpinButtonPlacementMode="Hidden"
                                           common:NumericInputNormalization.NormalizeOnLostFocus="True"
                                           Style="{StaticResource MP_NumberBox}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Session security -->
                <Border Style="{StaticResource MP_Card}">
                    <StackPanel Spacing="20">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Bind ViewModel.MyPreferences_SessionSecurity_Title, Mode=OneWay}" Style="{StaticResource MP_SectionTitle}"/>
                            <TextBlock Text="{x:Bind ViewModel.MyPreferences_SessionSecurity_Subtitle, Mode=OneWay}" Style="{StaticResource MP_SectionSubtitle}"/>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="{x:Bind ViewModel.MyPreferences_SessionTimeout_Label, Mode=OneWay}" Style="{StaticResource MP_FieldLabel}"/>
                            <NumberBox Value="{x:Bind ViewModel.SessionIdleTimeoutMinutesValue, Mode=TwoWay}"
                                       Minimum="1"
                                       Maximum="480"
                                       SmallChange="1"
                                       SpinButtonPlacementMode="Compact"
                                       AcceptsExpression="False"
                                       Width="180"
                                       HorizontalAlignment="Left"
                                       common:NumericInputNormalization.NormalizeOnLostFocus="True"
                                       Style="{StaticResource MP_NumberBox}"/>
                            <TextBlock Text="{x:Bind ViewModel.MyPreferences_SessionTimeout_Helper, Mode=OneWay}" Style="{StaticResource MP_HelperText}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Status banner -->
                <Border Style="{StaticResource App_BannerInfo}"
                        Visibility="{x:Bind ViewModel.StatusVisibility, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE946;"
                                  Style="{StaticResource App_BannerIcon}"
                                  Foreground="{StaticResource App_BannerInfoForeground}"/>
                        <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                                   Style="{StaticResource App_BannerText}"
                                   Foreground="{StaticResource App_BannerInfoForeground}"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
