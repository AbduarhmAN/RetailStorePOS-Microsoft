<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="RetailStorePOS.UI.Settings.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <Style x:Key="SettingsNavButtonStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </Page.Resources>

    <Grid FlowDirection="{x:Bind ViewModel.Loc.FlowDirection, Mode=OneWay}">
        <NavigationView x:Name="SettingsNavView"
                        Background="Transparent"
                        IsTabStop="False"
                        IsSettingsVisible="False"
                        IsBackButtonVisible="Collapsed"
                        IsTitleBarAutoPaddingEnabled="False"
                        AlwaysShowHeader="False"
                        IsPaneToggleButtonVisible="True"
                        PaneDisplayMode="Left"
                        IsPaneOpen="True"
                        OpenPaneLength="278">
            <NavigationView.PaneCustomContent>
                <StackPanel Spacing="4" Padding="8,8,8,0">
                    <Button x:Name="CheckoutNavButton"
                            Tag="checkout"
                            Click="NavigationButton_Click"
                            Style="{StaticResource SettingsNavButtonStyle}" />
                    <Button x:Name="ProductsNavButton"
                            Tag="products"
                            Click="NavigationButton_Click"
                            Style="{StaticResource SettingsNavButtonStyle}" />
                    <Button x:Name="ReportsNavButton"
                            Tag="reports"
                            Click="NavigationButton_Click"
                            Style="{StaticResource SettingsNavButtonStyle}" />
                    <Button x:Name="SettingsRootNavButton"
                            Tag="settings-root"
                            Click="NavigationButton_Click"
                            Style="{StaticResource SettingsNavButtonStyle}" />

                    <StackPanel x:Name="SettingsSubNavHost" Spacing="4" Margin="16,0,0,0">
                        <Button x:Name="StoreNavButton"
                                Tag="store"
                                Click="NavigationButton_Click"
                                Style="{StaticResource SettingsNavButtonStyle}" />
                        <Button x:Name="TaxNavButton"
                                Tag="tax"
                                Click="NavigationButton_Click"
                                Style="{StaticResource SettingsNavButtonStyle}" />
                        <Button x:Name="UsersNavButton"
                                Tag="users"
                                Click="NavigationButton_Click"
                                Style="{StaticResource SettingsNavButtonStyle}" />
                        <Button x:Name="PrefsNavButton"
                                Tag="prefs"
                                Click="NavigationButton_Click"
                                Style="{StaticResource SettingsNavButtonStyle}" />
                        <Button x:Name="LicenseNavButton"
                                Tag="license"
                                Click="NavigationButton_Click"
                                Style="{StaticResource SettingsNavButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </NavigationView.PaneCustomContent>

            <NavigationView.PaneFooter>
                <StackPanel Spacing="4" Padding="8,0,8,8">
                    <Button x:Name="AboutNavButton"
                            Tag="about"
                            Click="NavigationButton_Click"
                            Style="{StaticResource SettingsNavButtonStyle}" />
                    <Button x:Name="SignOutNavButton"
                            Tag="signout"
                            Click="NavigationButton_Click"
                            Style="{StaticResource SettingsNavButtonStyle}" />
                </StackPanel>
            </NavigationView.PaneFooter>

            <Frame x:Name="SettingsContentFrame"
                   IsNavigationStackEnabled="False"
                   Background="Transparent">
                <Frame.ContentTransitions>
                    <TransitionCollection />
                </Frame.ContentTransitions>
            </Frame>
        </NavigationView>

    </Grid>
</Page>
