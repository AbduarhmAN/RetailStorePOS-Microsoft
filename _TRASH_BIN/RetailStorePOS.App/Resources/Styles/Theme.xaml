<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         NEXILL DESIGN SYSTEM - PORTFOLIO-ALIGNED LIGHT THEME
         Mirrors the website palette: soft slate surfaces + cool blue accent.
         ============================================================ -->

    <!-- BRAND PALETTE -->
    <Color x:Key="NexillNavyColor">#1C2431</Color>       <!-- Primary text + dark UI accents -->
    <Color x:Key="NexillBlueColor">#3B82F6</Color>
    <Color x:Key="NexillBluePressedColor">#2563EB</Color>
    <Color x:Key="NexillLimeColor">#93C5FD</Color>       <!-- Focus ring tint -->
    <Color x:Key="NexillGreenColor">#15803D</Color>
    <Color x:Key="NexillRedColor">#B91C1C</Color>
    <Color x:Key="NexillWhiteColor">#FFFFFF</Color>

    <Color x:Key="NexillSlateColor">#F6F8FC</Color>
    <Color x:Key="NexillDarkSlateColor">#6A7486</Color>
    
    <!-- SEMANTIC BRUSHES -->
    <!-- Primary Backgrounds -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F8F9FB" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource NexillWhiteColor}" />
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="{StaticResource NexillSlateColor}" />

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1C2431" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6A7486" />
    <SolidColorBrush x:Key="TextOnDarkBrush" Color="{StaticResource NexillWhiteColor}" />
    <SolidColorBrush x:Key="TextAccentBrush" Color="{StaticResource NexillBlueColor}" />

    <!-- Actions & Interactive -->
    <SolidColorBrush x:Key="ActionPrimaryBrush" Color="{StaticResource NexillBlueColor}" />
    <SolidColorBrush x:Key="ActionSuccessBrush" Color="{StaticResource NexillGreenColor}" />
    <SolidColorBrush x:Key="ActionDestructiveBrush" Color="{StaticResource NexillRedColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="#DCE4EF" />

    <!-- Focus & Selection -->
    <SolidColorBrush x:Key="FocusStrokeBrush" Color="{StaticResource NexillLimeColor}" />
    <SolidColorBrush x:Key="SelectionBackgroundBrush" Color="#E8EFFC" />

    <!-- TYPOGRAPHY -->
    <Style x:Key="Header1" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="Header2" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>
    
    <Style x:Key="CaptionText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>

    <!-- COMPONENTS -->
    <!-- Premium Card Style -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#1D304D" Direction="270" ShadowDepth="2" BlurRadius="16" Opacity="0.06" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary Button (Navy) -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource ActionPrimaryBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#2563EB" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8" 
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#2F73E6" />
                            <Setter Property="BorderBrush" Value="#225CCF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#245FCA" />
                            <Setter Property="BorderBrush" Value="#1E53B1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="#9BB9EB" />
                            <Setter Property="BorderBrush" Value="#8EACE0" />
                            <Setter Property="Foreground" Value="#EAF2FF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Success/Pay Button (Green) -->
    <Style x:Key="SuccessButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="Background" Value="{StaticResource ActionSuccessBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="FontSize" Value="20" /> <!-- Larger for main action -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" 
                            CornerRadius="8" 
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#00E676" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#00A844" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="#94A3B8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Danger Button (Red) — destructive actions like Clear Cart -->
    <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="Background" Value="{StaticResource ActionDestructiveBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#CC2D00" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#A32400" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Secondary Button (Outline) — cancel / keep actions -->
    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#F8FAFD" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#EEF2F6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
