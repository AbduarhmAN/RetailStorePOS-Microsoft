<UserControl x:Class="RetailStorePOS.App.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Focusable="True"
             Loaded="LoginView_Loaded"
             SizeChanged="LoginView_SizeChanged"
             Background="{StaticResource AppBackgroundBrush}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             FontFamily="Segoe UI Variable Text, Segoe UI">

    <UserControl.Resources>
        <LinearGradientBrush x:Key="LoginBackdropBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F6F8FB" Offset="0" />
            <GradientStop Color="#EEF2F8" Offset="1" />
        </LinearGradientBrush>

        <SolidColorBrush x:Key="LoginSurfaceBrush" Color="#FCFCFE" />
        <SolidColorBrush x:Key="LoginPanelTintBrush" Color="#F4F7FB" />
        <SolidColorBrush x:Key="LoginPanelBorderBrush" Color="#D9E1EC" />
        <SolidColorBrush x:Key="LoginSubtleFillBrush" Color="#F5F7FB" />
        <SolidColorBrush x:Key="LoginAccentFillBrush" Color="#EAF2FF" />
        <SolidColorBrush x:Key="LoginAccentBorderBrush" Color="#C9DBFF" />
        <SolidColorBrush x:Key="LoginSuccessFillBrush" Color="#EEF9F1" />
        <SolidColorBrush x:Key="LoginSuccessBorderBrush" Color="#CAE8D3" />
        <SolidColorBrush x:Key="LoginHeroTitleBrush" Color="#0F172A" />
        <SolidColorBrush x:Key="LoginHeroTextBrush" Color="#475569" />

        <DropShadowEffect x:Key="LoginPanelShadow"
                          Color="#1A2940"
                          BlurRadius="42"
                          ShadowDepth="10"
                          Opacity="0.12" />

        <Style x:Key="WinUiPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource LoginSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LoginPanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Effect" Value="{StaticResource LoginPanelShadow}" />
        </Style>

        <Style x:Key="FeatureSurfaceStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource LoginSubtleFillBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LoginPanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="MinHeight" Value="88" />
        </Style>

        <Style x:Key="SegmentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource AppMuted}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="18,13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SegmentButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SegmentButtonBorder" Property="Background" Value="#F4F7FB" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="SegmentButtonBorder" Property="Background" Value="#EEF2F8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StaffCardButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="148" />
            <Setter Property="Height" Value="120" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource LoginPanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="18"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="#F7FAFF" />
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource LoginAccentBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="#EEF4FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PinKeyButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Height" Value="60" />
            <Setter Property="MinHeight" Value="60" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="#FAFBFD" />
            <Setter Property="BorderBrush" Value="{StaticResource LoginPanelBorderBrush}" />
        </Style>

        <Style x:Key="PinDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource DangerButtonStyle}">
            <Setter Property="Height" Value="60" />
            <Setter Property="MinHeight" Value="60" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="InlineGhostButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource AppAccent}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource LoginBackdropBrush}">
        <Border Width="420"
                Height="420"
                CornerRadius="210"
                Background="#40FFFFFF"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="-140,-180,0,0"
                IsHitTestVisible="False" />

        <Border Width="340"
                Height="340"
                CornerRadius="170"
                Background="#2AD8E6FF"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,-120,-140"
                IsHitTestVisible="False" />

        <Grid Margin="28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumnDef" Width="1.05*" />
                <ColumnDefinition Width="1.25*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="LeftBrandPanel"
                    Grid.Column="0"
                    Style="{StaticResource WinUiPanelStyle}"
                    CornerRadius="28,0,0,28"
                    Padding="34,30"
                    Background="{StaticResource LoginPanelTintBrush}"
                    BorderThickness="1,1,0,1">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False"
                              PanningMode="VerticalOnly">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <Border Width="56"
                                    Height="56"
                                    CornerRadius="16"
                                    Background="#FFFFFF"
                                    BorderBrush="{StaticResource LoginAccentBorderBrush}"
                                    BorderThickness="1"
                                    Padding="8"
                                    HorizontalAlignment="Left">
                                <Image Source="Resources/Images/logo.png"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>

                            <Border Background="{StaticResource LoginAccentFillBrush}"
                                    BorderBrush="{StaticResource LoginAccentBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="10,4"
                                    Margin="0,16,0,0"
                                    HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <iconPacks:PackIconMaterial Kind="Laptop"
                                                                Width="12"
                                                                Height="12"
                                                                Foreground="{StaticResource AppAccent}"
                                                                Margin="0,0,6,0" />
                                    <TextBlock Text="Windows-native sign-in"
                                               FontSize="11.5"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource AppAccent}" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Welcome to Nexill POS"
                                       Margin="0,22,0,0"
                                       FontSize="34"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource LoginHeroTitleBrush}" />
                            <TextBlock Text="A Fluent-style sign-in flow for fast cashier access and secure store management."
                                       Margin="0,10,0,0"
                                       FontSize="15"
                                       LineHeight="23"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource LoginHeroTextBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1"
                                    VerticalAlignment="Top"
                                    Margin="0,22,0,18">
                            <Border Style="{StaticResource FeatureSurfaceStyle}"
                                    Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="42"
                                            Height="42"
                                            CornerRadius="14"
                                            Background="{StaticResource LoginAccentFillBrush}"
                                            Margin="0,0,14,0">
                                        <iconPacks:PackIconMaterial Kind="StorefrontOutline"
                                                                    Width="18"
                                                                    Height="18"
                                                                    Foreground="{StaticResource AppAccent}"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Cashier-first access"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource LoginHeroTitleBrush}" />
                                        <TextBlock Text="Pick a cashier, enter a PIN, and get back to selling without extra navigation or setup friction."
                                                   Margin="0,5,0,0"
                                                   FontSize="14"
                                                   Foreground="{StaticResource LoginHeroTextBrush}"
                                                   TextWrapping="Wrap"
                                                   LineHeight="20" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource FeatureSurfaceStyle}"
                                    Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="42"
                                            Height="42"
                                            CornerRadius="14"
                                            Background="#EEF9F1"
                                            Margin="0,0,14,0">
                                        <iconPacks:PackIconMaterial Kind="ShieldLockOutline"
                                                                    Width="18"
                                                                    Height="18"
                                                                    Foreground="#0F8A43"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Role-aware access"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource LoginHeroTitleBrush}" />
                                        <TextBlock Text="Admin credentials keep products, reports, settings, and user controls behind the right permissions."
                                                   Margin="0,5,0,0"
                                                   FontSize="14"
                                                   Foreground="{StaticResource LoginHeroTextBrush}"
                                                   TextWrapping="Wrap"
                                                   LineHeight="20" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource FeatureSurfaceStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="42"
                                            Height="42"
                                            CornerRadius="14"
                                            Background="#FFF5E8"
                                            Margin="0,0,14,0">
                                        <iconPacks:PackIconMaterial Kind="CheckCircleOutline"
                                                                    Width="18"
                                                                    Height="18"
                                                                    Foreground="#C46A00"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Reliable startup flow"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource LoginHeroTitleBrush}" />
                                        <TextBlock Text="The app warms local services first so sign-in, search, and checkout can stay responsive on store hardware."
                                                   Margin="0,5,0,0"
                                                   FontSize="14"
                                                   Foreground="{StaticResource LoginHeroTextBrush}"
                                                   TextWrapping="Wrap"
                                                   LineHeight="20" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <Border Grid.Row="3"
                                Background="{StaticResource LoginSuccessFillBrush}"
                                BorderBrush="{StaticResource LoginSuccessBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="18"
                                Padding="16,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Width="38"
                                        Height="38"
                                        CornerRadius="12"
                                        Background="#DDF2E3"
                                        Margin="0,0,14,0">
                                    <iconPacks:PackIconMaterial Kind="CheckCircleOutline"
                                                                Width="18"
                                                                Height="18"
                                                                Foreground="#15803D"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Recommended direction"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#0F8A43" />
                                    <TextBlock Text="Keep checkout native for speed. Use modern surfaces where visual consistency matters most."
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource LoginHeroTitleBrush}"
                                               LineHeight="18" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Border>

            <Border x:Name="RightLoginPanel"
                    Grid.Column="1"
                    Style="{StaticResource WinUiPanelStyle}"
                    CornerRadius="0,28,28,0"
                    Padding="40,32"
                    Background="#FCFCFE">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False"
                              PanningMode="VerticalOnly">
                    <StackPanel HorizontalAlignment="Center"
                                MaxWidth="452">
                    <Border Background="{StaticResource LoginSubtleFillBrush}"
                            BorderBrush="{StaticResource LoginPanelBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="10,4"
                            HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <iconPacks:PackIconMaterial Kind="ShieldCheckOutline"
                                                        Width="12"
                                                        Height="12"
                                                        Foreground="{StaticResource AppAccent}"
                                                        Margin="0,0,6,0" />
                            <TextBlock Text="Secure local sign-in"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AppAccent}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Sign in"
                               Margin="0,20,0,0"
                               FontSize="36"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Choose an admin password or a cashier PIN. The store workspace stays local, warm, and ready."
                               Margin="0,8,0,24"
                               TextWrapping="Wrap"
                               FontSize="15"
                               LineHeight="22"
                               Foreground="{StaticResource AppMuted}" />

                    <Border Background="{StaticResource LoginSubtleFillBrush}"
                            BorderBrush="{StaticResource LoginPanelBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="18"
                            Padding="4"
                            Margin="0,0,0,24">
                        <Grid x:Name="SegmentHostGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border x:Name="ActiveTabIndicator"
                                    Width="{Binding ActualWidth, ElementName=AdminTabBtn}"
                                    Background="#FFFFFF"
                                    BorderBrush="{StaticResource LoginPanelBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    HorizontalAlignment="Left">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="TabIndicatorTranslate" />
                                </Border.RenderTransform>
                            </Border>

                            <Button x:Name="AdminTabBtn"
                                    Grid.Column="0"
                                    Content="Store Admin"
                                    Command="{Binding SwitchToPasswordCommand}"
                                    Style="{StaticResource SegmentButtonStyle}"
                                    Foreground="{StaticResource AppTextPrimary}" />

                            <Button x:Name="CashierTabBtn"
                                    Grid.Column="1"
                                    Content="Cashier PIN"
                                    Command="{Binding SwitchToPinCommand}"
                                    Style="{StaticResource SegmentButtonStyle}" />
                        </Grid>
                    </Border>

                    <Grid x:Name="PanelContainer"
                          ClipToBounds="True">
                        <StackPanel x:Name="PasswordPanel">
                            <StackPanel.RenderTransform>
                                <TranslateTransform x:Name="PasswordPanelTranslate" />
                            </StackPanel.RenderTransform>

                            <Border Style="{StaticResource FeatureSurfaceStyle}"
                                    Background="{StaticResource LoginAccentFillBrush}"
                                    BorderBrush="{StaticResource LoginAccentBorderBrush}"
                                    Margin="0,0,0,20">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="40"
                                            Height="40"
                                            CornerRadius="14"
                                            Background="#DCE9FF"
                                            Margin="0,0,14,0">
                                        <iconPacks:PackIconMaterial Kind="AccountTie"
                                                                    Width="18"
                                                                    Height="18"
                                                                    Foreground="{StaticResource AppAccent}"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Store management access"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="Use this mode for inventory, settings, reporting, and administrative store actions."
                                                   Margin="0,5,0,0"
                                                   Foreground="{StaticResource AppMuted}"
                                                   TextWrapping="Wrap"
                                                   LineHeight="19" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Background="{StaticResource LoginSuccessFillBrush}"
                                    BorderBrush="{StaticResource LoginSuccessBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    Padding="14,12"
                                    Margin="0,0,0,20"
                                    Visibility="{Binding IsSetupMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="InformationOutline"
                                                                Width="16"
                                                                Height="16"
                                                                Foreground="#15803D"
                                                                Margin="0,1,8,0" />
                                    <TextBlock Text="First-time setup is active. Use the admin flow to finish store onboarding."
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Username"
                                       Margin="0,0,0,7"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="Username"
                                     FontSize="15"
                                     Height="48"
                                     Margin="0,0,0,16" />

                            <TextBlock Text="Password"
                                       Margin="0,0,0,7"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <PasswordBox x:Name="PasswordBox"
                                         Tag="Password"
                                         FontSize="15"
                                         Height="48"
                                         Margin="0,0,0,18" />

                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="KeyboardReturn"
                                                                Width="15"
                                                                Height="15"
                                                                Foreground="{StaticResource AppMuted}"
                                                                Margin="0,0,6,0" />
                                    <TextBlock Text="Press Enter to continue"
                                               FontSize="12"
                                               Foreground="{StaticResource AppMuted}" />
                                </StackPanel>

                                <Border Grid.Column="1"
                                        Background="{StaticResource LoginSubtleFillBrush}"
                                        BorderBrush="{StaticResource LoginPanelBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        Padding="10,4"
                                        MinHeight="24">
                                    <TextBlock Text="Local account"
                                               FontSize="11.5"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource AppMuted}" />
                                </Border>
                            </Grid>

                            <Button Content="Sign in"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding LoginPasswordCommand}"
                                    CommandParameter="{Binding ElementName=PasswordBox}"
                                    Height="48"
                                    FontSize="15"
                                    HorizontalAlignment="Stretch" />
                        </StackPanel>

                        <StackPanel x:Name="PinPanel"
                                    Opacity="0"
                                    IsHitTestVisible="False">
                            <StackPanel.RenderTransform>
                                <TranslateTransform x:Name="PinPanelTranslate" X="420" />
                            </StackPanel.RenderTransform>

                            <Grid ClipToBounds="True">
                                <StackPanel x:Name="StaffListPanel">
                                    <StackPanel.RenderTransform>
                                        <TranslateTransform x:Name="StaffListTranslate" />
                                    </StackPanel.RenderTransform>

                                    <Border Style="{StaticResource FeatureSurfaceStyle}"
                                            Background="{StaticResource LoginAccentFillBrush}"
                                            BorderBrush="{StaticResource LoginAccentBorderBrush}"
                                            Margin="0,0,0,18">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Border Width="40"
                                                    Height="40"
                                                    CornerRadius="14"
                                                    Background="#DCE9FF"
                                                    Margin="0,0,14,0">
                                                <iconPacks:PackIconMaterial Kind="StorefrontOutline"
                                                                            Width="18"
                                                                            Height="18"
                                                                            Foreground="{StaticResource AppAccent}"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center" />
                                            </Border>

                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Cashier quick access"
                                                           FontSize="16"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                                <TextBlock Text="Choose your profile, then enter a 4-digit PIN to return to selling."
                                                           Margin="0,5,0,0"
                                                           Foreground="{StaticResource AppMuted}"
                                                           TextWrapping="Wrap"
                                                           LineHeight="19" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="Choose cashier"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center" />

                                        <Border Grid.Column="1"
                                                Background="{StaticResource LoginSubtleFillBrush}"
                                                BorderBrush="{StaticResource LoginPanelBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="999"
                                                Padding="10,5">
                                            <TextBlock Text="NumPad supported"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource AppMuted}" />
                                        </Border>
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding Staff}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"
                                                           HorizontalAlignment="Center" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.SelectStaffCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource StaffCardButtonStyle}">
                                                    <StackPanel HorizontalAlignment="Center"
                                                                VerticalAlignment="Center">
                                                        <Border Width="52"
                                                                Height="52"
                                                                CornerRadius="18"
                                                                Background="{StaticResource LoginAccentFillBrush}"
                                                                BorderBrush="{StaticResource LoginAccentBorderBrush}"
                                                                BorderThickness="1"
                                                                HorizontalAlignment="Center"
                                                                Margin="0,0,0,12">
                                                            <TextBlock Text="{Binding DisplayName, Converter={StaticResource InitialsConverter}}"
                                                                       Foreground="{StaticResource AppAccent}"
                                                                       FontSize="16"
                                                                       FontWeight="Bold"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center" />
                                                        </Border>
                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   TextAlignment="Center"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <StackPanel x:Name="PinEntryPanel"
                                            Opacity="0"
                                            IsHitTestVisible="False">
                                    <StackPanel.RenderTransform>
                                        <TranslateTransform x:Name="PinEntryTranslate" X="420" />
                                    </StackPanel.RenderTransform>

                                    <Border Style="{StaticResource FeatureSurfaceStyle}"
                                            Padding="22">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <Button Command="{Binding BackToListCommand}"
                                                        Style="{StaticResource InlineGhostButtonStyle}"
                                                        VerticalAlignment="Top">
                                                    <StackPanel Orientation="Horizontal">
                                                        <iconPacks:PackIconMaterial Kind="ArrowLeft"
                                                                                    Width="14"
                                                                                    Height="14"
                                                                                    Margin="0,0,6,0" />
                                                        <TextBlock Text="Back"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource AppAccent}" />
                                                    </StackPanel>
                                                </Button>

                                                <StackPanel Grid.Column="1"
                                                            HorizontalAlignment="Center">
                                                    <Border Width="58"
                                                            Height="58"
                                                            CornerRadius="20"
                                                            Background="{StaticResource LoginAccentFillBrush}"
                                                            BorderBrush="{StaticResource LoginAccentBorderBrush}"
                                                            BorderThickness="1"
                                                            HorizontalAlignment="Center">
                                                        <TextBlock Text="{Binding SelectedStaff.DisplayName, Converter={StaticResource InitialsConverter}}"
                                                                   Foreground="{StaticResource AppAccent}"
                                                                   FontSize="18"
                                                                   FontWeight="Bold"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Border>

                                                    <TextBlock Text="{Binding SelectedStaff.DisplayName}"
                                                               Margin="0,12,0,0"
                                                               FontSize="18"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               HorizontalAlignment="Center" />
                                                    <TextBlock Text="Enter your 4-digit PIN"
                                                               Margin="0,4,0,0"
                                                               FontSize="12"
                                                               Foreground="{StaticResource AppMuted}"
                                                               HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Grid>

                                            <StackPanel Grid.Row="1"
                                                        Orientation="Horizontal"
                                                        HorizontalAlignment="Center"
                                                        Margin="0,22,0,18">
                                                <Border Width="16"
                                                        Height="16"
                                                        CornerRadius="8"
                                                        BorderThickness="1.5"
                                                        Margin="0,0,10,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#FFFFFF" />
                                                            <Setter Property="BorderBrush" Value="#C7D2E2" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPinSlot1Filled}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource TextPrimaryBrush}" />
                                                                    <Setter Property="BorderBrush" Value="{StaticResource TextPrimaryBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>

                                                <Border Width="16"
                                                        Height="16"
                                                        CornerRadius="8"
                                                        BorderThickness="1.5"
                                                        Margin="0,0,10,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#FFFFFF" />
                                                            <Setter Property="BorderBrush" Value="#C7D2E2" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPinSlot2Filled}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource TextPrimaryBrush}" />
                                                                    <Setter Property="BorderBrush" Value="{StaticResource TextPrimaryBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>

                                                <Border Width="16"
                                                        Height="16"
                                                        CornerRadius="8"
                                                        BorderThickness="1.5"
                                                        Margin="0,0,10,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#FFFFFF" />
                                                            <Setter Property="BorderBrush" Value="#C7D2E2" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPinSlot3Filled}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource TextPrimaryBrush}" />
                                                                    <Setter Property="BorderBrush" Value="{StaticResource TextPrimaryBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>

                                                <Border Width="16"
                                                        Height="16"
                                                        CornerRadius="8"
                                                        BorderThickness="1.5">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#FFFFFF" />
                                                            <Setter Property="BorderBrush" Value="#C7D2E2" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPinSlot4Filled}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource TextPrimaryBrush}" />
                                                                    <Setter Property="BorderBrush" Value="{StaticResource TextPrimaryBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                            </StackPanel>

                                            <Grid Grid.Row="2"
                                                  HorizontalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="78" />
                                                    <ColumnDefinition Width="78" />
                                                    <ColumnDefinition Width="78" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="68" />
                                                    <RowDefinition Height="68" />
                                                    <RowDefinition Height="68" />
                                                    <RowDefinition Height="68" />
                                                </Grid.RowDefinitions>

                                                <Button Grid.Row="0" Grid.Column="0" Content="1" Command="{Binding PinDigitCommand}" CommandParameter="1" Style="{StaticResource PinKeyButtonStyle}" Margin="5" />
                                                <Button Grid.Row="0" Grid.Column="1" Content="2" Command="{Binding PinDigitCommand}" CommandParameter="2" Style="{StaticResource PinKeyButtonStyle}" Margin="5" />
                                                <Button Grid.Row="0" Grid.Column="2" Content="3" Command="{Binding PinDigitCommand}" CommandParameter="3" Style="{StaticResource PinKeyButtonStyle}" Margin="5" />
                                                <Button Grid.Row="1" Grid.Column="0" Content="4" Command="{Binding PinDigitCommand}" CommandParameter="4" Style="{StaticResource PinKeyButtonStyle}" Margin="5" />
                                                <Button Grid.Row="1" Grid.Column="1" Content="5" Command="{Binding PinDigitCommand}" CommandParameter="5" Style="{StaticResource PinKeyButtonStyle}" Margin="5" />
                                                <Button Grid.Row="1" Grid.Column="2" Content="6" Command="{Binding PinDigitCommand}" CommandParameter="6" Style="{StaticResource PinKeyButtonStyle}" Margin="5" />
                                                <Button Grid.Row="2" Grid.Column="0" Content="7" Command="{Binding PinDigitCommand}" CommandParameter="7" Style="{StaticResource PinKeyButtonStyle}" Margin="5" />
                                                <Button Grid.Row="2" Grid.Column="1" Content="8" Command="{Binding PinDigitCommand}" CommandParameter="8" Style="{StaticResource PinKeyButtonStyle}" Margin="5" />
                                                <Button Grid.Row="2" Grid.Column="2" Content="9" Command="{Binding PinDigitCommand}" CommandParameter="9" Style="{StaticResource PinKeyButtonStyle}" Margin="5" />
                                                <Button Grid.Row="3" Grid.Column="0" Content="C" Command="{Binding ClearPinCommand}" Style="{StaticResource PinDangerButtonStyle}" Margin="5" />
                                                <Button Grid.Row="3" Grid.Column="1" Content="0" Command="{Binding PinDigitCommand}" CommandParameter="0" Style="{StaticResource PinKeyButtonStyle}" Margin="5" />
                                                <Button Grid.Row="3" Grid.Column="2" Content="&#x2190;" Command="{Binding BackspacePinCommand}" Style="{StaticResource PinKeyButtonStyle}" Margin="5" />
                                            </Grid>

                                            <TextBlock Grid.Row="3"
                                                       Text="You can also use the keyboard number row or numpad."
                                                       Margin="0,18,0,0"
                                                       FontSize="12"
                                                       Foreground="{StaticResource AppMuted}"
                                                       HorizontalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <Border Background="#FFF2F2"
                            BorderBrush="#F7CACA"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="14,12"
                            Margin="0,20,0,0"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="AlertCircleOutline"
                                                        Width="16"
                                                        Height="16"
                                                        Foreground="#D14343"
                                                        Margin="0,0,8,0"
                                                        VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ErrorMessage}"
                                       Foreground="#D14343"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
