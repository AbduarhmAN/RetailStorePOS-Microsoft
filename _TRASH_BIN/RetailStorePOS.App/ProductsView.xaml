<UserControl x:Class="RetailStorePOS.App.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="Transparent"
             FontFamily="Inter, Segoe UI Variable Text, Segoe UI">

    <UserControl.Resources>
        <Color x:Key="MacProductsPageTop">#F8F9FB</Color>
        <Color x:Key="MacProductsPageBottom">#EEF2F6</Color>
        <Color x:Key="MacProductsSurface">#F6F8FC</Color>
        <Color x:Key="MacProductsCard">#FFFFFF</Color>
        <Color x:Key="MacProductsBorder">#DCE4EF</Color>
        <Color x:Key="MacProductsTextPrimary">#1C2431</Color>
        <Color x:Key="MacProductsTextSecondary">#6A7486</Color>
        <Color x:Key="MacProductsAccent">#3B82F6</Color>
        <Color x:Key="MacProductsAccentPressed">#2563EB</Color>
        <Color x:Key="MacProductsDanger">#FF3B30</Color>
        <Color x:Key="MacProductsOverlay">#8018233A</Color>

        <LinearGradientBrush x:Key="MacProductsPageBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="{StaticResource MacProductsPageTop}" Offset="0" />
            <GradientStop Color="{StaticResource MacProductsPageBottom}" Offset="1" />
        </LinearGradientBrush>

        <SolidColorBrush x:Key="MacProductsSurfaceBrush" Color="{StaticResource MacProductsSurface}" />
        <SolidColorBrush x:Key="MacProductsCardBrush" Color="{StaticResource MacProductsCard}" />
        <SolidColorBrush x:Key="MacProductsBorderBrush" Color="{StaticResource MacProductsBorder}" />
        <SolidColorBrush x:Key="MacProductsTextPrimaryBrush" Color="{StaticResource MacProductsTextPrimary}" />
        <SolidColorBrush x:Key="MacProductsTextSecondaryBrush" Color="{StaticResource MacProductsTextSecondary}" />
        <SolidColorBrush x:Key="MacProductsAccentBrush" Color="{StaticResource MacProductsAccent}" />
        <SolidColorBrush x:Key="MacProductsAccentPressedBrush" Color="{StaticResource MacProductsAccentPressed}" />
        <SolidColorBrush x:Key="MacProductsDangerBrush" Color="{StaticResource MacProductsDanger}" />
        <SolidColorBrush x:Key="MacProductsOverlayBrush" Color="{StaticResource MacProductsOverlay}" />

        <Style x:Key="ProductsToolbarStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource MacProductsCardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource MacProductsBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="20,18" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#0F1F33" BlurRadius="18" ShadowDepth="0" Opacity="0.05" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProductsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource MacProductsCardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource MacProductsBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#0F1F33" BlurRadius="18" ShadowDepth="0" Opacity="0.05" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProductsTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="31" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource MacProductsTextPrimaryBrush}" />
        </Style>

        <Style x:Key="ProductsSubtitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource MacProductsTextSecondaryBrush}" />
        </Style>

        <Style x:Key="ProductsLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource MacProductsTextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="ProductsTextBoxStyle" TargetType="TextBox">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Foreground" Value="{StaticResource MacProductsTextPrimaryBrush}" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#DCE4EF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsKeyboardFocused" Value="True" />
                                    <Condition Property="IsReadOnly" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="{StaticResource MacProductsAccentBrush}" />
                                <Setter TargetName="InputBorder" Property="BorderThickness" Value="2" />
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="InputBorder" Property="Opacity" Value="0.65" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProductsComboBoxStyle" TargetType="ComboBox">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Foreground" Value="{StaticResource MacProductsTextPrimaryBrush}" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#DCE4EF" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="ProductsBaseButtonStyle" TargetType="Button">
            <Style.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                </Style>
            </Style.Resources>
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.84" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProductsPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ProductsBaseButtonStyle}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource MacProductsAccentBrush}" />
            <Setter Property="BorderBrush" Value="#2563EB" />
        </Style>

        <Style x:Key="ProductsSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ProductsBaseButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource MacProductsTextPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#DCE4EF" />
        </Style>

        <Style x:Key="ProductsDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource ProductsBaseButtonStyle}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource MacProductsDangerBrush}" />
            <Setter Property="BorderBrush" Value="#D52E24" />
        </Style>

        <Style x:Key="ProductsDataGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#E6ECF6" />
            <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="ColumnHeaderHeight" Value="44" />
            <Setter Property="RowHeight" Value="52" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource MacProductsTextPrimaryBrush}" />
        </Style>

        <Style x:Key="ProductsDataGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F4F8FE" />
            <Setter Property="Foreground" Value="{StaticResource MacProductsTextSecondaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="BorderBrush" Value="#DFE6F2" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>

        <Style x:Key="ProductsDataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProductsDataGridRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource MacProductsTextPrimaryBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F5F9FF" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E2EEFF" />
                    <Setter Property="Foreground" Value="{StaticResource MacProductsTextPrimaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EditorPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource MacProductsCardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource MacProductsBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
        </Style>

        <Style x:Key="ToastStyle" TargetType="Border">
            <Setter Property="Background" Value="#102033" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Margin" Value="0,0,0,20" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusMessage}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusMessage}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Background="{StaticResource MacProductsPageBrush}">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource ProductsToolbarStyle}">
                <Grid>
                     <Grid.RowDefinitions>
                         <RowDefinition Height="Auto" />
                         <RowDefinition Height="Auto" />
                         <RowDefinition Height="Auto" />
                     </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <iconPacks:PackIconMaterial Kind="PackageVariantClosed" Width="24" Height="24" Foreground="{StaticResource MacProductsAccentBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="Products" Style="{StaticResource ProductsTitleStyle}" />
                            </StackPanel>
                            <TextBlock Text="Manage products, search quickly, and open any item to edit."
                                       Margin="0,8,0,0"
                                       Style="{StaticResource ProductsSubtitleStyle}" />
                        </StackPanel>

                        <WrapPanel Grid.Column="1" VerticalAlignment="Top">
                            <Button Style="{StaticResource ProductsSecondaryButtonStyle}" Command="{Binding ImportCommand}" Margin="0,0,8,0" IsEnabled="{Binding CanImportCsv}">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="FileImport" Width="15" Height="15" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding ImportButtonText}" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource ProductsPrimaryButtonStyle}" Command="{Binding NewCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="Plus" Width="15" Height="15" Margin="0,0,6,0" />
                                    <TextBlock Text="Add Product" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="360" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="#FFFFFF"
                                BorderBrush="{StaticResource MacProductsBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="12,0"
                                Height="42">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <iconPacks:PackIconMaterial Grid.Column="0"
                                                            Kind="Magnify"
                                                            Width="16"
                                                            Height="16"
                                                            Foreground="{StaticResource MacProductsTextSecondaryBrush}"
                                                            Margin="0,0,8,0"
                                                            VerticalAlignment="Center" />

                                <TextBox Grid.Column="1"
                                         Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ProductsTextBoxStyle}"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Padding="0"
                                         MinHeight="30"
                                         VerticalContentAlignment="Center"
                                         Tag="Search products by name" />
                            </Grid>
                        </Border>

                        <TextBlock Grid.Column="2"
                                   Text="{Binding SearchSummary}"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{StaticResource MacProductsTextSecondaryBrush}" />

                        <WrapPanel Grid.Column="3" VerticalAlignment="Center">
                            <Border Background="#F4F7FC" BorderBrush="#DCE4EF" BorderThickness="1" CornerRadius="10" Padding="10,5" Margin="0,0,8,0">
                                <TextBlock Text="{Binding Products.Count, StringFormat={}{0:N0} products}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MacProductsTextPrimaryBrush}" />
                            </Border>

                            <Border Background="#EDF3FD"
                                    BorderBrush="#D4E2F7"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="10,5"
                                    Visibility="{Binding SelectedProduct.Name, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="PencilOutline" Width="13" Height="13" Margin="0,0,6,0" Foreground="{StaticResource MacProductsAccentBrush}" />
                                    <TextBlock Text="{Binding SelectedProduct.Name}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MacProductsAccentBrush}" />
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                    </Grid>

                    <Border Grid.Row="2"
                            Margin="0,16,0,0"
                            Background="#F7FAFE"
                            BorderBrush="#DCE4EF"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="14,13"
                            Visibility="{Binding HasImportJob, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="40" Height="40" Background="#E8F0FF" BorderBrush="#D3E2FB" BorderThickness="1" CornerRadius="12" Margin="0,0,10,0">
                                        <iconPacks:PackIconMaterial Kind="FileImport" Width="19" Height="19" Foreground="{StaticResource MacProductsAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="{Binding ImportStatusText}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource MacProductsTextPrimaryBrush}" />
                                        <TextBlock Text="{Binding ImportFileName}" Margin="0,3,0,0" FontSize="12" Foreground="{StaticResource MacProductsTextSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>

                                <ProgressBar Margin="0,14,0,0"
                                             Height="8"
                                             Maximum="100"
                                             Value="{Binding ImportProgressPercent, Mode=OneWay}"
                                             Foreground="{StaticResource MacProductsAccentBrush}"
                                             Background="#E3EAF5"
                                             BorderThickness="0" />

                                <WrapPanel Margin="0,12,0,0">
                                    <Border Background="#FFFFFF" BorderBrush="#E0E8F2" BorderThickness="1" CornerRadius="10" Padding="10,6" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding ImportProcessedLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MacProductsTextPrimaryBrush}" />
                                    </Border>
                                    <Border Background="#FFFFFF" BorderBrush="#E0E8F2" BorderThickness="1" CornerRadius="10" Padding="10,6" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding ImportImportedLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MacProductsTextPrimaryBrush}" />
                                    </Border>
                                    <Border Background="#FFFFFF" BorderBrush="#E0E8F2" BorderThickness="1" CornerRadius="10" Padding="10,6">
                                        <TextBlock Text="{Binding ImportSkippedLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MacProductsTextPrimaryBrush}" />
                                    </Border>
                                </WrapPanel>

                                <TextBlock Text="{Binding ImportDetailText}"
                                           Margin="0,10,0,0"
                                           FontSize="12"
                                           Foreground="{StaticResource MacProductsTextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding HasImportDetail, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </StackPanel>

                            <Border Grid.Column="1"
                                    Background="#EDF3FD"
                                    BorderBrush="#D4E2F7"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="14,10"
                                    Margin="16,0,0,0"
                                    VerticalAlignment="Top">
                                <StackPanel>
                                    <TextBlock Text="PROGRESS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MacProductsAccentBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding ImportPercentLabel}" Margin="0,6,0,0" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource MacProductsTextPrimaryBrush}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource ProductsCardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="20,18,20,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Catalog" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource MacProductsTextPrimaryBrush}" />
                                <Border Background="#EDF3FD" BorderBrush="#D4E2F7" BorderThickness="1" CornerRadius="9" Padding="8,3" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding Products.Count, StringFormat={}{0:N0} products}" FontSize="12" Foreground="{StaticResource MacProductsTextSecondaryBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Select a product to edit its details."
                                       Margin="0,6,0,0"
                                       FontSize="12"
                                       Foreground="{StaticResource MacProductsTextSecondaryBrush}" />
                        </StackPanel>

                        <TextBlock Grid.Column="1"
                                   Text="Results update as you type"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{StaticResource MacProductsTextSecondaryBrush}" />
                    </Grid>

                    <Grid Grid.Row="1">
                        <DataGrid Margin="0,0,0,4"
                                  ItemsSource="{Binding Products}"
                                  SelectedItem="{Binding SelectedProduct}"
                                  Style="{StaticResource ProductsDataGridStyle}"
                                  ColumnHeaderStyle="{StaticResource ProductsDataGridHeaderStyle}"
                                  CellStyle="{StaticResource ProductsDataGridCellStyle}"
                                  RowStyle="{StaticResource ProductsDataGridRowStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="190" />
                                <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat={}{0:N2}}" Width="120" />
                                <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="110" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Background="#FBFCFE"
                                BorderBrush="#E5EBF4"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="22"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding HasNoProducts, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="56" Height="56" CornerRadius="18" Background="#E8EFFC" HorizontalAlignment="Center" Margin="0,0,0,12">
                                    <iconPacks:PackIconMaterial Kind="PackageVariantClosed" Width="24" Height="24" Foreground="{StaticResource MacProductsAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="No products found" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{StaticResource MacProductsTextPrimaryBrush}" />
                                <TextBlock Text="Try a different search or create a new product to grow the catalog." Margin="0,6,0,0" FontSize="12" TextAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource MacProductsTextSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Background="{StaticResource MacProductsOverlayBrush}"
                Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border.InputBindings>
                <MouseBinding MouseAction="LeftClick" Command="{Binding CloseEditorCommand}" />
            </Border.InputBindings>
        </Border>

        <Border HorizontalAlignment="Right"
                Width="500"
                Margin="20"
                Padding="0"
                Style="{StaticResource EditorPanelStyle}"
                Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border.Effect>
                <DropShadowEffect Color="#111F33" Direction="180" ShadowDepth="10" BlurRadius="24" Opacity="0.18" />
            </Border.Effect>

            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <iconPacks:PackIconMaterial Kind="PackageVariantClosed" Width="20" Height="20" Foreground="{StaticResource MacProductsAccentBrush}" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding EditorTitle}" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource MacProductsTextPrimaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="{Binding EditorSubtitle}" Margin="0,6,0,0" FontSize="12" Foreground="{StaticResource MacProductsTextSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Style="{StaticResource ProductsSecondaryButtonStyle}"
                            Command="{Binding CloseEditorCommand}"
                            MinWidth="40"
                            Width="40"
                            Padding="0">
                        <iconPacks:PackIconMaterial Kind="Close" Width="16" Height="16" />
                    </Button>
                </Grid>

                <WrapPanel Grid.Row="1" Margin="0,0,0,16">
                    <Border Background="#EDF3FD" BorderBrush="#D4E2F7" BorderThickness="1" CornerRadius="10" Padding="10,5" Margin="0,0,8,0">
                        <TextBlock Text="{Binding EditorTitle}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MacProductsAccentBrush}" />
                    </Border>

                    <Border Background="#F4F7FC"
                            BorderBrush="#DCE4EF"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="10,5"
                            Visibility="{Binding SelectedProduct.Name, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{Binding SelectedProduct.Name}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MacProductsTextPrimaryBrush}" />
                    </Border>
                </WrapPanel>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,6,0">
                        <Border Background="#FBFCFE" BorderBrush="#E3EAF5" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Identity" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource MacProductsTextPrimaryBrush}" />
                                <TextBlock Text="Core information used at search and checkout." Margin="0,4,0,14" FontSize="12" Foreground="{StaticResource MacProductsTextSecondaryBrush}" />

                                <TextBlock Text="Product Name" Style="{StaticResource ProductsLabelStyle}" />
                                <TextBox Style="{StaticResource ProductsTextBoxStyle}" Text="{Binding Editor.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" />

                                <TextBlock Text="Barcode" Style="{StaticResource ProductsLabelStyle}" />
                                <TextBox Style="{StaticResource ProductsTextBoxStyle}" Text="{Binding Editor.Barcode, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" />

                                <TextBlock Text="SKU" Style="{StaticResource ProductsLabelStyle}" />
                                <TextBox Style="{StaticResource ProductsTextBoxStyle}" Text="{Binding Editor.Sku, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Border>

                        <Border Background="#FBFCFE" BorderBrush="#E3EAF5" BorderThickness="1" CornerRadius="14" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Selling Details" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource MacProductsTextPrimaryBrush}" />
                                <TextBlock Text="Control price, unit, and tax behavior for this product." Margin="0,4,0,14" FontSize="12" Foreground="{StaticResource MacProductsTextSecondaryBrush}" />

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Price" Style="{StaticResource ProductsLabelStyle}" />
                                        <TextBox Style="{StaticResource ProductsTextBoxStyle}" Text="{Binding Editor.Price, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanOverridePrice}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Unit" Style="{StaticResource ProductsLabelStyle}" />
                                        <TextBox Style="{StaticResource ProductsTextBoxStyle}" Text="{Binding Editor.Unit, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Tax Category" Style="{StaticResource ProductsLabelStyle}" />
                                <ComboBox Style="{StaticResource ProductsComboBoxStyle}"
                                          ItemsSource="{Binding TaxCategories}"
                                          SelectedValue="{Binding Editor.TaxCategoryId}"
                                          SelectedValuePath="Id"
                                          DisplayMemberPath="Name" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="3" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="1"
                            Style="{StaticResource ProductsSecondaryButtonStyle}"
                            Command="{Binding CloseEditorCommand}"
                            Margin="0,0,8,0">
                        <TextBlock Text="Cancel" />
                    </Button>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Style="{StaticResource ProductsDangerButtonStyle}"
                                Command="{Binding DeleteCommand}"
                                IsEnabled="{Binding CanDeleteSelected}"
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="TrashCanOutline" Width="15" Height="15" Margin="0,0,6,0" />
                                <TextBlock Text="Delete" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource ProductsPrimaryButtonStyle}" Command="{Binding SaveCommand}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="ContentSave" Width="15" Height="15" Margin="0,0,6,0" />
                                <TextBlock Text="Save Product" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Border Style="{StaticResource ToastStyle}">
            <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconMaterial Kind="Information" Foreground="#FFFFFF" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding StatusMessage}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
