<UserControl x:Class="RetailStorePOS.App.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:RetailStorePOS.App"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d"
             d:DesignHeight="840"
             d:DesignWidth="1180"
             Background="Transparent"
             FontFamily="Inter, Segoe UI Variable Text, Segoe UI">

    <UserControl.Resources>
        <Color x:Key="MacReportsPageTop">#F8F9FB</Color>
        <Color x:Key="MacReportsPageBottom">#EEF2F6</Color>
        <Color x:Key="MacReportsSurface">#F6F8FC</Color>
        <Color x:Key="MacReportsCard">#FFFFFF</Color>
        <Color x:Key="MacReportsBorder">#DCE4EF</Color>
        <Color x:Key="MacReportsTextPrimary">#1C2431</Color>
        <Color x:Key="MacReportsTextSecondary">#6A7486</Color>
        <Color x:Key="MacReportsAccent">#3B82F6</Color>
        <Color x:Key="MacReportsAccentPressed">#2563EB</Color>
        <Color x:Key="MacReportsSuccess">#16A34A</Color>
        <Color x:Key="MacReportsWarning">#F59E0B</Color>

        <LinearGradientBrush x:Key="MacReportsPageBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="{StaticResource MacReportsPageTop}" Offset="0" />
            <GradientStop Color="{StaticResource MacReportsPageBottom}" Offset="1" />
        </LinearGradientBrush>

        <SolidColorBrush x:Key="MacReportsSurfaceBrush" Color="{StaticResource MacReportsSurface}" />
        <SolidColorBrush x:Key="MacReportsCardBrush" Color="{StaticResource MacReportsCard}" />
        <SolidColorBrush x:Key="MacReportsBorderBrush" Color="{StaticResource MacReportsBorder}" />
        <SolidColorBrush x:Key="MacReportsTextPrimaryBrush" Color="{StaticResource MacReportsTextPrimary}" />
        <SolidColorBrush x:Key="MacReportsTextSecondaryBrush" Color="{StaticResource MacReportsTextSecondary}" />
        <SolidColorBrush x:Key="MacReportsAccentBrush" Color="{StaticResource MacReportsAccent}" />
        <SolidColorBrush x:Key="MacReportsAccentPressedBrush" Color="{StaticResource MacReportsAccentPressed}" />
        <SolidColorBrush x:Key="MacReportsSuccessBrush" Color="{StaticResource MacReportsSuccess}" />
        <SolidColorBrush x:Key="MacReportsWarningBrush" Color="{StaticResource MacReportsWarning}" />

        <Style x:Key="ReportsPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource MacReportsSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource MacReportsBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
        </Style>

        <Style x:Key="ReportsCardStyle" TargetType="Border" BasedOn="{StaticResource ReportsPanelStyle}">
            <Setter Property="Background" Value="{StaticResource MacReportsCardBrush}" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style x:Key="ReportsTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource MacReportsTextPrimaryBrush}" />
        </Style>

        <Style x:Key="ReportsSubtitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource MacReportsTextSecondaryBrush}" />
        </Style>

        <Style x:Key="ReportsSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource MacReportsTextPrimaryBrush}" />
        </Style>

        <Style x:Key="ReportsFilterLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource MacReportsTextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="ReportsMetricLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource MacReportsTextSecondaryBrush}" />
        </Style>

        <Style x:Key="ReportsMetricValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="25" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource MacReportsTextPrimaryBrush}" />
        </Style>

        <Style x:Key="ReportsMetricFootStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource MacReportsTextSecondaryBrush}" />
        </Style>

        <Style x:Key="ReportsDatePickerStyle" TargetType="DatePicker">
            <Setter Property="Height" Value="38" />
            <Setter Property="Width" Value="168" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource MacReportsTextPrimaryBrush}" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource MacReportsBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,0" />
        </Style>

        <Style x:Key="ReportsFilterComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="38" />
            <Setter Property="Width" Value="170" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource MacReportsTextPrimaryBrush}" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource MacReportsBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,0" />
        </Style>

        <Style x:Key="ReportsSearchTextBoxStyle" TargetType="TextBox">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Width" Value="250" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource MacReportsTextPrimaryBrush}" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource MacReportsBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
        </Style>

        <Style x:Key="ReportsBaseButtonStyle" TargetType="Button">
            <Style.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                </Style>
            </Style.Resources>
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.84" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ReportsPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ReportsBaseButtonStyle}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource MacReportsAccentBrush}" />
            <Setter Property="BorderBrush" Value="#2563EB" />
        </Style>

        <Style x:Key="ReportsSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ReportsBaseButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource MacReportsTextPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#DCE4EF" />
        </Style>

        <Style x:Key="ReportsMiniButtonStyle" TargetType="Button" BasedOn="{StaticResource ReportsSecondaryButtonStyle}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="ReportsPresetButtonBaseStyle" TargetType="Button" BasedOn="{StaticResource ReportsSecondaryButtonStyle}">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <Style x:Key="ReportsTodayPresetButtonStyle" TargetType="Button" BasedOn="{StaticResource ReportsPresetButtonBaseStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTodayPreset}" Value="True">
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="Background" Value="{StaticResource MacReportsAccentBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource MacReportsAccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ReportsLast7PresetButtonStyle" TargetType="Button" BasedOn="{StaticResource ReportsPresetButtonBaseStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLast7DaysPreset}" Value="True">
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="Background" Value="{StaticResource MacReportsAccentBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource MacReportsAccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ReportsLast30PresetButtonStyle" TargetType="Button" BasedOn="{StaticResource ReportsPresetButtonBaseStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLast30DaysPreset}" Value="True">
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="Background" Value="{StaticResource MacReportsAccentBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource MacReportsAccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ReportsDataGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#E6ECF6" />
            <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="ColumnHeaderHeight" Value="42" />
            <Setter Property="RowHeight" Value="50" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource MacReportsTextPrimaryBrush}" />
        </Style>

        <Style x:Key="ReportsDataGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F4F8FE" />
            <Setter Property="Foreground" Value="{StaticResource MacReportsTextSecondaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="BorderBrush" Value="#DFE6F2" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>

        <Style x:Key="ReportsDataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ReportsDataGridRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource MacReportsTextPrimaryBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F5F9FF" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E2EEFF" />
                    <Setter Property="Foreground" Value="{StaticResource MacReportsTextPrimaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource MacReportsPageBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource ReportsPanelStyle}" Padding="18,14" Margin="0,0,0,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <iconPacks:PackIconMaterial Kind="ChartLine" Width="25" Height="25" Foreground="{StaticResource MacReportsAccentBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <StackPanel>
                                <TextBlock Text="Reports" Style="{StaticResource ReportsTitleStyle}" />
                                <TextBlock Text="Sales totals and transaction history" Style="{StaticResource ReportsSubtitleStyle}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Command="{Binding OpenReceiptsFolderCommand}" Style="{StaticResource ReportsSecondaryButtonStyle}" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="FolderOpen" Width="14" Height="14" Margin="0,0,6,0" />
                                    <TextBlock Text="Open Receipts" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding LoadReportCommand}" Style="{StaticResource ReportsPrimaryButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="Refresh" Width="14" Height="14" Margin="0,0,6,0" />
                                    <TextBlock Text="Refresh" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <WrapPanel Grid.Row="1" Margin="0,16,0,0">
                        <StackPanel Margin="0,0,14,10">
                            <TextBlock Text="Quick range" Style="{StaticResource ReportsFilterLabelStyle}" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Today" Command="{Binding TodayRangeCommand}" Style="{StaticResource ReportsTodayPresetButtonStyle}" />
                                <Button Content="Last 7 days" Command="{Binding Last7DaysRangeCommand}" Style="{StaticResource ReportsLast7PresetButtonStyle}" />
                                <Button Content="Last 30 days" Command="{Binding Last30DaysRangeCommand}" Style="{StaticResource ReportsLast30PresetButtonStyle}" Margin="0" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Margin="0,0,14,10">
                            <TextBlock Text="From" Style="{StaticResource ReportsFilterLabelStyle}" />
                            <DatePicker SelectedDate="{Binding FromDate}" Style="{StaticResource ReportsDatePickerStyle}" />
                        </StackPanel>

                        <StackPanel Margin="0,0,14,10">
                            <TextBlock Text="To" Style="{StaticResource ReportsFilterLabelStyle}" />
                            <DatePicker SelectedDate="{Binding ToDate}" Style="{StaticResource ReportsDatePickerStyle}" />
                        </StackPanel>

                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="Search" Style="{StaticResource ReportsFilterLabelStyle}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ReportsSearchTextBoxStyle}" Tag="Date or time (yyyy-mm-dd / HH:mm)" />
                                <Button Command="{Binding ClearSearchCommand}" Style="{StaticResource ReportsSecondaryButtonStyle}" Margin="8,0,0,0" Padding="12,8" MinHeight="38">
                                    <iconPacks:PackIconMaterial Kind="Close" Width="13" Height="13" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </WrapPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="0,0,0,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource ReportsCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="42" Height="42" CornerRadius="11" Background="#E5F0FF" Margin="0,0,12,0">
                            <iconPacks:PackIconMaterial Kind="CashMultiple" Width="20" Height="20" Foreground="{StaticResource MacReportsAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Total Sales" Style="{StaticResource ReportsMetricLabelStyle}" />
                            <TextBlock Text="{Binding DailySales, StringFormat=${0:F2}}" Style="{StaticResource ReportsMetricValueStyle}" Margin="0,1,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource ReportsCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="42" Height="42" CornerRadius="11" Background="#ECFDF3" Margin="0,0,12,0">
                            <iconPacks:PackIconMaterial Kind="ChartWaterfall" Width="20" Height="20" Foreground="{StaticResource MacReportsSuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Net Sales" Style="{StaticResource ReportsMetricLabelStyle}" />
                            <TextBlock Text="{Binding NetSales, StringFormat=${0:F2}}" Style="{StaticResource ReportsMetricValueStyle}" Margin="0,1,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="0" Grid.Column="4" Style="{StaticResource ReportsCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="42" Height="42" CornerRadius="11" Background="#EEF4FF" Margin="0,0,12,0">
                            <iconPacks:PackIconMaterial Kind="ReceiptTextCheck" Width="20" Height="20" Foreground="{StaticResource MacReportsAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Transactions" Style="{StaticResource ReportsMetricLabelStyle}" />
                            <TextBlock Text="{Binding Transactions}" Style="{StaticResource ReportsMetricValueStyle}" Margin="0,1,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource ReportsCardStyle}" Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="42" Height="42" CornerRadius="11" Background="#FFF7E8" Margin="0,0,12,0">
                            <iconPacks:PackIconMaterial Kind="CalculatorVariantOutline" Width="20" Height="20" Foreground="{StaticResource MacReportsWarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Average Sale" Style="{StaticResource ReportsMetricLabelStyle}" />
                            <TextBlock Text="{Binding AverageTicket, StringFormat=${0:F2}}" Style="{StaticResource ReportsMetricValueStyle}" Margin="0,1,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource ReportsCardStyle}" Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="42" Height="42" CornerRadius="11" Background="#FFF3EA" Margin="0,0,12,0">
                            <iconPacks:PackIconMaterial Kind="PercentBox" Width="20" Height="20" Foreground="#D97706" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Tax Collected" Style="{StaticResource ReportsMetricLabelStyle}" />
                            <TextBlock Text="{Binding TaxCollected, StringFormat=${0:F2}}" Style="{StaticResource ReportsMetricValueStyle}" Margin="0,1,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Grid.Column="4" Style="{StaticResource ReportsCardStyle}" Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="42" Height="42" CornerRadius="11" Background="#EDF3FD" Margin="0,0,12,0">
                            <iconPacks:PackIconMaterial Kind="FilterCheck" Width="20" Height="20" Foreground="{StaticResource MacReportsAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Results" Style="{StaticResource ReportsMetricLabelStyle}" />
                            <TextBlock Text="{Binding VisibleTransactions}" Style="{StaticResource ReportsMetricValueStyle}" Margin="0,1,0,0" />
                            <TextBlock Text="{Binding Transactions, StringFormat=of {0} matching transactions}" Style="{StaticResource ReportsMetricFootStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="2" Margin="0,0,0,14">
                <Border Style="{StaticResource ReportsCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Cash Summary" Style="{StaticResource ReportsSectionTitleStyle}" Margin="0,0,0,8" />
                            <TextBlock Text="Current range" Style="{StaticResource ReportsMetricLabelStyle}" />
                            <TextBlock Text="{Binding RangeLabel}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource MacReportsTextPrimaryBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Cash sales" Style="{StaticResource ReportsMetricLabelStyle}" />
                            <TextBlock Text="{Binding CashSales, StringFormat=${0:F2}}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource MacReportsTextPrimaryBrush}" />
                            <TextBlock Text="100% cash flow" Style="{StaticResource ReportsMetricFootStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Tax and average sale" Style="{StaticResource ReportsMetricLabelStyle}" />
                            <TextBlock Text="{Binding TaxCollected, StringFormat=Tax ${0:F2}}" Foreground="{StaticResource MacReportsTextSecondaryBrush}" />
                            <TextBlock Text="{Binding AverageTicket, StringFormat=Avg ${0:F2}}" Foreground="{StaticResource MacReportsTextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="3" Style="{StaticResource ReportsPanelStyle}" Padding="0" MinHeight="360">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="18,14,18,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Transactions" Style="{StaticResource ReportsSectionTitleStyle}" />
                            <Border Background="#EDF3FD" BorderBrush="#D4E2F7" BorderThickness="1" CornerRadius="9" Padding="8,3" Margin="10,0,0,0">
                                <TextBlock Text="{Binding VisibleTransactions, StringFormat={}{0} results}" FontSize="12" Foreground="{StaticResource MacReportsTextSecondaryBrush}" />
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding RangeLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MacReportsTextPrimaryBrush}" HorizontalAlignment="Right" />
                            <TextBlock Text="Matching transactions" Foreground="{StaticResource MacReportsTextSecondaryBrush}" FontSize="12" HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1">
                        <DataGrid ItemsSource="{Binding Sales}"
                                  local:NestedScrollViewerBehavior.BubbleMouseWheel="True"
                                  Style="{StaticResource ReportsDataGridStyle}"
                                  ColumnHeaderStyle="{StaticResource ReportsDataGridHeaderStyle}"
                                  CellStyle="{StaticResource ReportsDataGridCellStyle}"
                                  RowStyle="{StaticResource ReportsDataGridRowStyle}"
                                  MaxHeight="520">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Receipt #" Binding="{Binding ReceiptNumber}" Width="115" FontWeight="SemiBold" Foreground="{StaticResource MacReportsAccentBrush}" />
                                <DataGridTextColumn Header="Date" Binding="{Binding CreatedAt, StringFormat={}{0:MMM d}}" Width="110" Foreground="{StaticResource MacReportsTextSecondaryBrush}" />
                                <DataGridTextColumn Header="Time" Binding="{Binding CreatedAt, StringFormat={}{0:HH:mm}}" Width="90" Foreground="{StaticResource MacReportsTextSecondaryBrush}" />

                                <DataGridTemplateColumn Header="Payment" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#F1F5FB" CornerRadius="8" Padding="8,3" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding PaymentType}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MacReportsTextSecondaryBrush}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat=${0:F2}}" Width="100" />
                                <DataGridTextColumn Header="Tax" Binding="{Binding Tax, StringFormat=${0:F2}}" Width="90" />
                                <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=${0:F2}}" Width="*" FontWeight="SemiBold" />

                                <DataGridTemplateColumn Header="Actions" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.ReprintCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource ReportsMiniButtonStyle}">
                                                <StackPanel Orientation="Horizontal">
                                                    <iconPacks:PackIconMaterial Kind="Printer" Width="13" Height="13" Margin="0,0,5,0" />
                                                    <TextBlock Text="Reprint" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Background="#FFFFFF"
                                BorderBrush="#E4EAF3"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding HasNoVisibleTransactions, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="No transactions found" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{StaticResource MacReportsTextPrimaryBrush}" />
                                <TextBlock Text="Try a different date range or search term." FontSize="12" Foreground="{StaticResource MacReportsTextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="2" Background="#F4F8FE" BorderBrush="{StaticResource MacReportsBorderBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,16,16" Padding="14,9">
                        <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{StaticResource MacReportsTextSecondaryBrush}" />
                    </Border>
                </Grid>
            </Border>
        </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
