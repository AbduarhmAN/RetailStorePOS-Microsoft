<UserControl x:Class="RetailStorePOS.App.CheckoutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RetailStorePOS.App"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="Transparent"
             FontFamily="Manrope, Inter, Segoe UI Variable Text, Segoe UI"
             Loaded="CheckoutView_Loaded"
             PreviewKeyDown="CheckoutView_PreviewKeyDown">

    <UserControl.Resources>
        <Color x:Key="MacCheckoutPageTop">#F3F7FD</Color>
        <Color x:Key="MacCheckoutPageBottom">#E8EEF7</Color>
        <Color x:Key="MacCheckoutSurface">#F8FBFF</Color>
        <Color x:Key="MacCheckoutCard">#FFFFFF</Color>
        <Color x:Key="MacCheckoutBorder">#D9E3F0</Color>
        <Color x:Key="MacCheckoutTextPrimary">#0F172A</Color>
        <Color x:Key="MacCheckoutTextSecondary">#64748B</Color>
        <Color x:Key="MacCheckoutAccent">#0B5ED7</Color>
        <Color x:Key="MacCheckoutAccentPressed">#094DB1</Color>
        <Color x:Key="MacCheckoutSuccess">#15803D</Color>
        <Color x:Key="MacCheckoutDanger">#EF4444</Color>
        <Color x:Key="MacCheckoutAccentSoft">#E8F1FF</Color>
        <Color x:Key="MacCheckoutAccentBorder">#BFDBFE</Color>
        <Color x:Key="MacCheckoutSuccessSoft">#ECFDF3</Color>
        <Color x:Key="MacCheckoutSuccessBorder">#C7EFD6</Color>
        <Color x:Key="MacCheckoutDangerSoft">#FEF2F2</Color>
        <Color x:Key="MacCheckoutDangerBorder">#F9CACA</Color>
        <Color x:Key="MacCheckoutWarningSoft">#FFF7ED</Color>
        <Color x:Key="MacCheckoutWarningAccent">#D97706</Color>
        <Color x:Key="MacCheckoutSoftPanel">#F8FBFF</Color>

        <LinearGradientBrush x:Key="MacCheckoutPageBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="{StaticResource MacCheckoutPageTop}" Offset="0" />
            <GradientStop Color="{StaticResource MacCheckoutPageBottom}" Offset="1" />
        </LinearGradientBrush>

        <SolidColorBrush x:Key="MacCheckoutSurfaceBrush" Color="{StaticResource MacCheckoutSurface}" />
        <SolidColorBrush x:Key="MacCheckoutCardBrush" Color="{StaticResource MacCheckoutCard}" />
        <SolidColorBrush x:Key="MacCheckoutBorderBrush" Color="{StaticResource MacCheckoutBorder}" />
        <SolidColorBrush x:Key="MacCheckoutTextPrimaryBrush" Color="{StaticResource MacCheckoutTextPrimary}" />
        <SolidColorBrush x:Key="MacCheckoutTextSecondaryBrush" Color="{StaticResource MacCheckoutTextSecondary}" />
        <SolidColorBrush x:Key="MacCheckoutAccentBrush" Color="{StaticResource MacCheckoutAccent}" />
        <SolidColorBrush x:Key="MacCheckoutAccentPressedBrush" Color="{StaticResource MacCheckoutAccentPressed}" />
        <SolidColorBrush x:Key="MacCheckoutSuccessBrush" Color="{StaticResource MacCheckoutSuccess}" />
        <SolidColorBrush x:Key="MacCheckoutDangerBrush" Color="{StaticResource MacCheckoutDanger}" />
        <SolidColorBrush x:Key="MacCheckoutAccentSoftBrush" Color="{StaticResource MacCheckoutAccentSoft}" />
        <SolidColorBrush x:Key="MacCheckoutAccentBorderBrush" Color="{StaticResource MacCheckoutAccentBorder}" />
        <SolidColorBrush x:Key="MacCheckoutSuccessSoftBrush" Color="{StaticResource MacCheckoutSuccessSoft}" />
        <SolidColorBrush x:Key="MacCheckoutSuccessBorderBrush" Color="{StaticResource MacCheckoutSuccessBorder}" />
        <SolidColorBrush x:Key="MacCheckoutDangerSoftBrush" Color="{StaticResource MacCheckoutDangerSoft}" />
        <SolidColorBrush x:Key="MacCheckoutDangerBorderBrush" Color="{StaticResource MacCheckoutDangerBorder}" />
        <SolidColorBrush x:Key="MacCheckoutWarningSoftBrush" Color="{StaticResource MacCheckoutWarningSoft}" />
        <SolidColorBrush x:Key="MacCheckoutWarningAccentBrush" Color="{StaticResource MacCheckoutWarningAccent}" />
        <SolidColorBrush x:Key="MacCheckoutSoftPanelBrush" Color="{StaticResource MacCheckoutSoftPanel}" />

        <Style x:Key="CheckoutPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource MacCheckoutCardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource MacCheckoutBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#0F172A" BlurRadius="26" ShadowDepth="0" Opacity="0.08" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CheckoutHeadingStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="19" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource MacCheckoutTextPrimaryBrush}" />
        </Style>

        <Style x:Key="CheckoutSubtleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource MacCheckoutTextSecondaryBrush}" />
        </Style>

        <Style x:Key="CheckoutTextBoxStyle" TargetType="TextBox">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Foreground" Value="{StaticResource MacCheckoutTextPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource MacCheckoutCardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource MacCheckoutBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsKeyboardFocused" Value="True" />
                                    <Condition Property="IsReadOnly" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="{StaticResource MacCheckoutAccentBrush}" />
                                <Setter TargetName="InputBorder" Property="BorderThickness" Value="2" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CheckoutSearchTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource CheckoutTextBoxStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="Transparent" BorderThickness="0">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CheckoutBaseButtonStyle" TargetType="Button">
            <Style.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                </Style>
            </Style.Resources>
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.84" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CheckoutPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource CheckoutBaseButtonStyle}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource MacCheckoutAccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource MacCheckoutAccentPressedBrush}" />
        </Style>

        <Style x:Key="CheckoutSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource CheckoutBaseButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource MacCheckoutTextPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource MacCheckoutCardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource MacCheckoutBorderBrush}" />
        </Style>

        <Style x:Key="CheckoutDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource CheckoutBaseButtonStyle}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource MacCheckoutDangerBrush}" />
            <Setter Property="BorderBrush" Value="#C83A3E" />
        </Style>

        <Style x:Key="CheckoutMiniButtonStyle" TargetType="Button" BasedOn="{StaticResource CheckoutSecondaryButtonStyle}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style x:Key="CheckoutMiniDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource CheckoutDangerButtonStyle}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style x:Key="CheckoutChipButtonStyle" TargetType="Button" BasedOn="{StaticResource CheckoutSecondaryButtonStyle}">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,6,6" />
        </Style>

        <Style x:Key="CheckoutDataGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#E7EEF7" />
            <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="ColumnHeaderHeight" Value="38" />
            <Setter Property="RowHeight" Value="46" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource MacCheckoutTextPrimaryBrush}" />
        </Style>

        <Style x:Key="CheckoutDataGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource MacCheckoutSoftPanelBrush}" />
            <Setter Property="Foreground" Value="{StaticResource MacCheckoutTextSecondaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="BorderBrush" Value="{StaticResource MacCheckoutBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>

        <Style x:Key="CheckoutDataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CheckoutDataGridRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource MacCheckoutTextPrimaryBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource MacCheckoutSoftPanelBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource MacCheckoutAccentSoftBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource MacCheckoutTextPrimaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CheckoutSearchItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,10" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource MacCheckoutBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource MacCheckoutSoftPanelBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource MacCheckoutAccentSoftBrush}" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource MacCheckoutAccentBorderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource MacCheckoutPageBrush}">
        <Grid Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.25*" MinWidth="560" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1.1*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="260" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource CheckoutPanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <iconPacks:PackIconMaterial Kind="CartOutline" Width="18" Height="18" Foreground="{StaticResource MacCheckoutAccentBrush}" Margin="0,0,8,0" />
                                <TextBlock Text="Current Sale" Style="{StaticResource CheckoutHeadingStyle}" VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                 <Border Background="{StaticResource MacCheckoutSoftPanelBrush}" BorderBrush="{StaticResource MacCheckoutBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="8,4" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding CartItems.Count, StringFormat={}{0} items}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MacCheckoutTextSecondaryBrush}" />
                                </Border>
                                <Button Style="{StaticResource CheckoutSecondaryButtonStyle}" Command="{Binding ClearCartCommand}" Padding="10,7">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="TrashCanOutline" Width="14" Height="14" Margin="0,0,6,0" />
                                        <TextBlock Text="Clear" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" ClipToBounds="True">
                            <DataGrid ItemsSource="{Binding CartItems}"
                                      Style="{StaticResource CheckoutDataGridStyle}"
                                      ColumnHeaderStyle="{StaticResource CheckoutDataGridHeaderStyle}"
                                      CellStyle="{StaticResource CheckoutDataGridCellStyle}"
                                      RowStyle="{StaticResource CheckoutDataGridRowStyle}"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Item" Binding="{Binding Name}" Width="*" />
                                    <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="54" />

                                    <DataGridTemplateColumn Header="Price" Width="106">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Price, StringFormat={}{0:N2}}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                    <Button Command="{Binding DataContext.OverridePriceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"
                                                            Visibility="{Binding DataContext.CanOverridePrice, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource BoolToVisibility}}"
                                                            Style="{StaticResource CheckoutSecondaryButtonStyle}"
                                                            Width="28"
                                                            Height="28"
                                                            MinHeight="28"
                                                            Padding="0"
                                                            ToolTip="Override price">
                                                        <iconPacks:PackIconMaterial Kind="PencilOutline" Width="12" Height="12" Foreground="{StaticResource MacCheckoutAccentBrush}" />
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="Total" Binding="{Binding LineTotal, StringFormat={}{0:N2}}" Width="120" />

                                    <DataGridTemplateColumn Header="Adjust" Width="142">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                    <Button Style="{StaticResource CheckoutMiniButtonStyle}"
                                                            Content="+"
                                                            Command="{Binding DataContext.IncreaseQtyCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"
                                                            Margin="0,0,4,0" />
                                                    <Button Style="{StaticResource CheckoutMiniButtonStyle}"
                                                            Content="-"
                                                            Command="{Binding DataContext.DecreaseQtyCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"
                                                            Margin="0,0,4,0" />
                                                    <Button Style="{StaticResource CheckoutMiniDangerButtonStyle}"
                                                            Content="x"
                                                            Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Border Background="{StaticResource MacCheckoutSoftPanelBrush}"
                                    BorderBrush="{StaticResource MacCheckoutBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    Padding="18"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CartItems.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Width="52" Height="52" CornerRadius="18" Background="{StaticResource MacCheckoutAccentSoftBrush}" HorizontalAlignment="Center" Margin="0,0,0,10">
                                        <iconPacks:PackIconMaterial Kind="CartOutline" Width="22" Height="22" Foreground="{StaticResource MacCheckoutAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="No items yet" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{StaticResource MacCheckoutTextPrimaryBrush}" />
                                    <TextBlock Text="Search for a product and add it to start the sale."
                                               Margin="0,5,0,0"
                                               FontSize="12"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Center"
                                               Foreground="{StaticResource MacCheckoutTextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                             <Border Grid.Column="0" Background="{StaticResource MacCheckoutSoftPanelBrush}" BorderBrush="{StaticResource MacCheckoutBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="10,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Subtotal:" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MacCheckoutTextSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" HorizontalAlignment="Right" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource MacCheckoutTextPrimaryBrush}">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} {1:N2}">
                                                <Binding Path="CurrencyCode" />
                                                <Binding Path="Subtotal" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Grid>
                            </Border>

                             <Border Grid.Column="2" Background="{StaticResource MacCheckoutSoftPanelBrush}" BorderBrush="{StaticResource MacCheckoutBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="10,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Tax:" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MacCheckoutTextSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" HorizontalAlignment="Right" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource MacCheckoutTextPrimaryBrush}">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} {1:N2}">
                                                <Binding Path="CurrencyCode" />
                                                <Binding Path="Tax" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Grid>
                            </Border>

                             <Border Grid.Column="4" Background="{StaticResource MacCheckoutAccentSoftBrush}" BorderBrush="{StaticResource MacCheckoutAccentBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="10,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Total:" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MacCheckoutTextSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" HorizontalAlignment="Right" FontSize="15" FontWeight="Black" Foreground="{StaticResource MacCheckoutAccentBrush}">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} {1:N2}">
                                                <Binding Path="CurrencyCode" />
                                                <Binding Path="Total" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource CheckoutPanelStyle}" Padding="14,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="104" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" MinWidth="130" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="TenderedCashInput"
                                     Grid.Column="0"
                                     Style="{StaticResource CheckoutTextBoxStyle}"
                                     Text="{Binding TenderedCash, UpdateSourceTrigger=PropertyChanged}"
                                     KeyDown="CashTendered_KeyDown"
                                     FontWeight="SemiBold"
                                     VerticalContentAlignment="Center"
                                     Padding="10,0"
                                     MinHeight="38"
                                     Height="38" />

                            <WrapPanel Grid.Column="2" VerticalAlignment="Center">
                                <Button Style="{StaticResource CheckoutChipButtonStyle}" Content="Exact" Command="{Binding TenderExactCommand}" />
                                <Button Style="{StaticResource CheckoutChipButtonStyle}" Content="{Binding QuickCash1, StringFormat=+{0:N0}}" Command="{Binding TenderPlus1Command}" />
                                <Button Style="{StaticResource CheckoutChipButtonStyle}" Content="{Binding QuickCash2, StringFormat=+{0:N0}}" Command="{Binding TenderPlus2Command}" />
                                <Button Style="{StaticResource CheckoutChipButtonStyle}" Content="{Binding QuickCash3, StringFormat=+{0:N0}}" Command="{Binding TenderPlus3Command}" />
                            </WrapPanel>

                             <Border Grid.Column="4" Background="{StaticResource MacCheckoutSuccessSoftBrush}" BorderBrush="{StaticResource MacCheckoutSuccessBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="10,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Change:" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MacCheckoutTextSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" HorizontalAlignment="Right" FontSize="14" FontWeight="Black" Foreground="{StaticResource MacCheckoutSuccessBrush}">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} {1:N2}">
                                                <Binding Path="CurrencyCode" />
                                                <Binding Path="ChangeDue" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Grid>
                            </Border>

                            <Button Grid.Column="6"
                                    Style="{StaticResource CheckoutPrimaryButtonStyle}"
                                    Command="{Binding CompleteSaleCommand}"
                                    IsEnabled="{Binding CanCompleteSale}"
                                    Height="42"
                                    MinWidth="150"
                                    Padding="16,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <iconPacks:PackIconMaterial Kind="CheckCircleOutline" Width="16" Height="16" Margin="0,0,8,0" />
                                    <TextBlock Text="Complete Sale" FontSize="14" FontWeight="Bold" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Border Grid.Row="1"
                                Background="{StaticResource MacCheckoutDangerSoftBrush}"
                                BorderBrush="{StaticResource MacCheckoutDangerBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="10,8"
                                Margin="0,8,0,0"
                                Visibility="{Binding StatusMessage, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="AlertCircleOutline" Width="15" Height="15" Foreground="{StaticResource MacCheckoutDangerBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding StatusMessage}" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource MacCheckoutDangerBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Column="2" Style="{StaticResource CheckoutPanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="180" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="BarcodeScan" Width="18" Height="18" Foreground="{StaticResource MacCheckoutAccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Find Product" Style="{StaticResource CheckoutHeadingStyle}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="Search by product name, then add the selected item to the sale."
                                   Margin="0,4,0,0"
                                   Style="{StaticResource CheckoutSubtleTextStyle}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Border Grid.Row="1"
                            Background="{StaticResource MacCheckoutCardBrush}"
                            BorderBrush="{StaticResource MacCheckoutBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="12,0"
                            Height="42">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <iconPacks:PackIconMaterial Grid.Column="0"
                                                        Kind="Magnify"
                                                        Width="16"
                                                        Height="16"
                                                        Foreground="{StaticResource MacCheckoutTextSecondaryBrush}"
                                                        Margin="0,0,8,0"
                                                        VerticalAlignment="Center" />

                            <TextBox x:Name="UnifiedInputBox"
                                     Grid.Column="1"
                                     Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                                     KeyDown="UnifiedInput_KeyDown"
                                     Style="{StaticResource CheckoutSearchTextBoxStyle}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Padding="0"
                                     MinHeight="30"
                                     VerticalContentAlignment="Center" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2" Margin="0,8,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Background="{StaticResource MacCheckoutSoftPanelBrush}" BorderBrush="{StaticResource MacCheckoutBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10,6">
                            <TextBlock Text="{Binding SearchResultsCount, StringFormat={}{0:N0} products}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MacCheckoutTextPrimaryBrush}" />
                        </Border>

                        <TextBlock Grid.Column="1" Text="↑↓ move  •  Enter adds" FontSize="11" Foreground="{StaticResource MacCheckoutTextSecondaryBrush}" VerticalAlignment="Center" />
                    </Grid>

                    <Border Grid.Row="3" Background="{StaticResource MacCheckoutSoftPanelBrush}" BorderBrush="{StaticResource MacCheckoutBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="6" ClipToBounds="True">
                         <ListBox ItemsSource="{Binding SearchResults}"
                                  SelectedItem="{Binding SelectedProduct}"
                                  KeyDown="ProductList_KeyDown"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  ScrollViewer.CanContentScroll="True"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ItemContainerStyle="{StaticResource CheckoutSearchItemStyle}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource MacCheckoutTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock FontSize="12" Foreground="{StaticResource MacCheckoutTextSecondaryBrush}" Margin="0,3,0,0">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0} {1:N2}">
                                                        <Binding Path="DataContext.CurrencyCode" RelativeSource="{RelativeSource AncestorType=ListBox}" />
                                                        <Binding Path="Price" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>

                                        <iconPacks:PackIconMaterial Grid.Column="1" Kind="ChevronRight" Width="14" Height="14" Foreground="{StaticResource MacCheckoutTextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <Grid Grid.Row="4" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Press Enter or click Add to Sale to add the selected item."
                                   Style="{StaticResource CheckoutSubtleTextStyle}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />

                        <Button Grid.Column="2"
                                Style="{StaticResource CheckoutPrimaryButtonStyle}"
                                Command="{Binding AddSelectedCommand}"
                                Height="42"
                                MinWidth="132">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="CartPlus" Width="16" Height="16" Margin="0,0,8,0" />
                                <TextBlock Text="Add to Sale" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid Panel.ZIndex="200" Visibility="{Binding IsConfirmClearVisible, Converter={StaticResource BoolToVisibility}}">
            <Rectangle Fill="#80182438" />

            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="420" Background="White" BorderBrush="{StaticResource MacCheckoutBorderBrush}" BorderThickness="1" CornerRadius="20" Padding="28,24">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="36" ShadowDepth="0" Opacity="0.30" />
                </Border.Effect>

                <StackPanel>
                    <Border Width="68" Height="68" CornerRadius="34" Background="{StaticResource MacCheckoutWarningSoftBrush}" HorizontalAlignment="Center" Margin="0,0,0,14">
                        <iconPacks:PackIconMaterial Kind="AlertCircleOutline" Width="30" Height="30" Foreground="{StaticResource MacCheckoutWarningAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Text="Clear Cart?" FontSize="22" FontWeight="Black" HorizontalAlignment="Center" Foreground="{StaticResource MacCheckoutTextPrimaryBrush}" Margin="0,0,0,8" />

                    <TextBlock HorizontalAlignment="Center"
                               TextAlignment="Center"
                               FontSize="13"
                               Foreground="{StaticResource MacCheckoutTextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,22"
                               Text="{Binding CartItems.Count, StringFormat=This will remove {0} item(s) from the current sale. This cannot be undone.}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Style="{StaticResource CheckoutSecondaryButtonStyle}" Command="{Binding CancelClearCartCommand}" Height="46">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Undo" Width="15" Height="15" Margin="0,0,6,0" />
                                <TextBlock Text="Keep Items" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="2" Style="{StaticResource CheckoutDangerButtonStyle}" Command="{Binding ConfirmClearCartCommand}" Height="46">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="TrashCanOutline" Width="15" Height="15" Margin="0,0,6,0" />
                                <TextBlock Text="Yes, Clear All" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Panel.ZIndex="100" Visibility="{Binding IsReceiptVisible, Converter={StaticResource BoolToVisibility}}">
            <Rectangle Fill="#80182438" />

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False"
                          Margin="12">
                <Grid>
                    <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="510" MaxHeight="860" Background="White" BorderBrush="{StaticResource MacCheckoutBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="30,24">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.34" />
                        </Border.Effect>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,18">
                                            <Border Width="70" Height="70" CornerRadius="35" Background="{StaticResource MacCheckoutSuccessSoftBrush}" HorizontalAlignment="Center" Margin="0,0,0,12">
                                                <iconPacks:PackIconMaterial Kind="CheckBold" Width="30" Height="30" Foreground="{StaticResource MacCheckoutSuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="{Binding StoreName}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{StaticResource MacCheckoutAccentBrush}" />
                                            <TextBlock Text="{Binding StoreAddress}" FontSize="11" HorizontalAlignment="Center" Foreground="{StaticResource MacCheckoutTextSecondaryBrush}" Margin="0,2,0,8" Visibility="{Binding StoreAddress, Converter={StaticResource BoolToVisibility}}" />
                                            <TextBlock Text="Sale Complete" FontSize="22" FontWeight="Black" HorizontalAlignment="Center" Foreground="{StaticResource MacCheckoutTextPrimaryBrush}" />
                                            <TextBlock FontSize="13" HorizontalAlignment="Center" Foreground="{StaticResource MacCheckoutTextSecondaryBrush}" Margin="0,4,0,0">     
                                                <Run Text="Receipt # " />
                                                <Run Text="{Binding Receipt.ReceiptNumber}" FontWeight="SemiBold" />
                                            </TextBlock>
                                        </StackPanel>
                    <Border Grid.Row="1" Background="{StaticResource MacCheckoutSuccessSoftBrush}" CornerRadius="14" Padding="0,14" Margin="0,0,0,18">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="CHANGE DUE" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{StaticResource MacCheckoutTextSecondaryBrush}" Margin="0,0,0,4" />
                            <TextBlock FontSize="40" FontWeight="Black" HorizontalAlignment="Center" Foreground="{StaticResource MacCheckoutSuccessBrush}">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} {1:N2}">
                                        <Binding Path="CurrencyCode" />
                                        <Binding Path="Receipt.Change" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto"
                                  MaxHeight="200"
                                  Margin="0,0,0,10"
                                  local:NestedScrollViewerBehavior.BubbleMouseWheel="True">
                        <ItemsControl ItemsSource="{Binding Receipt.Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="110" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="13" Foreground="{StaticResource MacCheckoutTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding Quantity, StringFormat=x {0}}" Margin="8,0" FontSize="13" Foreground="{StaticResource MacCheckoutTextSecondaryBrush}" />

                                        <TextBlock Grid.Column="2" HorizontalAlignment="Right" FontSize="13" Foreground="{StaticResource MacCheckoutTextPrimaryBrush}">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0} {1:N2}">
                                                    <Binding Path="DataContext.CurrencyCode" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                    <Binding Path="LineTotal" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel Grid.Row="3" Margin="0,0,0,20">
                        <Separator Background="{StaticResource MacCheckoutBorderBrush}" />
                        <Grid Margin="0,10,0,0">
                            <TextBlock Text="Total Charged" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource MacCheckoutTextPrimaryBrush}" />
                            <TextBlock HorizontalAlignment="Right" FontWeight="Bold" FontSize="14" Foreground="{StaticResource MacCheckoutTextPrimaryBrush}">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} {1:N2}">
                                        <Binding Path="CurrencyCode" />
                                        <Binding Path="Receipt.Total" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Row="4">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                            <Button Style="{StaticResource CheckoutSecondaryButtonStyle}" Command="{Binding OpenReceiptPdfCommand}" Height="44" Padding="14,8" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="FilePdfBox" Width="15" Height="15" Margin="0,0,6,0" />
                                    <TextBlock Text="Open Receipt" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource CheckoutSecondaryButtonStyle}" Command="{Binding OpenReceiptsFolderCommand}" Height="44" Padding="14,8">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="FolderOpen" Width="15" Height="15" Margin="0,0,6,0" />
                                    <TextBlock Text="Receipts Folder" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <Button Style="{StaticResource CheckoutPrimaryButtonStyle}" Command="{Binding DismissReceiptCommand}" Height="52" FontSize="16" FontWeight="Bold">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="Refresh" Width="16" Height="16" Margin="0,0,8,0" />
                                <TextBlock Text="New Sale" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
