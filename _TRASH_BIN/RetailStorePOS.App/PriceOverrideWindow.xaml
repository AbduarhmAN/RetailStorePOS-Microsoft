<Window x:Class="RetailStorePOS.App.PriceOverrideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Override Price"
        Width="448"
        Height="368"
        MinWidth="448"
        MinHeight="368"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown"
        Focusable="True"
        FontFamily="Inter, Segoe UI Variable Text, Segoe UI">

    <Window.Resources>
        <LinearGradientBrush x:Key="PriceDialogShellBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FDFEFF" Offset="0" />
            <GradientStop Color="#F4F8FD" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PriceDialogSummaryBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F7FAFF" Offset="0" />
            <GradientStop Color="#EEF4FF" Offset="1" />
        </LinearGradientBrush>

        <SolidColorBrush x:Key="PriceDialogMutedBrush" Color="#667085" />
        <SolidColorBrush x:Key="PriceDialogSoftBorderBrush" Color="#E3EAF4" />
        <SolidColorBrush x:Key="PriceDialogAccentBrush" Color="#3B82F6" />
        <SolidColorBrush x:Key="PriceDialogDangerBrush" Color="#B91C1C" />
        <SolidColorBrush x:Key="PriceDialogSuccessBrush" Color="#15803D" />

        <Style x:Key="PriceDialogSectionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource PriceDialogMutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="PriceDialogValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>

        <Style x:Key="PriceDialogWindowButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource PriceDialogMutedBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource PriceDialogSoftBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ChromeBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChromeBorder" Property="Background" Value="#EDF3FC" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ChromeBorder" Property="Background" Value="#E3ECFA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource PriceDialogShellBrush}"
            BorderBrush="{StaticResource AppBorder}"
            BorderThickness="1"
            CornerRadius="24"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect Color="#10233F" BlurRadius="28" ShadowDepth="0" Opacity="0.18" />
        </Border.Effect>

        <Grid x:Name="DialogRoot" Focusable="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="18,16,18,14"
                    BorderBrush="#E5ECF5"
                    BorderThickness="0,0,0,1"
                    Background="#FCFDFE"
                    CornerRadius="24,24,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <Border Background="#EAF2FF"
                                BorderBrush="#D5E4FB"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="9,4"
                                HorizontalAlignment="Left">
                            <TextBlock Text="MANUAL OVERRIDE"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PriceDialogAccentBrush}" />
                        </Border>
                        <TextBlock Text="Override Price"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,10,0,0" />
                        <TextBlock Text="Set the exact selling price for this line item before it returns to the cart."
                                   FontSize="13"
                                   Foreground="{StaticResource PriceDialogMutedBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="X"
                            Style="{StaticResource PriceDialogWindowButtonStyle}"
                            Click="Cancel_Click"
                            VerticalAlignment="Top" />
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Margin="18,16,18,0"
                    Padding="16"
                    BorderBrush="#DAE5F6"
                    BorderThickness="1"
                    Background="{StaticResource PriceDialogSummaryBrush}"
                    CornerRadius="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Current Price" Style="{StaticResource PriceDialogSectionLabelStyle}" />
                        <TextBlock x:Name="CurrentPriceText"
                                   Style="{StaticResource PriceDialogValueStyle}"
                                   Margin="0,6,0,0" />
                    </StackPanel>

                    <Border Grid.Column="1"
                            Width="1"
                            Margin="10,0"
                            Background="#D8E4F6"
                            HorizontalAlignment="Center" />

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="New Price" Style="{StaticResource PriceDialogSectionLabelStyle}" />
                        <TextBlock x:Name="PreviewPlaceholderText"
                                   Text="Start typing new price..."
                                   FontSize="13"
                                   FontStyle="Italic"
                                   Foreground="{StaticResource PriceDialogMutedBrush}"
                                   Margin="0,10,0,0" />
                        <TextBlock x:Name="PreviewPriceText"
                                    Style="{StaticResource PriceDialogValueStyle}"
                                    Margin="0,6,0,0"
                                    Visibility="Collapsed" />
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Row="2"
                        Margin="18,14,18,0"
                        VerticalAlignment="Top">
                <TextBlock x:Name="DeltaText"
                           FontSize="12"
                           Foreground="{StaticResource PriceDialogAccentBrush}"
                           TextWrapping="Wrap" />

                <Border x:Name="ValidationBorder"
                        Margin="0,12,0,0"
                        Padding="12,10"
                        Background="#FEF2F2"
                        BorderBrush="#F5C2C7"
                        BorderThickness="1"
                        CornerRadius="12"
                        Visibility="Collapsed">
                    <TextBlock x:Name="ValidationText"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PriceDialogDangerBrush}"
                               TextWrapping="Wrap" />
                </Border>
            </StackPanel>

            <Border Grid.Row="3"
                    Margin="0,16,0,0"
                    Padding="18,14,18,18"
                    BorderBrush="#E5ECF5"
                    BorderThickness="0,1,0,0"
                    Background="#FCFDFE"
                    CornerRadius="0,0,24,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Apply only when the customer has approved the final selling amount."
                               FontSize="12"
                               Foreground="{StaticResource PriceDialogMutedBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,14,0" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Cancel"
                                IsCancel="True"
                                Click="Cancel_Click"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,8,0"
                                Padding="18,10" />
                        <Button x:Name="ConfirmButton"
                                Content="Apply Override"
                                IsDefault="True"
                                Click="Confirm_Click"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Padding="18,10" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
