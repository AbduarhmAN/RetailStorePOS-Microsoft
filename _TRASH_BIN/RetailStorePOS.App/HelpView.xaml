<UserControl x:Class="RetailStorePOS.App.HelpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RetailStorePOS.App"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AppTextPrimary}" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </UserControl.Resources>

    <Grid Background="#FBFCFE">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="#FCFDFF"
                BorderBrush="{StaticResource AppBorder}"
                BorderThickness="0,0,0,1"
                Padding="32,24">
            <StackPanel>
                <TextBlock Text="About Nexill POS"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AppTextPrimary}"
                           Margin="0,0,0,4" />
                <TextBlock Text="Review the terms of use and privacy policy for Nexill POS."
                           FontSize="15"
                           Foreground="{StaticResource AppMuted}" />
            </StackPanel>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="32,24">
            <Border Background="White"
                    BorderBrush="{StaticResource AppBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="32">
                <TextBox Text="{Binding PolicyText, Mode=OneWay}"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         BorderThickness="0"
                         Background="Transparent"
                         FontSize="14"
                         FontFamily="Consolas"
                         Foreground="#333333" />
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
