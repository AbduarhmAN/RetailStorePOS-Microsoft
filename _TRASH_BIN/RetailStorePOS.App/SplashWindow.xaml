<Window x:Class="RetailStorePOS.App.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Starting Nexill POS"
        Width="440"
        Height="260"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True">
    <Border Background="#CC0F172A"
            CornerRadius="28"
            BorderBrush="#335A78A6"
            BorderThickness="1"
            Padding="24">
        <Border.Effect>
            <DropShadowEffect Color="#0B1120" BlurRadius="36" ShadowDepth="0" Opacity="0.34" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <Border Width="56"
                        Height="56"
                        CornerRadius="18"
                        Background="#F8FBFF"
                        Padding="8">
                    <Image Source="Resources/Images/logo.png"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>

                <StackPanel Margin="14,2,0,0">
                    <TextBlock Text="Nexill POS"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="White" />
                    <TextBlock Text="Preparing the store workspace"
                               Margin="0,4,0,0"
                               FontSize="13"
                               Foreground="#C9D8EE" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,16,0,18">
                <TextBlock x:Name="StatusTitleText"
                           Text="Starting services"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="White" />
                <TextBlock x:Name="StatusDetailText"
                           Text="Loading local database, services, and WebView2 runtime."
                           Margin="0,8,0,0"
                           FontSize="13"
                           TextWrapping="Wrap"
                           Foreground="#B7C9E2"
                           LineHeight="20" />
            </StackPanel>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ProgressBar IsIndeterminate="True"
                             Height="8"
                             VerticalAlignment="Center"
                             Background="#243247"
                             Foreground="#5EA0FF"
                             BorderThickness="0" />

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center">
                    <iconPacks:PackIconMaterial Kind="LightningBolt"
                                                Width="16"
                                                Height="16"
                                                Foreground="#9CC2FF"
                                                Margin="0,0,6,0" />
                    <TextBlock Text="Offline-first startup"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#AFC6E8" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
