<UserControl x:Class="RetailStorePOS.App.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RetailStorePOS.App"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Background="Transparent"
             FontFamily="Inter, Segoe UI Variable Text, Segoe UI">

    <UserControl.Resources>
        <Color x:Key="MacPageTopColor">#F8F9FB</Color>
        <Color x:Key="MacPageBottomColor">#EEF2F6</Color>
        <Color x:Key="MacSurfaceColor">#F6F8FC</Color>
        <Color x:Key="MacCardColor">#FFFFFF</Color>
        <Color x:Key="MacBorderColor">#DCE4EF</Color>
        <Color x:Key="MacTextPrimaryColor">#1C2431</Color>
        <Color x:Key="MacTextSecondaryColor">#6A7486</Color>
        <Color x:Key="MacAccentColor">#3B82F6</Color>
        <Color x:Key="MacAccentPressedColor">#2563EB</Color>
        <Color x:Key="MacDangerColor">#FF3B30</Color>
        <Color x:Key="MacSuccessColor">#17994E</Color>

        <LinearGradientBrush x:Key="MacPageBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="{StaticResource MacPageTopColor}" Offset="0" />
            <GradientStop Color="{StaticResource MacPageBottomColor}" Offset="1" />
        </LinearGradientBrush>

        <SolidColorBrush x:Key="MacSurfaceBrush" Color="{StaticResource MacSurfaceColor}" />
        <SolidColorBrush x:Key="MacCardBrush" Color="{StaticResource MacCardColor}" />
        <SolidColorBrush x:Key="MacBorderBrush" Color="{StaticResource MacBorderColor}" />
        <SolidColorBrush x:Key="MacTextPrimaryBrush" Color="{StaticResource MacTextPrimaryColor}" />
        <SolidColorBrush x:Key="MacTextSecondaryBrush" Color="{StaticResource MacTextSecondaryColor}" />
        <SolidColorBrush x:Key="MacAccentBrush" Color="{StaticResource MacAccentColor}" />
        <SolidColorBrush x:Key="MacAccentPressedBrush" Color="{StaticResource MacAccentPressedColor}" />
        <SolidColorBrush x:Key="MacDangerBrush" Color="{StaticResource MacDangerColor}" />
        <SolidColorBrush x:Key="MacSuccessBrush" Color="{StaticResource MacSuccessColor}" />

        <Style x:Key="HeaderContainerStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource MacCardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource MacBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="18,15" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#0F1F33" BlurRadius="18" ShadowDepth="0" Opacity="0.05" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarContainerStyle" TargetType="Border" BasedOn="{StaticResource HeaderContainerStyle}">
            <Setter Property="Padding" Value="12" />
        </Style>

        <Style x:Key="ContentPanelStyle" TargetType="Border" BasedOn="{StaticResource HeaderContainerStyle}">
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="InnerCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FBFCFE" />
            <Setter Property="BorderBrush" Value="#E3EAF5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="15" />
            <Setter Property="Padding" Value="14" />
        </Style>

        <Style x:Key="HeaderTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource MacTextPrimaryBrush}" />
        </Style>

        <Style x:Key="HeaderSubtitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource MacTextSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource MacTextPrimaryBrush}" />
        </Style>

        <Style x:Key="BodyTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource MacTextSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource MacTextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>

        <Style x:Key="SidebarHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource MacTextSecondaryBrush}" />
            <Setter Property="Margin" Value="6,4,6,10" />
        </Style>

        <Style x:Key="SectionChipStyle" TargetType="Border">
            <Setter Property="Background" Value="#EDF3FD" />
            <Setter Property="BorderBrush" Value="#D4E2F7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <Style x:Key="SidebarNavButtonStyle" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="NavBorder"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="12">
                            <ContentPresenter Margin="11,9" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#ECF3FD" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#E2EEFF" />
                                <Setter TargetName="NavBorder" Property="BorderBrush" Value="#BFD7FA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarNavTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource MacTextPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="MacInputStyle" TargetType="TextBox">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="11,7" />
            <Setter Property="Foreground" Value="{StaticResource MacTextPrimaryBrush}" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#DCE4EF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsKeyboardFocused" Value="True" />
                                    <Condition Property="IsReadOnly" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="{StaticResource MacAccentBrush}" />
                                <Setter TargetName="InputBorder" Property="BorderThickness" Value="2" />
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="InputBorder" Property="Opacity" Value="0.65" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MacToggleStyle" TargetType="CheckBox">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource MacTextPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid Width="46" Height="28" VerticalAlignment="Center">
                                <Border x:Name="Track" CornerRadius="14" Background="#CED5E1" />
                                <Ellipse x:Name="Knob" Width="22" Height="22" Fill="White" Margin="3,3,21,3">
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="#5E6C80" ShadowDepth="1" BlurRadius="3" Opacity="0.18" />
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Grid>

                            <ContentPresenter Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource MacAccentBrush}" />
                                <Setter TargetName="Knob" Property="Margin" Value="21,3,3,3" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.6" />
                                <Setter TargetName="Knob" Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MacBaseButtonStyle" TargetType="Button">
            <Style.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                </Style>
            </Style.Resources>
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="13,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.84" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MacPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource MacBaseButtonStyle}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource MacAccentBrush}" />
            <Setter Property="BorderBrush" Value="#2563EB" />
        </Style>

        <Style x:Key="MacSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource MacBaseButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource MacTextPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#DCE4EF" />
        </Style>

        <Style x:Key="MacDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource MacBaseButtonStyle}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource MacDangerBrush}" />
            <Setter Property="BorderBrush" Value="#DC2F24" />
        </Style>

        <Style x:Key="MacListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="#F8FBFF" />
            <Setter Property="BorderBrush" Value="{StaticResource MacBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer Focusable="False">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MacListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#EDF3FD" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#E2EEFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="UnlockToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Border" Background="{StaticResource MacSurfaceBrush}" BorderBrush="{StaticResource MacBorderBrush}" BorderThickness="1" CornerRadius="12">
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <iconPacks:PackIconMaterial x:Name="Icon" Kind="Pencil" Width="14" Height="14" Foreground="{StaticResource MacTextSecondaryBrush}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Icon" Property="Kind" Value="Check" />
                                <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource MacSuccessBrush}" />
                                <Setter TargetName="Border" Property="Background" Value="#E6F4EA" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource MacSuccessBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource MacPageBackgroundBrush}">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource HeaderContainerStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="Cog" Width="26" Height="26" Foreground="{StaticResource MacAccentBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Settings" Style="{StaticResource HeaderTitleStyle}" Margin="10,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="Store setup, tax defaults, and cashier preferences in one workspace."
                               Style="{StaticResource HeaderSubtitleStyle}"
                               Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource SidebarContainerStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Sections" Style="{StaticResource SidebarHeaderStyle}" />

                            <RadioButton x:Name="NavStore"
                                         GroupName="SettingsSection"
                                         IsChecked="{Binding IsStoreManagementSelected, Mode=TwoWay}"
                                         Style="{StaticResource SidebarNavButtonStyle}"
                                         Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="StorefrontOutline" Width="16" Height="16" Foreground="{StaticResource MacAccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Store Management" Style="{StaticResource SidebarNavTextStyle}" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavPreferences"
                                         GroupName="SettingsSection"
                                         IsChecked="{Binding IsMyPreferencesSelected, Mode=TwoWay}"
                                         Style="{StaticResource SidebarNavButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="AccountCogOutline" Width="16" Height="16" Foreground="{StaticResource MacAccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="My Preferences" Style="{StaticResource SidebarNavTextStyle}" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <Border Grid.Row="2" Background="#F5F8FE" BorderBrush="#DCE4EF" BorderThickness="1" CornerRadius="12" Padding="11,9">
                            <TextBlock Text="Select a section to update store settings or your cashier workflow."
                                       Style="{StaticResource BodyTextStyle}" />
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Column="2">
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource ContentPanelStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStoreManagementSelected}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Grid Margin="18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="StorefrontOutline" Width="20" Height="20" Foreground="{StaticResource MacAccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Store Management" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Manage store details, receipt output, and tax settings used across the workspace."
                                           Style="{StaticResource BodyTextStyle}"
                                           Margin="0,6,0,0" />

                                <Border Style="{StaticResource InnerCardStyle}"
                                        Padding="12,10"
                                        Margin="0,12,0,0"
                                        Background="#F5F8FE"
                                        BorderBrush="#DCE4EF">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <iconPacks:PackIconMaterial Kind="ShieldLockOutline" Width="16" Height="16" Foreground="{StaticResource MacAccentBrush}" Margin="0,0,8,0" />
                                                <TextBlock Text="Store editing is protected" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MacTextPrimaryBrush}" />
                                            </StackPanel>
                                            <TextBlock Text="Unlock protected store details before editing. Tax defaults and category changes are managed in the cards below."
                                                       Style="{StaticResource BodyTextStyle}"
                                                       Margin="0,6,0,0" />
                                        </StackPanel>

                                        <Button Grid.Column="1"
                                                Content="Save Store Settings"
                                                Command="{Binding SaveStoreSettingsCommand}"
                                                Style="{StaticResource MacPrimaryButtonStyle}"
                                                Margin="14,0,0,0"
                                                VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="0,0,6,0">
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Style="{StaticResource InnerCardStyle}">
                                            <StackPanel>
                                                <TextBlock Text="Store Identity" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource MacTextPrimaryBrush}" />
                                                <TextBlock Text="These details appear on receipts and other customer-facing documents."
                                                           Style="{StaticResource BodyTextStyle}"
                                                           Margin="0,3,0,12" />

                                                <TextBlock Text="Store Name" Style="{StaticResource FieldLabelStyle}" />
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0"
                                                             Style="{StaticResource MacInputStyle}"
                                                             Text="{Binding StoreName, UpdateSourceTrigger=PropertyChanged}"
                                                             IsReadOnly="{Binding IsStoreNameUnlocked, Converter={StaticResource InverseBoolConverter}}" />
                                                    <ToggleButton Grid.Column="1"
                                                                  IsChecked="{Binding IsStoreNameUnlocked, Mode=TwoWay}"
                                                                  ToolTip="Unlock field for editing"
                                                                  Style="{StaticResource UnlockToggleButtonStyle}" />
                                                </Grid>

                                                <TextBlock Text="Store Address" Style="{StaticResource FieldLabelStyle}" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0"
                                                             AcceptsReturn="True"
                                                             TextWrapping="Wrap"
                                                             MinHeight="78"
                                                             Style="{StaticResource MacInputStyle}"
                                                             Text="{Binding StoreAddress, UpdateSourceTrigger=PropertyChanged}"
                                                             IsReadOnly="{Binding IsStoreAddressUnlocked, Converter={StaticResource InverseBoolConverter}}" />
                                                    <ToggleButton Grid.Column="1"
                                                                  VerticalAlignment="Top"
                                                                  IsChecked="{Binding IsStoreAddressUnlocked, Mode=TwoWay}"
                                                                  ToolTip="Unlock field for editing"
                                                                  Style="{StaticResource UnlockToggleButtonStyle}" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="2" Style="{StaticResource InnerCardStyle}">
                                            <StackPanel>
                                                <TextBlock Text="Checkout Defaults" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource MacTextPrimaryBrush}" />
                                                <TextBlock Text="Core settings used for pricing, tax, and receipt output."
                                                           Style="{StaticResource BodyTextStyle}"
                                                           Margin="0,3,0,12" />

                                                <TextBlock Text="Currency Code" Style="{StaticResource FieldLabelStyle}" />
                                                <TextBox Width="180"
                                                         HorizontalAlignment="Left"
                                                         Style="{StaticResource MacInputStyle}"
                                                         Text="{Binding CurrencyCode, UpdateSourceTrigger=PropertyChanged}"
                                                         Margin="0,0,0,12" />

                                                <TextBlock Text="Tax Calculation" Style="{StaticResource FieldLabelStyle}" />
                                                <CheckBox Content="Enable tax"
                                                          IsChecked="{Binding TaxEnabled}"
                                                          Style="{StaticResource MacToggleStyle}"
                                                          Margin="0,2,0,12" />

                                                <TextBlock Text="Default Tax Rate" Style="{StaticResource FieldLabelStyle}" />
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBox Width="180"
                                                             Style="{StaticResource MacInputStyle}"
                                                             Text="{Binding TaxRatePercent, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBlock Text="%"
                                                               Margin="8,0,0,0"
                                                               VerticalAlignment="Center"
                                                               Foreground="{StaticResource MacTextSecondaryBrush}"
                                                               FontWeight="SemiBold" />
                                                </StackPanel>

                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Border Style="{StaticResource InnerCardStyle}">
                                        <Grid MinHeight="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="0.92*" />
                                                <ColumnDefinition Width="18" />
                                                <ColumnDefinition Width="1.08*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0"
                                                        Margin="0,0,4,0"
                                                        MaxWidth="440"
                                                        MinWidth="0"
                                                        HorizontalAlignment="Stretch">
                                                <TextBlock Text="Tax Categories" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource MacTextPrimaryBrush}" />
                                                <TextBlock Text="Manage tax categories and rates used in product setup and reporting."
                                                           Style="{StaticResource BodyTextStyle}"
                                                           Margin="0,3,0,12"
                                                           MaxWidth="400" />

                                                <ListBox ItemsSource="{Binding TaxCategories}"
                                                         SelectedItem="{Binding SelectedTaxCategory, Mode=TwoWay}"
                                                         local:NestedScrollViewerBehavior.BubbleMouseWheel="True"
                                                         Style="{StaticResource MacListBoxStyle}"
                                                         ItemContainerStyle="{StaticResource MacListBoxItemStyle}"
                                                         Height="170"
                                                         MinWidth="0"
                                                         MaxWidth="440">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource MacTextPrimaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                                                                <TextBlock Grid.Column="1" Text="{Binding RatePercent, StringFormat={}{0:N2}%}" Foreground="{StaticResource MacTextSecondaryBrush}" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </StackPanel>

                                            <Border Grid.Column="2"
                                                    Background="White"
                                                    BorderBrush="#E3EAF5"
                                                    BorderThickness="1"
                                                    CornerRadius="14"
                                                    Padding="14"
                                                    IsEnabled="{Binding IsAdmin}"
                                                    MinWidth="0"
                                                    MaxWidth="420"
                                                    HorizontalAlignment="Stretch">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="14" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="14" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <StackPanel Grid.Row="0" MaxWidth="360">
                                                        <TextBlock Text="Category Editor" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource MacTextPrimaryBrush}" />
                                                        <TextBlock Text="Create, update, or remove tax categories from one simple form."
                                                                   Style="{StaticResource BodyTextStyle}"
                                                                   Margin="0,3,0,0"
                                                                   MaxWidth="340" />
                                                    </StackPanel>

                                                    <Grid Grid.Row="2" MaxWidth="340">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>

                                                        <TextBlock Grid.Row="0" Text="Category Name" Style="{StaticResource FieldLabelStyle}" />
                                                        <TextBox Grid.Row="1"
                                                                 Margin="0,0,0,10"
                                                                 Style="{StaticResource MacInputStyle}"
                                                                 MaxWidth="340"
                                                                 Text="{Binding EditCategoryName, UpdateSourceTrigger=PropertyChanged}" />

                                                        <TextBlock Grid.Row="2" Text="Tax Rate" Style="{StaticResource FieldLabelStyle}" />
                                                        <Grid Grid.Row="3" MaxWidth="220">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBox Grid.Column="0"
                                                                     Style="{StaticResource MacInputStyle}"
                                                                     MaxWidth="180"
                                                                     Text="{Binding EditCategoryRate, UpdateSourceTrigger=PropertyChanged}" />
                                                            <TextBlock Grid.Column="1"
                                                                       Text="%"
                                                                       Margin="8,0,0,0"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{StaticResource MacTextSecondaryBrush}"
                                                                       FontWeight="SemiBold" />
                                                        </Grid>
                                                    </Grid>

                                                    <WrapPanel Grid.Row="4"
                                                               HorizontalAlignment="Left"
                                                               ItemHeight="32"
                                                               MaxWidth="360">
                                                        <Button Content="Add" Command="{Binding NewCategoryCommand}" Style="{StaticResource MacSecondaryButtonStyle}" Margin="0,0,8,0" Padding="11,4" MinHeight="32" />
                                                        <Button Content="Save" Command="{Binding SaveCategoryCommand}" Style="{StaticResource MacPrimaryButtonStyle}" Margin="0,0,8,0" Padding="11,4" MinHeight="32" />
                                                        <Button Content="Delete" Command="{Binding DeleteCategoryCommand}" Style="{StaticResource MacDangerButtonStyle}" Padding="11,4" MinHeight="32" />
                                                    </WrapPanel>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <Border Grid.Row="2" Margin="0,16,0,0" Background="#F4F8FE" BorderBrush="#DFE6F2" BorderThickness="1" CornerRadius="12" Padding="11,9">
                                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource MacTextSecondaryBrush}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </Border>
                        </Grid>
                    </Border>

                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource ContentPanelStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMyPreferencesSelected}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Grid Margin="18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="AccountCogOutline" Width="20" Height="20" Foreground="{StaticResource MacAccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="My Preferences" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="These settings apply only to your login and are designed for faster checkout."
                                           Style="{StaticResource BodyTextStyle}"
                                           Margin="0,6,0,0" />

                                <Border Style="{StaticResource InnerCardStyle}"
                                        Padding="12,10"
                                        Margin="0,12,0,0"
                                        Background="#F5F8FE"
                                        BorderBrush="#DCE4EF">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <iconPacks:PackIconMaterial Kind="TuneVariant" Width="16" Height="16" Foreground="{StaticResource MacAccentBrush}" Margin="0,0,8,0" />
                                                <TextBlock Text="Personal preferences save automatically" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MacTextPrimaryBrush}" />
                                            </StackPanel>
                                            <TextBlock Text="Update your quick-cash values to match the bills you use most often. Changes apply right away."
                                                       Style="{StaticResource BodyTextStyle}"
                                                       Margin="0,6,0,0" />
                                        </StackPanel>

                                        <Border Grid.Column="1"
                                                Background="#EAF2FF"
                                                BorderBrush="#D5E4FB"
                                                BorderThickness="1"
                                                CornerRadius="9"
                                                Padding="10,5"
                                                Margin="14,0,0,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="AUTO-SAVE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MacAccentBrush}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="0,0,6,0">
                                    <Border Style="{StaticResource InnerCardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="Custom Quick-Cash Buttons" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource MacTextPrimaryBrush}" />
                                            <TextBlock Text="Set the cash shortcuts shown on the checkout screen."
                                                       Style="{StaticResource BodyTextStyle}"
                                                       Margin="0,3,0,12" />

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="14" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="14" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Button 1 Value" Style="{StaticResource FieldLabelStyle}" />
                                                    <TextBox Style="{StaticResource MacInputStyle}" Text="{Binding QuickCash1, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Button 2 Value" Style="{StaticResource FieldLabelStyle}" />
                                                    <TextBox Style="{StaticResource MacInputStyle}" Text="{Binding QuickCash2, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="4">
                                                    <TextBlock Text="Button 3 Value" Style="{StaticResource FieldLabelStyle}" />
                                                    <TextBox Style="{StaticResource MacInputStyle}" Text="{Binding QuickCash3, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource InnerCardStyle}" Margin="0,14,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Cashier Workflow" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource MacTextPrimaryBrush}" />
                                            <TextBlock Text="Keep quick-cash values aligned with the bills most often used at your counter."
                                                       Style="{StaticResource BodyTextStyle}"
                                                       Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <Border Grid.Row="2" Margin="0,16,0,0" Background="#F4F8FE" BorderBrush="#DFE6F2" BorderThickness="1" CornerRadius="12" Padding="11,9">
                                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource MacTextSecondaryBrush}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
